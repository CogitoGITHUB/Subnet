(defun my/cyberdeck-extract-aiu-proxy-links (ctx aiu-data)
  "Extract id: links from #+wormhole: keywords in CTX."
  (let* ((ast     (cyberdeck-parse-ctx-ast ctx))
         (aiu-id (plist-get aiu-data :id))
         (found   nil))
    (org-element-map ast 'keyword
      (lambda (kw)
        (when (string= (org-element-property :key kw) "WORMHOLE")
          (let ((value (org-element-property :value kw)))
            (when (string-match "\\[\\[id:\\([^] \t\n]+\\)\\]\\[" value)
              (push (match-string-no-properties 1 value) found))))))
    (when found
      (let ((unique (delete-dups (nreverse found))))
        (emacsql (cyberdeck-db)
                 [:delete :from aiu-proxy-links :where (= source $s1)]
                 aiu-id)
        (emacsql (cyberdeck-db)
                 [:insert :into aiu-proxy-links :values $v1]
                 (mapcar (lambda (d) (vector aiu-id d)) unique))
        (plist-put aiu-data :aiu-proxy-links unique)))
    aiu-data))


#+begin_src emacs-lisp
(defvar my/subnet-root nil
  "Cached Cartesia vault root. Found by structure, never by name.")

(defun my/subnet--from-here ()
  "Walk upward from the current file for the vault root: dir containing .git/."
  (let ((d (file-name-directory
            (or load-file-name buffer-file-name default-directory))))
    (catch 'found
      (while (and d (not (string= d (file-name-directory
                                     (directory-file-name d)))))
        (when (file-directory-p (expand-file-name ".git" d))
          (throw 'found (directory-file-name d)))
        (setq d (file-name-directory (directory-file-name d))))
      nil)))

(defun my/subnet--home-candidates ()
  "Dirs to search: home plus physical parents behind symlinks."
  (let ((home (expand-file-name "~"))
        (out nil))
    (push home out)
    (dolist (e (ignore-errors (directory-files home t "^[^.]")))
      (when (and (file-symlink-p e)
                 (file-directory-p e))
        (let ((parent (file-name-directory
                       (directory-file-name (file-truename e)))))
          (when (and parent (file-directory-p parent))
            (push parent out)))))
    (delete-dups out)))

(defun my/subnet--from-home ()
  "Scan home candidates' children for the vault: the child containing .git/."
  (catch 'found
    (dolist (home (my/subnet--home-candidates))
      (dolist (e (ignore-errors (directory-files home t "^[^.]")))
        (when (and (file-directory-p e)
                   (file-directory-p (expand-file-name ".git" e)))
          (throw 'found e))))
    nil))

(defun my/subnet-root-dir ()
  "Return the Cartesia vault root, discovered by structure.
Prefers the loader's own vault root (correct by construction: derived
from the Foundation file's location, never from call context), then
falls back to upward search and home-children scan.  Cached after
first hit.  The loader preference matters: a context-derived first
call from a foreign cwd (e.g. ~/.config/emacs, whose own .git matches
the upward search) once poisoned this cache for the whole session."
  (or my/subnet-root
      (setq my/subnet-root
            (or (and (boundp 'cyberdeck-emacs-vault-root)
                     cyberdeck-emacs-vault-root
                     (file-directory-p cyberdeck-emacs-vault-root)
                     cyberdeck-emacs-vault-root)
                (my/subnet--from-here)
                (my/subnet--from-home)
                (error "Cartesia root not found")))))

(defun my/cyberdeck-root-dir ()
  "Return the manifold AIU Frame root directory.
Single function everything asks. Self-locating: renames never break it."
  (my/subnet-root-dir))

;; Scope the agenda to AIUs. Excluded:
;;   /.git/               internals
;;   /WIP/                raw drift captures, not AIUs
;;   /admin/              prompt and commit infrastructure, not AIUs
;;   /emacs-cyberdeck/ the Emacs config tree itself
;;
;; The last is load-bearing, not cosmetic. The Cyberdeck aiu-contexts under
;; it carry 142 `** STATE :AIU_CONTEXT_BODY:' headings drawn from ~130
;; distinct state words (seasons, day-parts, cadences, the installation
;; spine) plus every heading of the TODO vocabulary itself. With those
;; states live as todo keywords — which `org-todo-states' now does —
;; an unfiltered agenda would list the aiu-context definitions as if
;; they were your work.
(setq org-agenda-files
      (cl-remove-if
       (lambda (f) (or (string-match-p (regexp-quote "/.git/") f)
                       (string-match-p "/WIP/" f)
                       (string-match-p "/admin/" f)
                       (string-match-p "/emacs-cyberdeck/" f)))
       (directory-files-recursively (my/cyberdeck-root-dir) "[^./]+$")))

(add-to-list 'auto-mode-alist
             `(,(concat "\\`" (regexp-quote (directory-file-name (my/cyberdeck-root-dir)))
                        "/" "\\(.*/\\)?" "[^./]+\\'")
               . org-mode))
#+end_src

* AIU Cyberdeck Bootstrap

** Engine configuration and require
#+begin_src emacs-lisp
(setq cyberdeck-db-location
      (expand-file-name "admin/cyberdeck.db"
                        (my/cyberdeck-root-dir)))

(setq cyberdeck-db-sync-directories
      (list (my/cyberdeck-root-dir)))

(setq cyberdeck-default-aius-directory
      (my/cyberdeck-root-dir))

(setq cyberdeck-db-sync-external-method 'poll)
(setq cyberdeck-db-sync-verbose nil)
;; Belt: fswatch rarely exists on Termux, so poll is the watcher.
;; Keep its interval tight; guarded in case the engine renames it.
(when (boundp 'cyberdeck-db-sync-poll-interval)
  (setq cyberdeck-db-sync-poll-interval 10))

;; AIU Subnet queries read the DB, so saved files must land there:
;; enable per-buffer autosync in every org buffer (the after-save
;; entry itself gates by sync-directories, so non-vault files are
;; untouched). Vault AIUs visit in org-mode via auto-mode-alist.
;; Deferred past the db unit: load order must never matter here.
(with-eval-after-load 'cyberdeck-db
  (when (fboundp 'cyberdeck--autosync-mode)
    (add-hook 'org-mode-hook
              (lambda ()
                (cyberdeck--autosync-mode 1)))))

;; Boot backfill, idle and one-shot: historical rows predate drawer
;; capture, so AIU Subnet reads would miss their MM_* data. One
;; background walk re-indexes everything; autosync plus explicit
;; creation updates keep it fresh after that. Never throws, never
;; blocks boot (idle 60s, silent unless it fails).
(defvar my/cyberdeck--backfill-timer nil
  "Idle timer for the one-shot boot backfill.")

(defun my/cyberdeck--backfill-vault ()
  "Re-index every vault file's DB row (drawers included)."
  (setq my/cyberdeck--backfill-timer nil)
  (condition-case nil
      (when (and (fboundp 'cyberdeck-db-update-file)
                 (fboundp 'my/cyberdeck-root-dir))
        (let ((root (ignore-errors (my/cyberdeck-root-dir)))
              (n 0))
          (when (and root (file-directory-p root))
            (dolist (f (directory-files-recursively root "[^./]+$"))
              (when (and (file-regular-p f)
                         (not (string-match-p "/\\.git/" f))
                         (not (string-match-p "/WIP/" f)))
                (ignore-errors
                 (cyberdeck-db-update-file f)
                 (setq n (1+ n)))))
            (message "Cyberdeck DB backfill: %d files re-indexed" n))))
    (error nil)))

(when (null my/cyberdeck--backfill-timer)
  (setq my/cyberdeck--backfill-timer
        (run-with-idle-timer 60 nil #'my/cyberdeck--backfill-vault)))

(defvar my/cyberdeck-db--location-used nil
  "Endpoint identity used when the current DB connection was opened.
A cons (BACKEND . LOCATION-OR-NIL): sqlite tracks the file path, pg
tracks the backend alone since its data lives outside the vault.")

(defvar my/cyberdeck-db--guard-inside nil
  "Re-entrancy latch for `my/cyberdeck-db-location-guard'.
Nested `(cyberdeck-db)' calls made during init must never
trigger another close/reopen cycle.")
#+end_src

** DB relocation guard
Guarantees the vault DB always lives beside the AIUs even if a
stale session opened it elsewhere.
#+begin_src emacs-lisp
(defun cyberdeck-db-close ()
  "Close the current vault DB connection, if any.
The guard below calls this; it was missing (void on every
endpoint change), so any save after a location change dropped
into the debugger."
  (when (and (boundp 'cyberdeck-db--connection)
             cyberdeck-db--connection)
    (ignore-errors
      (when (fboundp 'emacsql-close)
        (emacsql-close cyberdeck-db--connection)))
    (setq cyberdeck-db--connection nil)))

(defun my/cyberdeck-db--relocate-legacy ()
  "Move a default-location DB to `cyberdeck-db-location'.
Runs before every connection attempt; cheap no-op once relocated."
  (let ((legacy (expand-file-name "manifolding-aiu-frame.db"
                                  user-emacs-directory))
        (target cyberdeck-db-location))
    (when (and (file-exists-p legacy)
               (not (file-exists-p target))
               (not (equal (expand-file-name legacy)
                           (expand-file-name target))))
      (make-directory (file-name-directory target) t)
      (condition-case err
          (progn
            (cyberdeck-db-close)
            (rename-file legacy target nil)
            (message "AIU Cyberdeck: relocated database to %s"
                     target))
        (error
         (lwarn 'cyberdeck :warning
                "database relocation failed: %s"
                (error-message-string err)))))))

(defun my/cyberdeck-db-location-guard (orig)
  "Reconnect when the DB endpoint changed under us.
Tracks backend + location as one endpoint identity: sqlite reacts to
path changes (plus the legacy file relocation), pg reacts to backend
flips and ignores path changes (its data lives outside the vault)."
  (unless my/cyberdeck-db--guard-inside
    (let ((my/cyberdeck-db--guard-inside t))
      (when (eq my/cyberdeck-db-backend 'sqlite)
        (my/cyberdeck-db--relocate-legacy))
      (let ((endpoint (cons my/cyberdeck-db-backend
                            (and (eq my/cyberdeck-db-backend 'sqlite)
                                 cyberdeck-db-location))))
        (when (and cyberdeck-db--connection
                   (not (equal my/cyberdeck-db--location-used endpoint)))
          (cyberdeck-db-close))
        (when (or (null cyberdeck-db--connection)
                  (not (equal my/cyberdeck-db--location-used endpoint)))
          (funcall orig)
          (setq my/cyberdeck-db--location-used endpoint)))))
  (funcall orig))

(advice-add 'cyberdeck-db :around
            #'my/cyberdeck-db-location-guard)
#+end_src

** Sync overrides: fswatch sentinel and file predicate
Tracks `.org' files AND extensionless vault files.
#+begin_src emacs-lisp
(defun my/cyberdeck-db-sync--fswatch-sentinel (proc event)
  (unless (or (string-match-p "hangup\\|finished" event)
              (process-live-p proc))
    (message "AIU Cyberdeck: fswatch process died (%s), restarting..."
             (string-trim event))))

(advice-add 'cyberdeck-db-sync--fswatch-sentinel :override
            #'my/cyberdeck-db-sync--fswatch-sentinel)

(defun my/cyberdeck-db-sync--org-file-p (path)
  "Track extensionless vault files. Skips dotfiles."
  (and path
       (not (string-match-p "/\\." path))
       (not (string-match-p "\\." (file-name-nondirectory path)))))

(advice-add 'cyberdeck-db-sync--org-file-p :override
            #'my/cyberdeck-db-sync--org-file-p)
#+end_src

** Sync override: race-safe directory walk
Walks manually instead of `directory-files-recursively' so that:
`.git' is never descended into (it is not content), and a directory
that vanishes mid-scan (git gc/pack races) is skipped instead of
killing the whole poll cycle.
#+begin_src emacs-lisp
(defun my/cyberdeck-db-sync--list-org-files (dir)
  "List vault files under DIR: extensionless entries."
  (let* ((root (expand-file-name dir))
         (files nil)
         (dirs (list root))
         (seen (make-hash-table :test #'equal)))
    (while dirs
      (let ((d (pop dirs)))
        (when (and (file-directory-p d)
                   (not (gethash d seen)))
          (puthash d t seen)
          ;; "^[^.]" skips dotfiles/dotdirs (.git included) at the source.
          (let ((listing (ignore-errors (directory-files d t "^[^.]" t))))
            (dolist (entry listing)
              (cond
               ((file-directory-p entry)
                 ;; WIP excluded: forbidden territory is never walked,
                 ;; visited, or parsed by sync.
                 (unless (member (file-name-nondirectory entry)
                                 '(".git" "WIP"))
                   (push entry dirs)))
               ((file-regular-p entry)
                 (push entry files))))))))
    (seq-filter #'cyberdeck-db-sync--org-file-p
                (nreverse files))))

(advice-add 'cyberdeck-db-sync--list-org-files :override
            #'my/cyberdeck-db-sync--list-org-files)

(defun my/cyberdeck-db-sync--scan-files-async (dirs callback)
  "List tracked files in DIRS (extensionless included), call CALLBACK."
  (let ((files (mapcan (lambda (d)
                         (my/cyberdeck-db-sync--list-org-files d))
                       dirs)))
    (run-at-time 0 nil callback files)))

(advice-add 'cyberdeck-db-sync--scan-files-async :override
            #'my/cyberdeck-db-sync--scan-files-async)
#+end_src

** Sync override: parse method
AIU Cyberdeck forces non-'.org' files (extensionless vault AIUs) through
`find-file', which trips over cyberdeck-aiu-proxies's read-only buffers.
Always use the configured method instead.
#+begin_src emacs-lisp
(defun my/cyberdeck-db--parse-file (path)
  "Parse PATH honoring `cyberdeck-db-parse-method'."
  (let* ((cyberdeck-db--active-parse-method
          cyberdeck-db-parse-method)
         (method cyberdeck-db-parse-method))
    (pcase method
      ('single-temp-buffer
       (cyberdeck-db--parse-with-temp-buffer path nil))

      ('temp-buffer
       (cyberdeck-db--parse-with-temp-buffer path t))

      (_
       (let ((buffer (find-file-noselect path)))
         (unwind-protect
             (with-current-buffer buffer
               (let* ((ast
                       (org-element-parse-buffer
                        (cyberdeck-db--effective-granularity)))
                      (attrs (file-attributes path))
                      (mtime
                       (float-time
                        (file-attribute-modification-time attrs)))
                      (size (file-attribute-size attrs))
                      (hash (secure-hash 'sha256 (current-buffer)))
                      (file-title
                       (cyberdeck-db--extract-file-title ast path)))
                 (make-cyberdeck-parse-ctx
                  :path path
                  :ast ast
                  :file-aiu
                  (cyberdeck-db--extract-file-aiu
                   ast path (current-buffer) file-title)
                  :heading-aius
                  (cyberdeck-db--extract-heading-aius
                   ast path (current-buffer) file-title)
                  :hash hash
                  :mtime mtime
                  :size size)))

           (when (buffer-live-p buffer)
             (kill-buffer buffer))))))))

(advice-add 'cyberdeck-db--parse-file :override
            #'my/cyberdeck-db--parse-file)
#+end_src

** Deferred database open
Ensure the database exists shortly after boot, but late enough that
the initial full-vault index never competes with startup. The first
connection parses the whole vault and can block for a while.
#+begin_src emacs-lisp
(with-eval-after-load 'cyberdeck
  (run-with-idle-timer
   15 nil
   (lambda ()
     (message "AIU Cyberdeck: opening database (may pause briefly)...")
      (condition-case err
          (progn
            (cyberdeck-db)
            (cyberdeck-db-autosync-mode +1)
            (message "AIU Cyberdeck: database ready (%s)"
                     (file-name-nondirectory
                      cyberdeck-db-location))
            (when (fboundp 'my/cyberdeck-emacs-mechanism-auto-run-once)
              (my/cyberdeck-emacs-mechanism-auto-run-once)))
        (error (lwarn 'cyberdeck :error
                      "database init failed: %s"
                      (error-message-string err)))))))
#+end_src


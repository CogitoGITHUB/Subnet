Plain-data bridge for AI agents: read the cyberdeck (query, node,
schema), write through the same primitives interactive use
(set-field, link), with a provenance sidecar on every agent write.
Catalog documents the surface.  An explicit endpoint opts the
session into connected AI features; without one a single boot
warning says so and the dormant features stay off.  Nothing here
runs at load except the one-shot boot check.

** Endpoint + status
#+begin_src emacs-lisp
(require 'cl-lib)
(require 'json)

(defcustom my/cyberdeck-agent-endpoint nil
  "Agent endpoint URL, or nil when no agent is connected.
Semantic similarity and AI proposals stay dormant without one."
  :type '(choice (const nil) string) :group 'cyberdeck)

(defun my/cyberdeck-agent-status ()
  "Report agent connection state."
  (interactive)
  (if my/cyberdeck-agent-endpoint
      (message "agent connected: %s" my/cyberdeck-agent-endpoint)
    (message "no agent connected: AI features dormant")))

(defvar my/cyberdeck-agent-warn-when-absent nil
  "Non-nil to warn at boot when no agent is connected. Off by
default: dormant is the normal state, no need to announce it.")

(defun my/cyberdeck-agent-boot-check ()
  "One-shot boot warning when no agent is connected (opt-in)."
  (when (and my/cyberdeck-agent-warn-when-absent
             (not noninteractive)
             (not my/cyberdeck-agent-endpoint))
    (display-warning 'cyberdeck
                     "No agent connected (my/cyberdeck-agent-endpoint is nil): semantic similarity and AI proposals are dormant."
                     :warning)))

(add-hook 'after-init-hook #'my/cyberdeck-agent-boot-check)
#+end_src

** Reads
#+begin_src emacs-lisp
(defun my/cyberdeck-api-query (&optional filter)
  "AIUs as plists, optionally filtered by FILTER plist (:tag T ...)."
  (let ((notes (ignore-errors (cyberdeck-db-query))))
    (if (null filter)
        notes
      (let ((tag (plist-get filter :tag)))
        (if tag
            (seq-filter (lambda (n)
                          (member tag (ignore-errors
                                       (cyberdeck-aiu-tags n))))
                        notes)
          notes)))))

(defun my/cyberdeck-api-aiu (id)
  "AIU plist for ID, or nil."
  (and (fboundp 'cyberdeck-db-get-by-id)
       (ignore-errors (cyberdeck-db-get-by-id id))))

(defun my/cyberdeck-api-schema (name)
  "Schema NAME as plist (:name :fields (:key...) :includes), or nil."
  (when (and (fboundp 'cyberdeck-aiu-context-get)
             (fboundp 'cyberdeck-aiu-context-effective-fields))
    (let ((s (cyberdeck-aiu-context-get name)))
      (when s
        (list :name name
              :fields (mapcar (lambda (f) (plist-get f :key))
                              (ignore-errors
                               (cyberdeck-aiu-context-effective-fields s)))
              :includes (and (fboundp 'cyberdeck-aiu-context-includes)
                             (cyberdeck-aiu-context-includes s)))))))

(defun my/cyberdeck-api-catalog ()
  "The API surface: ((KIND NAME PARAMS)...)."
  (list (list :read 'my/cyberdeck-api-query '(&optional filter))
        (list :read 'my/cyberdeck-api-aiu '(id))
        (list :read 'my/cyberdeck-api-schema '(name))
        (list :write 'my/cyberdeck-api-set-field '(id key value &optional agent))
        (list :write 'my/cyberdeck-api-link '(from-id to-id &optional type))))

(defun my/cyberdeck-api-json (object)
  "Encode OBJECT (plists/lists/strings) as JSON."
  (json-encode object))
#+end_src

** Writes with provenance
#+begin_src emacs-lisp
(defmacro my/cyberdeck-api--with-aiu (id &rest body)
  "Run BODY in the buffer at AIU ID's heading."
  (declare (indent 1) (debug t))
  `(let* ((me-aiu (my/cyberdeck-api-aiu ,id))
          (me-id (ignore-errors (cyberdeck-aiu-id me-aiu)))
          (me-marker (and me-id (ignore-errors (org-id-find me-id t)))))
     (unless (and me-marker (marker-buffer me-marker))
       (error "agent api: AIU %s not found" ,id))
     (with-current-buffer (marker-buffer me-marker)
       (save-excursion
         (goto-char me-marker)
         (org-back-to-heading t)
         ,@body))))

(defun my/cyberdeck-api-set-field (id key value &optional agent)
  "Set drawer KEY to VALUE on note ID.  AGENT plist (:model M) records
provenance in a :PROVENANCE_<KEY>: entry."
  (my/cyberdeck-api--with-aiu id
    (when (fboundp 'my/cyberdeck--drawer-put)
      (my/cyberdeck--drawer-put key value))
    (when agent
      (let ((model (or (plist-get agent :model) "agent"))
            (now (format-time-string "%Y-%m-%dT%H:%M:%S")))
        (when (fboundp 'my/cyberdeck--drawer-put)
          (my/cyberdeck--drawer-put
           (concat "PROVENANCE_" key)
           (format "%s|%s" model now)))))
    (save-buffer))
  value)

(defun my/cyberdeck-api-link (from-id to-id &optional type)
  "Record a link FROM-ID -> TO-ID (TYPE informational, default reference).
Appends an id: link line under the source heading."
  (ignore type)
  (let ((target (my/cyberdeck-api-aiu to-id)))
    (unless target (error "agent api: target %s not found" to-id))
    (my/cyberdeck-api--with-aiu from-id
      (goto-char (org-entry-end-position))
      (insert (format "\n%s\n"
                      (cyberdeck-utils-link-make-string target))))
    (save-buffer)
    t))
#+end_src

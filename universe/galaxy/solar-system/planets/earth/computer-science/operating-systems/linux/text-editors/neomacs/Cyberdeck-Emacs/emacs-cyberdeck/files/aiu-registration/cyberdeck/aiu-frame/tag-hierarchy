Multi-parent tag graph (`:extends`), kept SEPARATE from the AIU Subnet
single-parent topology by design: mm owns AIU placement, this owns
tag meaning.  Transitive queries (stream, search, manager) consult
this graph; nothing else changes.  Slash paths entered via inline
hashtags feed parents here.  Tag renames flow through the hook below
(which the manager calls).  Nothing here runs at load.

** Store
#+begin_src emacs-lisp
(require 'cl-lib)

(defvar my/cyberdeck-tag-extends-file
  (expand-file-name ".local/cache/aiu-frame-tag-extends.el" (expand-file-name "~"))
  "Persisted CHILD -> (PARENTS...) graph.")

(defvar my/cyberdeck-tag-extends (make-hash-table :test 'equal)
  "TAG string -> list of parent TAG strings (multi-parent allowed).")

(defun my/cyberdeck-tag-extends-load ()
  (clrhash my/cyberdeck-tag-extends)
  (condition-case nil
      (when (file-exists-p my/cyberdeck-tag-extends-file)
        (dolist (pair (car (read-from-string
                            (with-temp-buffer
                              (insert-file-contents my/cyberdeck-tag-extends-file)
                              (buffer-string)))))
          (puthash (car pair) (cdr pair) my/cyberdeck-tag-extends)))
    (error nil)))

(defun my/cyberdeck-tag-extends-save ()
  (condition-case nil
      (let ((tmp (concat my/cyberdeck-tag-extends-file ".tmp"))
            (pairs nil) (print-length nil) (print-level nil))
        (make-directory (file-name-directory my/cyberdeck-tag-extends-file) t)
        (maphash (lambda (k v) (push (cons k v) pairs)) my/cyberdeck-tag-extends)
        (with-temp-file tmp (prin1 pairs (current-buffer)))
        (rename-file tmp my/cyberdeck-tag-extends-file t))
    (error nil)))

(my/cyberdeck-tag-extends-load)

(defun my/cyberdeck-tag-add-parent (child parent)
  "Record PARENT as a parent of CHILD (multi-parent allowed)."
  (interactive
   (let ((all (mapcar #'car (my/cyberdeck-tags-census))))
     (list (completing-read "Child tag: " all)
           (completing-read "Parent tag: " all))))
  (puthash child (cl-adjoin parent (gethash child my/cyberdeck-tag-extends)
                            :test #'string=)
           my/cyberdeck-tag-extends)
  (my/cyberdeck-tag-extends-save))

(defun my/cyberdeck-tag-remove-parent (child parent)
  "Drop PARENT from CHILD's parents."
  (puthash child (delete parent (gethash child my/cyberdeck-tag-extends))
           my/cyberdeck-tag-extends)
  (my/cyberdeck-tag-extends-save))

(defun my/cyberdeck-tag-transitive (tag)
  "TAG plus all its descendants (children, recursively)."
  (let ((seen (list tag)) (queue (list tag)))
    (maphash (lambda (child parents)
               (when (member tag parents)
                 (unless (member child seen)
                   (push child seen) (push child queue))))
             my/cyberdeck-tag-extends)
    (let ((qs queue))
      (while qs
        (let ((cur (pop qs)))
          (maphash (lambda (child parents)
                     (when (and (member cur parents) (not (member child seen)))
                       (push child seen) (push child qs)))
                   my/cyberdeck-tag-extends))))
    seen))

(defvar my/cyberdeck-tag-renamed-functions nil
  "Hook run with (OLD NEW) after a tag rename; keeps extends in sync.")

(defun my/cyberdeck-tag-after-rename (old new)
  "Move OLD's extends entries (as child and as parent) to NEW.
Empty NEW means delete: entries are dropped, never re-added."
  (let ((as-child (gethash old my/cyberdeck-tag-extends)))
    (remhash old my/cyberdeck-tag-extends)
    (when (and as-child (not (string-empty-p new)))
      (puthash new (cl-union as-child (gethash new my/cyberdeck-tag-extends)
                             :test #'string=)
               my/cyberdeck-tag-extends)))
  (maphash (lambda (child parents)
             (if (string-empty-p new)
                 (puthash child (delete old parents)
                          my/cyberdeck-tag-extends)
               (when (member old parents)
                 (puthash child (cons new (delete old parents))
                          my/cyberdeck-tag-extends))))
           my/cyberdeck-tag-extends)
  (my/cyberdeck-tag-extends-save))

(add-hook 'my/cyberdeck-tag-renamed-functions #'my/cyberdeck-tag-after-rename)

(defun my/cyberdeck-tag-merge (from to)
  "Rewrite tag FROM to TO everywhere, then fold extends entries.
Uses the manager's preview machinery for the rewrite."
  (interactive
   (let ((all (mapcar #'car (my/cyberdeck-tags-census))))
     (list (completing-read "Merge from: " all)
           (completing-read "Merge into: " all))))
  (let ((occ (and (fboundp 'my/cyberdeck-tag-all-occurrences)
                  (my/cyberdeck-tag-all-occurrences from))))
    (if (null occ)
        (message "no occurrences of '%s'" from)
      (and (fboundp 'my/cyberdeck-tag-preview) (my/cyberdeck-tag-preview occ to
        (and (fboundp 'my/cyberdeck-tag-vocab-aius) (my/cyberdeck-tag-vocab-aius from))))
      (when (yes-or-no-p (format "Merge %d occurrence(s) of '%s' into '%s'? "
                                 (length occ) from to))
        (my/cyberdeck-tag-apply occ to)
        (run-hook-with-args 'my/cyberdeck-tag-renamed-functions from to)
        (message "merged '%s' into '%s'" from to)))))

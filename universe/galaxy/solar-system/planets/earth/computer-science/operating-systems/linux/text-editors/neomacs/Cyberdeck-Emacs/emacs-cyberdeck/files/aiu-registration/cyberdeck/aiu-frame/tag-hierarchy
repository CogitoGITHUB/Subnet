** Slash-path intake
#+begin_src emacs-lisp
(unless (boundp 'my/cyberdeck-hashtag-recorded-functions)
  (defvar my/cyberdeck-hashtag-recorded-functions nil
    "Hook run with (TAG PATH) after an inline tag is inserted."))

(defun my/cyberdeck-tag-record-path (_leaf path)
  "Consume a slash PATH typed as an inline tag into parent links."
  (when path
    (let ((parts (split-string path "/" t)))
      (cl-loop for (child parent) on (reverse parts) by #'cdr
               while parent
               do (puthash child
                           (cl-adjoin parent (gethash child my/cyberdeck-tag-extends)
                                      :test #'string=)
                           my/cyberdeck-tag-extends)))
    (my/cyberdeck-tag-extends-save)))

(add-hook 'my/cyberdeck-hashtag-recorded-functions #'my/cyberdeck-tag-record-path)
#+end_src

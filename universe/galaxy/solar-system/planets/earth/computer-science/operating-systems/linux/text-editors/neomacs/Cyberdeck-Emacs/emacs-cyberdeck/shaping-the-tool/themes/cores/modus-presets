;;;; Helper functions for theme setup

(defvar modus-themes--hex-regexp
  (concat
   "\\`#"
   "\\(?:[[:xdigit:]]\\{3\\}"
   "\\|"
   "[[:xdigit:]]\\{6\\}\\)"
   "\\'")
  "Regular expression to match a color in hexadecimal RGB notation.")

#+begin_src emacs-lisp :lexical t
(defun my/cyberdeck--refresh-property-aiu-proxy (property-type drawer-value aiu-context-id)
  "Replace UNFOLDING-TYPE's current entry IN PLACE -- at whatever
position it already occupies in the drawer, whether a plain value
line or a legacy wormhole -- instead of always appending at
the bottom of the drawer. Writes a `#+wormhole:' line so
`aiu-proxy-add-all' can render it live; re-picking also
clears legacy AIU Proxies of this type."
  (let (removed insert-marker)
    (save-excursion
      (org-back-to-heading t)
      (let* ((key (my/cyberdeck--property-key-from-type property-type))
             (r (my/cyberdeck--drawer-region)))
        (when r
          (goto-char (car r))
          (if (re-search-forward
               (format "^:%s:[[:blank:]]*\\(.*\\)$" (regexp-quote key))
               (cdr r) t)
              (progn
                (beginning-of-line)
                (setq insert-marker (copy-marker (point)))
                (delete-region (point) (1+ (line-end-position))))
            (goto-char (car r))
            (let (found)
              (while (and (not found)
                          (re-search-forward
                           "^#\\+AIU Proxy: \\[\\[id:\\([^]]+\\)\\]\\[\\([^]]*\\)\\]\\]"
                           (cdr r) t))
                (let ((label (match-string-no-properties 2)))
                  (when (string-equal key (my/cyberdeck--key-from-label label))
                    (setq found t)
                    (beginning-of-line)
                    (setq insert-marker (copy-marker (point)))
                    (delete-region (point) (1+ (line-end-position)))))))))
        (setq removed (my/cyberdeck--remove-other-type-aiu-proxies
                       property-type aiu-context-id))
        (goto-char (or (and insert-marker (marker-position insert-marker))
                       (my/cyberdeck--drawer-insert-point)
                       (point-max)))
        (beginning-of-line)
        (insert (format "#+wormhole: [[id:%s][%s: %s]] :property\n"
                        aiu-context-id
                        (string-replace "_" " " key)
                        drawer-value))
        (when insert-marker (set-marker insert-marker nil)))
      (save-buffer))
    removed))

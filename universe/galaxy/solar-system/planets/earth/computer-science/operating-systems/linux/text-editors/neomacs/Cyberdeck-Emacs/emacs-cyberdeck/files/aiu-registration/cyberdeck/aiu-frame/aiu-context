(defun my/cyberdeck--ensure-aiu-context-aiu (property-type value &optional note)
  "Create or reuse an unfolding note for UNFOLDING-TYPE=VALUE.
When a parent note can be determined (via _NOTE, session, or point),
creates a *scoped* unique file per parent (via `create-scoped-aiu`);
otherwise falls back to shared vocab file. This makes each unfolding
unique per parent so per-file AIUs don't leak."
  (when (and value (not (string-equal value "WARNING")))
    (let* ((parent-aiu (or note
                            (and (bound-and-true-p my/cyberdeck-org-prompt--session)
                                 (plist-get my/cyberdeck-org-prompt--session :note))
                            (ignore-errors (my/cyberdeck--aiu-at-point))
                            (ignore-errors
                              (when-let* ((m (and (boundp 'my/cyberdeck-links--deleted-id)
                                                 my/cyberdeck-links--deleted-id))
                                         (note (ignore-errors (cyberdeck-db-get-by-id m))))
                                note))))
           (parent-id (and parent-aiu (ignore-errors (cyberdeck-aiu-id parent-aiu)))))
      (if parent-id
          ;; Unique per parent — scoped file holds AIUs for *this* parent only
          (my/cyberdeck--create-scoped-aiu property-type value parent-id note)
        ;; Fallback shared (legacy / no parent context)
        (let* ((slug (my/cyberdeck--canonicalize value))
               (root (expand-file-name (format "admin/unfoldings/%s/" property-type) (my/cyberdeck-root-dir)))
               (path (expand-file-name slug root))
               (id (my/cyberdeck--aiu-id-by-path path))
               (key (my/cyberdeck--property-key-from-type property-type))
               (tag (replace-regexp-in-string "[^A-Za-z0-9_@]" "_" value))
               (title (format "%s >" key)))
          (if id
              (my/cyberdeck--make-id-link id value)
            (make-directory root t)
            (let ((cyberdeck-create-default-function (lambda (_) '())))
              (let ((note (cyberdeck-create title path
                           :tags (list tag) :unfoldings nil :body nil)))
                (when note
                  (my/cyberdeck--make-id-link (cyberdeck-aiu-id note) value))))))))))

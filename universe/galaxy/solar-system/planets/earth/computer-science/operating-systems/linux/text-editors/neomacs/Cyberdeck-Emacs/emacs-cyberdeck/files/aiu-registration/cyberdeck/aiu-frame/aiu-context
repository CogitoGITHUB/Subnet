(defun my/cyberdeck--strip-one-drawer ()
  "Strip AIU Proxy lines in the drawer at point; return restore cell."
  (let* ((pbeg (line-beginning-position 2))
         (pm (save-excursion
               (if (re-search-forward "^:END:[ \t]*$" nil t)
                   (copy-marker (line-beginning-position))
                 nil)))
         restore)
    (when pm
      (goto-char pbeg)
      (while (re-search-forward "^[^:].*$" pm t)
        (let* ((text (match-string 0))
               (m (when (string-match
                         "^#\\+AIU Proxy: \\[\\[id:\\([^]]+\\)\\]\\[\\([^]]*\\)\\]\\]"
                         text)
                    (let* ((label (match-string-no-properties 2 text))
                           (key (my/cyberdeck--key-from-label label)))
                      (when key
                        (list key
                              (match-string-no-properties 1 text)
                              label)))))
               (syn (when m
                      (format ":%s: [[id:%s][%s]]"
                              (nth 0 m) (nth 1 m) (nth 2 m)))))
          (push (cons (point-marker) (cons text syn)) restore)
          (delete-region (line-beginning-position)
                         (1+ (line-end-position)))
          (when syn
            (insert syn "\n"))))
      (goto-char pm)
      (set-marker pm nil))
    restore))

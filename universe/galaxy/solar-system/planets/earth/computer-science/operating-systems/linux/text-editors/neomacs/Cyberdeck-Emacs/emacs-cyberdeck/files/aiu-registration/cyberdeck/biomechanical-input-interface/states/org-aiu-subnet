** Entry and exit
Enter automatically with the map mode; leave explicitly. Neither
side depends on the other: every call is guarded, so the keyboard
works with the unit absent and the unit works with the keyboard
absent.
#+begin_src emacs-lisp
(defun my/org-aiu-subnet-quit-state ()
  "Leave the org-aiu-subnet state back to normal."
  (interactive)
  (when (fboundp 'biomechanical-input-interface-set-state)
    (biomechanical-input-interface-set-state "normal")))

(defun my/org-aiu-subnet--auto-enter ()
  "Enter the org-aiu-subnet state when the map mode turns on."
  (when (and (boundp 'org-aiu-subnet-mode) org-aiu-subnet-mode
             (fboundp 'biomechanical-input-interface-set-state))
    (biomechanical-input-interface-set-state "org-aiu-subnet")))

(add-hook 'org-aiu-subnet-mode-hook #'my/org-aiu-subnet--auto-enter)
#+end_src

(manifolding-modeline-define-segment modified
  (manifolding-modeline--with-source-buffer
    (cond (buffer-read-only
           (propertize "R" 'face 'manifolding-modeline-modified-face))
          ((buffer-modified-p)
           (propertize "M" 'face 'manifolding-modeline-modified-face))
          (t "-"))))

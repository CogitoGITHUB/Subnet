** Literate loader
Loads the package manager source from next to this file (extensionless
~cyberdeck~ preferred, ~cyberdeck-emacs~ backcompat, legacy ~.org~
fallbacks), tangles to ~.el~ in ~.config/emacs~, then loads it.
~lisp/~, ~straight/~ and all generated dirs stay under
~user-emacs-directory~ (~/.config/emacs) — only the literate sources
live in the vault.

#+begin_src emacs-lisp
(defvar my/emacs-root
  (file-name-directory
   (or (and (boundp 'manifold--foundation-org)
            manifold--foundation-org)
       (and (boundp 'cyberdeck--foundation-org)
            cyberdeck--foundation-org)
       load-file-name buffer-file-name))
  "Directory holding the AIU Frame org. Derived, never hardcoded.")

(defvar my/loader-modules
  '("core/vars" "core/errors" "core/parse"
    "discovery-index" "discovery-order"
    "staging-stages" "staging-skip" "discovery-units"
    "packages"
    "compiler-extract" "compiler-eval" "compiler-cache" "compiler-parts"
    "compiler-validate" "compiler-gates" "compiler-loop"
    "splash" "doctor" "entry")
  "Loader modules in tangle order.  Tangle order IS load order: the
concatenated artifact must read exactly as the old single file did.")

(defun my/loader-module-dir ()
  "Directory holding the loader modules."
  (expand-file-name "loader" my/emacs-root))

(defun my/note-slow (label secs)
  "Echo-area line when a single boot step runs more than 2 seconds.
Messages only: never throws, never changes control flow."
  (when (> (or secs 0) 2.0)
    (message "AIU Cyberdeck: %s took %.1fs…" label secs)
    (redisplay t)))

(defun my/tangle-loader-files (files target)
  "Tangle FILES (Org, in order) and write the concatenation to TARGET.
Each file tangles to its own temp file with an explicit target, so no
file-level tangle property can redirect a block elsewhere; the temps
are concatenated in order and TARGET is replaced by rename, never
partially written.  Readers never see a half artifact.  Returns the
total number of emacs-lisp blocks tangled."
  (require 'ob-tangle)
  (let ((total 0)
        (tmp-target (make-temp-file "cyberdeck-loader-")))
    (unwind-protect
        (let ((parts nil))
          (let ((n (length files)) (i 0))
            (dolist (f files)
              (setq i (1+ i))
              (message "AIU Cyberdeck: tangling loader %d/%d %s"
                       i n (file-name-nondirectory f))
              (redisplay t)
              (let ((tmp (make-temp-file "cyberdeck-module-"))
                    (t0 (float-time)))
                (unwind-protect
                    (progn
                      ;; Explicit target: this Org ignores dynamically bound
                      ;; default header args, so the target goes on the call.
                      (org-babel-tangle-file f tmp)
                      (my/note-slow (format "tangle %s" (file-name-nondirectory f))
                                    (- (float-time) t0))
                      (push (with-temp-buffer
                              (insert-file-contents tmp)
                              (buffer-string))
                            parts))
                  (ignore-errors (delete-file tmp))))))
          (setq parts (nreverse parts))
          ;; Join rule, matching org-babel-tangle exactly: blocks are
          ;; separated by one blank line, the file ends with one newline.
          (with-temp-file tmp-target
            (let ((first t))
              (dolist (p parts)
                (unless first
                  (insert "\n"))
                (setq first nil)
                (insert (replace-regexp-in-string "\n+\\'" "\n" p)))))
          (rename-file tmp-target target t)
          (dolist (f files)
            (with-temp-buffer
              (insert-file-contents f)
              (goto-char (point-min))
              (while (re-search-forward
                      "^#\\+begin_src[ \t]+emacs-lisp[ \t]*$"
                      nil t)
                (setq total (1+ total))))))
      (ignore-errors (delete-file tmp-target)))
    total))

(defun my/load-literate-loader (&optional file)
  "Tangle the loader org to ~/.config/emacs/cyberdeck-emacs.el, then load it."
  (or file (setq file
                 (let ((dir my/emacs-root))
                   (or (let ((f (expand-file-name "cyberdeck" dir)))
                         (when (file-exists-p f) f))
                       (let ((f (expand-file-name "cyberdeck-emacs" dir)))
                         (when (file-exists-p f) f))
                       (let ((f (expand-file-name "cyberdeck.org" dir)))
                         (when (file-exists-p f) f))
                       (expand-file-name "cyberdeck-emacs.org" dir)))))
  (unless (file-exists-p file)
    (error "[init] literate loader missing: %s" file))
  (let ((el (locate-user-emacs-file "cyberdeck-emacs.el"))
        (mods (mapcar (lambda (m)
                        (expand-file-name (concat m ".org")
                                          (my/loader-module-dir)))
                      my/loader-modules)))
    ;; (my/init-aiu "[init] tangling loader…")
    ;; Guarded like the AIU Frame tangle: with explicit sync allowed,
    ;; re-tangling an up-to-date loader every boot is pure waste.
    ;; Freshness compares the NEWEST module against the artifact.
    (when (or (not (file-exists-p el))
              (cl-some (lambda (m) (file-newer-than-file-p m el)) mods))
      (with-demoted-errors "[init] tangle failed: %s"
        (let ((tangled (my/tangle-loader-files mods el))
              (source  (let ((n 0))
                         (dolist (m mods)
                           (with-temp-buffer
                             (insert-file-contents m)
                             (goto-char (point-min))
                             (while (re-search-forward
                                     "^#\\+begin_src[ \t]+emacs-lisp[ \t]*$"
                                     nil t)
                               (setq n (1+ n)))))
                         n)))
          (when (and tangled (= source 0))
            (lwarn 'foundation :warning
                   "loader tangle produced nothing from %s" file))
          (when (< source (or tangled 0))
            (lwarn 'foundation :warning
                   "loader tangle dropped blocks: %d of %d emacs-lisp src blocks from %s"
                   (or tangled 0) source (file-name-nondirectory file))))))
    ;; (my/init-aiu "[init] loading literate loader…")
    (message "AIU Cyberdeck: loading cyberdeck-emacs.el…")
    (redisplay t)
    (load el nil t)))

(add-to-list 'load-path (expand-file-name "lisp/" user-emacs-directory))
(my/load-literate-loader)
(my/boot-mark "loader-loaded")

;; (my/init-aiu "[init] loader ready — booting modules…")

(setq cyberdeck-emacs--boot-warnings '())
(advice-add 'cyberdeck-emacs-boot :before

(defun my/chord-define (keymap keys command)
  "Define in KEYMAP a chord of the two keys in KEYS calling COMMAND.
KEYS is a string/vector of two byte characters (codes < 256). If COMMAND is nil
the chord is removed. A pair is bound in both orders (K1K2 and K2K1); a same-key
double-tap chord is defined once."
  (when (/= 2 (length keys))
    (error "Chord keys must have two elements"))
  (let ((key1 (aref keys 0))
        (key2 (aref keys 1)))
    (unless (and (integerp key1) (< key1 256)
                 (integerp key2) (< key2 256))
      (error "Chord keys must both be bytes (characters with codes < 256)"))
    (if (eq key1 key2)
        (define-key keymap (vector 'my/chord key1 key2) command)
      (define-key keymap (vector 'my/chord key1 key2) command)
      (define-key keymap (vector 'my/chord key2 key1) command))))


(defun my/chord-define-local (keys command)
  "Locally define a chord of the two keys in KEYS calling COMMAND."
  (interactive "sSet key chord locally (2 keys): \nCSet chord \"%s\" to command: ")
  (my/chord-define (current-local-map) keys command))

(defun my/chord-unset-global (keys)
  "Remove the global chord of the two keys in KEYS."
  (interactive "sUnset key chord globally (2 keys): ")
  (my/chord-define (current-global-map) keys nil))

(defun my/chord-unset-local (keys)
  "Remove the local chord of the two keys in KEYS."
  (interactive "sUnset key chord locally (2 keys): ")
  (my/chord-define (current-local-map) keys nil))

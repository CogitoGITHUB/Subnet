(defvar my/chord-last-unmatched nil)
(defvar my/chord-in-typing-flow nil)
(defvar my/chord-last-key-time nil)
(defvar my/chord-typing-reset-time nil)
(defvar my/chord-two-keys-delay 0.1)
(defvar my/chord-one-key-delay 0.2)
(defvar my/chord-one-key-min-delay 0.0)
(defvar my/chord-typing-speed-threshold 0.1)
(defvar my/chord-typing-reset-delay 0.5)
(defvar my/chord-typing-detection t)

(defun my/chord-in-read-char-context-p ()
  "Non-nil in a read-char/read-key context (input should bypass chords)."
  (and overriding-local-map
       (memq overriding-local-map (list read-key-empty-map read-key-full-map))))

(defun my/chord-valid-chord-char-p (char)
  "Non-nil if CHAR (<= 255) can participate in a chord."
  (and (integerp char) (< char 255)))

(defun my/chord-lookup-key1 (keymap key)
  "Like `lookup-key' but returns nil when the result is a number."
  (let ((res (lookup-key keymap key)))
    (and (not (numberp res)) res)))

(defun my/chord-lookup-key (key)
  "Look up KEY in all current minor, local and global maps."
  (let ((maps (current-minor-mode-maps)) res)
    (while (and maps (not res))
      (setq res (my/chord-lookup-key1 (car maps) key))
      (setq maps (cdr maps)))
    (or res
        (and (current-local-map)
             (my/chord-lookup-key1 (current-local-map) key))
        (my/chord-lookup-key1 (current-global-map) key))))

(defun my/chord-execute-chord (first-char next-char)
  "Return the `(my/chord FIRST NEXT)' event for a matched chord."
  (setq my/chord-last-unmatched nil)
  (list 'my/chord first-char next-char))

(defun my/chord-no-chord (first-char &optional next-char)
  "Return FIRST-CHAR alone, pushing NEXT-CHAR back for later processing."
  (when next-char
    (setq unread-command-events (cons next-char unread-command-events)))
  (setq my/chord-last-unmatched first-char)
  (list first-char))

(defun my/chord-pause-typing-flow ()
  "Temporarily pause typing flow to allow chord detection."
  (when my/chord-typing-detection
    (setq my/chord-in-typing-flow nil)))

(defun my/chord-check-typing-flow (current-time)
  "Toggle typing-flow state from the spacing between keystrokes."
  (when my/chord-typing-detection
    (when (and my/chord-typing-reset-time
               (> (float-time current-time) my/chord-typing-reset-time))
      (setq my/chord-in-typing-flow nil)
      (setq my/chord-last-unmatched nil))
    (setq my/chord-typing-reset-time
          (+ (float-time current-time) my/chord-typing-reset-delay))
    (unless my/chord-in-typing-flow
      (when my/chord-last-key-time
        (let ((elapsed (float-time
                        (time-subtract current-time my/chord-last-key-time))))
          (when (< elapsed my/chord-typing-speed-threshold)
            (setq my/chord-in-typing-flow t)))))
    (setq my/chord-last-key-time current-time)))

(defun my/chord-input-method (first-char)
  "Input-method hook dispatching `(my/chord K1 K2)' chords.
FIRST-CHAR is the first key input. Bypassed in read-char contexts and during
keyboard macros; otherwise reads a second key within the chord delay and emits
a chord event when one matches, else replays FIRST-CHAR."
  (if (my/chord-in-read-char-context-p)
      (progn (setq my/chord-last-unmatched nil) (list first-char))
    (unless executing-kbd-macro
      (my/chord-check-typing-flow (current-time)))
    (cond
     ((not (my/chord-valid-chord-char-p first-char))
      (setq my/chord-last-unmatched nil)
      (list first-char))
     ((and my/chord-typing-detection my/chord-in-typing-flow
           (not executing-kbd-macro))
      (list first-char))
     (executing-kbd-macro
      (my/chord-no-chord first-char))
     ((not (eq first-char my/chord-last-unmatched))
      (my/chord-pause-typing-flow)
      (let ((res (my/chord-lookup-key (vector 'my/chord first-char))))
        (if (not res)
            (my/chord-no-chord first-char)
          (let ((start-time (current-time))
                (delay (if (my/chord-lookup-key
                            (vector 'my/chord first-char first-char))
                           my/chord-one-key-delay
                         my/chord-two-keys-delay)))
            (let ((next-char (read-event nil nil delay)))
              (cond
               ((null next-char) (my/chord-no-chord first-char))
               ((not (my/chord-valid-chord-char-p next-char))
                (my/chord-no-chord first-char next-char))
               ((eq first-char next-char)
                (let ((elapsed (float-time
                                (time-subtract (current-time) start-time))))
                  (if (< elapsed my/chord-one-key-min-delay)
                      (my/chord-no-chord first-char next-char)
                    (if (my/chord-lookup-key
                         (vector 'my/chord first-char next-char))
                        (my/chord-execute-chord first-char next-char)
                      (my/chord-no-chord first-char next-char)))))
               (t
                (if (my/chord-lookup-key
                     (vector 'my/chord first-char next-char))
                    (my/chord-execute-chord first-char next-char)
                  (my/chord-no-chord first-char next-char)))))))))
     (t (my/chord-no-chord first-char)))))

(setq-default input-method-function #'my/chord-input-method)
(define-key (current-global-map) (vector 'my/chord ?j ?j) 'my/repeat-last)

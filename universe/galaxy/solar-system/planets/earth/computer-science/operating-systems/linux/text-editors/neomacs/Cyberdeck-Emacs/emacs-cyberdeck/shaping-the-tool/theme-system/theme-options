(require 'color)
(eval-when-compile
  (require 'subr-x)
  (require 'cl-lib))

(defgroup theme ()
  "User options for the themes.
The themes conform with the WCAG AAA standard for color
contrast between background and foreground combinations (a
minimum contrast of 7:1---the highest standard of its kind).

The theme collection includes themes that are optimized
for people with red-green or blue-yellow color
deficiency (deuteranopia or tritanopia, respectively)."
  :group 'faces
  :prefix "theme-"
  :tag "Theme")

(defgroup theme-faces ()
  "Faces defined by the themes."
  :group 'theme
  :prefix "theme-"
  :tag "Theme Faces")



;;;; Custom faces

;; TODO 2026-07-14: Review which other theme faces can be
;; introduced. I am only interested in the semantic ones, not those
;; with named colours.

;; NOTE 2025-10-25: I could not find the `make-obsolete' equivalent for faces.

;; These faces are used internally to ensure consistency between various
;; groups and to streamline the evaluation of relevant customization
;; options.

(dotimes (n 9)
  (custom-declare-face
   (intern (format "theme-heading-%d" n))
   nil (format "Level %d heading." n)
   :version "30.1"
   :group 'theme-faces))

(defface theme-bold nil
  "Generic face for applying a conditional bold weight.
This behaves in accordance with `theme-bold-constructs'."
  :version "30.1"
  :group 'theme-faces)

(defface theme-slant nil
  "Generic face for applying a conditional slant (italics).
This behaves in accordance with `theme-italic-constructs'."
  :version "30.1"
  :group 'theme-faces)

(defface theme-fixed-pitch nil
  "Face for `fixed-pitch' if `theme-mixed-fonts' is non-nil."
  :version "30.1"
  :group 'theme-faces)

(defface theme-ui-variable-pitch nil
  "Face for `variable-pitch' if `theme-variable-pitch-ui' is non-nil."
  :version "30.1"
  :group 'theme-faces)

(defface theme-reset-soft nil
  "Generic face to set most face properties to nil.

This is intended to be inherited by faces that should not retain
properties from their context (e.g. an overlay over an underlined
text should not be underlined as well) yet still blend in."
  :group 'theme-faces)

(defface theme-button nil
  "Face for graphical buttons."
  :group 'theme-faces)

(defface theme-prompt nil
  "Prompts like in the minibuffer and the shell."
  :group 'theme-faces)

(defface theme-completion-selected nil
  "Face for completion selected candidate."
  :group 'theme-faces)

(dotimes (n 4)
  (custom-declare-face
   (intern (format "theme-completion-match-%d" n))
   nil (format "Face for completion matches %d." n)
   :group 'theme-faces))

(dolist (suffix '(current lazy replace static))
  (custom-declare-face
   (intern (format "theme-search-%s" suffix))
   nil (format "Face for %s search matches." suffix)
   :group 'theme-faces))

(dotimes (n 4)
  (custom-declare-face
   (intern (format "theme-search-rx-group-%d" n))
   nil (format "Face for regexp group %d." n)
   :group 'theme-faces))

(dolist (suffix '(other delete select))
  (custom-declare-face
   (intern (format "theme-mark-%s" suffix))
   nil (format "Face for %s marks." suffix)
   :group 'theme-faces))



;;;; Customization variables

(make-obsolete-variable
 'theme-custom-auto-reload
 "reload the theme manually for changes to take effect"
 "5.0.0")

(defcustom theme-disable-other-themes t
  "Disable all other themes when loading one of these themes.

When the value is non-nil, the commands `theme-toggle' and
`theme-select', as well as the `theme-load-theme'
function, will disable all other themes while loading the
specified theme.  This is done to ensure that Emacs does
not blend two or more themes: such blends lead to awkward results
that undermine the work of the designer.

When the value is nil, the aforementioned commands and function
will only disable other themes within this collection.

This option is provided because Emacs themes are not necessarily
limited to colors/faces: they can consist of an arbitrary set of
customizations.  Users who use such customization bundles must
set this variable to a nil value."
  :group 'theme
  :version "30.1"
  :type 'boolean
  )

(defconst theme-items
  '( light
     light-tinted
     light-deuteranopia
     light-tritanopia
     dark
     dark-tinted
     dark-deuteranopia
     dark-tritanopia)
  "Symbols of the themes.")

(defcustom theme-to-toggle '(light dark)
  "Specify two themes for `theme-toggle' command.
The variable `theme-items' contains the symbols of all
official themes that form part of this collection.

The default value of this user option includes the original
themes: `light' (light) and `dark' (dark).

If the value is nil or otherwise does not specify two valid
themes, the command `theme-toggle' reverts to selecting a
theme from the list of available themes.  In effect, it is
the same as using the command `theme-select'."
  :type (let ((themes (mapcar (lambda (theme) (list 'const theme)) theme-items)))
          `(choice
            (const :tag "No toggle" nil)
            (list :tag "Pick two themes to toggle between"
                  (choice :tag "Theme one of two" ,@themes)
                  (choice :tag "Theme two of two" ,@themes))))
  :version "30.1"
  :group 'theme)

(defcustom theme-to-rotate nil
  "List of themes to rotate, per `theme-rotate'.
If the value is nil, then rotation applies to all themes returned by
`theme-get-themes'."
  :type `(repeat
          (choice :tag "A theme among the `theme-items'"
                  ,@(mapcar
                     (lambda (theme)
                       (list 'const theme))
                     (if (fboundp 'theme-get-themes)
                         (theme-get-themes)
                       theme-items))))
  :version "31.1"
  :group 'theme)

(defcustom cyberdeck-after-load-theme-hook nil
  "Hook that runs after loading one of these themes.
This is used by the commands `theme-toggle',
`theme-rotate', `theme-select', as well as the function
`theme-load-theme'."
  :type 'hook
  :version "30.1"
  :group 'theme)


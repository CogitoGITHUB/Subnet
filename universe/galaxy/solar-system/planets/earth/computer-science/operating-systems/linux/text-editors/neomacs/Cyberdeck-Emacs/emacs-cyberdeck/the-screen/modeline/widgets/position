#+begin_src emacs-lisp
(manifolding-modeline-define-segment position
  (manifolding-modeline--with-source-buffer
    (let ((size (max 1 (- (point-max) (point-min)))))
      (format "L%d C%d %d"
              (line-number-at-pos) (current-column)
              (/ (* 100 (1- (point))) size)))))

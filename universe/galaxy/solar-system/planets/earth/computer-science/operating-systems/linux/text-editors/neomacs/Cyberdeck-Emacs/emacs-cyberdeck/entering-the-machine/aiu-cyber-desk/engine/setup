* AIU Cyber Desk Setup :EMACS_MECHANISM:S0:
:PROPERTIES:
:ID:       797e199d-e94f-4e23-b316-d07a0694270f
:MM_PARENT: none
:MM_ORDER:  78.9
:CATEGORY: ui
:END:

Wires last: composes the section order from the widget registry,
then hooks, keys, recentf, startup. Loads after every widgets/ file
so the registry is full.

** Section order
Mirrors the aiu-context drawer-order mechanism: the `order' file holds
`** key' headings top to bottom; setup composes `dashboard-items'
from it, reconciles it on boot (append new, prune dead cyberdeck-*),
and re-applies on manual save. The banner is structural and always
renders first — it never belongs here.
#+begin_src emacs-lisp
(defvar aiu-cyber-desk--default-items
  '((recents . 10) (bookmarks . 10) (registers . 10) (projects . 10)
    (cyberdeck-status . 1) (cyberdeck-todos . 1) (cyberdeck-sartre . 1))
  "Seed and empty-file fallback for the section order. Mirrors the
aiu-context default key list.")

(defvar aiu-cyber-desk--stock-items
  '((recents . 10) (bookmarks . 10) (registers . 10) (projects . 10)
    (agenda . 5))
  "Upstream sections and their lengths. Never pruned from the order file.")

(defun aiu-cyber-desk--order-file ()
  "Absolute path of the section order file.
Lives in admin/order/, beside the modeline's, so both bars' layouts are
in one place. Anchored on the vault root rather than the module
directory: this file is read and written at runtime (see
`aiu-cyber-desk--reconcile-order-file' and the widget
scaffolder), and admin/ is excluded from unit discovery, so the loader
will never compile it — which is what a data file wants."
  (expand-file-name "admin/order/dashboard widgets"
                   cyberdeck-emacs-vault-root))

(defun aiu-cyber-desk--order-file-keys ()
  "Item keys top-down from the order file (symbols), or nil when the
file is missing or holds no headings."
  (let ((f (aiu-cyber-desk--order-file)))
    (when (file-exists-p f)
      (with-temp-buffer
        (insert-file-contents f)
        (let (keys)
          (goto-char (point-min))
          (while (re-search-forward "^\\*\\* \\(.*\\)$" nil t)
            (let ((k (intern (string-trim (match-string 1)))))
              (unless (or (memq k keys))
                (push k keys))))
          (nreverse keys))))))

(defun aiu-cyber-desk--entry-length (name)
  "Length for item NAME: the widget registry first, then stock, else 1.
The registry is authoritative, and it is the widget's own
`aiu-cyber-desk-define-widget' :length — declared in the file that
renders the section, next to the code that decides how tall it is.

There was an aiu-context-file step ahead of this, and it was worse than
redundant: every widget aiu-context declared `:LENGTH: 1` while the
sections they claimed to measure rendered 2 to 6 lines, and one of them
(`todos') has no fixed height at all. So the step was both wrong and
unread, and removing it changed no rendering at all."
  (or (cdr (assq name aiu-cyber-desk--widget-registry))
      (cdr (assq name aiu-cyber-desk--stock-items))
      1))

(defun aiu-cyber-desk--apply-order ()
  "Compose `dashboard-items' from the order file: file order first,
then any present-but-unlisted items in current order. Unknown file
keys are skipped (audit warns). Returns the items."
  (let* ((file-keys (aiu-cyber-desk--order-file-keys))
         (names (or file-keys (mapcar #'car aiu-cyber-desk--default-items)))
         (have (mapcar #'car dashboard-item-generators))
         (out nil))
    (dolist (name names)
      (when (memq name have)
        (push (cons name (aiu-cyber-desk--entry-length name)) out)))
    ;; Unlisted cyberdeck widgets append (registry-driven, never stock:
    ;; stock sections appear only when the order file lists them).
    (setq out (nreverse out))
    (let (extra)
      (dolist (pair (reverse aiu-cyber-desk--widget-registry))
        (unless (assq (car pair) out)
          (push pair extra)))
      (setq dashboard-items (nconc out (nreverse extra))))
    dashboard-items))

(defun aiu-cyber-desk--reconcile-order-file ()
  "Append registry widgets missing from the order file at EOF; prune
`cyberdeck-*' headings with no registered widget and no generator;
seed the file when missing. Never reorders, never touches stock.
Mirrors the aiu-context boot reconcile. Returns t when the file changed."
  (let* ((f (aiu-cyber-desk--order-file))
         (changed nil))
    (if (not (file-exists-p f))
        (progn
          (with-temp-file f
            (insert '"* AIU Cyber Desk Section Order\n\n")
            (dolist (pair aiu-cyber-desk--default-items)
              (insert (format "** %s\n" (car pair)))))
          t)
      (let ((have (mapcar #'car dashboard-item-generators))
            (keys (aiu-cyber-desk--order-file-keys)))
        ;; Append new registry widgets in load order.
        (dolist (pair (reverse aiu-cyber-desk--widget-registry))
          (let ((name (car pair)))
            (unless (memq name keys)
              (setq keys (nconc keys (list name)))
              (setq changed t))))
        ;; Prune dead cyberdeck-* headings.
        (let ((before (length keys))
              (kept nil))
          (dolist (k keys)
            (unless (and (string-prefix-p "cyberdeck-" (format "%s" k))
                         (not (assq k aiu-cyber-desk--widget-registry))
                         (not (memq k have)))
              (push k kept)))
          (setq keys (nreverse kept))
          (when (/= (length keys) before)
            (setq changed t)))
        (when changed
          (with-temp-file f
            (insert '"* AIU Cyber Desk Section Order\n\n")
            (dolist (k keys)
              (insert (format "** %s\n" k)))))
        changed))))

(defun aiu-cyber-desk--audit-order-file ()
  "Warn about order-file keys matching neither registry nor stock
generators. Passive audit, never modifies — mirrors the aiu-context
reinforce audit."
  (let ((have (mapcar #'car dashboard-item-generators)))
    (dolist (name (aiu-cyber-desk--order-file-keys))
      (unless (or (memq name have)
                  (assq name aiu-cyber-desk--stock-items))
        (message "aiu-cyber-desk: order file %s matches no widget" name)))))

(defun aiu-cyber-desk--order-after-save ()
  "Re-apply the order file when the user saves it; refresh the live
dashboard. Mirrors the aiu-context drawer-order save hook."
  (when (and buffer-file-name
             (equal (expand-file-name buffer-file-name)
                    (aiu-cyber-desk--order-file)))
    (aiu-cyber-desk--apply-order)
    (when (and (get-buffer "*dashboard*")
               (fboundp 'dashboard-refresh-buffer))
      (with-current-buffer "*dashboard*"
        (dashboard-refresh-buffer)))))

(defun aiu-cyber-desk--order-find-file-hook ()
  "Install the order save hook buffer-locally. Mirrors the aiu-context
find-file installer."
  (when (and buffer-file-name
             (equal (expand-file-name buffer-file-name)
                    (aiu-cyber-desk--order-file)))
    (add-hook 'after-save-hook
              #'aiu-cyber-desk--order-after-save nil t)))

(add-hook 'find-file-hook #'aiu-cyber-desk--order-find-file-hook)

;; Registry is full (setup loads last): reconcile, compose, audit.
(aiu-cyber-desk--reconcile-order-file)
(aiu-cyber-desk--apply-order)
(aiu-cyber-desk--audit-order-file)
#+end_src

** Mode hook & keys

#+begin_src emacs-lisp
(add-hook 'dashboard-mode-hook
          (lambda ()
            (setq-local mode-line-format nil)
            ;; Let Olivetti handle centering — wide enough to not mangle the ASCII banner
            (when (fboundp 'olivetti-mode)
              (setq-local olivetti-body-width 120)
              (olivetti-mode 1))
            (local-set-key (kbd "r") #'dashboard-jump-to-recents)
            (local-set-key (kbd "m") #'dashboard-jump-to-bookmarks)
            (local-set-key (kbd "e") #'dashboard-jump-to-registers)
            (local-set-key (kbd "p") #'dashboard-jump-to-projects)
            (local-set-key (kbd "a") #'org-agenda)
            (local-set-key (kbd "g") #'consult-register)
            (local-set-key (kbd "q") (lambda () (interactive) (save-buffers-kill-terminal)))
            (local-set-key (kbd "d") (lambda () (interactive) (dired "~")))))
#+end_src

** Recentf wiring
#+begin_src emacs-lisp
;; Ensure recentf is active so dashboard recents are always fresh
(recentf-mode +1)
(setq recentf-max-saved-items 100)
;; Save recentf list every 5 minutes in case of crash
(run-at-time nil (* 5 60) 'recentf-save-list)

;; Refresh dashboard recents after super-save, at most once per
;; two minutes: every save re-rendering the whole dashboard kept the
;; editor busy indefinitely.
(defvar aiu-cyber-desk--last-save-refresh 0
  "Last time an after-save dashboard refresh ran, as float-time.")
(add-hook 'after-save-hook
          (lambda ()
            (when (and (fboundp 'recentf-add-file)
                       buffer-file-name)
              (recentf-add-file buffer-file-name))
            (when (and (get-buffer-window "*dashboard*")
                       (not (active-minibuffer-window))
                       (not (cl-some (lambda (b) (buffer-local-value 'org-capture-mode b))
                                     (buffer-list)))
                       (> (- (float-time) aiu-cyber-desk--last-save-refresh) 120))
              (setq aiu-cyber-desk--last-save-refresh (float-time))
              (with-current-buffer "*dashboard*"
                (dashboard-refresh-buffer)))))
#+end_src

** Bounded agenda (boot must not walk the vault)
The stock agenda widget calls `org-agenda-prepare-buffers', which
opens EVERY .org file in the vault with polymode + org-mode and
reads each file's persisted element cache. On phone storage that is
minutes of synchronous I/O right after boot, which read as a frozen
editor. Bound it: nil agenda-files means the section renders "No
items" instantly and costs nothing. The real agenda is one SPC away
(`org-agenda' stays bound; it reads `org-agenda-files' directly).
Loads here because this is the last dashboard unit, so it wins.
#+begin_src emacs-lisp
(setq dashboard-agenda-files nil)
#+end_src

** Startup
#+begin_src emacs-lisp
;; Only show dashboard on startup when no files were passed as arguments
(when (and (not (daemonp))
           (= 0 (length command-line-args-left)))
  (dashboard-setup-startup-hook))
#+end_src

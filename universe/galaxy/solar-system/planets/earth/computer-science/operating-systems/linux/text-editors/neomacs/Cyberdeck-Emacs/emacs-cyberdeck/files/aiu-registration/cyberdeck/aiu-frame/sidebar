** Buffer outline
Native clickable heading tree of the followed buffer: indent,
jump buttons, current-heading mark, depth cycling.  Built on
plain regex (imenu/org-element need no display), capped for
huge buffers.  Nothing here runs at load.
#+begin_src emacs-lisp
(defvar my/cyberdeck-sidebar-outline-limit 500
  "Max headings rendered in the outline section.")

(defvar my/cyberdeck-sidebar-outline-depth nil
  "Max level shown; nil shows all.  Cycled by command.")

(defun my/cyberdeck-sidebar-outline-entries ()
  "List of (LEVEL TITLE POS) for the followed buffer, capped."
  (let (out (n 0))
    (when (buffer-live-p my/cyberdeck-sidebar-source-buffer)
      (with-current-buffer my/cyberdeck-sidebar-source-buffer
        (when (derived-mode-p 'org-mode)
          (save-excursion
            (goto-char (point-min))
            (while (and (< n my/cyberdeck-sidebar-outline-limit)
                        (re-search-forward "^\\(\\*+\\) \\(.*\\)$" nil t))
              (push (list (length (match-string-no-properties 1))
                          (match-string-no-properties 2)
                          (match-beginning 0))
                    out)
              (setq n (1+ n)))))))
    (nreverse out)))

(defun my/cyberdeck-sidebar-outline-current (entries)
  "Buffer position of the entry at or before point, or nil."
  (let ((pt (when (buffer-live-p my/cyberdeck-sidebar-source-buffer)
              (with-current-buffer my/cyberdeck-sidebar-source-buffer
                (point))))
        (best nil))
    (dolist (e entries)
      (when (and pt (>= pt (nth 2 e)))
        (setq best (nth 2 e))))
    best))

(defun my/cyberdeck-sidebar-goto-entry (entry)
  "Jump to outline ENTRY in the followed buffer."
  (let ((buf my/cyberdeck-sidebar-source-buffer))
    (when (buffer-live-p buf)
      (pop-to-buffer buf)
      (goto-char (nth 2 entry)))))

(defun my/cyberdeck-sidebar-cycle-depth ()
  "Cycle outline depth 1-2-3-all."
  (interactive)
  (setq my/cyberdeck-sidebar-outline-depth
        (pcase my/cyberdeck-sidebar-outline-depth
          ('nil 1) (1 2) (2 3) (_ nil)))
  (my/cyberdeck-sidebar-refresh))

(defun my/cyberdeck-sidebar-insert-outline (_note)
  "Render the outline section for the followed buffer, if any."
  (let ((entries (my/cyberdeck-sidebar-outline-entries)))
    (when entries
      (insert "-- Outline --\n")
      (let ((cur (my/cyberdeck-sidebar-outline-current entries)))
        (dolist (e entries)
          (let ((entry e))
            (when (or (null my/cyberdeck-sidebar-outline-depth)
                      (<= (nth 0 entry) my/cyberdeck-sidebar-outline-depth))
              (insert (if (equal (nth 2 entry) cur) ">> " "   "))
              (insert-text-button
               (format "%s%s" (make-string (* 2 (1- (nth 0 entry))) ?\s)
                       (nth 1 entry))
               'action (lambda (_) (my/cyberdeck-sidebar-goto-entry entry)))
              (insert "\n"))))))))
#+end_src

** Due digest
Condensed rollup calling the agenda-day machinery (never duplicated):
counts plus the next few items.  Full detail lives in `agenda-day`.
#+begin_src emacs-lisp
(defun my/cyberdeck-sidebar-insert-digest (_note)
  "Render the due digest section, when agenda-day is loaded."
  (when (and (fboundp 'my/cyberdeck-agenda--due-entries)
             (fboundp 'my/cyberdeck-agenda--due-protocols))
    (let ((entries (ignore-errors (my/cyberdeck-agenda--due-entries)))
          (protos (ignore-errors (my/cyberdeck-agenda--due-protocols))))
      (insert "-- Due --\n")
      (insert (format "AIU Runs due: %d \u00b7 protocols due: %d\n"
                      (length entries) (length protos)))
      (dolist (e (seq-take entries 3))
        (insert (format "  - %s\n" (nth 1 e))))
      (dolist (x (seq-take protos 3))
        (insert (format "  - %s\n" (nth 1 x)))))))
#+end_src

** Follow, tree, keys
Auto-follow (single 2s idle timer, skips non-file/non-org/WIP),
vault file tree (treemacs when installed, dired side window
otherwise), and sidebar-local keys.  Nothing here runs at load
except nothing at all: timer starts on toggle.
#+begin_src emacs-lisp
(defvar my/cyberdeck-sidebar-follow-timer nil
  "Single idle timer refreshing the sidebar.")

(defun my/cyberdeck-sidebar-follow-tick ()
  "Refresh sidebar for the current buffer when followable."
  (let ((sb (get-buffer "*Cyberdeck Sidebar*")))
    (when (buffer-live-p sb)
      (let ((cur (current-buffer)))
        (when (and (not (eq cur sb))
                   (buffer-file-name cur)
                   (with-current-buffer cur (derived-mode-p 'org-mode))
                   (let ((root (ignore-errors (my/cyberdeck-root-dir)))
                         (bfn (buffer-file-name cur)))
                     (and root bfn
                          (file-in-directory-p bfn root)
                          (not (string-match-p "/WIP/" bfn)))))
          (unless (eq cur my/cyberdeck-sidebar-source-buffer)
            (setq my/cyberdeck-sidebar-source-buffer cur)
            (my/cyberdeck-sidebar-refresh)))))))

(defun my/cyberdeck-sidebar-follow-start ()
  "Start the follow timer once."
  (unless (timerp my/cyberdeck-sidebar-follow-timer)
    (setq my/cyberdeck-sidebar-follow-timer
          (run-with-idle-timer 2 t #'my/cyberdeck-sidebar-follow-tick))))

(defun my/cyberdeck-file-tree-toggle ()
  "Vault file tree: treemacs when installed, dired side window otherwise."
  (interactive)
  (if (or (featurep 'treemacs) (locate-library "treemacs"))
      (call-interactively #'treemacs)
    (let ((root (ignore-errors (my/cyberdeck-root-dir))))
      (if (null root)
          (message "vault root unknown")
        (display-buffer-in-side-window
         (dired-noselect root) '((side . left) (window-width . 30)))))))

(defvar my/cyberdeck-sidebar-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "q") #'quit-window)
    (define-key map (kbd "g") #'my/cyberdeck-sidebar-refresh)
    (define-key map (kbd "TAB") #'my/cyberdeck-sidebar-cycle-depth)
    (define-key map (kbd "1") (lambda () (interactive)
                                (my/cyberdeck-sidebar-goto-section "-- Context --")))
    (define-key map (kbd "2") (lambda () (interactive)
                                (my/cyberdeck-sidebar-goto-section "-- AIU Proxies --")))
    (define-key map (kbd "3") (lambda () (interactive)
                                (my/cyberdeck-sidebar-goto-section "-- Outline --")))
    (define-key map (kbd "4") (lambda () (interactive)
                                (my/cyberdeck-sidebar-goto-section "-- Due --")))
    (define-key map (kbd "j") #'next-line)
    (define-key map (kbd "k") #'previous-line)
    (define-key map (kbd "SPC") #'scroll-up-command)
    (define-key map (kbd "DEL") #'scroll-down-command)
    map)
  "Sidebar-local keys.  No global bindings; view-mode conveniences kept.")

(defun my/cyberdeck-sidebar-goto-section (marker)
  "Jump to MARKER section in the sidebar."
  (let ((sb (get-buffer "*Cyberdeck Sidebar*")))
    (when (buffer-live-p sb)
      (pop-to-buffer sb)
      (goto-char (point-min))
      (if (search-forward marker nil t)
          (beginning-of-line)
        (message "section absent: %s" marker)))))

(defun my/cyberdeck-sidebar-setup-keys ()
  "Install the sidebar-local keymap."
  (let ((sb (get-buffer "*Cyberdeck Sidebar*")))
    (when (buffer-live-p sb)
      (with-current-buffer sb
        (use-local-map my/cyberdeck-sidebar-mode-map)))))
#+end_src

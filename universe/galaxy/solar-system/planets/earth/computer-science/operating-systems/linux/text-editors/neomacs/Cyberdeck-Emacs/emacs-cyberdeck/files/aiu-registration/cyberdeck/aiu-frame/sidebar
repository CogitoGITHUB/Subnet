(defvar my/cyberdeck-sidebar-source-buffer nil
  "Buffer the sidebar follows (set on open).")

(defun cyberdeck-ui-sidebar-toggle ()
  "Toggle a minimal Cyberdeck sidebar."
  (interactive)
  (let ((win (get-buffer-window "*Cyberdeck Sidebar*")))
    (if win
        (delete-window win)
      (setq my/cyberdeck-sidebar-source-buffer (current-buffer))
      (let ((buf (get-buffer-create "*Cyberdeck Sidebar*")))
        (with-current-buffer buf
          (view-mode 1))
        (my/cyberdeck-sidebar-setup-keys)
        (my/cyberdeck-sidebar-refresh)
        (my/cyberdeck-sidebar-follow-start)
        (display-buffer-in-side-window buf '((side . left) (window-width . 0.20)))))))

(defun cyberdeck-ui-sidebar-open ()
  "Open sidebar."
  (interactive)
  (cyberdeck-ui-sidebar-toggle))

(defun cyberdeck-ui-sidebar-close ()
  "Close sidebar."
  (interactive)
  (cyberdeck-ui-sidebar-toggle))

(defun cyberdeck-ui--detect-context-type (pos line)
  "Detect the context type at POS given LINE content."
  (cond
   ;; Meta block: - key :: value
   ((string-match-p "^[ \t]*- [^:]+[ \t]+::" line) 'meta)
   ;; Header: starts with *
   ((string-match-p "^\\*+ " line) 'header)
   ;; Table: starts with |
   ((string-match-p "^[ \t]*|" line) 'table)
   ;; Quote block: check if inside #+BEGIN_QUOTE
   ((cyberdeck-ui--inside-block-p pos "QUOTE") 'quote)
   ;; Code/src block
   ((or (cyberdeck-ui--inside-block-p pos "SRC")
        (cyberdeck-ui--inside-block-p pos "EXAMPLE"))
    'code)
   ;; Footnote: [fn:...]
   ((string-match-p "^\\[fn:" line) 'footnote)
   ;; List item (non-meta): - item or + item or 1. item
   ((string-match-p "^[ \t]*[-+*] [^:]" line) 'list)
   ((string-match-p "^[ \t]*[0-9]+[.)] " line) 'list)
;; Default: prose
    (t 'prose)))
#+end_src

** Sidebar content
Calls the aiu-view section builders (never forks them): context plus
the historical AIU Proxies section the header always promised.
#+begin_src emacs-lisp
(defun my/cyberdeck-sidebar--aiu-at-point ()
  "AIU at point or in this buffer, or nil."
  (or (and (fboundp 'my/cyberdeck--aiu-at-point)
           (ignore-errors (my/cyberdeck--aiu-at-point)))
      (and (fboundp 'my/cyberdeck--buffer-aiu)
           (ignore-errors (my/cyberdeck--buffer-aiu)))))

(defun my/cyberdeck-sidebar-refresh ()
  "Fill *Cyberdeck Sidebar* with context and AIU Proxies.  Read-only."
  (interactive)
  (let ((buf (get-buffer "*Cyberdeck Sidebar*")))
    (when (buffer-live-p buf)
      (with-current-buffer buf
        (let ((inhibit-read-only t)
              (note (my/cyberdeck-sidebar--aiu-at-point)))
          (erase-buffer)
          (insert "* Cyberdeck Sidebar\n\n")
          (if (null note)
              (insert "- No AIU at point (open a vault file)\n")
            (when (fboundp 'my/cyberdeck-aiu-view-sections)
              (insert "-- Context --\n")
              (dolist (sec (ignore-errors (my/cyberdeck-aiu-view-sections note)))
                (insert (format "%s: %s\n" (car sec) (cdr sec))))
              (insert "\n"))
            (when (fboundp 'my/cyberdeck-aiu-view-backlinks)
              (insert "-- AIU Proxies --\n")
              (let ((bl (ignore-errors (my/cyberdeck-aiu-view-backlinks note))))
                (if bl
                    (dolist (b bl) (insert b "\n"))
                  (insert "none\n")))))
          (my/cyberdeck-sidebar-insert-outline note)
          (my/cyberdeck-sidebar-insert-digest note)
          (insert "\n[q] close  [g] refresh\n"))))))

;;;; Helper functions for theme setup

(defvar theme--hex-regexp
  (concat
   "\\`#"
   "\\(?:[[:xdigit:]]\\{3\\}"
   "\\|"
   "[[:xdigit:]]\\{6\\}\\)"
   "\\'")
  "Regular expression to match a color in hexadecimal RGB notation.")

(defun theme--color-hex-p (color)
  "Return non-nil if COLOR is hexadecimal RGB."
  (and (stringp color) (string-match-p theme--hex-regexp color)))

(defun theme--hex-or-name-to-rgb (color)
  "Convert COLOR to a list of normalized RGB values.
COLOR can be a hexadecimal RGB value like #123456 or a named color
like those produced by `list-colors-display'."
  (cond
   ((theme--color-hex-p color)
    (when-let* ((spec (color-values-from-color-spec color)))
      (mapcar (lambda (x) (/ x 65535.0)) spec)))
   ((color-name-to-rgb color))
   (t
    (error "The color `%s' cannot be resolved" color))))

;; This is the WCAG formula: https://www.w3.org/TR/WCAG20-TECHS/G18.html
(defun theme--wcag-contribution (channel weight)
  "Return the CHANNEL contribution to overall luminance given WEIGHT."
  (* weight
     (if (<= channel 0.03928)
         (/ channel 12.92)
       (expt (/ (+ channel 0.055) 1.055) 2.4))))

(defun theme-wcag-formula (color)
  "Get WCAG value of color value COLOR.
The value is defined in hexadecimal RGB notation, such #123456, or
as a named color like those of `list-colors-display'."
  (when-let* ((channels (theme--hex-or-name-to-rgb color)))
    (let ((weights '(0.2126 0.7152 0.0722))
          (contribution nil))
      (while channels
        (push (theme--wcag-contribution (pop channels) (pop weights)) contribution))
      (apply #'+ contribution))))

;;;###autoload
(defun theme-contrast (color-1 color-2)
  "Measure WCAG contrast ratio between COLOR-1 and COLOR-2.
Color values are of the form accepted by `theme-wcag-formula'."
  (if-let* ((hex1-weight (theme-wcag-formula color-1))
            (hex2-weight (theme-wcag-formula color-2)))
      (let ((contrast (/ (+ hex1-weight 0.05) (+ hex2-weight 0.05))))
        (max contrast (/ contrast)))
    (error "Both `%s' and `%s' must be valid hexadecimal RGB or named colors" color-1 color-2)))

(defun theme--color-eight-to-six-digits (hex-color)
  "Reduce representation of hexadecimal RGB HEX-COLOR from eight to six digits.
If HEX-COLOR is three or six digits, then return it as is."
  (if (theme--color-hex-p hex-color)
      hex-color
    (let* ((color-no-hash (substring hex-color 1))
           (triplets (seq-split color-no-hash 4))
           (triplets-shortened (mapcar
                                (lambda (string)
                                  (substring string 0 2))
                                triplets)))
      (concat "#" (string-join triplets-shortened)))))

(defun theme-adjust-value (color percentage)
  "Adjust value of COLOR by PERCENTAGE.
COLOR is either a hexadecimal RGB string or a named color."
  (when-let* ((rgb (theme--hex-or-name-to-rgb color)))
    (pcase-let* ((`(,r ,g ,b) rgb)
                 (`(,h ,s ,l) (color-rgb-to-hsl r g b))
                 (adjusted (color-lighten-hsl h s l percentage))
                 (adjusted-rgb (apply #'color-hsl-to-rgb adjusted))
                 (value (apply #'color-rgb-to-hex adjusted-rgb)))
      (theme--color-eight-to-six-digits value))))

(defvar theme-registered-items nil
  "List of defined themes.
This list is instantiated by the `theme-theme' macro.  Themes
that build on top of another theme but cannot use that macro
must define theme properties to include those that the macro specifies.

Also see `theme-get-themes'.")

(defvar theme--activated-themes nil
  "List of themes that `theme-activate' operated on.")

;;;###autoload
(defun theme-activate (theme)
  "Load THEME if neeeded, so that it can be used by other commands."
  ;; If it is already in the `theme--activated-themes', then we
  ;; have already processed it.
  (unless (memq theme theme--activated-themes)
    (let ((properties (get theme 'theme-properties)))
      ;; If it has no properties, then we need to load it so that
      ;; those are reified.
      (if (null properties)
          (progn
            (push theme theme--activated-themes)
            (load-theme theme t t))
        (let ((core-palette (plist-get properties :theme-core-palette))
              (user-palette (plist-get properties :theme-user-palette)))
          ;; If its core palette is void or nil, then we need to load it.
          ;; Same if its user palette is void, but it is okay if that
          ;; one is nil.
          (unless (and (boundp core-palette)
                       core-palette
                       (boundp user-palette))
            (push theme theme--activated-themes)
            (load-theme theme t t)))))))

(defun theme--belongs-to-family-p (theme family)
  "Return non-nil if THEME has FAMILY property."
  (when-let* ((properties (get theme 'theme-properties))
              (theme-family (plist-get properties :family)))
    (eq theme-family family)))

(defun theme-get-all-known-themes (&optional theme-family)
  "Return all known themes or derivatives, enabling them if needed.
With optional THEME-FAMILY, operate only on the themes whose :family
property is that.  Else consider the themes as well as all their
derivatives.

Also see `theme-sort'."
  (let ((themes (pcase theme-family
                  ('cyberdeck theme-items)
                  ((pred identity) theme-registered-items)
                  (_ (seq-union theme-items theme-registered-items)))))
    (if theme-family
        (seq-filter
         (lambda (theme)
           (theme--belongs-to-family-p theme theme-family))
         themes)
      themes)))

(defun theme--background-p (theme background-mode)
  "Return non-nil if THEME has BACKGROUND-MODE :background-mode property."
  (when-let* ((properties (get theme 'theme-properties))
              (background (plist-get properties :background-mode)))
    (eq background background-mode)))

(defun theme-sort (themes background-mode)
  "Reorder THEMES so that those with BACKGROUND-MODE come first.
BACKGROUND-MODE is either `dark' or `light'."
  (unless (memq background-mode '(dark light))
    (error "The BACKGROUND-MODE can be either `dark' or `light'"))
  (sort
   themes
   (lambda (theme1 theme2)
     (and (theme--background-p theme1 background-mode)
          (theme--background-p theme2 (if (eq background-mode 'dark) 'light 'dark))))))

(cl-defgeneric theme-get-themes ()
  "Return a list of all themes with the `cyberdeck' :family property.
Use `theme-sort' to sort by light and then dark background."
  (if-let* ((themes (theme-get-all-known-themes 'cyberdeck))
            (sorted-themes (theme-sort themes 'light)))
      sorted-themes
    theme-items))

(defun theme-known-p (themes)
  "Return THEMES if they are among `theme-get-themes' else nil.
THEMES is either a list of symbols, like `theme-items' or a
symbol.

With optional SHOW-ERROR, throw an error instead of returning nil."
  (let ((known-themes (theme-get-all-known-themes)))
    (cond
     ((symbolp themes)
      (memq themes known-themes))
     ((listp themes)
      (when (seq-every-p (lambda (theme) (memq theme known-themes)) themes)
        themes))
     (t
      (error "Themes `%S' is not a symbol or a list of symbols" themes)))))

(defun theme--family-theme-p (theme)
  "Return non-nil if THEME has a :theme-core-palette property."
  (when-let* ((properties (get theme 'theme-properties))
              (core (plist-get properties :theme-core-palette)))
    theme))

(defun theme-get-current-theme ()
  "Return currently enabled theme.
More specifically, return the first of the currently enabled family
themes among the `custom-enabled-themes'.

Assume that a theme has a `theme-properties' entry of
`:theme-core-palette'."
  (seq-find #'theme--family-theme-p custom-enabled-themes))

(defun theme--get-theme-palette-subr (theme with-overrides with-user-palette)
  "Get THEME palette without `theme-known-p'.
WITH-OVERRIDES and WITH-USER-PALETTE are described in
`theme-get-theme-palette'.

If THEME does not have at least a `:theme-core-palette' among its
`theme-properties', return nil.

Else return (append OVERRIDES USER CORE)."
  (when-let* ((properties (get theme 'theme-properties))
              (core-palette-name (plist-get properties :theme-core-palette)))
    ;; If the palette variable hasn't been loaded into memory yet, load the theme silently
    (unless (boundp core-palette-name)
      (load-theme theme t t))
    (when (boundp core-palette-name)
      (let* ((core-palette (symbol-value core-palette-name))
             (user-palette-name (plist-get properties :theme-user-palette))
             (user-palette (when (and with-user-palette
                                      user-palette-name
                                      (boundp user-palette-name))
                             (symbol-value user-palette-name)))
             (overrides-palette-name (plist-get properties :theme-overrides-palette))
             (overrides-palette (when (and with-overrides
                                           overrides-palette-name
                                           (boundp overrides-palette-name))
                                  (symbol-value overrides-palette-name)))
             (all-overrides (when with-overrides
                              (append overrides-palette palette-common-overrides))))
        (append all-overrides user-palette core-palette)))))

(defun theme-get-theme-palette (&optional theme with-overrides with-user-palette)
  "Return palette value of active `theme-get-themes' THEME.
If THEME is nil, use the return value of
`theme-get-current-theme'.  With WITH-OVERRIDES, include all
overrides in the combined palette.  With WITH-USER-PALETTE do the same
for the user-defined palette extension.

If THEME is unknown, return nil.  Else return (append OVERRIDES USER CORE)."
  (theme--get-theme-palette-subr (or theme (theme-get-current-theme)) with-overrides with-user-palette))

(defun theme--disable-themes (themes)
  "Disable THEMES per `theme-disable-other-themes'."
  (mapc
   #'disable-theme
   (if theme-disable-other-themes
       themes
     (seq-filter #'theme--family-theme-p themes))))

(defun theme--get-color-schemes ()
  "Return `custom-enabled-themes' of :kind `color-scheme'."
  (seq-filter
   (lambda (theme)
     (eq (plist-get (get theme 'theme-properties) :kind) 'color-scheme))
   custom-enabled-themes))

(defun theme-load-theme (theme &optional hook)
  "Load THEME while disabling other themes.

Which themes are disabled is determined by the user option
`theme-disable-other-themes'.

Run the `cyberdeck-after-load-theme-hook' as the final step
after loading the THEME.  If HOOK, then call that instead.

Return THEME."
  (load-theme theme :no-confirm)
  (theme--disable-themes (remq theme (theme--get-color-schemes)))
  (run-hooks (or hook 'cyberdeck-after-load-theme-hook))
  theme)

(define-obsolete-function-alias
  'theme--retrieve-palette-value
  'theme-retrieve-palette-value
  "5.3.0")

(defun theme-retrieve-palette-value (color palette)
  "Return COLOR from PALETTE.
Use recursion until COLOR is retrieved as a string.  Refrain from
doing so if the value of COLOR is not a key in the PALETTE.

Return `unspecified' if the value of COLOR cannot be determined.
This symbol is accepted by faces and is thus harmless.

This function is used in the macro `theme-theme'"
  (let ((value (car (alist-get color palette))))
    (cond
     ((or (stringp value)
          (eq value 'unspecified))
      value)
     ((and (symbolp value)
           value)
      (theme-retrieve-palette-value value palette))
     (t
      'unspecified))))

;; NOTE 2025-09-29: We keep THEME at that position for backward-compatibility.
(defun theme-get-color-value (color &optional with-overrides theme)
  "Return color value of named COLOR for current theme.

COLOR is a symbol that represents a named color entry in the
palette.

If the value is the name of another color entry in the
palette (so a mapping), recur until you find the underlying color
value.

With optional WITH-OVERRIDES as a non-nil value, include palette
overrides.  Else use the default palette.

With optional THEME among `theme-get-themes', use the palette of
that item.  Else use the current theme.

If COLOR is not present in the palette, return the `unspecified'
symbol, which is safe when used as a face attribute's value."
  (when theme
    (theme-activate theme))
  (if-let* ((palette (theme-get-theme-palette theme with-overrides :with-user-palette))
            (value (theme-retrieve-palette-value color palette)))
      value
    'unspecified))


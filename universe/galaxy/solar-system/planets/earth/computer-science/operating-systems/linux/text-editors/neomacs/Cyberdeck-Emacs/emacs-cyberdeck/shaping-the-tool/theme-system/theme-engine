(defvar theme--select-theme-history nil
  "Minibuffer history of `theme-select-prompt'.")

(defun theme--annotate-theme (theme)
  "Return description of THEME ."
  (when-let* ((symbol (intern-soft theme))
              (properties (get symbol 'theme-properties))
              (doc-string (or (get symbol 'theme-documentation)
                              (plist-get properties :theme-documentation))))
    (format " %s"
            (propertize (concat "-- " (car (split-string doc-string "\\.")))
                        'face 'completions-annotations))))

(defun theme--group-themes (theme transform)
  "Group THEME by its background for minibuffer completion.
If TRANSFORM is non-nil, return THEME as-is."
  (let ((symbol (intern-soft theme)))
    (cond
     (transform
      theme)
     ((eq symbol (theme-get-current-theme))
      "Current")
     ((when-let* ((properties (get symbol 'theme-properties))
                  (background (plist-get properties :background-mode)))
        (capitalize (format "%s" background)))))))

(defun theme--display-sort (themes)
  "Put the current theme before other THEMES for minibuffer completion."
  (let* ((current (theme-get-current-theme))
         (current-theme-p (lambda (theme) (eq (intern-soft theme) current))))
    (nconc
     (seq-filter current-theme-p themes)
     (seq-remove current-theme-p themes))))

(defun theme--completion-table (themes)
  "Pass appropriate metadata to THEMES for minibuffer completion."
  (lambda (string pred action)
    (if (eq action 'metadata)
        (list 'metadata
              (cons 'category 'theme)
              (cons 'annotation-function #'theme--annotate-theme)
              (cons 'group-function #'theme--group-themes)
              (cons 'display-sort-function #'theme--display-sort))
      (complete-with-action action themes string pred))))

(defun theme-select-prompt (&optional prompt background-mode)
  "Minibuffer prompt to select a theme.
With optional PROMPT string, use it as the first argument of
`format-prompt'.  Else use a generic prompt.

With optional BACKGROUND-MODE as either `dark' or `light' limit the
themes accordingly."
  (intern
   (completing-read
    (format-prompt (or prompt "Select theme") nil)
    (theme--completion-table
     (if background-mode
         (theme-filter-by-background-mode
          (theme-get-themes)
          background-mode)
       (theme-get-themes)))
    nil t nil
    'theme--select-theme-history)))

;;;###autoload
(defun theme-select (theme)
  "Load a theme THEME using minibuffer completion.
With optional prefix argument, prompt to limit the set of themes to
either dark or light variants.

Run `cyberdeck-after-load-theme-hook' after loading the theme.
Disable other themes per `theme-disable-other-themes'."
  (interactive
   (list
    (if current-prefix-arg
        (theme-select-prompt nil (theme-background-mode-prompt))
      (theme-select-prompt))))
  (theme-load-theme theme))

;;;###autoload
(defun theme-select-dark (theme)
  "Like `theme-select' for a dark THEME."
  (interactive (list (theme-select-prompt nil 'dark)))
  (theme-load-theme theme))

;;;###autoload
(defun theme-select-light (theme)
  "Like `theme-select' for a light THEME."
  (interactive (list (theme-select-prompt nil 'light)))
  (theme-load-theme theme))

;;;;; Toggle between two themes

;;;###autoload
(defun theme-toggle ()
  "Toggle between the two `theme-to-toggle'.
If `theme-to-toggle' does not specify two themes,
prompt with completion for a theme among our collection (this is
practically the same as the `theme-select' command).

Run `cyberdeck-after-load-theme-hook' after loading the theme.
Disable other themes per `theme-disable-other-themes'."
  (declare (interactive-only t))
  (interactive)
  (if-let* ((themes (theme-known-p theme-to-toggle))
            (one (car themes))
            (two (cadr themes)))
      (theme-load-theme (if (eq (theme-get-current-theme) one) two one))
    (theme-load-theme (theme-select-prompt "No two valid themes to toggle; select other"))))

;;;;; Rotate through a list of themes

(defun theme-rotate-subr (themes &optional reverse)
  "Return a new theme for `theme-rotate'.
The theme is the next among THEMES if it is possible to rotate to it.
When REVERSE is non-nil, move to the left, else to the right."
  (if-let* ((valid-themes (theme-known-p themes)))
      (if-let* ((index (or (seq-position valid-themes (theme-get-current-theme)) -1))
                (offset (mod
                         (if reverse (1- index) (1+ index))
                         (length valid-themes)))
                (new-theme (nth offset valid-themes)))
          new-theme
        (theme-select-prompt "Cannot determine next rotation; select other"))
    (theme-select-prompt "No valid theme to rotate; select other")))

;;;###autoload
(defun theme-rotate (themes &optional reverse)
  "Rotate to the next theme among THEMES.
When called interactively THEMES is the value of `theme-to-rotate'
and REVERSE is the prefix argument.

If the current theme is already the next in line, then move to the one
after.  The rotation is performed rightwards if REVERSE is nil (the
default), and leftwards if REVERSE is non-nil.  Perform the rotation
such that the current element in the list becomes the last.  Do not
modify THEMES in the process."
  (interactive
   (list
    (or theme-to-rotate (theme-get-themes))
    current-prefix-arg))
  (let ((theme (theme-rotate-subr themes reverse)))
    (message "Rotating to `%s'" theme)
    (theme-load-theme theme)))

;;;;; Load a random theme

(defun theme-filter-by-background-mode (themes background-mode)
  "Return list of THEMES by BACKGROUND-MODE property.
BACKGROUND-MODE is the symbol `dark' or `light'.  It corresponds to the
theme property of :background-mode.  Any other value means to use all
THEMES."
  (if background-mode
      (progn
        (unless (memq background-mode '(dark light))
          (error "The BACKGROUND-MODE can be either `dark' or `light'"))
        (seq-filter
         (lambda (theme)
           (theme--background-p theme background-mode))
         themes))
    themes))

(defun theme-background-mode-prompt ()
  "Select `dark' or `light' and return it as a symbol."
  (intern
   (cadr
    (read-multiple-choice
     "Variant"
     '((?d "dark" "Load a random dark theme")
       (?l "light" "Load a random light theme"))
     "Limit to the dark or light subset of the themes."))))

(defun theme-load-random-subr (background-mode)
  "Return theme for `theme-load-random' given BACKGROUND-MODE."
  (let* ((themes (theme-filter-by-background-mode
                  (theme-get-themes)
                  background-mode))
         (current (theme-get-current-theme))
         (themes-minus-current (delete current (copy-sequence themes))))
    (or (nth (random (length themes-minus-current)) themes-minus-current)
        (car themes-minus-current))))

;;;###autoload
(defun theme-load-random (&optional background-mode)
  "Load a theme at random, excluding the current one.

With optional BACKGROUND-MODE as a prefix argument, prompt to limit the
set of themes to either dark or light variants.  When called from Lisp,
BACKGROUND-MODE is either the `dark' or `light' symbol.

Run `cyberdeck-after-load-theme-hook' after loading a theme."
  (interactive
   (list
    (when current-prefix-arg
      (theme-background-mode-prompt))))
  (if-let* ((theme (theme-load-random-subr background-mode)))
      (progn
        (message "Loading `%s'" theme)
        (theme-load-theme theme))
    (error "Could not find a theme to load at random")))

;;;###autoload
(defun theme-load-random-dark ()
  "Load a random dark theme."
  (declare (interactive-only t))
  (interactive)
  (theme-load-random 'dark))

;;;###autoload
(defun theme-load-random-light ()
  "Load a random light theme."
  (declare (interactive-only t))
  (interactive)
  (theme-load-random 'light))


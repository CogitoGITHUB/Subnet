Data-integrity health for the cyberdeck (distinct from the package-health
doctor): checks reply ok/repair/skipped per item, repairs are explicit
and snapshot first.  Read-only by default; `cyberdeck-data-doctor` with
repair confirms each fix with y-or-n.  Nothing here runs at load.

** Checks
#+begin_src emacs-lisp
(require 'cl-lib)

(defun my/cyberdeck-data-doctor-checks ()
  "Alist (LABEL STATUS DETAIL).  STATUS is ok, bad, or skipped."
  (let ((root (ignore-errors (my/cyberdeck-root-dir)))
        (home (expand-file-name "~"))
        (out nil))
    (push (list "vault-root" (if (and root (file-directory-p root)) 'ok 'bad)
                (or root "unresolvable"))
          out)
    (push (list "discovery-index"
                (condition-case nil
                    (progn (with-temp-buffer
                             (insert-file-contents
                              (expand-file-name ".config/emacs/.local/cache/discovery-index.el" home))
                             (read (current-buffer)))
                           'ok)
                  (error 'bad))
                "")
          out)
    (push (list "known-keys"
                (let ((p (and (fboundp 'my/cyberdeck-links--known-keys-path)
                              (ignore-errors
                               (my/cyberdeck-links--known-keys-path)))))
                  (if (and p (file-exists-p p)) 'ok 'bad))
                "")
          out)
    (push (list "database"
                (condition-case nil
                    (if (ignore-errors (cyberdeck-db)) 'ok 'bad)
                  (error 'bad))
                "")
          out)
    (push (list "eval-cache-dir"
                (if (file-directory-p
                     (expand-file-name ".config/emacs/.local/cache/module-cache" home))
                    'ok 'bad)
                "")
          out)
    (nreverse out)))
#+end_src

** Repair
#+begin_src emacs-lisp
(defun my/cyberdeck-data-doctor-repair (label)
  "Repair LABEL's issue with confirmation.  Only cache-grade data is
ever deleted (everything rebuilds on reload); AIUs are never touched."
  (interactive
   (list (completing-read "Repair: " '("discovery-index" "eval-cache-dir"))))
  (let ((home (expand-file-name "~")))
    (cond
     ((string= label "discovery-index")
      (when (yes-or-no-p "Delete discovery index (rebuilds on reload)? ")
        (ignore-errors
          (delete-file (expand-file-name ".config/emacs/.local/cache/discovery-index.el" home)))
        (message "index deleted")))
     ((string= label "eval-cache-dir")
      (when (yes-or-no-p "Delete eval cache (rebuilds on reload)? ")
        (ignore-errors
          (delete-directory
           (expand-file-name ".config/emacs/.local/cache/module-cache" home) t))
        (message "cache deleted"))))))

(defun cyberdeck-data-doctor (&optional repair)
  "Report data health; with prefix arg, offer repairs one by one."
  (interactive "P")
  (let ((rows (my/cyberdeck-data-doctor-checks)))
    (message "data-doctor: %s"
             (mapconcat (lambda (r) (format "%s=%s" (nth 0 r) (nth 1 r)))
                        rows " "))
    (when repair
      (dolist (r rows)
        (when (eq (nth 1 r) 'bad)
          (my/cyberdeck-data-doctor-repair (nth 0 r)))))))
#+end_src

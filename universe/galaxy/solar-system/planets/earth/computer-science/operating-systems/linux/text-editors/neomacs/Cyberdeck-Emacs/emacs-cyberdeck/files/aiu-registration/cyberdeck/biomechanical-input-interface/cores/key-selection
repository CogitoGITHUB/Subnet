(defun ks--window-candidates ()
  "Live non-minibuffer windows as ks leaves ((POS . POS) . WND).
POS is the window start (top-left label, ace-window style)."
  (mapcar (lambda (w)
            (let ((pos (window-start w)))
              (cons (cons pos pos) w)))
          (seq-filter (lambda (w)
                        (and (window-live-p w)
                             (not (window-minibuffer-p w))))
                      (ks-window-list))))

(defun ks-read-windows ()
  "Select a live window via ks overlays; return the window or nil."
  (let ((wnds (mapcar #'cdr (ks--window-candidates))))
    (when (cdr wnds)
      (ks--make-backgrounds wnds)
      (unwind-protect
          (let ((leaf (ks-read (ks-tree (ks--window-candidates) ks-keys)
                               #'ks--overlay-at
                               #'ks--remove-leading-chars)))
            (and (consp leaf)
                 (window-live-p (cdr leaf))
                 (cdr leaf)))
        (ks--done)))))

(defun ks-action-goto-window (&optional arg)
  "Jump to a ks-selected window.
With one \\[universal-argument], swap buffers with it instead.
With two, delete it instead. Single window: fall back to other-window."
  (interactive "p")
  (let ((wnd (ks-read-windows)))
    (cond ((null wnd)
           (other-window 1))
          ((not (window-live-p wnd))
           (message "Window is gone"))
          ((eq arg 4)
           (unless (eq wnd (selected-window))
             (let ((cur (selected-window))
                   (b1 (window-buffer (selected-window)))
                   (b2 (window-buffer wnd)))
               (set-window-buffer cur b2)
               (set-window-buffer wnd b1)
               (select-window wnd))))
          ((eq arg 16)
           (unless (eq wnd (selected-window))
             (delete-window wnd)))
          (t
           (select-window wnd)))))

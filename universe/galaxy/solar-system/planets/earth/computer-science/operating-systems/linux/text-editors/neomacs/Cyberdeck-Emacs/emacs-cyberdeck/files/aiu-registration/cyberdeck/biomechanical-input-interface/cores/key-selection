(defun ks-org-refile-as-child ()
  "Refile current heading as first child of heading selected with `ks'."
  ;; Inspired by `org-teleport': http://kitchingroup.cheme.cmu.edu/blog/2016/03/18/Org-teleport-headlines/
  (interactive)

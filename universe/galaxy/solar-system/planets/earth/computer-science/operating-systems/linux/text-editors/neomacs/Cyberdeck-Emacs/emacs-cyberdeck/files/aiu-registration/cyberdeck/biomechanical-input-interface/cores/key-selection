(defvar ks-action nil
  "Function to call at the end of select.")

(defvar ks-action-oneshot nil
  "Function to call once at the end of select.")

(defun ks-handler-default (char)
  "The default handler for a bad CHAR."
  (let (dispatch)
    (cond ((setq dispatch (assoc char ks-dispatch-alist))
           (unless (eq ks-style 'words)
             (setq ks-action (cdr dispatch)))
           (throw 'done 'restart))
          ((memq char ks-escape-chars)
           ;; exit silently
           (throw 'done 'abort))
          ((eq char ??)
           (ks-show-dispatch-help)
           (throw 'done 'restart))
          ((mouse-event-p char)
           (signal 'user-error (list "Mouse event not handled" char)))
          (t
           (message "No such candidate: %s, hit `C-g' to quit."
                    (if (characterp char) (string char) char))))))

(defun ks-show-dispatch-help ()
  "Display action shortucts in echo area."
  (let ((len (length "ks-action-")))
    (message "%s" (mapconcat
                   (lambda (x)
                     (format "%s: %s"
                             (propertize
                              (char-to-string (car x))
                              'face 'ks-lead-face)
                             (substring (symbol-name (cdr x)) len)))
                   ks-dispatch-alist
                   " "))))

(defvar ks-handler-function 'ks-handler-default
  "A function to call for a bad `read-key' in `ks-read'.")

(defvar ks-current-path ""
  "Store the current incomplete path during `ks-read'.")

(defun ks-wheel-event-p (char)
  "Non-nil when CHAR is a mouse wheel event list.
`mouse-event-p' returns nil for wheel events on some builds, so
wheel needs its own test: without it every ks reader feeds the
event list to handlers that do character arithmetic and crash
with wrong-type-argument on scroll."
  (and (consp char)
       (memq (car char) '(wheel-up wheel-down wheel-left wheel-right))))

(defun ks-mouse-event-window (char)
  "Return the window of mouse event CHAR if any or the selected window.
Return nil if CHAR is not a mouse event. Wheel events count here:
they carry positions and must never fall through to character
handlers downstream."
  (when (or (mouse-event-p char) (ks-wheel-event-p char))
    (cond ((windowp (posn-window (event-start char)))
           (posn-window (event-start char)))
          ((framep (posn-window (event-start char)))
           (frame-selected-window (posn-window (event-start char))))
          (t (selected-window)))))

(defun ks-read (tree display-fn cleanup-fn)
  "Select a leaf from TREE using consecutive `read-key'.

DISPLAY-FN should take CHAR and LEAF and signify that LEAFs
associated with CHAR will be selected if CHAR is pressed.  This is
commonly done by adding a CHAR overlay at LEAF position.

CLEANUP-FN should take no arguments and remove the effects of
multiple DISPLAY-FN invocations."
  (catch 'done
    (setq ks-current-path "")
    (while tree
      (let ((ks--leafs nil))
        (ks-traverse tree
                      (lambda (path leaf)
                        (push (cons path leaf) ks--leafs)))
        (dolist (x ks--leafs)
          (funcall display-fn (car x) (cdr x))))
      (let ((char (funcall ks-translate-char-function (read-key)))
            window
            branch)
        (funcall cleanup-fn)
        (when (ks-wheel-event-p char)
          ;; Scroll now (direction and modifiers honored), then
          ;; restart over fresh overlays. Without this the event
          ;; reaches digit-testing handlers and crashes there.
          (when (fboundp 'mwheel-scroll)
            (ignore-errors (mwheel-scroll char)))
          (throw 'done 'restart))
        (if (setq window (ks-mouse-event-window char))
            (throw 'done (cons char window))
          (if (setq branch (assoc char tree))
              (progn
                ;; Ensure ks-current-path stores the full path prior to
                ;; exit so other packages can utilize its value.
                (setq ks-current-path
                      (concat ks-current-path (string (ks--key-to-char char))))
                (if (eq (car (setq tree (cdr branch))) 'leaf)
                    (throw 'done (cdr tree))))
            (funcall ks-handler-function char)))))))

(defun ks-read-de-bruijn (lst keys)
  "Select from LST dispatching on KEYS."
  ;; In theory, the De Bruijn sequence B(k,n) has k^n subsequences of length n
  ;; (the path length) usable as paths, thus that's the lower bound.  Due to
  ;; partially overlapping matches, not all subsequences may be usable, so it's
  ;; possible that the path-len must be incremented, e.g., if we're matching
  ;; for x and a buffer contains xaxbxcx only every second subsequence is
  ;; usable for the four matches.
  (catch 'done
    (let* ((path-len (ceiling (log (length lst) (length keys))))
           (alist (ks--path-alist-1 lst path-len keys)))
      (while (not alist)
        (cl-incf path-len)
        (setq alist (ks--path-alist-1 lst path-len keys)))
      (let* ((len (length (caar alist)))
             (i 0))
        (setq ks-current-path "")
        (while (< i len)
          (dolist (x (reverse alist))
            (ks--overlay-at-full (reverse (car x)) (cdr x)))
          (let ((char (funcall ks-translate-char-function (read-key))))
            (ks--remove-leading-chars)
            (when (ks-wheel-event-p char)
              (when (fboundp 'mwheel-scroll)
                (ignore-errors (mwheel-scroll char)))
              (throw 'done 'restart))
            (setq alist
                  (delq nil
                        (mapcar (lambda (x)
                                  (when (eq (caar x) char)
                                    (cons (cdr (car x)) (cdr x))))
                                alist)))
            (setq ks-current-path
                  (concat ks-current-path (string (ks--key-to-char char))))
            (cl-incf i)
            (unless alist
              (funcall ks-handler-function char))))
        (cdar alist)))))

(defun ks-read-words (lst words)
  "Select from LST using WORDS."
  (catch 'done
    (let ((num-words (length words))
          (num-entries (length lst))
          alist)
      ;; If there are not enough words to cover all the candidates,
      ;; we use a De Bruijn sequence to generate the remaining ones.
      (when (< num-words num-entries)
        (let ((keys ks-keys)
              (bad-keys '(?a ?e ?i ?o ?u ?y))
              (path-len 1)
              (num-remaining (- num-entries num-words))
              tmp-alist)
          ;; Delete all keys which could lead to duplicates.
          ;; We want at least three keys left to work with.
          (dolist (x bad-keys)
            (when (memq x keys)
              (setq keys (delq ?a keys))))
          (when (< (length keys) 3)
            (signal 'user-error
                    '("Please add more keys to the variable `ks-keys'.")))
          ;; Generate the sequence and add the keys to the existing words.
          (while (not tmp-alist)
            (cl-incf path-len)
            (setq tmp-alist (ks--path-alist-1 lst path-len keys)))
          (while (>= (cl-decf num-remaining) 0)
            (push (mapconcat 'string (caar tmp-alist) nil) (cdr (last words)))
            (setq tmp-alist (cdr tmp-alist)))))
      (dolist (x lst)
        (push (cons (string-to-list (pop words)) x) alist))
      (setq ks-current-path "")
      (while (or (> (length alist) 1)
                 (caar alist))
        (dolist (x (reverse alist))
          (ks--overlay-at-full (reverse (car x)) (cdr x)))
        (let ((char (funcall ks-translate-char-function (read-key))))
          (ks--remove-leading-chars)
          (when (ks-wheel-event-p char)
            (when (fboundp 'mwheel-scroll)
              (ignore-errors (mwheel-scroll char)))
            (throw 'done 'restart))
          (setq alist
                (delq nil
                      (mapcar (lambda (x)
                                (when (eq (caar x) char)
                                  (cons (cdr (car x)) (cdr x))))
                              alist)))
          (setq ks-current-path
                (concat ks-current-path (string (ks--key-to-char char))))
          (unless alist
            (funcall ks-handler-function char))))
      (cdar alist))))

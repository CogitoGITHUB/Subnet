(defvar ks--overlays-back nil
  "Hold overlays for when `ks-background' is t.")

(defun ks--make-backgrounds (wnd-list)
  "Create a dim background overlay for each window on WND-LIST."
  (when ks-background
    (setq ks--overlays-back
          (mapcar (lambda (w)
                    (let ((ol (make-overlay
                               (window-start w)
                               (window-end w)
                               (window-buffer w))))
                      (overlay-put ol 'face 'ks-background-face)
                      (overlay-put ol 'window w)
                      ol))
                  wnd-list))))

(defun ks--done ()
  "Clean up overlays."
  (mapc #'delete-overlay ks--overlays-back)
  (setq ks--overlays-back nil)
  (ks--remove-leading-chars))

(defun ks--visible-p (s)
  (let ((invisible (get-char-property s 'invisible)))
    (or (null invisible)
        (eq t buffer-invisibility-spec)
        (null (assoc invisible buffer-invisibility-spec)))))

(defun ks--next-visible-point ()
  "Return the next closest point without `invisible' property."
  (let ((s (point)))
    (while (and (not (= (point-max) (setq s (next-char-property-change s))))
                (not (ks--visible-p s))))
    s))

(defun ks--next-invisible-point ()
  "Return the next closest point with `invisible' property."
  (let ((s (point)))
    (while (and (not (= (point-max) (setq s (next-char-property-change s))))
                (ks--visible-p s)))
    s))

(defun ks--find-visible-regions (rbeg rend)
  "Return a list of all visible regions between RBEG and REND."
  (setq rbeg (max rbeg (point-min)))
  (setq rend (min rend (point-max)))
  (when (< rbeg rend)
    (let (visibles beg)
      (save-excursion
        (save-restriction
          (narrow-to-region rbeg rend)
          (setq beg (goto-char (point-min)))
          (while (not (= (point) (point-max)))
            (goto-char (ks--next-invisible-point))
            (push (cons beg (point)) visibles)
            (setq beg (goto-char (ks--next-visible-point))))
          (nreverse visibles))))))

(defun ks--regex-candidates (regex &optional beg end pred group)
  "Return all elements that match REGEX.
Each element of the list is ((BEG . END) . WND)
When PRED is non-nil, it's a filter for matching point positions.
When GROUP is non-nil, (BEG . END) should delimit that regex group."
  (setq group (or group 0))
  (let ((case-fold-search (or ks-case-fold-search
                              (string= regex (downcase regex))))
        candidates)
    (ks-dowindows current-prefix-arg
      (dolist (pair (ks--find-visible-regions
                     (or beg (window-start))
                     (or end (window-end (selected-window) t))))
        (save-excursion
          (goto-char (car pair))
          (while (re-search-forward regex (cdr pair) t)
            (when (ks--visible-p (1- (point)))
              (when (or (null pred)
                        (funcall pred))
                (push (cons
                       (if (numberp group)
                           (cons (match-beginning group)
                                 (match-end group))
                         (funcall group))
                       wnd) candidates)))))))
    (nreverse candidates)))

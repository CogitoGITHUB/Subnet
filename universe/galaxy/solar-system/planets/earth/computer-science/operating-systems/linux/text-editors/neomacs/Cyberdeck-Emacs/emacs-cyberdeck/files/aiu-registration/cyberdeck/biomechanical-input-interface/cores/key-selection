      ;; honored; the binding stays, warning suppressed.
      (with-no-warnings
        (let ((inhibit-point-motion-hooks t))
          (forward-line)))
      (setq line (1+ line)))
    (when (display-graphic-p)
      (setq width (ceiling
                   (/ (* width 1.0 (linum--face-width 'linum))
                      (frame-char-width)))))

(defun my/hl-read-face-name ()
  "Return the next available highlight face (or read one with a prefix arg)."
  (unless my/hl-unused-faces
    (setq my/hl-unused-faces my/hl-face-defaults))
  (let* ((defaults (append my/hl-unused-faces my/hl-face-defaults))
         (face (if current-prefix-arg
                   (intern (completing-read
                            (format-prompt "Highlight using face" (car defaults))
                            obarray 'facep t nil 'face-name-history
                            (mapcar #'symbol-name defaults)))
                 (car defaults))))
    (setq my/hl-unused-faces (remove face my/hl-unused-faces))
    (add-to-list 'my/hl-face-defaults face t)
    face))

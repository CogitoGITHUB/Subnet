(defun my/hl-add (regexp face &optional lighter case-fold spaces-regexp)
  "Highlight matches of REGEXP with FACE; LIGHTER is a human label.
CASE-FOLD ignores case; SPACES-REGEXP substitutes spaces in font-lock search.
Each highlight stores a keyword closure supporting both forward and backward
search, so it can be jumped between."
  (let ((id (list regexp case-fold spaces-regexp)))
    (let ((ix (cl-position id my/hl-patterns
                           :key (lambda (p) (plist-get (cdr p) :id))
                           :test #'equal)))
      (if ix
          (progn
            (setq my/hl-patterns
                  (cons (nth ix my/hl-patterns)
                        (append (cl-subseq my/hl-patterns 0 ix)
                                (cl-subseq my/hl-patterns (1+ ix)))))
            (nth 0 my/hl-patterns))
        (setq face (or face (my/hl-read-face-name)))
        (let ((kw (list (lambda (limit &optional backward)
                          (let ((case-fold-search case-fold)
                                (search-spaces-regexp spaces-regexp))
                            (if backward
                                (re-search-backward regexp limit t)
                              (re-search-forward regexp limit t))))
                        (list 0 (list 'quote face) 'prepend))))
          (let ((entry (list (or lighter regexp) :kw kw :face face :id id)))
            (push entry my/hl-patterns)
            (font-lock-add-keywords nil (list kw) t)
            (font-lock-flush)
            entry))))))

(defun my/qsearch (forward &optional pattern)
  "Search for the current highlight PATTERN in direction FORWARD.
Move point to the start of the match, wrapping around with feedback."
  (if-let* ((pattern (or pattern (my/hl-current-pattern))))
      (setq isearch-success
            (save-excursion
              (goto-char (if forward (1+ (point)) (1- (point))))
              (or (my/hl-search pattern (not forward))
                  (if isearch-success
                      (prog1 nil
                        (message "No more occurrences %s"
                                 (if forward "below" "above")))
                    (message "Wrapping around")
                    (goto-char (if forward (point-min) (point-max)))
                    (my/hl-search pattern (not forward))))))
    (error "Nothing to search: highlight something before using my/qsearch."))
  (when isearch-success (goto-char (match-beginning 0))))

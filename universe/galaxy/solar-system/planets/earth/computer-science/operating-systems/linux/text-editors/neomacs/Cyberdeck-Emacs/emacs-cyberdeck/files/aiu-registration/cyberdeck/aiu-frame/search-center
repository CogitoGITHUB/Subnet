(defun my/cyberdeck-search--pick-aius (prompt notes source)
  "Pick from NOTE objects with PROMPT under SOURCE contract."
  (let ((items (my/cyberdeck-search--aiu-items notes source)))
    (when items
      (let ((sel (consult--read items :prompt prompt :require-match t
                                :category 'cyberdeck-candidate
                                :annotate #'my/cyberdeck-search--annotate
                                :state (my/cyberdeck-search--preview-state))))
        (when sel (my/cyberdeck-search--visit-candidate sel))))))


(defvar-local my/cyberdeck-search--file-id-cache nil
  "Session cache: file path -> AIU id, for annotate enrichment.")

(defun my/cyberdeck-search--aiu-id-for-file (file)
  "AIU id for FILE, cached per search session."
  (unless my/cyberdeck-search--file-id-cache
    (setq my/cyberdeck-search--file-id-cache (make-hash-table :test 'equal)))
  (or (gethash file my/cyberdeck-search--file-id-cache)
      (let ((id (ignore-errors
                  (cyberdeck-aiu-id
                   (car (cyberdeck-db-query-by-file-path file))))))
        (when id (puthash file id my/cyberdeck-search--file-id-cache))
        id)))

(defun my/cyberdeck-search--schedule-for (id)
  "Schedule row plist for ID, or nil. Single indexed lookup."
  (when id
    (let ((row (car (ignore-errors
                       (emacsql (cyberdeck-db)
                         [:select [stage status next-rev] :from installation-schedule
                          :where (= aiu-id $s1)]
                         id)))))
      (when row
        (list :stage (nth 0 row) :status (nth 1 row) :due (nth 2 row))))))

(defun my/cyberdeck-search-candidate-from-aiu (note source)
  "Lift cyberdeck AIU object into a candidate from SOURCE."
  (let* ((id (cyberdeck-aiu-id note))
         (sched (my/cyberdeck-search--schedule-for id))
         (tags (ignore-errors (cyberdeck-aiu-tags note))))
    (my/cyberdeck-search--make-candidate
     :id id
     :title (or (cyberdeck-aiu-title note) id)
     :path (cyberdeck-aiu-path note)
     :source source
     :stage (plist-get sched :stage)
     :status (plist-get sched :status)
     :tags tags
     :due (plist-get sched :due)
     :note note)))

(defun my/cyberdeck-search--display-string (cand)
  "L0: display string for CAND, carrying the plist as text property.
The plist rides passenger — consult passes the string to annotate,
action, and state untouched."
  (propertize (or (plist-get cand :title) (plist-get cand :id) "?")
              'cyberdeck-candidate cand))

(defun my/cyberdeck-search--candidate-of (str)
  "Recover the plist from display string STR, or nil."
  (and (stringp str) (get-text-property 0 'cyberdeck-candidate str)))

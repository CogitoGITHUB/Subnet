(defun biomechanical-input-interface-new-leader (key title)
  "Create leaders/<KEY> from the leader skeleton.
KEY is the SPC sub-key (single char); TITLE is the menu title.
Errors loudly when the file already exists."
  (interactive "sLeader key (single char under SPC): \nsMenu title: ")
  (when (or (string-empty-p key) (string-empty-p title))
    (user-error "Leader key and title must not be empty"))
  (let* ((slug (downcase (replace-regexp-in-string "[^a-z0-9]+" "-" title)))
         (path (expand-file-name
                (format "leaders/%s" slug)
                (biomechanical-input-interface--module-dir))))
    (when (file-exists-p path)
      (user-error "Leader file exists: %s" path))
    (with-temp-file path
      (insert (format "#+title: Biomechanical Input Interface — %s Leader\n\n* %s Leader :EMACS_MECHANISM:\n:PROPERTIES:\n:ID:       %s\n:END:\n\n** %s menu\n#+begin_src emacs-lisp\n(my/defhydra-state my/%s-hydra nil \"%s\" (my/main-hydra/body \"main menu\")\n  \"Actions\"\n  ((\"<sub>\" <command> \"<desc>\" :exit t)))\n#+end_src\n"
                      title (capitalize title) (org-id-uuid) key slug title)))
    (find-file path)
    (message "Leader created: %s" path)))

(defun biomechanical-input-interface--module-dir ()
  "Absolute path of the biomechanical-input-interface/ module directory.
Derived from this file's own location; renames above it never break it."
  (file-name-directory
   (directory-file-name
    (file-name-directory (or load-file-name buffer-file-name
                             default-directory)))))

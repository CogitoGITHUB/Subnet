(defun biomechanical-input-interface-new-state (name)
  "Create states/<NAME>.org from the state skeleton.
Errors loudly when the file already exists."
  (interactive "sState name (lowercase, e.g. foreplay): ")
  (when (string-empty-p name)
    (user-error "State name must not be empty"))
  (let ((path (expand-file-name
               (format "states/%s" name)
               (biomechanical-input-interface--module-dir))))
    (when (file-exists-p path)
      (user-error "State file exists: %s" path))
    (with-temp-file path
      (insert (format "#+title: Biomechanical Input Interface — %s State\n\n* %s State :EMACS_MECHANISM:\n:PROPERTIES:\n:ID:       %s\n:END:\n\nKeys specific to the %s state. Shared bindings live in universal.org.\n** Bindings\n#+begin_src emacs-lisp\n(biomechanical-input-interface-define-keys\n  :states '(\"%s\")\n  :bind\n  `((\"<key>\" . <command>)))\n#+end_src\n\n** Owned functions\n"
                      (capitalize name) (capitalize name) (org-id-uuid) name name)))
    (find-file path)
    (message "State created: %s (add define-state + init routing, see header)" path)))
#+end_src


(defun my/cyberdeck-recipes--template-hash ()
  "SHA-256 of the current recipes template body, or \"unknown\"."
  (or (ignore-errors
        (let ((body (my/cyberdeck-recipes--template-body)))
          (unless (string= body "%?")
            (secure-hash 'sha256 body))))
      "unknown"))


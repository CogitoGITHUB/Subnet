(defun my/cyberdeck-recipe-create ()
  "Create a new recipe note under `my/cyberdeck-recipes-directory'.
Prompts for title, fast mode level, recipe-specific prompts (SERVINGS etc.), and
opens the `recipes' body template for editing."
  (interactive)
  (let* ((cyberdeck-create-default-function (lambda (_) '()))
         (root (expand-file-name "recipes/" (my/cyberdeck-root-dir)))
         (_ (make-directory root t))
         (title (read-string "Recipe title: "))
         (slug (my/cyberdeck-recipes--slugify title))
         (subdir (my/cyberdeck-choose-subdir
                  (expand-file-name "recipes/" (my/cyberdeck-root-dir))
                  "Subdirectory under recipes/: "))
         (fname (concat "recipes/" subdir slug))
         (fast (my/cyberdeck--fast-level))
         (prompts (my/cyberdeck-collect-prompts-with-fast '(recipe) nil fast))
         (tags (cons "recipe" (plist-get prompts :tags)))
         (recipe (my/cyberdeck--create-file-wrapper
                  title fname tags
                  (plist-get prompts :unfoldings)
                  (plist-get prompts :body))))
    (dolist (fn (plist-get prompts :post-apply))
      (funcall fn recipe))
    (my/cyberdeck-recipes--open-capture recipe)))

(defun my/cyberdeck-recipes--open-capture (recipe)
  (let* ((file (cyberdeck-aiu-path recipe))
         (body (my/cyberdeck-recipes--template-body)))
    (my/cyberdeck-recipes--store-template recipe)
    (let ((org-capture-templates
           `(("v" "Edit recipe body"
               plain
               (file+function
                ,file
                (lambda ()
                  (goto-char (point-max))
                  (skip-chars-backward " \t\n")))
               ,body
               :kill-buffer t
               :unnarrowed t)))
          (org-capture-use-indirect-buffer nil))
      (when-let* ((buf (get-file-buffer file)))
        (when (eq buf (current-buffer))
          (switch-to-buffer (other-buffer))))
      (org-capture nil "v"))))

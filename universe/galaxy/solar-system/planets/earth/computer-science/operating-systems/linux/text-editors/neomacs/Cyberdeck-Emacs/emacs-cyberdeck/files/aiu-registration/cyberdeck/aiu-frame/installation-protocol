*** Map-Ordered Review (Installation Protocol reads the map)
Foundations first: the due queue walks the AIU Subnet depth-first so
prerequisites grade before dependents and failures cascade visibly
instead of surfacing as downstream confusion. This is consumption,
not ownership — every position fact comes from aiu-subnet/* queries, and no
topology is stored or mutated here. Unmapped AIUs sink to the end
rather than blocking; headings follow their file card directly.
#+begin_src emacs-lisp
(defun my/cyberdeck-installation-protocol--map-sort-key (aiu-id)
  "Sort key for NOTE-ID: (depth order-key title).
Unmapped notes sort last (depth 9999). Headings inherit their file
card's depth and sort by their own order key right after it."
  (let ((row (and (fboundp 'aiu-subnet/node-at) (aiu-subnet/node-at aiu-id))))
    (if (null row)
        (list 9999 0.0 "")
      (let* ((depth (nth 4 row))
             (order (nth 2 row))
             (note (cyberdeck-db-get-by-id aiu-id))
             (title (if note (cyberdeck-aiu-title note) "")))
        (list depth order title)))))

(defun my/cyberdeck-installation-protocol--ordered-due-aiu-ids ()
  "Due AIU IDs in map order: parents before children, stable by title."
  (sort (my/cyberdeck-installation-protocol--due-aiu-ids)
        (lambda (a b)
          (let ((ka (my/cyberdeck-installation-protocol--map-sort-key a))
                (kb (my/cyberdeck-installation-protocol--map-sort-key b)))
            (or (< (nth 0 ka) (nth 0 kb))
                (and (= (nth 0 ka) (nth 0 kb))
                     (or (< (nth 1 ka) (nth 1 kb))
                         (and (= (nth 1 ka) (nth 1 kb))
                              (string< (nth 2 ka) (nth 2 kb))))))))))

(defun my/cyberdeck-installation-protocol-review-subtree ()
  "Review the due cards of the branch at point, in map order.
Resolves the current note's subtree (plus its headings), intersects
with today's due list, and runs the standard session over that set.
Reports \"branch clear\" with counts when nothing is due — an empty
branch is information, not an error."
  (interactive)
  (let* ((note (my/cyberdeck--buffer-aiu)))
    (unless note (user-error "No AIU at point"))
    (unless (fboundp 'aiu-subnet/subtree-of)
      (user-error "AIU Subnet engine not loaded"))
    (let* ((id (cyberdeck-aiu-id note))
           (branch (cons id (aiu-subnet/subtree-of id)))
           (headings (and (fboundp 'aiu-subnet/headings-of)
                          (mapcar #'car (aiu-subnet/headings-of id))))
           (scope (append branch headings))
           (due (my/cyberdeck-installation-protocol--due-aiu-ids))
           (ids (seq-filter (lambda (x) (member x scope)) due))
           (ordered (sort (copy-sequence ids)
                          (lambda (a b)
                            (let ((ka (my/cyberdeck-installation-protocol--map-sort-key a))
                                  (kb (my/cyberdeck-installation-protocol--map-sort-key b)))
                              (or (< (nth 0 ka) (nth 0 kb))
                                  (and (= (nth 0 ka) (nth 0 kb))
                                       (< (nth 1 ka) (nth 1 kb)))))))))
      (if (null ordered)
          (message "Branch clear: 0 of %d scoped cards due."
                   (length scope))
        (my/cyberdeck-installation-protocol--review-session ordered)))))

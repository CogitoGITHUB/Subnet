(defun my/cyberdeck-installation-protocol--write-schedule-aiu-contexts
    (aiu-id next-rev-int n success c-succ c-fails t-succ t-fails score)
  "Write schedule AIU Contexts for NOTE-ID back to its org drawer."
  (let ((note (cyberdeck-db-get-by-id aiu-id)))

(defun my/cyberdeck-installation-protocol--review-session (ids)
  "Review NOTE-IDS in sequence, grading with algorithm."
  (let ((buf (get-buffer-create "*cyberdeck-installation-protocol-review*"))
        (total (length ids))
        (reviewed 0)
        (t0 (cyberdeck-timer-stopwatch-start)))
    (with-current-buffer buf
      (special-mode)
      (setq buffer-read-only t))
    (pop-to-buffer-same-window buf)
    (catch 'installation-protocol--quit
      (dolist (id ids)
        (when (and my/cyberdeck-installation-protocol--timebox-seconds
                   (> (cyberdeck-timer-stopwatch-elapsed t0)
                      my/cyberdeck-installation-protocol--timebox-seconds))
          (message "Timebox reached — stopping cleanly.")
          (throw 'installation-protocol--quit nil))
        (let* ((note (cyberdeck-db-get-by-id id))
               (title (if note (cyberdeck-aiu-title note) id))
               (c0 (cyberdeck-timer-stopwatch-start)))
          (my/cyberdeck-installation-protocol--display-aiu id)
          (message "[%d/%d] %s" (1+ reviewed) total title)
          (let ((action (my/cyberdeck-installation-protocol--grade-prompt id)))
            (message "[%d/%d] %s (%s/card)"
                     (1+ reviewed) total title
                     (cyberdeck-timer-format-seconds
                      (cyberdeck-timer-stopwatch-elapsed c0)))
            (cond
             ((eq action 'quit) (throw 'installation-protocol--quit nil))
             ((eq action 'suspend)
              (my/cyberdeck-installation-protocol--set-suspend id 1))
             ((eq action 'open)
              (when note
                (find-file (cyberdeck-aiu-path note))
                (let ((inhibit-read-only t))
                  (with-current-buffer buf (erase-buffer)))
                (when (y-or-n-p "Grade this AIU? ")
                  (catch 'inline-graded
                    (while t
                      (pcase (read-char-choice "n=next f=fail s=suspend t=type q=quit: "
                                               '(?n ?f ?s ?t ?q))
                        (?n (my/cyberdeck-installation-protocol--apply-grade id t)
                            (throw 'inline-graded nil))
                        (?f (my/cyberdeck-installation-protocol--apply-grade id nil)
                            (throw 'inline-graded nil))
                        (?s (my/cyberdeck-installation-protocol--set-suspend id 1)
                            (throw 'inline-graded nil))
                        (?t (my/cyberdeck-installation-protocol--type-drill-for id)
                            (message "Drill launched — grade when ready."))
                        (?q (throw 'inline-graded nil)))))))))))
        (cl-incf reviewed)))
    (let ((elapsed (cyberdeck-timer-stopwatch-elapsed t0)))
      (message "Reviewed %d/%d in %s%s" reviewed total
               (cyberdeck-timer-format-seconds elapsed)
               (if (> reviewed 0)
                   (format " (avg %s/card)"
                           (cyberdeck-timer-format-seconds (/ elapsed reviewed)))
                 "")))
    (kill-buffer buf)))

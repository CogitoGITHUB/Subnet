(defun my/cyberdeck-installation-protocol-mark-review (arg)
  "Mark current note reviewed; with prefix, mark as failed.
Enrolls the note first when it has no schedule row (birth state
AWARE+ACTIVE), so grading never meets an unenrolled card."
  (interactive "P")
  (let ((note (my/cyberdeck--buffer-aiu)))
    (unless note (user-error "No AIU at point"))
    (let ((id (cyberdeck-aiu-id note)))
      (unless (car (emacsql (cyberdeck-db)
                    [:select [aiu-id] :from installation-schedule
                     :where (= aiu-id $s1)] id))
        (my/cyberdeck-installation-protocol--init-schedule nil note))
      (my/cyberdeck-installation-protocol--update id (not arg)
       (my/cyberdeck-installation-protocol--review-algorithm id (not arg)))
      (message "AIU marked %s." (if arg "failed" "reviewed")))))

(defun my/cyberdeck-installation-protocol-toggle-participation ()
  "Flip current note between ACTIVE and SUSPENDED.
The schedule row and the stage survive both directions — this is a
pause button, not an exit. Resuming restores exactly where the
knowledge left off."
  (interactive)
  (let ((note (my/cyberdeck--buffer-aiu)))
    (unless note (user-error "No AIU at point"))
    (let* ((id (cyberdeck-aiu-id note))
           (row (car (emacsql (cyberdeck-db)
                      [:select [suspend] :from installation-schedule
                       :where (= aiu-id $s1)] id))))
      (unless row
        (my/cyberdeck-installation-protocol--init-schedule nil note)
        (setq row '(0)))
      (my/cyberdeck-installation-protocol--set-suspend id (zerop (car row))))))

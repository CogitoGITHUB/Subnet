(defun my/cyberdeck-installation-protocol--review-algorithm (aiu-id success)
  "Compute (NEXT-REV MASTERING-SCORE LOG-ALIST) for reviewing NOTE-ID with SUCCESS."
  (let* ((row (car (emacsql (cyberdeck-db)
                   [:select [t-success c-success c-fails last-rev next-rev
                             n t-fails plus minus synolon]
                    :from installation-schedule :where (= aiu-id $s1)]
                   aiu-id)))
         (t-success (nth 0 row))
         (c-success (nth 1 row))
         (c-fails (nth 2 row))
         (last-interval (my/cyberdeck-installation-protocol--date-diff
                         (my/cyberdeck-installation-protocol--int-to-date (nth 3 row))))
         (existing-next-rev (my/cyberdeck-installation-protocol--int-to-date (nth 4 row)))
         (n (nth 5 row))
         (t-fails (nth 6 row))
         (mastering (list (nth 7 row) (nth 8 row) (nth 9 row)))
         (computed-next-rev (my/cyberdeck-installation-protocol--next-interval
                             :last-interval last-interval
                             :installation-protocol--synolon (nth 2 mastering)
                             :success success
                             :successful-reviews t-success
                             :c-fails c-fails
                             :lethe my/cyberdeck-installation-protocol--lethe
                             :amnesia my/cyberdeck-installation-protocol--amnesia
                             :proto my/cyberdeck-installation-protocol--proto))
         (next-rev (if (and success
                            (my/cyberdeck-installation-protocol--date-later-p
                             existing-next-rev computed-next-rev))
                       existing-next-rev
                     computed-next-rev)))
    (list next-rev
          (my/cyberdeck-installation-protocol--next-installation-protocol
           :mastering mastering :success success
           :epignosis my/cyberdeck-installation-protocol--epignosis
           :agnoia my/cyberdeck-installation-protocol--agnoia
           :anagnosis my/cyberdeck-installation-protocol--anagnosis
           :c-successes (if success (1+ c-success) 0)
           :c-failures (if success 0 (1+ c-fails))
           :lethe my/cyberdeck-installation-protocol--lethe)
          `((n . ,n) (c-success . ,c-success) (c-fails . ,c-fails)
            (t-success . ,t-success) (t-fails . ,t-fails)))))



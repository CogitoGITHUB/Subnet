*** Restore command
Searches history for the commit carrying the AIU's :ID:, restores
it plus its orphaned AIU Contexts, then cleans up the queue entries.
#+begin_src emacs-lisp
(defun my/cyberdeck-links-restore ()
  "Restore a deleted AIU from Git history."
  (interactive)
  (let ((deleted-id (org-entry-get (point) "DELETED_ID")))
    (unless deleted-id
      (user-error "No DELETED_ID found at point. Place cursor on a broken link TODO entry"))
    (let ((deleted-aiu (org-entry-get (point) "DELETED_NOTE")))
      (message "Searching Git history for %s..." deleted-aiu)
      (let ((default-directory (my/cyberdeck-root-dir))
            (commits (my/cyberdeck-links--git-find-commits-for-id deleted-id))
            (id-re (format "^:ID:[ \t]+%s" (regexp-quote deleted-id)))
            restore-info)
        (unless commits
          (user-error "Could not find %s in Git history. Was it ever committed?" deleted-aiu))
        (dolist (commit commits)
          (let ((files (magit-git-lines "show" "--name-only" "--format=" commit)))
            (catch 'found
              (dolist (f files)
                (let ((content (string-join
                                (magit-git-lines "show" (format "%s:%s" commit f))
                                "\n")))
                  (when (string-match-p id-re content)
                    (setq restore-info (cons f commit))
                    (throw 'found t)))))))
        (unless restore-info
          (user-error "Could not identify file for %s in Git history"
                      deleted-aiu))
        (let ((target-file (car restore-info))
              (restore-rev (cdr restore-info)))
          (if (my/cyberdeck-links--git-restore-file restore-rev target-file)
              (progn
                (let ((unfoldings (my/cyberdeck-links--deleted-aiu-contexts-for-id deleted-id)))
                  (when unfoldings
                    (my/cyberdeck-links--restore-aiu-contexts unfoldings restore-rev)))
                (org-mark-subtree)
                (delete-region (region-beginning) (region-end))
                (my/cyberdeck-links--remove-deleted-entry target-file deleted-id)
                (let ((after-save-hook nil))
                  (save-buffer))
                (my/cyberdeck-links--cleanup-empty-admin-files)
                (message "Restored %s from %s. AIU Cyberdeck will re-index via fswatch."
                         target-file restore-rev)
                (when (y-or-n-p (format "Open restored file %s? " target-file))
                  (find-file (expand-file-name target-file (my/cyberdeck-root-dir)))))
            (user-error "Git restore failed for %s" target-file)))))))

(defun my/cyberdeck-git--do-auto-commit (file &optional root)
  "Run git add, commit, and push for FILE in ROOT's repo.
ROOT defaults to FILE's watched root. The vault keeps the historical
add --all catch-all; the config tree scopes `git add' to files saved
since the last commit so unrelated dotfiles never get swept in."
  (let* ((root (or root
                   (my/cyberdeck-git--root-for file)
                   (my/cyberdeck-root-dir)))
         (default-directory (my/cyberdeck-git--repo-top root))
         (rel (file-relative-name file root)))
    (condition-case err
        (progn
          (if (string= root (my/cyberdeck-root-dir))
              (call-process magit-git-executable nil nil nil "add" "--all")
            (let ((pending (cdr (assoc root
                                       my/cyberdeck-git--pending-files))))
              (setf (alist-get root my/cyberdeck-git--pending-files
                               nil nil #'string=)
                    nil)
              (apply #'call-process magit-git-executable nil nil nil
                     "add" "--" (or pending (list file)))))
          (if (= 0 (call-process magit-git-executable nil nil nil "diff" "--cached" "--quiet"))
              nil
            (if (= 0 (call-process magit-git-executable nil nil nil "commit" "-m"
                                     (format "auto: %s [%s]"
                                             rel
                                             (format-time-string "%H:%M:%S"))))
                (if my/cyberdeck-git--pushing
                    (setq my/cyberdeck-git--pending t)
                  (my/cyberdeck-git--push file root))
              (message "Git commit failed for %s" rel))))
      (error
        (message "Git auto-commit error: %s" (error-message-string err))))))

(defun my/cyberdeck-git--tracked-p (file)
  "Return t if FILE is tracked by git in the AIUs repo."
  (= 0 (call-process magit-git-executable nil nil nil
                     "-C" (my/cyberdeck-root-dir)
                     "ls-files" "--error-unmatch" file)))

(defun my/cyberdeck-git--check-delete (file)
  "Warn if FILE is in AIUs dir and not git-tracked."
  (when (and file
             (file-in-directory-p file (my/cyberdeck-root-dir))
             (not (my/cyberdeck-git--tracked-p file)))
    (unless (y-or-n-p (format "\"%s\" is NOT tracked by git -- delete anyway? "
                              (file-name-nondirectory file)))
      (user-error "Delete cancelled"))))

(defun my/cyberdeck-git--before-dired-delete ()
  "Check each marked dired file in AIUs dir is git-tracked."
  (dolist (f (dired-get-marked-files))
    (my/cyberdeck-git--check-delete f)))

(add-hook 'dired-before-delete-hook #'my/cyberdeck-git--before-dired-delete)

*** Auto-Commit on Any Mutation
Every write/delete/rename touching a watched tree (vault AIUs dir,
cyberdeck config dir) schedules a debounced add+commit+push in its repo.
#+begin_src emacs-lisp
(defun my/cyberdeck-git--root-for (file)
  "Return the watched root containing FILE, or nil (.git dirs excluded)."
  (let ((f (expand-file-name file)))
    (cl-find-if (lambda (root)
                  (and (file-in-directory-p f root)
                       (not (file-in-directory-p
                             f (expand-file-name ".git" root)))))
                (list (my/cyberdeck-root-dir)
                      my/cyberdeck-git--config-root))))

(defun my/cyberdeck-git-auto-commit (&optional file)
  "After save in a watched tree: defer git add, commit, and push.
FILE defaults to `buffer-file-name'. Per-repo timers so rapid writes
in both trees commit independently."
  (let ((f (or file (buffer-file-name))))
    (when-let* ((root (and f (my/cyberdeck-git--root-for f))))
      (unless (string= root (my/cyberdeck-root-dir))
        (let ((cell (assoc root my/cyberdeck-git--pending-files)))
          (if cell (cl-pushnew f (cdr cell) :test #'string=)
            (push (cons root (list f)) my/cyberdeck-git--pending-files))))
      (let ((cell (assoc root my/cyberdeck-git--save-timers)))
        (when (cdr cell)
          (cancel-timer (cdr cell)))
        (if cell
            (setcdr cell (run-with-idle-timer
                          2 nil #'my/cyberdeck-git--do-auto-commit
                          f root))
          (push (cons root (run-with-idle-timer
                            2 nil #'my/cyberdeck-git--do-auto-commit
                            f root))
                my/cyberdeck-git--save-timers))))))

(defun my/cyberdeck-git--in-aius-p (path)
  "Return non-nil when PATH is inside the AIUs directory (not its .git)."
  (and (stringp path)
       (not (string-empty-p path))
       (let ((f (expand-file-name path)))
         (and (file-in-directory-p f (my/cyberdeck-root-dir))
              (not (file-in-directory-p f (expand-file-name ".git" (my/cyberdeck-root-dir))))))))

(defun my/cyberdeck-git--after-write (_start _end file &rest _)
  "Advice for `write-region': schedule a git commit after any watched write."
  (when (my/cyberdeck-git--root-for file)
    (my/cyberdeck-git-auto-commit file)))

(defun my/cyberdeck-git--after-delete (file &rest _)
  "Advice for `delete-file'/`delete-directory': commit watched deletion."
  (when (my/cyberdeck-git--root-for file)
    (my/cyberdeck-git-auto-commit file)))
(defun my/cyberdeck-git--after-rename (file to &optional _ok-if-already-exists)
  "Advice for `rename-file': commit renames inside watched trees."
  (let
      ((from (expand-file-name file))
       (to (expand-file-name to)))
    (when (or (my/cyberdeck-git--root-for from)
              (my/cyberdeck-git--root-for to))
      (my/cyberdeck-git-auto-commit to))))

(advice-add 'write-region :after (function my/cyberdeck-git--after-write))
(advice-add 'delete-file :after (function my/cyberdeck-git--after-delete))
(advice-add 'delete-directory :after (function my/cyberdeck-git--after-delete))
(advice-add 'rename-file :after (function my/cyberdeck-git--after-rename))

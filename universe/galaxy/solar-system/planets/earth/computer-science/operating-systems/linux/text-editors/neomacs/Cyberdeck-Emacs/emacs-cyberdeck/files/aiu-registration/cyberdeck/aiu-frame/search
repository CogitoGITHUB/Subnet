(defun cyberdeck-search-todo--dir-files (dir)
  "Return AIU files under DIR, skipping `cyberdeck-search-todo--skip-dirs'."
  (cl-remove-if
   (lambda (file)
     (or (cl-some (lambda (sub)
                    (string-match-p (concat "\\(?:^\\|/\\)" (regexp-quote sub) "/")
                                    (file-relative-name file dir)))
                  cyberdeck-search-todo--skip-dirs)
         (unless (or (null (file-name-extension file))
                     (string-match-p "\\.org\\'" file))
           file)))
   (directory-files-recursively dir "^[^.]" nil nil)))



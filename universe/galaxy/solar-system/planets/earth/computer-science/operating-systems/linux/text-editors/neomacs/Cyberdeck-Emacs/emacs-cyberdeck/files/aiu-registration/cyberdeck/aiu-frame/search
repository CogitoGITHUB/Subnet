(defun cyberdeck-search-todo--parse-file (file)
  "Return list of hl-todo matches in FILE."
  (with-temp-buffer
    (insert-file-contents file)
    (goto-char (point-min))
    (let (found)
      (while (re-search-forward (hl-todo--regexp) nil t)
        (push
         (let ((type (or (match-string-no-properties 2)
                         (save-excursion
                           (backward-to-word)
                           (substring-no-properties
                            (save-match-data
                              (thing-at-point 'word)))))))
           (list (file-name-nondirectory file)
                 (number-to-string (line-number-at-pos))
                 type
                 (list file (1- (line-number-at-pos)) 0)
                 (car (or (rassoc type (cyberdeck-search-todo--narrow))
                          cyberdeck-search-todo-other))
                 (string-trim (buffer-substring-no-properties
                               (point)
                               (line-end-position)))))
         found))
      (nreverse found))))



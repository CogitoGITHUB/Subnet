Per-file sync state plus snapshot-guarded orphan pruning.  The rule:
never delete index rows for files a scan may simply not have reached
yet — prune only against the file set of the last COMPLETED scan
generation.  Complements (never replaces) the existing autosync and
prune-orphans paths.  Nothing here runs at load.

** Sync state table
#+begin_src emacs-lisp
(require 'cl-lib)

(defun my/cyberdeck-sync-ensure-table ()
  "Create the sync_state table if absent."
  (let ((db (ignore-errors (cyberdeck-db))))
    (when db
      (ignore-errors
        (emacsql db [:create :table :if :not :exists sync_state
                     ([(file :primary-key) (hash) (mtime) (generation)])])))))

(defun my/cyberdeck-sync-record (file hash mtime generation)
  "Record FILE's sync state for GENERATION.  Never throws."
  (condition-case nil
      (let ((db (ignore-errors (cyberdeck-db))))
        (when db
          (my/cyberdeck-sync-ensure-table)
          (emacsql db [:insert :or :replace :into sync_state
                       :values $v1]
                   (vector file hash mtime generation))))
    (error nil)))

(defun my/cyberdeck-sync-known (file)
  "Stored (HASH MTIME GENERATION) for FILE, or nil."
  (condition-case nil
      (let ((db (ignore-errors (cyberdeck-db))))
        (when db
          (my/cyberdeck-sync-ensure-table)
          (let ((row (car (emacsql db [:select [hash mtime generation]
                                       :from sync_state :where (= file $s1)]
                                   file))))
            (when row (append row nil)))))
    (error nil)))
#+end_src

** Guarded prune
#+begin_src emacs-lisp
(defvar my/cyberdeck-sync-generation 0
  "Current scan generation; bumped by `my/cyberdeck-sync-begin'.")

(defvar my/cyberdeck-sync-last-complete nil
  "Generation of the last fully completed scan, or nil.")

(defun my/cyberdeck-sync-begin ()
  "Start a scan generation; returns its id."
  (setq my/cyberdeck-sync-generation (1+ my/cyberdeck-sync-generation)))

(defun my/cyberdeck-sync-complete (generation)
  "Mark GENERATION complete (only moves forward)."
  (when (and (integerp generation)
             (or (null my/cyberdeck-sync-last-complete)
                 (> generation my/cyberdeck-sync-last-complete)))
    (setq my/cyberdeck-sync-last-complete generation)))

(defun my/cyberdeck-sync-guarded-prune (present-ids)
  "Delete note rows whose ids are absent from PRESENT-IDS, but ONLY when
a completed generation exists (proof a full scan finished).  Returns
rows deleted.  Without a completed generation this is a safe no-op."
  (if (null my/cyberdeck-sync-last-complete)
      0
    (condition-case nil
        (let ((db (ignore-errors (cyberdeck-db)))
              (deleted 0))
          (when db
            (dolist (row (emacsql db [:select [id] :from notes]))
              (unless (member (car row) present-ids)
                (emacsql db [:delete :from notes :where (= id $s1)] (car row))
                (setq deleted (1+ deleted)))))
          deleted)
      (error 0))))
#+end_src

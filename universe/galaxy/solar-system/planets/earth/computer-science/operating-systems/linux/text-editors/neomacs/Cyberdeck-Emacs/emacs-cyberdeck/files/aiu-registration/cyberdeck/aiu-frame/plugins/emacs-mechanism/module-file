(defun my/cyberdeck-emacs-mechanism--ensure-table ()
  "Create the emacs_mechanism_modules table if it does not exist."
  (emacsql (cyberdeck-db)
    [:create :table :if :not :exists emacs_mechanism_modules
     ([(aiu-id :not-null)
       (package :null)]
      (:primary-key [aiu-id])
      (:foreign-key [aiu-id] :references notes [id]
       :on-delete :cascade))]))

(defun my/cyberdeck-emacs-mechanism--extract (_ctx aiu-data)
  "Index PACKAGE AIU Context of mechanism module AIUs."
  (let* ((aiu-id (plist-get aiu-data :id))
         (tags (plist-get aiu-data :tags))
         (unfoldings (plist-get aiu-data :unfoldings)))
    (when (member "emacs-mechanism" tags)
      (emacsql (cyberdeck-db)
        [:delete :from emacs_mechanism_modules :where (= aiu-id $s1)]
        aiu-id)
      (emacsql (cyberdeck-db)
        [:insert :into emacs_mechanism_modules :values $v1]
        (vector aiu-id (cdr (assoc "PACKAGE" unfoldings)))))
    aiu-data))
#+end_src


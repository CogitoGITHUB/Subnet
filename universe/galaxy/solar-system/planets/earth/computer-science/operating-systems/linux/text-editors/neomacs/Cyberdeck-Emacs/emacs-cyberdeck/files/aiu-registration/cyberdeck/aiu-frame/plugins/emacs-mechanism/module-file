(defun my/cyberdeck-emacs-mechanism-module-create (package)
  "Create a loadable mechanism module for PACKAGE under modules/."
  (interactive (list (read-string "Package name: ")))
  (unless (boundp 'cyberdeck-emacs-org-directory)
    (user-error "Loader modules dir unknown (boot first)"))
  (let* ((recipe (read-string "Straight recipe: "
                   (format "(%s :type git :host github :repo \"\")" package)))
         (category (read-string "Category: "))
         (slug (downcase (replace-regexp-in-string "[^a-z0-9]+" "-" package)))
         (abs (expand-file-name slug cyberdeck-emacs-org-directory))
         (rel (file-relative-name abs (my/cyberdeck-root-dir)))
         (body (my/cyberdeck-emacs-mechanism--module-body package))
         (note (cyberdeck-create package rel
                 :tags '("emacs-mechanism") :body body)))
    (with-current-buffer (find-file-noselect
                          (cyberdeck-aiu-path note))
      (goto-char (point-min))
      (when (re-search-forward "^\\*+ " nil t)
        (org-set-property "PACKAGE" package)
        (org-set-property "STRAIGHT" recipe)
        (org-set-property "CATEGORY" category))
      (save-buffer))
    (my/cyberdeck-emacs-mechanism--store-template
     note "emacs-mechanism-module")
    (my/cyberdeck-emacs-mechanism--ensure-headline-tag note)
    (when (fboundp 'cyberdeck-db-update-file)
      (cyberdeck-db-update-file
       (cyberdeck-aiu-path note)))
    note))
#+end_src

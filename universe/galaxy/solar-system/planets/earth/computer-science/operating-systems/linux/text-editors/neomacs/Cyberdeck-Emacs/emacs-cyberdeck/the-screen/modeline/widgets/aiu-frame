A when the cyberdeck DB is reachable, C appended while clocking. Cached
on a minute timer plus after-save (never a syscall per render).
#+begin_src emacs-lisp
(defvar manifolding-modeline--cyberdeck-cache "A")

(defun manifolding-modeline--cyberdeck-refresh ()
  "Recompute the cached cyberdeck letters."
  (setq manifolding-modeline--cyberdeck-cache
        (condition-case nil
            (concat
             (if (and (boundp 'cyberdeck-db-location)
                      (stringp cyberdeck-db-location)
                      (file-exists-p cyberdeck-db-location))
                 "A"
               (propertize "A" 'face 'manifolding-modeline-error-face))
             (if (and (fboundp 'org-clocking-p) (org-clocking-p))
                 (propertize "C" 'face 'manifolding-modeline-ok-face)
               ""))
          (error "A")))
  nil)

(defvar manifolding-modeline--cyberdeck-timer nil)

(unless (timerp manifolding-modeline--cyberdeck-timer)
  (setq manifolding-modeline--cyberdeck-timer
        (run-with-timer 0 60 #'manifolding-modeline--cyberdeck-refresh)))

(unless (member #'manifolding-modeline--cyberdeck-refresh after-save-hook)
  (add-hook 'after-save-hook #'manifolding-modeline--cyberdeck-refresh))

(manifolding-modeline--cyberdeck-refresh)

(manifolding-modeline-define-segment aiu-frame
  manifolding-modeline--cyberdeck-cache)
#+end_src

(defun my/cyberdeck-aiu-context-files ()
  "All files holding :AIU_CONTEXT_DRAWER: KEY headings, absolute."
  (mapcar #'cdr (my/cyberdeck-aiu-context-key-files)))

(defvar my/cyberdeck--pending-aiu-context-register nil
  "AIU Context path to register when the current capture finalizes.")

(defun my/cyberdeck-aiu-context-add (title)
  "Create a new prompt aiu-context for TITLE beside existing aiu-contexts.
Derives KEY (upper, underscores), errors loudly on empty KEY or
existing KEY. Registers the prompt when the capture finalizes."
  (interactive (list (read-string "AIU Context title: ")))
  (let* ((key (replace-regexp-in-string
               "_+$" ""
               (replace-regexp-in-string "[^A-Z0-9]+" "_" (upcase title)))))
    (when (string-empty-p key)
      (user-error "Title yields empty KEY — use letters/digits"))
    (when (my/cyberdeck-aiu-context-file-for key)
      (user-error "AIU Context exists for KEY: %s" key))
    (let* ((anchor (car (my/cyberdeck-aiu-context-key-files)))
           (dir (if anchor (file-name-directory (cdr anchor))
                  (expand-file-name "~")))
           (path (expand-file-name (downcase key) dir)))
      (when (file-exists-p path)
        (user-error "AIU Context exists: %s" path))
      (make-directory dir t)
      ;; let*: the template below splices `id', so it must see the
      ;; sibling binding (plain let evaluates inits outside, leaving
      ;; a free-variable read). The org-capture vars are special
      ;; (defvar'd by org), so they stay dynamically bound for the
      ;; capture call either way.
      (let* ((id (org-id-new))
             (org-capture-templates
             `(("b" "AIU Context prompt" plain (file ,path)
                 ,(format "* %s :unfolding:file:heading:task:AIU_CONTEXT_DRAWER:\n:PROPERTIES:\n:ID: %s\n:END:\n** First option :AIU_CONTEXT_BODY:\n%%?"
                          key id)
                :unnarrowed t :empty-lines 1 :kill-buffer t)))
            (org-capture-use-indirect-buffer nil)
            (org-capture-window-setup 'other-window))
        (setq my/cyberdeck--pending-aiu-context-register path)
        (org-capture nil "b")))))

(defun my/cyberdeck--register-pending-aiu-context ()
  "Register the pending new aiu-context file, if it was saved."
  (when-let* ((p my/cyberdeck--pending-aiu-context-register))
    (setq my/cyberdeck--pending-aiu-context-register nil)
    (when (file-exists-p p)
      (my/cyberdeck-org-prompt--register-file p nil)
      (message "AIU Context registered: %s" (file-name-nondirectory p)))))

(add-hook 'org-capture-after-finalize-hook
          #'my/cyberdeck--register-pending-aiu-context)

(defun my/cyberdeck-aiu-context-edit (file)
  "Open aiu-context FILE for free editing."
  (interactive
   (list (completing-read "Edit aiu-context: "
                          (my/cyberdeck-aiu-context-files) nil t)))
  (find-file file))

(defun my/cyberdeck-aiu-context--key-references (key file)
  "Return report lines for references to aiu-context KEY (defined in FILE)."
  (let* ((key-sym (intern (downcase key)))
         (report nil))
    (when (gethash key-sym my/cyberdeck-org-prompt--specs)
      (push (format "registered prompt: %s" key-sym) report))
    (when (member key-sym (mapcar (lambda (e) (plist-get e :name))
                                  my/cyberdeck-prompt-registry))
      (push "prompt-registry entry" report))
    (let ((found (if (executable-find "rg")
                     (ignore-errors
                       (split-string
                        (shell-command-to-string
                         (format "rg -l -F %s %s 2>/dev/null"
                                 (shell-quote-argument key)
                                 (shell-quote-argument
                                  cyberdeck-emacs-org-directory)))
                        "\n" t))
                   nil)))
      (dolist (f (seq-remove (lambda (p) (string= (expand-file-name p) (expand-file-name file)))
                             (or found nil)))
        (push (format "code ref: %s" (file-relative-name f cyberdeck-emacs-org-directory)) report)))
    (let ((famdir (expand-file-name (concat "admin/unfoldings/" (downcase key) "/")
                                    (my/cyberdeck-root-dir))))
      (when (file-directory-p famdir)
        (push (format "vault data: %s (%d AIUs)"
                      famdir (length (directory-files famdir nil "^[^.]")))
              report)))
    (nreverse report)))

(defun my/cyberdeck-aiu-context-remove (file)
  "Delete aiu-context FILE after a reference check + single confirm.
Also deletes orphaned vault data dir on the same confirm."
  (interactive
   (list (completing-read "Remove aiu-context: "
                          (my/cyberdeck-aiu-context-files) nil t)))
  (let* ((key (with-temp-buffer
                (insert-file-contents file)
                (goto-char (point-min))
                (if (re-search-forward "^\\* \\([A-Z][A-Z0-9_]*\\)\\([ \t]+:[A-Za-z0-9_:@]+:\\)?[ \t]*$" nil t)
                    (match-string 1)
                  (user-error "No KEY heading in %s" file))))
         (key-sym (intern (downcase key)))
         (report (my/cyberdeck-aiu-context--key-references key file))
         (famdir (expand-file-name (concat "admin/unfoldings/" (downcase key) "/")
                                   (my/cyberdeck-root-dir)))
         (famcount (if (file-directory-p famdir)
                       (length (directory-files famdir nil "^[^.]"))
                     0)))
    (when (y-or-n-p
           (format "Delete %s?%s%s "
                   (file-name-nondirectory file)
                   (if report (format "\nRefs:\n- %s" (string-join report "\n- ")) "")
                   (if (> famcount 0)
                       (format "\nPlus %d vault AIU(s) in %s" famcount famdir)
                     "")))
      (when (and (> famcount 0) (file-directory-p famdir))
        (delete-directory famdir t))
      (delete-file file)
      (remhash key-sym my/cyberdeck-org-prompt--specs)
      (setq my/cyberdeck-prompt-registry
            (cl-remove-if (lambda (e) (eq (plist-get e :name) key-sym))
                          my/cyberdeck-prompt-registry))
      (when (boundp 'my/cyberdeck-org-prompt--declarative)
        (remhash key-sym my/cyberdeck-org-prompt--declarative))
      (let ((alias (intern (concat "my/cyberdeck-prompt-"
                                   (symbol-name key-sym)))))
        (when (fboundp alias) (fmakunbound alias)))
      (message "AIU Context removed: %s" (file-name-nondirectory file)))))

            my/cyberdeck--pending-open-origin nil
            my/cyberdeck--pending-open-aiu nil
            my/cyberdeck--last-created-file f)
      (message "Capture ended without finalize for %s — M-x my/cyberdeck-open-offer-last for the open menu"
               (file-name-nondirectory f)))))

(add-hook 'post-command-hook #'my/cyberdeck--open-offer-watchdog)

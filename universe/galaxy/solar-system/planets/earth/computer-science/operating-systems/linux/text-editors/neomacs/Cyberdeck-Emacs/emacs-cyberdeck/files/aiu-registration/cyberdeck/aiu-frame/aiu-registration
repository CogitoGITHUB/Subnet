(defvar my/cyberdeck-org-prompt--boot-timer nil)
(defvar my/cyberdeck--reconcile-boot-timer nil)
(defvar my/cyberdeck--reconcile-boot-attempts 0)

(defun my/cyberdeck--reconcile-boot-maybe ()
  "Run boot reconcile once restoration.org is loaded, else retry.
The 0.05s boot timer can fire before later files load
(restoration comes later in aiu-subnet order); a one-shot skip then loses the
reconcile for the whole session. Retry every 5s, bounded (~5 min)."
  (setq my/cyberdeck--reconcile-boot-timer nil)
  (cond
   ((fboundp 'my/cyberdeck-links--reconcile-on-boot)
    (condition-case err
        (let ((t0 (float-time))
              (rc (my/cyberdeck-links--reconcile-on-boot)))
          (message "known-keys: reconcile done in %.2fs (+%d -%d)"
                   (- (float-time) t0)
                   (length (car rc)) (length (cdr rc))))
      (error (lwarn 'cyberdeck-org-prompts :error
                    "reconcile failed: %s" err))))
   ((< (cl-incf my/cyberdeck--reconcile-boot-attempts) 60)
    (setq my/cyberdeck--reconcile-boot-timer
          (run-with-timer 5 nil #'my/cyberdeck--reconcile-boot-maybe)))
   (t (message "known-keys: reconcile unavailable, skipping"))))

;; No with-eval-after-load gate: 'cyberdeck is never provided, so
;; that wrapper could never fire. This code already lives inside
;; aiu-registration.org, which the loader compiles regardless.
(when my/cyberdeck-org-prompt--boot-timer
  (cancel-timer my/cyberdeck-org-prompt--boot-timer))
(when my/cyberdeck--reconcile-boot-timer
  (cancel-timer my/cyberdeck--reconcile-boot-timer))
(setq my/cyberdeck--reconcile-boot-attempts 0)
(defun my/cyberdeck--boot-register-and-reconcile ()
  "Register prompts, reconcile, prune orphans.  Runs once post-compile."
  (condition-case err
      (let ((n (my/cyberdeck-org-prompt--register-all)))
        (message "org-prompts: registered %d declarative prompts, %d templates"
                 n (length my/cyberdeck-template-registry))
        (my/cyberdeck--reconcile-boot-maybe)
        ;; Orphan rows die here, synchronously, same boot pass —
        ;; no timers: files already settled, engine loaded.
        (when (fboundp 'my/cyberdeck-db--prune-orphans)
          (my/cyberdeck-db--prune-orphans))
        (when (= n 0)
          (lwarn 'cyberdeck-org-prompts
                 :warning "registered 0 declarative prompts")))
    (error (lwarn 'cyberdeck-org-prompts :error
                  "registration failed: %s" err))))
(setq my/cyberdeck-org-prompt--boot-timer
      ;; During a fresh boot a 0.05s timer fires MID-COMPILE, when most
      ;; units the registration needs are not loaded yet.  After compile
      ;; (after-init), run at once; on reload (units loaded), keep 0.05s.
      (if (and (boundp 'cyberdeck-emacs--booting)
               cyberdeck-emacs--booting)
          (progn (add-hook 'after-init-hook
                           #'my/cyberdeck--boot-register-and-reconcile)
                 nil)
        (run-with-timer
         0.05 nil
         #'my/cyberdeck--boot-register-and-reconcile)))

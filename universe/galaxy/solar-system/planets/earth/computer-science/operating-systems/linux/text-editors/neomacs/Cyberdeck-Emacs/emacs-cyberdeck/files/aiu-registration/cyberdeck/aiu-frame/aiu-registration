         (subdir (my/cyberdeck-prompt-subdir))
         (default-aiu-contexts (my/cyberdeck--first-option-defaults 'file))
         (note (cyberdeck-create title (concat subdir fname)
                           :unfoldings default-aiu-contexts))
          (file-path (cyberdeck-aiu-path note)))
      ;; 2b. AIU Subnet ownership: map first, then placement (forced order).
      ;; HARD INVARIANT: no AIU survives mappeless. A missing map
      ;; aborts the whole creation and the fresh file is removed;
      ;; placement quit keeps the mapped file with WARNING instead.
      ;; Machine truth lands in MM_* drawers (aiu-subnet-sync reads those).
      ;; Flat by design: the two steps are independently testable
      ;; helpers above; unexpected errors abort the same way as quit.
      (let* ((target-dir (file-name-directory file-path))
             (map-id (condition-case nil
                         (my/aiu-subnet--find-require-map target-dir)
                       (quit nil)
                       (error nil))))
        (if (not (and (stringp map-id)
                      (not (string-equal map-id "WARNING"))))
            (progn
              (ignore-errors (kill-buffer (find-buffer-visiting file-path)))
              (ignore-errors (delete-file file-path))
              (user-error "Creation aborted: every AIU needs an AIU Subnet parent (file removed)"))

                            (my/aiu-subnet--find-require-placement)
                          (quit 'aiu-subnet-skip)
                          (error 'aiu-subnet-skip))))
            (unless (eq placed 'aiu-subnet-skip)
              (let ((frag (and (fboundp 'my/cyberdeck-org-prompt--fragment-aiu-subnet)
                               (condition-case nil
                                   (my/cyberdeck-org-prompt--fragment-aiu-subnet
                                    "AIU_SUBNET_PLACEMENT" placed)

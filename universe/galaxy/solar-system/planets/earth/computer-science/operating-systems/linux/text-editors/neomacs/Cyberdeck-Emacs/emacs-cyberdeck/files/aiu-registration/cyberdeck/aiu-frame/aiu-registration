(defun my/cyberdeck--sweep-sync-drawer-keys (add-alist &optional order)
  "Insert missing drawer stubs then arrange, per vault note file.
ADD-ALIST is ((KEY . DEFAULT-VALUE)...). ORDER defaults to
`my/cyberdeck-drawer-key-order'. Skips .git and admin/.
Files already complete are not saved. Saves once per changed file.
Returns count of files changed."
  (let* ((root (my/cyberdeck-root-dir))
         (gitdir (expand-file-name ".git" root))
         (admindir (expand-file-name "admin/" root))
         (files (append (directory-files-recursively root "\\.org\\'")
                        (directory-files-recursively root "[^./]+\\'")))
         (n 0))
      (dolist (f files)
        (unless (or (file-in-directory-p f gitdir)
                    (file-in-directory-p f admindir)
                    (string-match-p "/WIP/" f))
          (when (and f (file-exists-p f))
            (let ((ins (my/cyberdeck--ensure-drawer-stubs f add-alist)))
            (when (and ins
                       (fboundp 'my/cyberdeck-links--log-added-properties))
              (my/cyberdeck-links--log-added-properties f ins))
            (when (my/cyberdeck--arrange-drawer-per-order f order)
              (setq ins t))
            (when ins
              (with-current-buffer (find-file-noselect f)
                (when (buffer-modified-p)
                  (save-buffer)))
              (setq n (1+ n)))))))
    (message "Drawer sync: %d file(s) updated." n)
    n))

(defun my/cyberdeck--ensure-drawer-stubs (file add-alist)
  "Insert missing ADD-ALIST stubs into FILE's first level-1 drawer.
ADD-ALIST is ((KEY . DEFAULT-VALUE)...). Creates the drawer when the
heading exists but has none. Never saves; caller saves. Returns list
of inserted (KEY . DEFAULT-VALUE) pairs, nil if none."
  (when (and file (file-exists-p file) add-alist)
    (with-current-buffer (find-file-noselect file)
      (save-restriction
        (widen)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^\\* " nil t)
            (org-back-to-heading t)
            (let ((sub-end (save-excursion
                             (org-end-of-subtree t t)
                             (point)))
                  (inserted nil))
              (if (re-search-forward "^[ \t]*:PROPERTIES:[ \t]*$" sub-end t)
                  (let ((drawer-end
                         (save-excursion
                           (when (re-search-forward "^[ \t]*:END:[ \t]*$"
                                                    sub-end t)
                             (line-beginning-position)))))
                    (when drawer-end
                      (dolist (kv add-alist)
                        (save-excursion
                          (goto-char (point-min))
                          (unless (re-search-forward
                                   (format "^[ \t]*:%s:[ \t]*.*$"
                                           (regexp-quote (car kv)))
                                   drawer-end t)
                            (goto-char drawer-end)
                            (beginning-of-line)
                            (insert (format ":%s: %s\n" (car kv) (cdr kv)))
                            (push kv inserted))))))
                (end-of-line)
                (forward-line 1)
                (insert ":PROPERTIES:\n")
                (dolist (kv add-alist)
                  (insert (format ":%s: %s\n" (car kv) (cdr kv))))
                (insert ":END:\n")
                (setq inserted (copy-sequence add-alist)))
              (when inserted
                (nreverse inserted)))))))))


(defun my/cyberdeck--sweep-remove-drawer-key (key)
  "Delete `:KEY:' lines from first level-1 drawers vault-wide.
Skips .git and admin/. Saves once per changed file.
Returns count of files changed."
  (when (and (stringp key) (not (string-empty-p key)))
    (let* ((root (my/cyberdeck-root-dir))
           (gitdir (expand-file-name ".git" root))
           (admindir (expand-file-name "admin/" root))
           (files (append (directory-files-recursively root "\\.org\\'")
                          (directory-files-recursively root "[^./]+\\'")))
           (re (format "^[ \t]*:%s:[ \t]*.*$" (regexp-quote key)))
           (n 0))
      (dolist (f files)
        (unless (or (file-in-directory-p f gitdir)
                    (file-in-directory-p f admindir)
                    (string-match-p "/WIP/" f))
          (when (and f (file-exists-p f))
            (with-current-buffer (find-file-noselect f)
              (save-restriction
                (widen)
                (save-excursion
                  (goto-char (point-min))
                  (when (re-search-forward "^\\* " nil t)
                    (org-back-to-heading t)
                    (let ((sub-end (save-excursion
                                     (org-end-of-subtree t t)
                                     (point))))
                      (when (re-search-forward "^[ \t]*:PROPERTIES:[ \t]*$"
                                               sub-end t)
                        (forward-line 1)
                        (let ((props-beg (point))
                              (drawer-end
                               (save-excursion
                                 (when (re-search-forward "^[ \t]*:END:[ \t]*$"
                                                          sub-end t)
                                   (line-beginning-position)))))
                          (when drawer-end
                            (goto-char props-beg)
                            (let (dels)
                              (while (re-search-forward re drawer-end t)
                                (push (cons (line-beginning-position)
                                            (min (1+ (line-end-position))
                                                 (point-max)))
                                      dels))
                              (when dels
                                (dolist (span dels)
                                  (delete-region (car span) (cdr span)))
                                (save-buffer)
                                (when (fboundp 'my/cyberdeck-links--log-removed-property)
                                  (my/cyberdeck-links--log-removed-property f key))
                                (setq n (1+ n)))))))))))))))
      (message "Drawer key removal: %d file(s) updated." n)
      n)))

(defun my/cyberdeck--sweep-remove-drawer-key-if-static (key)
  "Delete `:KEY:' lines holding static sentinels from first
level-1 drawers vault-wide. Static = value exactly TODO or
WARNING (never real user content). Live values stay untouched.
Same whole-line span mechanic as
`my/cyberdeck--sweep-remove-drawer-key' (matched line
plus its newline, no residue). Skips .git and admin/. Saves
once per changed file. Returns (STRIPPED-FILES . LIVE-HITS)
where LIVE-HITS is a list of (FILE . VALUE) for lines kept."
  (when (and (stringp key) (not (string-empty-p key)))
    (let* ((root (my/cyberdeck-root-dir))
           (gitdir (expand-file-name ".git" root))
           (admindir (expand-file-name "admin/" root))
           (files (append (directory-files-recursively root "\\.org\\'")
                          (directory-files-recursively root "[^./]+\\'")))
           (re (format "^[ \t]*:%s:[ \t]*\\(.*\\)$" (regexp-quote key)))
           (stripped 0)
           live)
      (dolist (f files)
        (unless (or (file-in-directory-p f gitdir)
                    (file-in-directory-p f admindir)
                    (string-match-p "/WIP/" f))
          (when (and f (file-exists-p f))
            (with-current-buffer (find-file-noselect f)
              (save-restriction
                (widen)
                (save-excursion
                  (goto-char (point-min))
                  (when (re-search-forward "^\\* " nil t)
                    (org-back-to-heading t)
                    (let ((sub-end (save-excursion
                                     (org-end-of-subtree t t)
                                     (point))))
                      (when (re-search-forward "^[ \t]*:PROPERTIES:[ \t]*$"
                                               sub-end t)
                        (forward-line 1)
                        (let ((props-beg (point))
                              (drawer-end
                               (save-excursion
                                 (when (re-search-forward "^[ \t]*:END:[ \t]*$"
                                                          sub-end t)
                                   (line-beginning-position)))))
                          (when drawer-end
                            (goto-char props-beg)
                            (let (dels)
                              (while (re-search-forward re drawer-end t)
                                (let ((val (string-trim
                                            (match-string-no-properties 1))))
                                  (if (member val '("TODO" "WARNING"))
                                      (push (cons (line-beginning-position)
                                                  (min (1+ (line-end-position))
                                                       (point-max)))
                                            dels)
                                    (push (cons f val) live))))
                              (when dels
                                (dolist (span dels)
                                  (delete-region (car span) (cdr span)))
                                (save-buffer)
                                (setq stripped (1+ stripped)))))))))))))))
      (cons stripped (nreverse live)))))

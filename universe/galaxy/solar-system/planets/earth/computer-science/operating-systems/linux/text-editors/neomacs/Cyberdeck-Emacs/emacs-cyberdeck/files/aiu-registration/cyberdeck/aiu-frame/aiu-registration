(defvar my/cyberdeck--pending-open-after-capture nil
  "File to offer opening after the next cyberdeck capture finalizes.")
(defvar my/cyberdeck--pending-open-origin nil
  "Marker of where the user was when the new-aiu capture was armed.")
(defvar my/cyberdeck--pending-open-aiu nil
  "Cons (ID . TITLE) of the AIU created by the pending capture.")
(defvar my/cyberdeck--last-created-file nil
  "File of the most recently created AIU (for on-demand open menu).")

(defun my/cyberdeck--arrange-drawer-per-order (file &optional order)
  "Arrange the first level-1 drawer in FILE per ORDER list.
Configured keys come first (in list order); everything else keeps
file order. No-op (no save) when already ordered, missing keys are
skipped, files without drawers untouched. Saves when changed.
Returns t when changed. ORDER defaults to
`my/cyberdeck-drawer-key-order'."
  (setq order (or order my/cyberdeck-drawer-key-order))
  (when (and file (file-exists-p file))
    (with-current-buffer (find-file-noselect file)
      (save-restriction
        (widen)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^\\* " nil t)
            (org-back-to-heading t)
            (let ((sub-end (save-excursion
                             (org-end-of-subtree t t)
                             (point))))
              (when (re-search-forward "^[ \t]*:PROPERTIES:[ \t]*$"
                                       sub-end t)
                (forward-line 1)
                (let ((props-beg (point))
                      (drawer-end
                       (save-excursion
                         (when (re-search-forward "^[ \t]*:END:[ \t]*$"
                                                  sub-end t)
                           (line-beginning-position)))))
                  (when drawer-end
                    (goto-char props-beg)
                    (let (entries)
                      (while (re-search-forward
                              "^[ \t]*:\\([^ :\n]+\\):[ \t]*.*$"
                              drawer-end t)
                        (push (cons (match-string 1)
                                    (buffer-substring-no-properties
                                     (line-beginning-position)
                                     (min (1+ (line-end-position))
                                          (point-max))))
                              entries))
                      (setq entries (nreverse entries))
                      (let ((ordered
                             (append
                              (mapcan
                               (lambda (k)
                                 (seq-filter
                                  (lambda (e) (string= (car e) k))
                                   entries))
                                order)
                               (seq-remove
                                (lambda (e)
                                  (member (car e)
                                          order))
                                entries))))
                        (unless (equal ordered entries)
                          (delete-region props-beg drawer-end)
                          (goto-char props-beg)
                          (dolist (e ordered)
                            (insert (cdr e)))
                          (save-buffer)
                          t)))))))))))))

(defun my/cyberdeck--open-offer-pick (fname)

(cl-defun cyberdeck-insert (&key filter-fn candidates-fn create-fn
                              (expand-aliases t))
  "Select a note and insert a link to it.

Allows capturing new notes. After link is inserted,
`cyberdeck-insert-handle-functions' are called with the inserted
note as the only argument regardless involvement of capture
process.

CANDIDATES-FN is the function to query candidates for selection,
which takes as its argument a filtering function (see FILTER-FN).
Unless specified, `cyberdeck-insert-default-candidates-source' is
used.

FILTER-FN is the function to apply on the candidates, which takes
as its argument a `cyberdeck-aiu'. Unless specified,
`cyberdeck-insert-default-filter' is used.

CREATE-FN allows to control how a new note is created when user picks a
non-existent note. This function is called with two arguments - title
and capture unfoldings. When CREATE-FN is nil,
`cyberdeck-insert-default-create-fn' is used; when that is also nil, the
default implementation is used.

When EXPAND-ALIASES is non-nil (the default), each note with
aliases will appear multiple times in the completion list - once
for the original title and once for each alias."
  (interactive)
  (unwind-protect
      (atomic-change-group
        (let* (region-text
               beg end
               (_ (when (region-active-p)
                    (setq
                     beg (set-marker
                          (make-marker) (region-beginning))
                     end (set-marker
                          (make-marker) (region-end))
                     region-text
                     (org-link-display-format
                      (buffer-substring-no-properties
                       beg end)))))
               (notes (funcall (or candidates-fn
                                   cyberdeck-insert-default-candidates-source)
                               (or filter-fn cyberdeck-insert-default-filter)))
               (note (cyberdeck-select-from "AIU" notes
                                         :initial-prompt region-text
                                         :expand-aliases expand-aliases))
               (description (or region-text
                                (cyberdeck-aiu-title note))))
          (if (cyberdeck-aiu-id note)
              ;; Existing AIU - insert link immediately
              (progn
                (when region-text
                  (delete-region beg end)
                  (set-marker beg nil)
                  (set-marker end nil))
                (insert (org-link-make-string
                         (concat "id:" (cyberdeck-aiu-id note))
                         description))
                (run-hook-with-args
                 'cyberdeck-insert-handle-functions
                 note))
            ;; New AIU - create it then insert link
            (let ((cfn (or create-fn cyberdeck-insert-default-create-fn)))
              (if cfn
                  (funcall cfn (cyberdeck-aiu-title note) nil)

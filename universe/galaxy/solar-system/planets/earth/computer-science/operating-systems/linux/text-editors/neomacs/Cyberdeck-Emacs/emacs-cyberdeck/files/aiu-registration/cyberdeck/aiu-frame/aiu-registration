                ((cyberdeck-aiu-p aiu-or-id) aiu-or-id)
                ((stringp aiu-or-id) (cyberdeck-db-get-by-id aiu-or-id))
                (t (when-let* ((id (org-entry-get nil "ID")))
                     (cyberdeck-db-get-by-id id)))))

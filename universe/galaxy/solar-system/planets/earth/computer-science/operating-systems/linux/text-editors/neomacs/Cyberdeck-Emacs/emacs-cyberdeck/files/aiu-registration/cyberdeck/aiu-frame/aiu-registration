(defvar my/cyberdeck-prompt-registry nil
  "List of prompt specs. Each spec is a plist with:
:key           SYMBOL   — unique identifier (same as :name)
:name          SYMBOL   — unique identifier (alias for :key)
:label         STRING   — human-readable display name for Transient UI
:prompt-fn     FUNCTION — (&optional current) -> raw value from the user
:contexts      LIST     — \='(file heading task ...)
:to-plist      FUNCTION — (VAL CONTEXT) -> plist fragment
:read-current-fn FUNCTION — () -> current value from the visited buffer
:validate-fn   FUNCTION or nil — (VAL) -> non-nil means valid
:merge-strategy SYMBOL  — \='replace | \='merge | \='append

Fragment keys:
:tags         (list of strings)      — merged by append
:unfoldings   (alist)                — merged by append
:body         (string)               — concatenated
:post-apply   (list of functions)    — each called with the note
:after        nil or \='last         — heading insert position")

;; Reset on every config load so prompts don't accumulate duplicates
(setq my/cyberdeck-prompt-registry nil)

(defcustom my/cyberdeck-prompt-key-order
  '("AIU_SUBNET_MAP_SELECT" "AIU_SUBNET_PLACEMENT")
  "Prompt keys forced first, in order, during collection.
Map first, then placement, then everything else in registry order.
Never allow placement before the map is chosen."
  :type '(repeat string)
  :group 'cyberdeck)

(defun my/cyberdeck--ordered-specs (specs)
  "Stable-sort SPECS by `my/cyberdeck-prompt-key-order'.
Unknown keys keep registry-relative order at the end."
  (let ((n 0)
        (rank (make-hash-table :test 'equal)))
    (dolist (k my/cyberdeck-prompt-key-order)
      (puthash k n rank)
      (setq n (1+ n)))
    (sort (copy-sequence specs)
          (lambda (a b)
            (let ((ka (format "%s" (plist-get a :key)))
                  (kb (format "%s" (plist-get b :key))))
              (let ((ra (gethash ka rank 1e18))
                    (rb (gethash kb rank 1e18)))
                (or (< ra rb)
                    (and (= ra rb) (string< ka kb)))))))))

(defun my/cyberdeck-register-prompt (&rest plist)
  "Register a prompt spec PLIST into `my/cyberdeck-prompt-registry'.
If :key is missing, copies :name into :key for backward compat."
  (unless (plist-get plist :key)
    (setq plist (plist-put plist :key (plist-get plist :name))))
  (unless (plist-get plist :name)
    (setq plist (plist-put plist :name (plist-get plist :key))))
  (push plist my/cyberdeck-prompt-registry))

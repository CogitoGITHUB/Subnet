(defvar my/cyberdeck-missing--static-types
  '(missing-required disallowed-value invalid-value template-outdated)
  "Violation types that belong in Static AIU Contexts: the value is
absent or a static default wanting proper unfolding use.
Link-structure types (wrong-type, invalid-reference, invalid-target)
are excluded — those stay visible via flymake and the doctor, and
must not dilute a queue about static values.")

(defun my/cyberdeck-missing--aggregate-health ()
  "Return static-needing violation entries aggregated by AIU id."
  (let ((by-id (make-hash-table :test #'equal)))
    (dolist (health (cyberdeck-aiu-context-collection-health))
      (let ((schema-name (cyberdeck-aiu-context-health-schema health)))
        (dolist (pair (cyberdeck-aiu-context-health-invalid-aius health))
          (let* ((note (car pair))
                 (violations (cl-remove-if-not
                              (lambda (v)
                                (memq (cyberdeck-violation-type v)
                                      my/cyberdeck-missing--static-types))
                              (cdr pair)))
                 (id (cyberdeck-aiu-id note))
                 (title (cyberdeck-aiu-title note))
                 (existing (gethash id by-id)))
            (when violations
              (if existing
                (progn
                  (plist-put existing :schemas
                             (cons (symbol-name schema-name)
                                   (plist-get existing :schemas)))
                  (plist-put existing :violations
                             (append violations (plist-get existing :violations))))
              (puthash id
                       (list :id id :title title
                             :schemas (list (symbol-name schema-name))
                             :violations violations)
                       by-id)))))))
    (let (entries)
      (maphash (lambda (_id plist) (push plist entries)) by-id)
      (nreverse entries))))

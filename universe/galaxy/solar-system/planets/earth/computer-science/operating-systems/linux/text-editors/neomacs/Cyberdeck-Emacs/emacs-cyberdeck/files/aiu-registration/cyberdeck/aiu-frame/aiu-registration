(defun my/cyberdeck--sweep-drawer-order (&optional order)
  "Arrange drawers in all vault note files per ORDER (default saved).
Skips .git and non-aiu files. Files already ordered are not saved.
Returns count of files changed; saves trigger auto-commit."
  (let* ((root (my/cyberdeck-root-dir))
         (gitdir (expand-file-name ".git" root))
         (order (or order my/cyberdeck-drawer-key-order))
         (files (append (directory-files-recursively root "\\.org\\'")
                        (directory-files-recursively root "[^./]+\\'")))
         (n 0))
    (dolist (f files)
      (unless (or (file-in-directory-p f gitdir)
                  (string-match-p "/WIP/" f))
        (when (my/cyberdeck--arrange-drawer-per-order f order)
          (setq n (1+ n)))))
    (message "Drawer order: %d file(s) updated." n)
    n))

(defun my/cyberdeck--open-offer-insert-link (f origin note)
  "Insert an [[id:...][title]] link for NOTE at ORIGIN marker.
Link string built via `my/cyberdeck--make-id-link'.
Dead origin reports loudly; nil origin stays silent (no promise made)."
  (let ((id (car note)) (title (cdr note)))
    (if (and (markerp origin) (marker-buffer origin)
             (buffer-live-p (marker-buffer origin)) id)
        (with-current-buffer (marker-buffer origin)
          (save-excursion
            (goto-char origin)
            (insert (my/cyberdeck--make-id-link
                     id (or title (file-name-base f))))))
      (when (markerp origin)
        (message "Origin buffer no longer exists; link not inserted%s"
                 (if id "" " (no AIU id)"))))))

(defun my/cyberdeck--open-offer-rename-open (f _origin note open-fn)
  "Rename NOTE's title, propagate, then call OPEN-FN with the final path.
Title applied via `cyberdeck-buffer-title-set'; inbound
links and file rename handled by `cyberdeck-propagate-title-change'
(run as-is, old title pre-supplied). Any quit/error in the rename
step is reported and OPEN-FN still runs — the AIU exists regardless."
  (let* ((id (car note)) (title (cdr note))
         (old-title (or title (file-name-base f)))
         (final-path f))
    (condition-case err
        (let ((new-title (read-string "New title: " old-title)))
          (if (string= old-title new-title)
              (message "Title unchanged; skipping rename")
            (let ((buf (find-file-noselect f)))
              (with-current-buffer buf
                (cyberdeck-buffer-title-set new-title)
                (save-buffer)))
            (let ((cyberdeck--title-before-save old-title))
              (cyberdeck-propagate-title-change
               (list :id id :title new-title :path f)))))
      (quit (message "Rename skipped"))
      (error (message "Rename skipped: %s" (error-message-string err))))
    ;; The rename may have moved the file — re-resolve before opening.
    (let ((fresh (and id (ignore-errors (cyberdeck-db-get-by-id id)))))
      (when (and fresh (cyberdeck-aiu-path fresh)
                 (file-exists-p (cyberdeck-aiu-path fresh)))
        (setq final-path (cyberdeck-aiu-path fresh))))
    (funcall open-fn final-path)))

(defun my/cyberdeck--open-offer-dispatch (choice f origin note)
  "Run post-creation CHOICE for file F. ORIGIN is a marker (maybe dead),
NOTE is (ID . TITLE). The origin buffer is never killed; \"skip\"
restores it."
  (pcase choice
    ("open (capture)"
     (my/cyberdeck--open-offer-open-capture f))
    ("open (buffer)"
     (my/cyberdeck--open-offer-open-buffer f))
    ("insert link + open (capture)"
     (my/cyberdeck--open-offer-insert-link f origin note)
     (my/cyberdeck--open-offer-open-capture f))
    ("insert link + open (buffer)"
     (my/cyberdeck--open-offer-insert-link f origin note)
     (my/cyberdeck--open-offer-open-buffer f))
    ("insert link"
     (my/cyberdeck--open-offer-insert-link f origin note))
    ("insert link + rename + open (capture)"
     (my/cyberdeck--open-offer-insert-link f origin note)
     (my/cyberdeck--open-offer-rename-open
      f origin note #'my/cyberdeck--open-offer-open-capture))
    ("insert link + rename + open (buffer)"
     (my/cyberdeck--open-offer-insert-link f origin note)
     (my/cyberdeck--open-offer-rename-open
      f origin note #'my/cyberdeck--open-offer-open-buffer))
    ("skip"
     (if (and (markerp origin) (marker-buffer origin)
              (buffer-live-p (marker-buffer origin)))
         (pop-to-buffer (marker-buffer origin))
       (when (markerp origin)
         (message "Origin buffer no longer exists; staying here"))))
    (_ (my/cyberdeck--open-offer-open-capture f))))

(defun my/cyberdeck--maybe-open-after-capture ()
  "Offer post-creation actions for the pending new-aiu file.
Never kills the origin buffer; every step is error-isolated so a
failing action cannot break the finalize chain. Runs synchronously
inside the hook — finalize already restored windows/kills first."
  ;; Tripwire (temporary): proves the hook ran and shows arm state.
  (message "open-offer hook: pending=%s"
           my/cyberdeck--pending-open-after-capture)
  (when-let* ((f my/cyberdeck--pending-open-after-capture))
    (let ((origin my/cyberdeck--pending-open-origin)
          (note my/cyberdeck--pending-open-aiu))
      (setq my/cyberdeck--pending-open-after-capture nil
            my/cyberdeck--pending-open-origin nil
            my/cyberdeck--pending-open-aiu nil)
      (condition-case err
          (my/cyberdeck--arrange-drawer-per-order f)
        (quit (message "Open offer aborted during drawer arrange: quit"))
        (error (lwarn 'cyberdeck :warning "Drawer arrange: %s" err)))
      (if (file-exists-p f)
          (condition-case err
              (let ((choice (my/cyberdeck--open-offer-pick f)))
                (when choice
                  (my/cyberdeck--open-offer-dispatch
                   choice f origin note)))
            (quit (message "Open cancelled"))
            (error (lwarn 'cyberdeck :warning "Open action: %s" err)))
        (message "Open offer: %s vanished, nothing to open" f))
      (when (markerp origin) (set-marker origin nil)))))

(add-hook 'org-capture-after-finalize-hook #'my/cyberdeck--maybe-open-after-capture)

;; Aborted captures never finalize — clear stale pending paths.
(advice-add 'org-capture-kill :before
            (lambda (&rest _)
              (setq my/cyberdeck--pending-open-after-capture nil
                    my/cyberdeck--pending-open-origin nil
                    my/cyberdeck--pending-open-aiu nil)
              (setq my/cyberdeck--pending-aiu-context-register nil)))

(defun my/cyberdeck-open-offer-last ()
  "Run the post-creation menu for the most recently created note.
On-demand fallback when a capture ended without finalizing."
  (interactive)
  (let ((f (or my/cyberdeck--pending-open-after-capture
               my/cyberdeck--last-created-file)))
    (unless (and f (file-exists-p f))
      (user-error "No created AIU file to act on"))
    (let ((origin my/cyberdeck--pending-open-origin)
          (note my/cyberdeck--pending-open-aiu))
      (setq my/cyberdeck--pending-open-after-capture nil
            my/cyberdeck--pending-open-origin nil
            my/cyberdeck--pending-open-aiu nil)
      (let ((choice (my/cyberdeck--open-offer-pick f)))
        (when choice
          (my/cyberdeck--open-offer-dispatch choice f origin note)))
      (when (markerp origin) (set-marker origin nil)))))

(defun my/cyberdeck--capture-live-p ()

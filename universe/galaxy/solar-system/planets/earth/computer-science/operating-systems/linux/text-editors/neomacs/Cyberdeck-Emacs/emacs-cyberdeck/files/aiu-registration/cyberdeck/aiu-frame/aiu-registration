(defcustom my/cyberdeck-drawer-key-order '("TODO_STATE" "ID")
  "Drawer keys in display order. Unlisted keys keep file order after these."
  :type '(repeat string)
  :group 'cyberdeck)

(defconst my/cyberdeck--drawer-order-file
  (expand-file-name "admin/order/headings aiu-context drawer"
                   cyberdeck-emacs-vault-root)
  "The drawer-order file, in admin/order/ beside the other two order files.

Stated, not discovered. The search below cannot see admin/ — it walks
the vault and skips it — so a file living there is unreachable to it, and
a move that leaves the search untouched is a silent no-op. Data files
belong in admin/, so the path is named here and the search kept only as a
fallback for trees that have not moved.")

(defun my/cyberdeck-drawer-order-file ()
  "Return the drawer-order file: a tagged file with a level-1
headline and zero parseable KEYs.  Prefers the named file, then the
candidate that actually holds a key list (level-2 headings); template
files share the first two properties but carry prose sections instead.
Falls back to the first candidate when none has keys."
  (if (file-exists-p my/cyberdeck--drawer-order-file)
      my/cyberdeck--drawer-order-file
    (catch 'found
      (let (first)
        (dolist (f (mapcar #'cdr (my/cyberdeck-aiu-context-key-files)))
          (with-temp-buffer
            (ignore-errors (insert-file-contents f))
            (goto-char (point-min))
            (when (and (re-search-forward "^\\* " nil t)
                       (not (re-search-forward
                             "^\\* [A-Z][A-Z0-9_]*\\([ \t]+:[A-Za-z0-9_:@]+:\\)?[ \t]*$"
                             nil t)))
              (unless first (setq first f))
              (when (save-excursion
                      (goto-char (point-min))
                      (re-search-forward "^\\*\\*+ " nil t))
                (throw 'found f)))))
        (when first (throw 'found first))
        nil))))

(defun my/cyberdeck-drawer-order-from-file (&optional file)
  "Read drawer key order from FILE (default the order file).
Returns level-2 heading titles top-down, duplicates removed.
Returns nil when unreadable or empty."
  (let ((f (or file (my/cyberdeck-drawer-order-file))))
    (when (and f (file-exists-p f))
      (with-temp-buffer
        (insert-file-contents f)
        (let (keys)
          (goto-char (point-min))
          (while (re-search-forward "^\\*\\*+ [. ]*\\(.*?\\)[ \t]*$" nil t)
            (let ((k (string-trim (match-string 1))))
              (unless (string-empty-p k)
                (push k keys))))
          (cl-delete-duplicates (nreverse keys) :test #'string=))))))


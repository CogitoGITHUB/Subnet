(defun cyberdeck--create-file (title file-name id head meta body tags unfoldings context)
  "Create a file-level note with TITLE.

FILE-NAME, ID, HEAD, META, BODY, TAGS, UNFOLDINGS, and CONTEXT
are as documented in `cyberdeck-create'."
  ;; Get defaults from function or template
  (let* ((defaults (cond
                    (cyberdeck-create-default-function
                     (funcall cyberdeck-create-default-function title))
                    (cyberdeck-create-default-template
                     cyberdeck-create-default-template)
                    (t nil)))
         ;; Merge explicit parameters with defaults (explicit takes precedence)
         (file-name (or file-name (plist-get defaults :file-name)))
         (head (or head (plist-get defaults :head)))
         (body (or body (plist-get defaults :body)))
         (tags (or tags (plist-get defaults :tags)))
         (unfoldings (or unfoldings (plist-get defaults :unfoldings)))
         (meta (or meta (plist-get defaults :meta)))
         (context (or context (plist-get defaults :context)))
         (file-path (cyberdeck--expand-file-name-template title id file-name context))
         ;; Expand templates everywhere with context
         (expanded-head (when head
                          (cyberdeck--expand-template head title id context)))
         (expanded-body (when body
                          (cyberdeck--expand-template body title id context)))
         (expanded-tags (when tags
                          (mapcar (lambda (tag)
                                    (cyberdeck--expand-template tag title id context))
                                  tags)))
         (expanded-aiu-contexts (when unfoldings
                                (mapcar (lambda (unfolding)
                                          (cons (car unfolding)
                                                (cyberdeck--expand-template (cdr unfolding) title id context)))
                                        unfoldings)))
         (expanded-meta (when meta
                          (mapcar (lambda (kvp)
                                    (cons (car kvp)
                                          (if (listp (cdr kvp))
                                              ;; List of values
                                              (mapcar (lambda (val)
                                                        (if (stringp val)
                                                            (cyberdeck--expand-template val title id context)
                                                          val))
                                                      (cdr kvp))
                                            ;; Single value
                                            (if (stringp (cdr kvp))
                                                (cyberdeck--expand-template (cdr kvp) title id context)
                                              (cdr kvp)))))
                                  meta)))
         (content (cyberdeck--format-aiu-content id title expanded-head expanded-meta expanded-tags expanded-aiu-contexts))
         (full-content (if expanded-body
                           (concat content "\n\n" expanded-body)
                         content))
         (dir (file-name-directory file-path)))

    ;; Ensure directory exists
    (unless (file-directory-p dir)
      (make-directory dir t))

    ;; Safety check: refuse to overwrite existing files
    (when (file-exists-p file-path)
      (error "cyberdeck-create: File %s already exists; refusing to overwrite" file-path))

    ;; Write file directly (no org-capture, no hooks, no blank lines)
    (with-temp-buffer
      (insert full-content)
      (write-region (point-min) (point-max) file-path nil 'silent))

    ;; Register ID with org-id so links can be followed
    (org-id-add-location id file-path)

    ;; Update database with the new file
    (let ((update-count (or (cyberdeck-db-update-file file-path) 0)))
      (when (zerop update-count)
        (error "cyberdeck-create: No AIUs extracted from file %s (expected ID %s)"
               file-path id)))

    ;; Return the AIU
    (or (cyberdeck-db-get-by-id id)
        (error "cyberdeck-create: AIU with ID %s not found in database after creation" id))))




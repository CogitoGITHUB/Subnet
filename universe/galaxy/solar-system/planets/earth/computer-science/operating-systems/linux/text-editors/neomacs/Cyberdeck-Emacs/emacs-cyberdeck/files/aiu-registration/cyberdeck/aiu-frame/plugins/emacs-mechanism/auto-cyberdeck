(defun my/cyberdeck-emacs-mechanism-auto-scan ()
  "Tagged files that are not full Cyberdeck files yet. Whole vault minus WIP."
  (when (fboundp 'my/cyberdeck-root-dir)
    (let ((root (my/cyberdeck-root-dir)) out)
      (dolist (f (directory-files-recursively root "[^./]+$"))
        (unless (or (string-match-p "/\\.git/" f)
                    (string-match-p "/WIP/" f))
          (when (my/cyberdeck-emacs-mechanism--needs-convert-p f)
            (push f out))))
      (nreverse out))))
#+end_src


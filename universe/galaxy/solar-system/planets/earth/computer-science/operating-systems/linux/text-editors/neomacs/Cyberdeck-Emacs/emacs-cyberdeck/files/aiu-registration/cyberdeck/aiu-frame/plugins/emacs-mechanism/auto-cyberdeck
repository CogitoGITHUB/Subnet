(defun my/cyberdeck-emacs-mechanism--needs-convert-p (file)
  "Non-nil when any tagged heading in FILE lacks an ID or DB rows."
  (and (fboundp 'cyberdeck-emacs-file-tagged-units)
       (cl-some (lambda (u)
                  (let ((id (plist-get u :id)))
                    (or (null id)
                        (not (my/cyberdeck-emacs-mechanism--indexed-p
                              id)))))
                (cyberdeck-emacs-file-tagged-units file))))

(defun my/cyberdeck-emacs-mechanism--indexed-p (id)
  "Non-nil when ID has both AIUs and aiu-subnet-nodes rows. Nil-safe without DB."
  (and id (fboundp 'cyberdeck-db)
       (condition-case nil
           (let ((db (cyberdeck-db)))
             (and (car (emacsql db [:select [id] :from notes :where (= id $s1)] id))
                  (car (emacsql db [:select [aiu-id] :from aiu-subnet-nodes :where (= aiu-id $s1)] id))))
         (error nil))))

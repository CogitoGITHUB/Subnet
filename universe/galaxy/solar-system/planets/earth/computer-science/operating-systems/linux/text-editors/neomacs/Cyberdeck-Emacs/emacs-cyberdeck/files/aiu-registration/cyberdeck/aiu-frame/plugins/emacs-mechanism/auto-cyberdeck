(defun my/cyberdeck-emacs-mechanism-auto-convert-file (file &optional parent-id)
  "Make every tagged level-1 heading in FILE a real AIU: ID
drawer, index rows, aiu-subnet row. Returns the converted id list."
  (require 'org-id nil t)
  (let (converted)
    (with-current-buffer (find-file-noselect file)
      (goto-char (point-min))
      (let (insrc)
        (while (not (eobp))
          (let ((line (buffer-substring-no-properties
                       (line-beginning-position) (line-end-position))))
            (cond
             ((string-match-p "^[ \t]*#\\+begin_" line) (setq insrc t))
             ((string-match-p "^[ \t]*#\\+end_" line) (setq insrc nil))
             ((and (not insrc)
                   (string-match "^\\* \\(.*\\)$" line)
                    (let* ((text (match-string 1 line))
                           ;; Org-compatible tag run: ":" inside allowed,
                           ;; empty segments dropped, hyphen legal
                           ;; (see loader scan).
                           (m (and (string-match "\\s-+\\(:[[:alnum:]_@:-]*:\\)\\s-*$" text)
                                         (match-string 1 text))))
                     (and m (member "EMACS_MECHANISM"
                                    (split-string (string-trim m ":" ":") ":" t)))))
              (save-excursion
                (forward-line 1)
                (let ((id nil))
                  (when (looking-at-p "^[ \t]*:PROPERTIES:[ \t]*$")
                    (forward-line 1)
                    (while (and (not (eobp))
                                (not (looking-at-p "^[ \t]*:END:[ \t]*$")))
                      (when (looking-at "^[ \t]*:ID:[ \t]*\\(\\S-+\\)")
                        (setq id (match-string 1)))
                      (forward-line 1))
                    (unless id
                      (setq id (org-id-uuid))
                      (re-search-backward "^[ \t]*:PROPERTIES:[ \t]*$" nil t)
                      (forward-line 1)
                      (insert ":ID:       " id "\n")))
                  (unless id
                    (setq id (org-id-uuid))
                    (insert ":PROPERTIES:\n:ID:       " id "\n:END:\n"))
                  (push id converted))))))
          (forward-line 1)))
      (save-buffer))
    (when converted
      (when (fboundp 'cyberdeck-db-update-file)
        (cyberdeck-db-update-file file))
      (dolist (id converted)
        (my/cyberdeck-emacs-mechanism--ensure-aiu-subnet-row id parent-id)))
    (nreverse converted)))
#+end_src


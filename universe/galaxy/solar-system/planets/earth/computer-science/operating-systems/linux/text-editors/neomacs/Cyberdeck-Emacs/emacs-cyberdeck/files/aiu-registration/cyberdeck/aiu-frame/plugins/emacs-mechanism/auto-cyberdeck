(defvar my/cyberdeck-emacs-mechanism--auto-ran nil
  "Session guard: auto-run fires once behind the db-open timer.")

(defun my/cyberdeck-emacs-mechanism-auto-run-once (&optional force)
  "Convert all tagged-but-incomplete files. Timer-safe, idempotent."
  (when (or force (not my/cyberdeck-emacs-mechanism--auto-ran))
    (setq my/cyberdeck-emacs-mechanism--auto-ran t)
    (let ((files (my/cyberdeck-emacs-mechanism-auto-scan))
          (done 0) (failed nil))
      (dolist (f files)
        (condition-case err
            (when (my/cyberdeck-emacs-mechanism-auto-convert-file f)
              (setq done (1+ done)))
          (error (push (cons f (error-message-string err)) failed))))
      (message "auto-cyberdeck: %d converted, %d failed" done (length failed))
      (dolist (fl failed) (message "auto-cyberdeck FAIL %s: %s" (car fl) (cdr fl)))
      done)))
#+end_src


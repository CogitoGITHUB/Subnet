(defun my/cyberdeck-emacs-mechanism--ensure-aiu-subnet-row (id parent-id)
  "Insert aiu-subnet-nodes root row for ID (or under PARENT-ID) when missing."
  (when (and id (fboundp 'cyberdeck-db)
             (not (my/cyberdeck-emacs-mechanism--indexed-p id)))
    (condition-case err
        (let* ((db (cyberdeck-db))
               (depth (if parent-id 1 0))
               (maxk (or (caar (emacsql db [:select [(funcall max order-key)]
                                               :from aiu-subnet-nodes])) 0.0)))
          (emacsql db [:insert :into aiu-subnet-nodes :values $v1]
                   (vector id parent-id (+ maxk 1.0) "file" depth)))
      (error (message "auto-cyberdeck aiu-subnet row failed [%s]: %s"
                      id (error-message-string err))))))
#+end_src


     (act
      (when bounds (goto-char (car bounds)))
      (message "Act on %s: %s"
               (if (region-active-p) "region" "thing")
               value)
      (call-interactively act))
     (t
      (message "No known target at point%s"
               (if value (format ": %s" value) ""))))))

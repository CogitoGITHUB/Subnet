(defun my/act ()
  "Act on the thing at point.
Find the contextual target under point, classify its type, and run a
type-appropriate default action (Embark-extracted). The per-type actions REUSE
existing M-K functions where they already cover a type — no parallel duplicates:

  - active region     -> ks-kill-ring-save-region (copy region)
  - existing file     -> find-file (open it)
  - URL               -> browse-url
  - live buffer       -> switch-to-buffer
  - symbol / word     -> my/jump-to-symbol (search-jump to its occurrence)

If nothing matches, reports the detected target and type in the echo area."
  (interactive)
  (let* ((bounds (or (and (region-active-p)
                          (cons (region-beginning) (region-end)))
                     (bounds-of-thing-at-point 'filename)
                     (bounds-of-thing-at-point 'url)
                     (bounds-of-thing-at-point 'buffer)
                     (bounds-of-thing-at-point 'symbol)
                     (bounds-of-thing-at-point 'word)))
         (value (and bounds
                     (buffer-substring-no-properties (car bounds) (cdr bounds))))
         (act (cond
               ((region-active-p) 'ks-kill-ring-save-region)
               ((and value (file-exists-p value)) 'find-file)
               ((and value (string-prefix-p "http" value)) 'browse-url)
               ((and value (get-buffer value)) 'switch-to-buffer)
               (value 'my/jump-to-symbol))))

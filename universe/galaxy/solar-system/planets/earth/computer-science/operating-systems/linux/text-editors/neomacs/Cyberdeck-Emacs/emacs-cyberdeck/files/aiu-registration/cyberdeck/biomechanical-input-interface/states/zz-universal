(defun my/spec-selector (msg)
  "Read a decimal count and a single command key, returning (count . command).
MSG is used as the prompt. If no digits are typed, count is nil. Digits are
accumulated into a decimal number exactly like Boon, then a single key is read
and resolved against the currently active keymaps (which include M-K's state
keymaps). Returns nil if the key is not a command."
  (let ((count 0)
        (maps (current-active-maps t)))
    (while (let ((ch (read-event (format "%s %s" msg count))))
             (and (integerp ch) (>= ch ?0) (<= ch ?9)
                  (setq count (+ (- ch ?0) (* 10 count)))))
      nil)
    (if (zerop count) (setq count nil))
    (let ((cmd (lookup-key maps (vector last-input-event))))
      (when (commandp cmd)
        (cons count cmd)))))

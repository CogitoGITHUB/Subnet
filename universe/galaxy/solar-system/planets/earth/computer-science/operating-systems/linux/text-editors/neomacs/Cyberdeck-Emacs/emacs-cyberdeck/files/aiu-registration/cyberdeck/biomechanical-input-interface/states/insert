Self-registration: mode and keymap in one unit (manual activation only). Delete this file and the state unregisters on next boot.
#+begin_src emacs-lisp
(biomechanical-input-interface-define-state "insert"
  :sparse t
  :no-suppress t
  :lighter "[INS]"
  :cursor-type 'bar)
#+end_src
** Owned functions
#+begin_src emacs-lisp
(defun my/smart-escape ()
  "Return to the appropriate modal state based on the current buffer."
  (interactive)
  (cond
   ((derived-mode-p 'org-mode)   (biomechanical-input-interface-set-state "org"))
   (t                            (biomechanical-input-interface-set-state "normal"))))
#+end_src
** Bindings
#+begin_src emacs-lisp

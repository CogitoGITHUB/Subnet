** Saved library + babel
#+begin_src emacs-lisp
(defvar my/cyberdeck-query-library-file
  (expand-file-name ".local/cache/aiu-frame-queries.el" (expand-file-name "~"))
  "Persisted alist (NAME . QUERY).")

(defvar my/cyberdeck-saved-queries nil
  "Alist (NAME . QUERY sexp).")

(defun my/cyberdeck-queries-load ()
  (setq my/cyberdeck-saved-queries nil)
  (condition-case nil
      (when (file-exists-p my/cyberdeck-query-library-file)
        (setq my/cyberdeck-saved-queries
              (car (read-from-string
                    (with-temp-buffer
                      (insert-file-contents my/cyberdeck-query-library-file)
                      (buffer-string))))))
    (error nil)))

(defun my/cyberdeck-queries-save ()
  (condition-case nil
      (let ((tmp (concat my/cyberdeck-query-library-file ".tmp"))
            (print-length nil) (print-level nil))
        (make-directory (file-name-directory my/cyberdeck-query-library-file) t)
        (with-temp-file tmp (prin1 my/cyberdeck-saved-queries (current-buffer)))
        (rename-file tmp my/cyberdeck-query-library-file t))
    (error nil)))

(my/cyberdeck-queries-load)

(defun my/cyberdeck-query-save (name query)
  "Save QUERY sexp under NAME."
  (interactive
   (list (read-string "Query name: ") (read--expression "Query sexp: ")))
  (push (cons name query)
        (setq my/cyberdeck-saved-queries
              (assoc-delete-all name my/cyberdeck-saved-queries)))
  (my/cyberdeck-queries-save))

(defun my/cyberdeck-query-run-saved (name)
  "AIUs matching saved query NAME."
  (interactive
   (list (completing-read "Run query: "
                          (mapcar #'car my/cyberdeck-saved-queries))))
  (my/cyberdeck-query (cdr (assoc name my/cyberdeck-saved-queries))))

(defun org-babel-execute:cyberdeck-query (body _params)
  "Run an cyberdeck query from a src block; returns matching titles."
  (let ((query (car (read-from-string body))))
    (mapcar (lambda (n) (or (ignore-errors (cyberdeck-aiu-title n))
                            "?"))
            (my/cyberdeck-query query))))
#+end_src

#+title:      Modeline Composer
#+filetags:   :emacs-package:ui:
#+property:   header-args:emacs-lisp :lexical t

* Modeline Composer :EMACS_MECHANISM:S0:
:PROPERTIES:
:ID:       c45be44e-cab1-4b0b-bde8-3836b5698eb7
:MM_PARENT: none
:MM_ORDER:  80.03
:CATEGORY: mode-line
:END:

Reads the order file, builds both stacked rows plus the fallback
single-row bar, detaches the doctor segment from global-mode-string
(the widget calls it directly — never twice), and keeps *Messages*
complete under mini-modeline. Migrated from
the-screen/display/06-screen (Emulating Mode Line Formatting).

** Emulating Mode Line Formatting

You can use the function format-mode-line to compute the text that would appear in a mode line or header line based on a certain mode line construct.

Function: format-mode-line format &optional face window buffer ¶
This function formats a line of text according to format as if it were generating the mode line for window, but it also returns the text as a string. The argument window defaults to the selected window. If buffer is non-nil, all the information used is taken from buffer; by default, it comes from window’s buffer.

The value string normally has text properties that correspond to the faces, keymaps, etc., that the mode line would have. Any character for which no face property is specified by format gets a default value determined by face. If face is t, that stands for either mode-line if window is selected, otherwise mode-line-inactive. If face is nil or omitted, that stands for the default face. If face is an integer, the value returned by this function will have no text properties.

You can also specify other valid faces as the value of face. If specified, that face provides the face property for characters whose face is not specified by format.

Note that using mode-line, mode-line-inactive, or header-line as face will actually redisplay the mode line or the header line, respectively, using the current definitions of the corresponding face, in addition to returning the formatted string. (Other faces do not cause redisplay.)

For example, (format-mode-line header-line-format) returns the text that would appear in the selected window’s header line ("" if it has no header line). (format-mode-line header-line-format 'header-line) returns the same text, with each character carrying the face that it will have in the header line itself, and also redraws the header line.

** Order reader
The order file groups keys under `** Row N Left/Right' with `***'
keys. Missing file or empty group means empty row (renders blank,
pairing holds).
#+begin_src emacs-lisp
(defvar manifolding-modeline--row1-left-keys nil)
(defvar manifolding-modeline--row1-right-keys nil)
(defvar manifolding-modeline--row2-left-keys nil)
(defvar manifolding-modeline--row2-right-keys nil)

;; The unit tree root, captured at load (the only moment the loader
;; binds the current unit file). after-init installers and M-: probes
;; run with no such binding; without this the order file is
;; unresolvable and the rows stay empty.
(defvar manifolding-modeline--dir
  (let ((d (file-name-directory
            (directory-file-name
                     (file-name-directory
                      (or (and (boundp 'cyberdeck-emacs--current-unit-file)
                               cyberdeck-emacs--current-unit-file)
                          load-file-name buffer-file-name default-directory))))))
    ;; Only keep it when it really is the tree (batch probes load
    ;; from module-el cache, where it is not).
    (when (file-exists-p (expand-file-name "order" d)) d))
  "Directory holding order and widgets (the-screen/modeline/).")

(defun manifolding-modeline--tree-dir ()
  "Modeline tree directory, or nil when unresolvable.
Prefers the root captured at unit load; falls back through the
loader binding and buffer context (covers M-: probes)."
  (let ((dir nil))
    (when (and (boundp 'manifolding-modeline--dir)
               manifolding-modeline--dir
               (file-directory-p manifolding-modeline--dir))
      (setq dir manifolding-modeline--dir))
    (unless dir
      (setq dir (file-name-directory
                 (or (and (boundp 'cyberdeck-emacs--current-unit-file)
                          cyberdeck-emacs--current-unit-file)
                     load-file-name
                     buffer-file-name
                     default-directory))))
    dir))

(defun manifolding-modeline--order-file ()
  "Absolute path of the sibling order file, or nil."
  (let ((dir (manifolding-modeline--tree-dir)))
    (when dir
      (expand-file-name "order" dir))))

(defun manifolding-modeline--read-order ()
  "Fill the four row key lists from the sibling order file."
  (let ((order (manifolding-modeline--order-file))
        (row nil)
        (side nil)
        r1l r1r r2l r2r)
    (when (file-exists-p order)
      (with-temp-buffer
        (insert-file-contents order)
        (goto-char (point-min))
        (while (not (eobp))
          (let ((line (buffer-substring-no-properties
                       (line-beginning-position) (line-end-position))))
            (cond
             ((string-match "^\\*\\* Row \\([12]\\) \\(Left\\|Right\\)" line)
              (setq row (string-to-number (match-string 1 line))
                    side (match-string 2 line)))
             ((string-match "^\\*\\*\\* \\([a-z-]+\\)" line)
              (let ((key (intern (match-string 1 line))))
                (cond
                 ((and (= row 1) (equal side "Left")) (push key r1l))
                 ((and (= row 1) (equal side "Right")) (push key r1r))
                 ((and (= row 2) (equal side "Left")) (push key r2l))
                 ((and (= row 2) (equal side "Right")) (push key r2r)))))))
          (forward-line 1))))
    (setq manifolding-modeline--row1-left-keys (nreverse r1l)
          manifolding-modeline--row1-right-keys (nreverse r1r)
          manifolding-modeline--row2-left-keys (nreverse r2l)
          manifolding-modeline--row2-right-keys (nreverse r2r))))
#+end_src

** Composer
Each side renders exactly "line1\nline2" (segments are newline
sanitized at render time), so the stacked pairing never breaks even
with empty rows. The fallback bar is row 1 only: a newline in a real
mode-line kills the whole row.
#+begin_src emacs-lisp
(defun manifolding-modeline--side (side)
  "Render SIDE (left or right) as a two-line string."
  (let ((r1 (cdr (assq side '((left . manifolding-modeline--row1-left-keys)
                              (right . manifolding-modeline--row1-right-keys)))))
        (r2 (cdr (assq side '((left . manifolding-modeline--row2-left-keys)
                              (right . manifolding-modeline--row2-right-keys))))))
    (concat (mapconcat #'manifolding-modeline--render (symbol-value r1) " ")
            "\n"
            (mapconcat #'manifolding-modeline--render (symbol-value r2) " "))))

(defun manifolding-modeline-install ()
  "Read order, detach doctor, install fallback bar.
The single install path: called by the install unit (after-init),
never inline here — segments register with the widgets, and
composing before they arrive builds an empty bar."
  (manifolding-modeline--read-order)
  ;; The doctor widget calls the indicator function directly; drop the
  ;; global-mode-string copy so it never shows twice.
  (setq global-mode-string
        (delete '(:eval (cyberdeck-emacs-doctor--mode-line-string))
                global-mode-string))
  ;; Fallback single-row bar reuses the same segment functions.
  (setq-default mode-line-format
                (list '(:eval (mapconcat #'manifolding-modeline--render
                                         manifolding-modeline--row1-left-keys ""))
                      " "
                      '(:eval (mapconcat #'manifolding-modeline--render
                                         manifolding-modeline--row1-right-keys ""))))
  (force-mode-line-update t))
#+end_src

** State-change entry
The keyboard calls this (guarded, neither side depends on the
other) on every real state flip. Push the bar now instead of
waiting for the render timer.
#+begin_src emacs-lisp
(defun manifolding-modeline--state-changed ()
  "Refresh the bar after a keyboard state change. Never throws."
  (condition-case nil
      (progn
        (force-mode-line-update)
        (when (and (boundp 'mini-modeline-mode) mini-modeline-mode
                   (fboundp 'mini-modeline-display))
          (mini-modeline-display 'force)))
    (error nil)))
#+end_src

** Messages shim
Mini-modeline reroutes `message' past *Messages*; this logs a copy
directly (no recursion: never calls message itself).
#+begin_src emacs-lisp
(defun manifolding-modeline--log-message (_func &rest args)
  "Append FUNC's message text to *Messages* before it shows inline."
  (when args
    (condition-case nil
        (with-current-buffer (get-buffer-create "*Messages*")
          (let ((inhibit-read-only t))
            (goto-char (point-max))
            (insert (apply #'format args) "\n")))
      (error nil))))

(with-eval-after-load 'mini-modeline
  (advice-add #'mini-modeline--reroute-msg :before
              #'manifolding-modeline--log-message))
#+end_src

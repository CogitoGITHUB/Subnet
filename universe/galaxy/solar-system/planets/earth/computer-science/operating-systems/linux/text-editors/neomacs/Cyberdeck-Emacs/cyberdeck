lifetime and rationale as `cyberdeck-emacs--truename-cache':
`cyberdeck-emacs--file-sig' was computed once in
`cyberdeck-emacs-file-tagged-units', again in `cyberdeck-emacs--index-lookup',
and again in `cyberdeck-emacs--index-apply' — three `file-attributes'
calls per file for one answer.  Never persisted: the index still stores
mtime+size per entry, so the trust model is unchanged.")

(defun cyberdeck-emacs--truename (file)
  "`file-truename' of FILE, computed at most once per boot.
Memoised per path string.  Falls back to the plain call when the memo is
unavailable, so behaviour never depends on caching being present."
  (if cyberdeck-emacs--truename-cache
      (let ((hit (gethash file cyberdeck-emacs--truename-cache)))
        (if hit
            hit
          (let ((v (file-truename file)))
            (puthash file v cyberdeck-emacs--truename-cache)
            v)))
    (file-truename file)))

(defun cyberdeck-emacs--file-sig (file)
  "Stat signature (MTIME SIZE) of FILE, or nil when stat fails.
Memoised per path string for the boot; one `file-attributes' call per
file instead of one per call site.  A nil signature is a real answer and
is memoised too, so a missing or unreadable file is not re-statted at
every call site -- hence the ABSENT sentinel rather than a bare nil test."
  (if cyberdeck-emacs--sig-cache
      (let ((hit (gethash file cyberdeck-emacs--sig-cache :absent)))
        (if (eq hit :absent)
            (let* ((a (file-attributes file))
                   (v (and a (list (nth 5 a) (nth 7 a)))))
              (puthash file v cyberdeck-emacs--sig-cache)
              v)
          hit))
    (let ((a (file-attributes file)))
      (and a (list (nth 5 a) (nth 7 a))))))

(defun cyberdeck-emacs-file-tagged-units (file)

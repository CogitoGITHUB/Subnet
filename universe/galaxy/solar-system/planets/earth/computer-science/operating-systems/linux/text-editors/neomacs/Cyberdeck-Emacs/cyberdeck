      (let (pinned rest)
        (setq rest ordered)
        (dolist (frag cyberdeck-emacs--bootstrap-first-paths)
          (let (group com)
            (dolist (u rest)
              (if (string-match-p (regexp-quote frag)
                                  (or (plist-get u :file) ""))

                ('leaf (when (and (require 'leaf nil t)
                                  (fboundp 'leaf-available-keywords))
                         (leaf-available-keywords)))
                ((or 'use-package 'use-package!)
                 (when (and (require 'use-package-core nil t)
                            (boundp 'use-package-keywords))
                   use-package-keywords))
                (_ '()))))

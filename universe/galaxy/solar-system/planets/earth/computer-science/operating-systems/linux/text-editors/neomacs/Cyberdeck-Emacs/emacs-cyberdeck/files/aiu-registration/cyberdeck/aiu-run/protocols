(defun my/cyberdeck-protocols--route-aiu (note)
  "Route NOTE (a cyberdeck-aiu already marked PROTOCOL: t)
to its protocol file."
  (let* ((unfoldings    (cyberdeck-aiu-aiu-contexts note))
         (topics   (split-string (or (cdr (assoc "PROTOCOL_TOPICS" unfoldings)) "") " " t))
         (level    (or (cdr (assoc "PROTOCOL_LEVEL" unfoldings)) "L1"))
         (title    (cyberdeck-aiu-title note))
         (aiu-id  (cyberdeck-aiu-id note))
         (routed   nil))
    (if (null topics)
        (let ((file (expand-file-name "protocols-universal"
                                      my/cyberdeck-protocols--protocols-directory)))
          (my/cyberdeck-protocols--write-pointer file aiu-id title level)
          (push file routed))
      (dolist (topic topics)
        (let ((file (my/cyberdeck-protocols--resolve-file topic)))
          (my/cyberdeck-protocols--write-pointer file aiu-id title level)
          (push file routed))))
    (my/cyberdeck-protocols--record-routed aiu-id routed)))

(defun my/cyberdeck-protocols--protocol-parents ()
  "Alist of (TITLE . ID) for every protocol parent heading.
Parents are PROTOCOL=t headings with PROTOCOL_ORDER 0."
  (let (out)
    (dolist (row (emacsql (cyberdeck-db)
                   [:select [aiu-id] :from protocols
                    :where (= protocol-order $s1)]
                   0))
      (let ((note (cyberdeck-db-get-by-id (car row))))
        (when note
          (push (cons (cyberdeck-aiu-title note)
                      (car row))
                out))))
    (nreverse out)))

(defun my/cyberdeck-protocols--advance-parent (id)
  "Advance protocol parent ID when it carries cadence.
Anchor becomes today; next occurrence is stamped as PROTOCOL_ANCHOR,
PROTOCOL_NEXT and the SCHEDULED planning line. Cadence-less parents
are left alone. Return the next ISO date, or nil."
  (when-let* ((marker (org-id-find id t)))
    (prog1
        (with-current-buffer (marker-buffer marker)
          (goto-char marker)
          (let* ((iv (my/cyberdeck-protocols--parse-interval
                      (org-entry-get nil "PROTOCOL_INTERVAL")))
                 (dy (my/cyberdeck-protocols--parse-days
                      (org-entry-get nil "PROTOCOL_DAYS"))))
            (when (or iv dy)
              (let* ((today (my/cyberdeck-protocols--today))
                     (next (my/cyberdeck-protocols--next-occurrence
                            (org-entry-get nil "PROTOCOL_ANCHOR")
                            today iv dy)))
                (when next
                  (org-entry-put nil "PROTOCOL_ANCHOR" today)
                  (org-entry-put nil "PROTOCOL_NEXT"
                                 (concat (substring next 0 4)
                                         (substring next 5 7)
                                         (substring next 8 10)))
                  (save-excursion
                    (org-back-to-heading t)
                    (let ((end (save-excursion (org-end-of-subtree t t)))
                          (sched (format "<%s %s>" next
                                         (aref my/cyberdeck-protocols--dow-names
                                               (my/cyberdeck-protocols--iso-weekday next)))))
                      (forward-line 1)
                      (if (re-search-forward "^SCHEDULED:" end t)
                          (progn (beginning-of-line)
                                 (delete-region (line-beginning-position)
                                                (line-end-position))
                                 (insert (format "SCHEDULED: %s" sched)))
                        (org-back-to-heading t)
                        (end-of-line)
                        (insert (format "\nSCHEDULED: %s" sched)))))
                  (save-buffer)
                  (condition-case nil
                      (emacsql (cyberdeck-db)
                        [:update protocols
                         :set panchor = $s1, pnext = $s2
                         :where (= aiu-id $s3)]
                        today
                        (string-to-number
                         (concat (substring next 0 4)
                                 (substring next 5 7)
                                 (substring next 8 10)))
                        id)
                    (error nil))
                  next)))))
      (set-marker marker nil))))

(defun my/cyberdeck-protocols--advance-parents ()
  "Advance every protocol parent carrying cadence; report how many."
  (let ((n 0))
    (dolist (parent (my/cyberdeck-protocols--protocol-parents))
      (when (my/cyberdeck-protocols--advance-parent (cdr parent))
        (cl-incf n)))
    (when (> n 0)
      (message "Advanced %d protocol(s)" n))))

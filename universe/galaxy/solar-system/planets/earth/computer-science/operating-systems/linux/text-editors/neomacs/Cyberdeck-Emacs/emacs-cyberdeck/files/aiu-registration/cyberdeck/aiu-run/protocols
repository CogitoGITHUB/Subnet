(defun my/cyberdeck-protocols--parent-steps (parent-id)
  "Return step IDs from the wormhole lines under protocol PARENT-ID,
in document order."
  (when-let* ((marker (org-id-find parent-id t)))
    (prog1
        (with-current-buffer (marker-buffer marker)
          (save-excursion
            (goto-char marker)
            (let ((end (save-excursion (org-end-of-subtree t t)))
                  (ids nil))
              (forward-line 1)
              (while (re-search-forward
                      "#\\+AIU Proxy: \\[\\[id:\\([^]]+\\)\\]" end t)
                (push (match-string-no-properties 1) ids))
              (nreverse ids))))
      (set-marker marker nil))))

(defun my/cyberdeck-protocols-reset ()
  "Set all protocol steps to TODO; advance parents carrying cadence.
The TODO flip is the completion hook: every protocol parent with
PROTOCOL_INTERVAL/DAYS stamps its next occurrence from the anchor."
  (interactive)
  (let ((ids (mapcar #'car (emacsql (cyberdeck-db)
                        [:select [aiu-id] :from protocols])))
        (count 0))
    (dolist (id ids)
      (when-let* ((marker (org-id-find id t)))
        (with-current-buffer (marker-buffer marker)
          (goto-char marker)
          (org-todo "TODO"))
        (set-marker marker nil)
        (setq count (1+ count))))
    (my/cyberdeck-protocols--advance-parents)
    (message "Reset %d protocol steps to TODO." count)))

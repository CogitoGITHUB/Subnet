** Defhydra-state macro
Single declaration generates both a biomechanical-input-interface state's keybindings and its Transient menu. Bindings with `:exit nil` become state keys (and sticky Transient suffixes); all bindings appear in the menu. The "Back → parent" group is automatic. Same spec shape the Hydra engine took — engine swapped, files untouched.
#+begin_src emacs-lisp
(defmacro my/defhydra-state (hydra-name state-name title back-target &rest spec)
  "Define biomechanical-input-interface STATE-NAME and its Transient menu from SPEC.
STATE-NAME may be nil for menus without a biomechanical-input-interface state.
BACK-TARGET is (HYDRA/BODY LABEL) for the back link, or nil for root.
SPEC is alternating group-name / binding-list pairs:
  GROUP-NAME  ((KEY CMD LABEL &key EXIT) ...)
Bindings with :exit nil go into the biomechanical-input-interface state keymap
and become sticky (:transient t) suffixes; the rest exit after invoke.
Non-symbol CMDs (lambdas, call forms like (fn arg)) get deterministic
wrapper names (my/<hydra>-<key>-action).
A \"Back\" group linking to BACK-TARGET is appended automatically.
The menu command is <HYDRA-NAME>/body, same as the Hydra era."
  (declare (indent defun))
  (let ((groups '())
        (state-binds '())
        (wrappers '()))
    (while spec
      (let ((group-name (pop spec))
            (bindings (pop spec)))
        (push (list group-name
                    (mapcar (lambda (b)
                              (let ((key (nth 0 b))
                                    (cmd (nth 1 b))
                                    (label (nth 2 b))
                                    (exit (plist-get (nthcdr 3 b) :exit)))
                                (unless (symbolp cmd)
                                  (let ((w (intern (format "my/%s-%s-action"
                                                           (substring (symbol-name hydra-name) 3)
                                                           key))))
                                    (push `(defun ,w ()
                                             ,(format "Wrapper for %s %s menu key." hydra-name key)
                                             (interactive)
                                             ,(if (and (consp cmd) (eq (car cmd) 'lambda))
                                                  `(funcall ,cmd)
                                                cmd))
                                          wrappers)
                                    (setq cmd w)))
                                (append (list key label cmd)
                                        (when (eq exit nil) '(:transient t)))))
                            bindings))
              groups)
        (dolist (b bindings)
          (unless (plist-get (cdddr b) :exit)
            (push (list (nth 0 b) (nth 1 b)) state-binds)))))
    (setq groups (nreverse groups)
          state-binds (nreverse state-binds))
    (let ((back-group
           (when back-target
             `([ "Back" :class transient-column
                 ("SPC" ,(cadr back-target) ,(car back-target)) ]))))
      `(progn
         ,@wrappers
         ,@(when state-name
             `((biomechanical-input-interface-define-keys
                :states '(,state-name)
                :bind ',state-binds)))
         (transient-define-prefix
             ,(intern (format "%s/body" hydra-name)) ()
           ,title
           ,@(mapcar (lambda (g)
                       (apply #'vector (car g) :class 'transient-column
                              (cadr g)))
                     groups)
           ,@back-group)
         (when (boundp 'my/menus-hydra-registry)
           (cl-pushnew (cons ',hydra-name ,title)
                       my/menus-hydra-registry :test #'equal))))))

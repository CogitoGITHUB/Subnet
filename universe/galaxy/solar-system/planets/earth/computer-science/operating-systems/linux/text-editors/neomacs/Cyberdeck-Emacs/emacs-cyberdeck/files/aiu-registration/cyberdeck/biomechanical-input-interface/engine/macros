(defmacro biomechanical-input-interface-define-state (state &rest body)
  "Define a new STATE minor mode with options in BODY.
:init INIT-FN registers an auto-activation predicate: a function
symbol (preferred) or lambda, called with no args — non-nil means
activate this state. Nil (default) leaves activation manual.
Registration is a side effect of expansion: dropping this file's
invocation unregisters the state on next boot, nothing else touched."
  (declare (indent defun))
  (let ((mode (biomechanical-input-interface-get-state-mode state))
        (keymap (biomechanical-input-interface-get-state-keymap state))
        (init (plist-get body :init)))
    `(progn
       (biomechanical-input-interface--define-minor-mode ,mode ,keymap ,body)
       (cl-pushnew (cons ,state ,init) biomechanical-input-interface-state-init-alist
                   :key #'car :test #'equal))))



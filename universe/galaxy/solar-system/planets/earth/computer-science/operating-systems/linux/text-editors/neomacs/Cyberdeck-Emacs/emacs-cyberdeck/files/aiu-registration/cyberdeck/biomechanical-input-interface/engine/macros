(defmacro biomechanical-input-interface--define-minor-mode (mode keymap body)
  "Define a minor MODE with KEYMAP and options in BODY."
  (let ((mode-name (symbol-name mode))
        (sparse (plist-get body :sparse))
        (no-suppress (plist-get body :no-suppress))
        (lighter (plist-get body :lighter))
        (cursor-type (plist-get body :cursor-type))
        (no-emulation (plist-get body :no-emulation)))
    `(progn
      (defvar ,keymap
        (if ,sparse (make-sparse-keymap) (make-keymap))
        ,(format "Keymap for %s." mode-name))
      (unless ,no-suppress
        (suppress-keymap ,keymap))
      (define-minor-mode ,mode
        ,(format "Biomechanical-Input-Interface minor mode %s" mode-name)
        :lighter ,lighter
        :keymap ,keymap
        (when ,cursor-type (setq-local cursor-type ,cursor-type)))
      (unless ,no-emulation
        (unless (boundp 'biomechanical-input-interface--emulation-mode-map-alist)
          (setq biomechanical-input-interface--emulation-mode-map-alist nil))
        (add-to-list 'biomechanical-input-interface--emulation-mode-map-alist (cons ',mode ,keymap))
        (add-to-list 'emulation-mode-map-alists biomechanical-input-interface--emulation-mode-map-alist)))))

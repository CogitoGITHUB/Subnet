**** Per-aiu and reverse lookups
#+begin_src emacs-lisp
(defun my/cyberdeck-citations-for-aiu (aiu-id)
  "Return list of citekeys cited by NOTE-ID."
  (mapcar #'car
          (emacsql (cyberdeck-db)
                   [:select [citekey] :from citations
                    :where (= aiu-id $s1)]
                   aiu-id)))

(defun my/cyberdeck-aius-citing (citekey)
  "Return list of (id title) for notes that cite CITEKEY."
  (emacsql (cyberdeck-db)
           [:select [notes:id notes:title]
            :from notes
            :inner :join citations
            :on   (= notes:id citations:aiu-id)
            :where (= citations:citekey $s1)]
           citekey))
#+end_src

**** Frequency counts
#+begin_src emacs-lisp
(defun my/cyberdeck-citation-counts ()
  "Return alist of (citekey . count) sorted by frequency descending."
  (mapcar (lambda (row) (cons (car row) (cadr row)))
          (emacsql (cyberdeck-db)
                   [:select [citekey (funcall count aiu-id)]
                    :from citations
                    :group :by citekey
                     :order :by [(desc (funcall count aiu-id))]])))
#+end_src

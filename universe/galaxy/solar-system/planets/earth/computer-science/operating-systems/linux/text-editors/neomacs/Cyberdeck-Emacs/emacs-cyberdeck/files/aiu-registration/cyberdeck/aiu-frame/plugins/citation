**** Citation scanning
#+begin_src emacs-lisp
(defun my/cyberdeck--scan-citekeys (ast)
  "Return unique [@citekey] citations found in AST paragraphs."
  (let ((found nil))
    (org-element-map ast 'paragraph
      (lambda (para)
        (let ((text  (org-element-interpret-data para))
              (start 0))
          (while (string-match "\\[@\\([^]]+\\)\\]" text start)
            (push (match-string 1 text) found)
            (setq start (match-end 0))))))
    (when found
      (delete-dups (nreverse found)))))
#+end_src

**** Extractor command
#+begin_src emacs-lisp
(defun my/cyberdeck-extract-citations (ctx aiu-data)
  "Extract [@citekey] citations from org paragraphs in CTX.
Inserts unique citekeys into the citations table and sets
:citations on NOTE-DATA for downstream extractors."
  (let* ((ast     (cyberdeck-parse-ctx-ast ctx))
         (aiu-id (plist-get aiu-data :id))
         (unique  (my/cyberdeck--scan-citekeys ast)))
    (when unique
      (emacsql (cyberdeck-db)
               [:delete :from citations :where (= aiu-id $s1)]
               aiu-id)
      (emacsql (cyberdeck-db)
               [:insert :into citations :values $v1]
               (mapcar (lambda (k) (vector aiu-id k)) unique))
      (plist-put aiu-data :citations unique))
    aiu-data))
#+end_src

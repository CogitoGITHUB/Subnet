(defun my/cyberdeck-citations-ensure-table ()
  "Create the citations table if it does not already exist."
  (emacsql (cyberdeck-db)
           [:create :table :if :not :exists citations
            ([(aiu-id :not-null)
              (citekey  :not-null)]
             (:primary-key [aiu-id citekey])
             (:foreign-key [aiu-id] :references notes [id]
              :on-delete :cascade))]))
(with-eval-after-load 'cyberdeck
  (add-hook 'cyberdeck-db-autosync-mode-hook
            #'my/cyberdeck-citations-ensure-table))

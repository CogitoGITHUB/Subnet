AIU nodes todo's list from every .org in Cyberdeck-Emacs/modules/.

** Widget
#+begin_src emacs-lisp
(aiu-cyber-desk-define-widget todos
  :doc "AIU nodes todo's list section."
  :generate
  ((let ((todos (cyberdeck-emacs-splash--module-todos)))
     (dashboard-insert-heading "aiu nodes todo's list:" nil nil)
     (insert "\n")
     (if (null todos)
         (insert "    --- No items ---\n")
       (dolist (td todos)
         (insert (format "    %s: %s\n"
                         (propertize (car td) 'face 'bold)
                         (cdr td))))))))
#+end_src

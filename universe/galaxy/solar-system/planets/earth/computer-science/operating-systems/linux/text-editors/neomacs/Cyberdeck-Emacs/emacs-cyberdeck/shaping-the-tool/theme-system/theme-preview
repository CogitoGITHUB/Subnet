(defun theme-color-dark-p (color)
  "Return non-nil if hexadecimal RGB COLOR is dark.
Test that COLOR has more contrast against white than black."
  (> (theme-contrast color "#ffffff")
     (theme-contrast color "#000000")))

(defun theme-get-readable-foreground (color)
  "Get readable foreground for background hexadecimal RGB COLOR."
  (if (theme-color-dark-p color)
      "#ffffff"
    "#000000"))

(defun theme--list-colors-get-mappings (palette)
  "Get the semantic palette entries in PALETTE.
PALETTE is the value of a variable like `palette-light'."
  (seq-remove
   (lambda (cell)
     (stringp (cadr cell)))
   palette))

(defun theme--list-colors-tabulated (theme &optional mappings)
  "Return a data structure of THEME palette or MAPPINGS for tabulated list."
  (let* ((current-palette (theme-get-theme-palette theme :with-overrides :with-user-palette))
         (palette (if mappings
                      (theme--list-colors-get-mappings current-palette)
                    current-palette)))
    (mapcar
     (lambda (entry)
       (pcase-let* ((`(,name ,value) entry)
                    (name-string (format "%s" name))
                    (value-string (format "%s" value))
                    (value-string-padded (format "%-30s" value-string))
                    (color (theme-get-color-value name :with-overrides theme))) ; resolve a semantic mapping
         (list
          (cons entry color)
          (vector
           (pcase value
             ('unspecified "---")
             ((pred symbolp) "Yes")
             (_ ""))
           name-string
           (propertize value-string 'face `( :foreground ,color))
           (propertize value-string-padded 'face `( :background ,color
                                                    :foreground ,(if (string= color "unspecified")
                                                                     (theme-get-readable-foreground (theme-get-color-value 'bg-main nil theme))
                                                                   (theme-get-readable-foreground color))))))))
     palette)))

(defvar theme-current-preview nil)
(defvar theme-current-preview-show-mappings nil)

(defun theme--set-tabulated-entries ()
  "Set the value of `tabulated-list-entries' with palette entries."
  (setq-local tabulated-list-entries
              (theme--list-colors-tabulated theme-current-preview theme-current-preview-show-mappings)))

(defun theme-list-colors (theme &optional mappings)
  "Preview the palette of the THEME of choice.
With optional prefix argument for MAPPINGS preview only the semantic
color mappings instead of the complete palette."
  (interactive
   (let ((prompt (if current-prefix-arg
                     "Preview palette mappings of THEME"
                   "Preview palette of THEME")))
     (list
      (theme-select-prompt prompt)
      current-prefix-arg)))
  (theme-activate theme)
  (let ((buffer (get-buffer-create (format (if mappings "*%s-list-mappings*" "*%s-list-all*") theme))))
    (with-current-buffer buffer
      (let ((theme-current-preview theme)
            (theme-current-preview-show-mappings mappings))
        (theme-preview-mode)))
    (pop-to-buffer buffer)))

(defalias 'theme-preview-colors 'theme-list-colors
  "Alias for `theme-list-colors'.")

(defun theme-list-colors-current (&optional mappings)
  "Like `theme-list-colors' with optional MAPPINGS for the current theme."
  (interactive "P")
  (theme-list-colors (theme-get-current-theme) mappings))

(defalias 'theme-preview-colors-current 'theme-list-colors-current
  "Alias for `theme-list-colors-current'.")

(defvar-local theme-preview-mode--marked-entries nil
  "List of entries marked in the `theme-list-colors' buffer.")

(defun theme-preview-mode-mark ()
  "Mark a palette entry in the `theme-list-colors' buffer."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (when-let* ((id-at-point (tabulated-list-get-id)))
    (add-to-list 'theme-preview-mode--marked-entries id-at-point)
    (tabulated-list-put-tag "*" t)))

(defun theme-preview-mode-mark-all ()
  "Mark all palette entries in the `theme-list-colors' buffer."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (save-excursion
    (goto-char (point-min))
    (while (re-search-forward (format "^\s\\{%d,\\}" tabulated-list-padding) nil t)
      (call-interactively 'theme-preview-mode-mark))))

(defun theme-preview-mode-unmark ()
  "Unmark a palette entry in the `theme-list-colors' buffer."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (when-let* ((id-at-point (tabulated-list-get-id)))
    (setq-local theme-preview-mode--marked-entries (delq id-at-point theme-preview-mode--marked-entries))
    (tabulated-list-put-tag " " t)))

(defun theme-preview-mode-unmark-all ()
  "Unmark all palette entries in the `theme-list-colors' buffer."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (setq-local theme-preview-mode--marked-entries nil)
  (tabulated-list-clear-all-tags))

(defun theme-preview-mode-copy-entry ()
  "Copy marked entries or entry at point in the `theme-list-colors' buffer.
Each entry is of the form that appears is the underlying palette.  This
is useful as a starting point for writing palette overrides.

Also see `theme-preview-mode-copy-color'."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (cond
   (theme-preview-mode--marked-entries
    (let* ((entries (copy-sequence theme-preview-mode--marked-entries))
           (colors (mapcar #'car (nreverse entries))))
      (kill-new (format "%S" colors))
      (message "Copied all marked entries: `%S'" colors)))
   ((when-let* ((color (car (tabulated-list-get-id)))
                (string (format "%S" color)))
      (kill-new string)
      (message "Copied palette entry: `%s'" (propertize string 'face 'success))))
   (t
    (user-error "Nothing to copy"))))

(defun theme-preview-mode-copy-color ()
  "Copy marked colors or colors at point in the `theme-list-colors' buffer.
Each color is a string.  Also see `theme-preview-mode-copy-entry'."
  (declare (interactive-only t))
  (interactive nil theme-preview-mode)
  (unless (derived-mode-p 'theme-preview-mode)
    (user-error "Only use this command inside the `theme-preview-mode'"))
  (cond
   (theme-preview-mode--marked-entries
    (let* ((entries (copy-sequence theme-preview-mode--marked-entries))
           (colors (mapcar #'cdr (nreverse entries))))
      (kill-new (format "%S" colors))
      (message "Copied all marked entries: `%S'" colors)))
   ((when-let* ((color (cdr (tabulated-list-get-id)))
                (string (format "%S" color)))
      (kill-new string)
      (message "Copied palette entry: `%s'" (propertize string 'face 'success))))
   (t
    (user-error "Nothing to copy"))))

(defvar theme-preview-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "m") #'theme-preview-mode-mark)
    (define-key map (kbd "M") #'theme-preview-mode-mark-all)
    (define-key map (kbd "u") #'theme-preview-mode-unmark)
    (define-key map (kbd "U") #'theme-preview-mode-unmark-all)
    (define-key map (kbd "w") #'theme-preview-mode-copy-color)
    (define-key map (kbd "W") #'theme-preview-mode-copy-entry)
    map)
  "Key map for `theme-preview-mode'.")

(define-derived-mode theme-preview-mode tabulated-list-mode "Theme palette"
  "Major mode to display a themes palette."
  :interactive nil
  (setq-local theme-preview-mode--marked-entries nil)
  (setq-local tabulated-list-padding 2)
  (setq-local tabulated-list-format
              [("Mapping?" 10 t)
               ("Symbol name" 30 t)
               ("As foreground" 30 t)
               ("As background" 0 t)])
  (theme--set-tabulated-entries)
  (tabulated-list-init-header)
  (tabulated-list-print))



;;;; Internal functions

(defun theme--warn (option)
  "Warn that OPTION has changed."
  (prog1 nil
    (display-warning
     'theme-system
     (format "`%s' has changed; please read the updated documentation" option)
     :warning)))

(defun theme--list-or-warn (option)
  "Return list or nil value of OPTION, else `theme--warn'."
  (let* ((value (symbol-value option)))
    (if (or (null value) (listp value))
        value
      (theme--warn option))))

(defun theme--property-lookup (properties alist-key list-pred default)
  "Return value from property alist or list.
Check PROPERTIES for an alist value that corresponds to
ALIST-KEY.  If no alist is present, search the PROPERTIES
list given LIST-PRED, using DEFAULT as a fallback."
  (if-let* ((val (or (alist-get alist-key properties)
                     (seq-filter (lambda (x) (funcall list-pred x)) properties)
                     default))
            ((listp val)))
      (car val)
    val))

;; Helper functions that are meant to ease the implementation of the
;; above customization variables.
(defun theme--bold-weight ()
  "Conditional use of a heavier text weight."
  (when theme-bold-constructs
    (list :inherit 'bold)))

(defun theme--slant ()
  "Conditional use of italics for slant attribute."
  (when theme-italic-constructs
    (list :inherit 'italic)))

(defun theme--fixed-pitch ()
  "Conditional application of `fixed-pitch' inheritance."
  (when theme-mixed-fonts
    (list :inherit 'fixed-pitch)))

(defun theme--variable-pitch-ui ()
  "Conditional use of `variable-pitch' in UI elements."
  (when theme-variable-pitch-ui
    (list :inherit 'variable-pitch)))

(defconst theme-weights
  '( thin ultralight extralight light semilight regular medium
     semibold bold heavy extrabold ultrabold)
  "List of font weights.")

(defun theme--weight (list)
  "Search for `theme-weights' weight in LIST."
  (catch 'found
    (dolist (elt list)
      (when (memq elt theme-weights)
        (throw 'found elt)))))

(defun theme--heading (level fg &optional bg ol)
  "Conditional styles for `theme-headings'.

LEVEL is the heading's position in their order.  FG is the
default text color.  Optional BG is an appropriate background.
Optional OL is the color of an overline."
  (let* ((key (alist-get level theme-headings))
         (style (or key (alist-get t theme-headings)))
         (style-listp (listp style))
         (properties style)
         (var (when (and style-listp (memq 'variable-pitch properties)) 'variable-pitch))
         (weight (when style-listp (theme--weight style))))
    (list :inherit (cond
                    ((not style-listp) 'bold)
                    ;; `no-bold' is for backward compatibility because we cannot
                    ;; deprecate a variable's value.
                    ((or weight (memq 'no-bold properties))
                     var)
                    (var (append (list 'bold) (list var)))
                    (t 'bold))
          :background (or bg 'unspecified)
          :foreground fg
          :overline (or ol 'unspecified)
          :height (if style-listp
                      (theme--property-lookup properties 'height #'floatp 'unspecified)
                    'unspecified)
          :weight (or weight 'unspecified))))


;; NOTE 2025-11-23: In theory we need the `theme--box'
;; equivalent for this:
;;
;;     :underline (:style wave :color unspecified)
;;
;; I checked all the relevant faces and feel that users will not be
;; benefitting form such a style anyway.  What would be the point of a
;; spell checker that cannot highlight its errors, for example?
;; Granted, we could have another kind of highlight, but I am here
;; focusing on the use of this:
;;
;;     :underline unspecified
(defun theme--box (color width style)
  "Return :box COLOR, WIDTH, STYLE if appropriate.
If COLOR is unspecified, then return :box unspecified."
  (cond
   ((eq color 'unspecified)
    '(:box unspecified))
   ((and width style)
    `(:box (:line-width ,width :color ,color :style ,style)))
   (width
    `(:box (:line-width ,width :color ,color)))
   (style
    `(:box (:color ,color :style ,style)))
   (t
    `(:box ,color))))

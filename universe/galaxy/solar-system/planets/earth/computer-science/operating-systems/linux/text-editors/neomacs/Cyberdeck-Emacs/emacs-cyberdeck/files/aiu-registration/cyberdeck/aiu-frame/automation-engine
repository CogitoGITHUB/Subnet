(defun my/cyberdeck-automation-condition-met-p (condition)
  "Non-nil when CONDITION holds in the current buffer."
  (pcase (car condition)
    (:always t)
    (:drawer-equals
     (let ((key (nth 1 condition)) (val (nth 2 condition)))
       (and (fboundp 'my/cyberdeck--drawer-get)
            (save-excursion
              (ignore-errors (org-back-to-heading t))
              (equal (my/cyberdeck--drawer-get key) val)))))
    (:tag-present
     (let ((tag (nth 1 condition)))
       (or (member tag (ignore-errors (org-get-tags)))
           (save-excursion
             (goto-char (point-min))
             (re-search-forward (concat "#" (regexp-quote tag)
                                       "\\([^A-Za-z0-9_@/]\\|$\\)")
                                nil t)))))
    (_ nil)))

(defun my/cyberdeck-automation-run-actions (actions)
  "Run ACTIONS in the current buffer."
  (dolist (a actions)
    (pcase (car a)
      (:set-drawer
       (when (fboundp 'my/cyberdeck--drawer-put)
         (save-excursion
           (ignore-errors (org-back-to-heading t))
           (my/cyberdeck--drawer-put (nth 1 a) (nth 2 a)))))
      (:add-inline-tag
       (insert (format " #%s" (nth 1 a))))
      (:message (message "%s" (nth 1 a)))
      (:call (ignore-errors (apply (nth 1 a) (nthcdr 2 a)))))))

(defun my/cyberdeck-automation-run-rule (rule)
  "Evaluate RULE's condition, run actions when met.  Never throws."
  (condition-case err
      (when (my/cyberdeck-automation-condition-met-p (plist-get rule :condition))
        (my/cyberdeck-automation-run-actions (plist-get rule :actions)))
    (error (message "automation '%s': %s"
                    (plist-get rule :name) (error-message-string err)))))

(defun my/cyberdeck-automation-on-save ()
  "After-save entry: run :after-save rules for vault org files."
  (when (and buffer-file-name (derived-mode-p 'org-mode))
    (let ((root (ignore-errors (my/cyberdeck-root-dir))))
      (when (and root (file-in-directory-p buffer-file-name root))
        (dolist (rule my/cyberdeck-automations)
          (when (eq (car (plist-get rule :trigger)) :after-save)
            (my/cyberdeck-automation-run-rule rule)))))))

(defun my/cyberdeck-automation-tick ()
  "Scheduler entry: run due :schedule rules."
  (let ((now (float-time)) (ran nil))
    (dolist (rule my/cyberdeck-automations)
      (let ((trig (plist-get rule :trigger)))
        (when (eq (car trig) :schedule)
          (let ((last (or (plist-get rule :last-run) 0)))
            (when (>= (- now last) (nth 1 trig))
              (plist-put rule :last-run now)
              (setq ran t)
              (my/cyberdeck-automation-run-rule rule))))))
    (when ran (my/cyberdeck-automations-save))))

(defvar my/cyberdeck-automation-timer nil
  "Scheduler timer (60s cadence).")

(unless my/cyberdeck-automation-timer
  (setq my/cyberdeck-automation-timer
        (run-with-timer 60 60 #'my/cyberdeck-automation-tick)))

(add-hook 'after-save-hook #'my/cyberdeck-automation-on-save)
#+end_src

(require 'cl-lib)

(defvar my/cyberdeck-automation-file
  (expand-file-name ".local/cache/aiu-frame-automations.el" (expand-file-name "~"))
  "Persisted list of rule plists.")

(defvar my/cyberdeck-automations nil
  "List of rule plists (:name :trigger :condition :actions :last-run).")

(defun my/cyberdeck-automations-load ()
  (setq my/cyberdeck-automations nil)
  (condition-case nil
      (when (file-exists-p my/cyberdeck-automation-file)
        (setq my/cyberdeck-automations
              (car (read-from-string
                    (with-temp-buffer
                      (insert-file-contents my/cyberdeck-automation-file)
                      (buffer-string))))))
    (error nil)))

(defun my/cyberdeck-automations-save ()
  (condition-case nil
      (let ((tmp (concat my/cyberdeck-automation-file ".tmp"))
            (print-length nil) (print-level nil))
        (make-directory (file-name-directory my/cyberdeck-automation-file) t)
        (with-temp-file tmp (prin1 my/cyberdeck-automations (current-buffer)))
        (rename-file tmp my/cyberdeck-automation-file t))
    (error nil)))

(my/cyberdeck-automations-load)

(defun my/cyberdeck-automation-add (rule)
  "Add RULE plist and persist.  RULE: (:name S :trigger T :condition C
:actions (A...)).  Trigger: (:after-save) (:schedule SECS) (:manual).
Condition: (:always) (:drawer-equals KEY VAL) (:tag-present TAG).
Action: (:set-drawer KEY VAL) (:add-inline-tag TAG) (:message TEXT)
(:call FN &rest ARGS)."
  (push rule my/cyberdeck-automations)
  (my/cyberdeck-automations-save)
  rule)

(defun my/cyberdeck-automation-delete (name)
  "Delete the rule named NAME."
  (setq my/cyberdeck-automations
        (cl-remove-if (lambda (r) (string= (plist-get r :name) name))
                      my/cyberdeck-automations))
  (my/cyberdeck-automations-save))

(defun my/cyberdeck-automation-list ()
  "Rule names."
  (mapcar (lambda (r) (plist-get r :name)) my/cyberdeck-automations))
#+end_src


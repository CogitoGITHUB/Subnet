#+begin_src emacs-lisp
;; Package keymap; declared for compiles that run before load.
(defvar treemacs-mode-map)
(with-eval-after-load 'treemacs
  (define-key treemacs-mode-map (kbd "h") #'treemacs-goto-parent-node)
  (define-key treemacs-mode-map (kbd "t") #'treemacs-next-line)
  (define-key treemacs-mode-map (kbd "n") #'treemacs-previous-line)
  (define-key treemacs-mode-map (kbd "o") #'treemacs-RET-action)
  (define-key treemacs-mode-map (kbd "r") #'treemacs-rename-file)
  (define-key treemacs-mode-map (kbd "c") #'treemacs-create-file)
  (define-key treemacs-mode-map (kbd "C") #'treemacs-create-dir)
  (define-key treemacs-mode-map (kbd "d") #'treemacs-delete-file)
  (define-key treemacs-mode-map (kbd "f") #'treemacs-find-file)
  (define-key treemacs-mode-map (kbd "p") #'treemacs-add-project-to-workspace)
  (define-key treemacs-mode-map (kbd "q") #'treemacs-quit)
  (define-key treemacs-mode-map (kbd "F") #'my/treemacs-toggle)
  (define-key treemacs-mode-map (kbd "R") #'treemacs-refresh))
#+end_src

(defvar my/aiu-subnet--default-warned-files nil
  "Files already warned about default-map fallback this session.")

(defun my/aiu-subnet-db-ready-p ()
  "Non-nil when the cyberdeck DB answers AIU Subnet queries."
  (and (fboundp 'emacsql)
       (fboundp 'cyberdeck-db)
       (condition-case nil
           (not (null (cyberdeck-db)))
         (error nil))))

(defun my/aiu-subnet-db-text (v)
  "Decode a TEXT value from the AIU Cyberdeck DB into a string or nil.
Stored printed form parses back on read, so strings arrive
decoded; legacy bare tokens arrive as symbols and are coerced
via symbol-name. Anything else becomes nil. Never throws."
  (condition-case nil
      (cond ((stringp v) v)
            ((symbolp v) (symbol-name v))
            (t nil))
    (error nil)))

(defun my/aiu-subnet-db-aiu-rows ()
  "Aligned vault note rows as (ID TITLE PATH UNFOLDINGS) plists.
Alignment rule: a returned row has exactly 4 elements. The
driver splices every readable object of a bare-stored cell into
the row, so bare multi-token titles shift columns (lengths 5-13
seen in the wild); length 4 proves each cell contributed exactly
one object, hence positions are correct. PATH is absolutized
against the vault root: historical rows store vault-relative
paths (arriving as symbols), and every consumer does
file-exists-p and same-directory compares that only make sense
absolute. UNFOLDINGS is the parsed drawer alist or nil: printed
forms arrive decoded (strings need one more read,
single-printed alists arrive as lists), legacy bare tokens
become nil and heal from disk via the callers' same-directory
union. One indexed query over small rows — milliseconds, no file
opens. The DB is the index; files stay source of truth. Returns
nil when the DB is unreachable, and callers fall back to file
reads. Never throws."
  (condition-case nil
      (when (my/aiu-subnet-db-ready-p)
        (let (out)
          (dolist (r (emacsql (cyberdeck-db)
                              [:select [id title path unfoldings]
                               :from notes]))
            (when (= (length r) 4)
              (let* ((unf-raw (nth 3 r))
                     (unf (cond ((null unf-raw) nil)
                                ((listp unf-raw) unf-raw)
                                ((stringp unf-raw)
                                 (let ((x (ignore-errors
                                           (car (read-from-string unf-raw)))))
                                   (and (listp x) x)))
                                (t nil)))
                     (p (my/aiu-subnet-db-text (nth 2 r))))
                (push (list :id (my/aiu-subnet-db-text (nth 0 r))
                            :title (my/aiu-subnet-db-text (nth 1 r))
                            :path (my/aiu-subnet-db-absolute-path p)
                            :unfoldings unf)
                      out))))
          (nreverse out)))
    (error nil)))

(defun my/aiu-subnet-db-absolute-path (path)
  "PATH absolutized against the vault root when relative.
Historical rows store vault-relative paths; consumers need
absolute ones for existence and directory compares. A value
wrapped in literal quotes (double-printed artifact or quoted
paste) is unwrapped first: without this, expand-file-name reads
it as relative and nests the whole absolute path under the root
— the `ROOT/\"...\"' garbage-tree failure. Absolute paths, nil,
and non-strings pass through (non-strings as nil). Never throws."
  (condition-case nil
      (when (stringp path)
        (let ((c (string-trim path)))
          ;; Strip surrounding quote layers (34 dq, 39 sq, 96 bq):
          ;; char codes, never literals (boot scanner limitation).
          (while (and (>= (length c) 2)
                      (let ((f (aref c 0)) (l (aref c (1- (length c)))))
                        (and (memq f '(34 39 96)) (eq f l))))
            (setq c (string-trim (substring c 1 (1- (length c))))))
          (if (file-name-absolute-p c)
              c
            (let ((root (and (fboundp 'my/cyberdeck-root-dir)
                             (ignore-errors
                              (my/cyberdeck-root-dir)))))
              (if (and (stringp root) (file-directory-p root))
                  (expand-file-name c root)
                c)))))
    (error nil)))

(defun my/aiu-subnet-strip-title-tags (title)
  "TITLE without a trailing org tag run, mirroring headline text.
The DB stores raw headlines including tags; file reads exclude
them. Stripping keeps both sources identical for sync compares."
  (if (and (stringp title)
           (string-match "\\s-+\\(:[[:alnum:]_@:-]*:\\)\\s-*$" title))
      (string-trim (substring title 0 (match-beginning 0)))
    title))

(defun my/aiu-subnet-drawer-alist (file)
  "Drawer of FILE's first headline as an alist, or nil.
Single-file fallback for paths the DB missed. Never throws."
  (condition-case nil
      (when (and file (file-exists-p file))
        (with-temp-buffer
          (insert-file-contents file)
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*:PROPERTIES:[ \t]*$" nil t)
            (let (out)
              (while (re-search-forward
                      "^[ \t]*:\\([^ :\n]+\\):[ \t]*\\(.*\\)$" nil t)
                (let ((k (match-string 1)))
                  (if (string= k "END")
                      (goto-char (point-max))
                    (push (cons k (match-string 2)) out))))
              (nreverse out)))))
    (error nil)))

(defun my/aiu-subnet-maps-info ()
  "All known maps as ((ID TITLE FILE ORDER)) from the DB.
Falls back to a filesystem walk only when the DB is unreachable.
Skips vanished paths. Never throws."
  (condition-case nil
      (let ((rows (my/aiu-subnet-db-aiu-rows)))
        (if (null rows)
            (my/aiu-subnet-maps-info--scan)
          (let (out)
            (dolist (r rows)
              (let ((unf (plist-get r :unfoldings))
                    (p (plist-get r :path)))
                (when (and (equal (cdr (assoc "MM_KIND" unf)) "map")
                           (stringp p)
                           (file-exists-p p))
                  (push (list (plist-get r :id)
                              (my/aiu-subnet-strip-title-tags (plist-get r :title))
                              p
                              (my/aiu-subnet-order-of-aiu-contexts unf))
                        out))))
            (nreverse out))))
    (error nil)))

(defun my/aiu-subnet-order-of-aiu-contexts (unf)
  "MM_ORDER float from drawer alist UNF, huge when absent."
  (let ((o (cdr (assoc "MM_ORDER" unf))))
    (if (and (stringp o) (string-match-p "^-?[0-9.]+$" o))
        (string-to-number o)
      1e18)))

(defun my/aiu-subnet-maps-info--scan ()
  "Legacy filesystem walk for map discovery (DB unreachable).
Opens every vault file once. Never throws."
  (condition-case nil
      (let (out)
        (when (fboundp 'my/cyberdeck-root-dir)
          (let ((root (ignore-errors (my/cyberdeck-root-dir))))
            (when (and root (file-directory-p root))
              (dolist (f (directory-files-recursively root "[^./]+$"))
                (when (and (file-regular-p f)
                           (not (string-match-p "/\\.git/" f))
                           (not (string-match-p "/WIP/" f))
                           (equal (my/aiu-subnet-file-drawer-get f "MM_KIND") "map"))
                  (push (list (my/aiu-subnet-file-id f)
                              (my/aiu-subnet-sync-file-title f)
                              f
                              (let ((o (my/aiu-subnet-file-drawer-get f "MM_ORDER")))
                                (if (and o (string-match-p "^-?[0-9.]+$" o))
                                    (string-to-number o)
                                  1e18)))
                        out))))))
        (nreverse out))
    (error nil)))

(defun my/aiu-subnet-map-files ()

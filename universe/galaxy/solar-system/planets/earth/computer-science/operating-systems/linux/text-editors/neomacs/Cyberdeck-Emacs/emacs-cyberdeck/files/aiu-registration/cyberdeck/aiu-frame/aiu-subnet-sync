            (t
             (let ((m (my/aiu-subnet-primary-map buffer-file-name)))
               (when (and m (file-exists-p m))
                 (my/aiu-subnet-sync-map m))))))))

(unless (member #'my/aiu-subnet-sync-on-save after-save-hook)
  (add-hook 'after-save-hook #'my/aiu-subnet-sync-on-save))

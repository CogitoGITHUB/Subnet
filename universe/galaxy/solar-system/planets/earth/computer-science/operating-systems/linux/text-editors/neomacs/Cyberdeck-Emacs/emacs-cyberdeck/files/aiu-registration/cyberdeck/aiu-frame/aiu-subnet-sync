(defun my/aiu-subnet-validate-map-dir (dir)
  "Signal an error if DIR already holds an aiu-subnet file.
Enforces: no two map files in one directory. DB-backed, with a
single-directory readdir fallback so an unsynced on-disk map can
never slip through and violate the law."
  (let* ((ddir (file-name-directory (directory-file-name
                                     (expand-file-name dir))))
         (found (cl-remove-if-not
                 (lambda (f)
                   (equal (file-name-directory (directory-file-name f))
                          ddir))
                 (my/aiu-subnet-map-files))))
    (unless found
      ;; Unsynced files on disk: check this one directory only
      ;; (a handful of opens, not a vault walk).
      (when (file-directory-p ddir)
        (dolist (f (directory-files ddir t "^[^.]"))
          (when (and (file-regular-p f)
                     (null (file-name-extension f))
                     (equal (my/aiu-subnet-file-drawer-get f "MM_KIND") "map"))
            (push f found)))))
    (when found
      (error "Directory already has an AIU Subnet file: %s"
             (file-name-nondirectory (car found))))))

    (push (list (org-aiu-subnet-parser-node-row node)
                (org-aiu-subnet-parser-node-col node)
                (org-aiu-subnet-parser-node-width node)
                (org-aiu-subnet-parser-node-text node)
                (not (null (and (fboundp 'org-aiu-subnet-parser-node-parent)
                                (org-aiu-subnet-parser-node-parent node)))))
          acc)

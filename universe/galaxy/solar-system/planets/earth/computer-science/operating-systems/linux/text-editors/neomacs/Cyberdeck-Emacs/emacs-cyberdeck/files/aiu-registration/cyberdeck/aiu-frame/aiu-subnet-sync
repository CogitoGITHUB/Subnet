(defun my/aiu-subnet-file-drawer-get (file key)
  "Drawer KEY from FILE's first headline, or nil."
  (when (and file (file-exists-p file))
    (with-temp-buffer
      (insert-file-contents file)
      ;; The macro form, exactly: on Emacs 30 it pre-makes
      ;; delay-mode-hooks buffer-local before binding, so org's own
      ;; startup makes no complaint. A bare let around org-mode
      ;; skips that step and warns on every call.
      (delay-mode-hooks (org-mode))
      (goto-char (point-min))
      (when (re-search-forward org-heading-regexp nil t)
        (org-entry-get (point) key)))))


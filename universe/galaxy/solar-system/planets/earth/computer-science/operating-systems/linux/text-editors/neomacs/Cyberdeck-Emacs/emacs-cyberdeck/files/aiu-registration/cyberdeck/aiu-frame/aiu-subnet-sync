(defun my/aiu-subnet-default-map (file)
  "Nearest ancestor directory of FILE containing a map file.
Documented fallback when FILE has no explicit AIU_SUBNET_MAP. Logs a soft
warning once per file per session so missing AIU_SUBNET_MAP gets noticed."
  (let* ((dir (file-name-directory (directory-file-name
                                    (expand-file-name file))))
         (best nil)
         (best-len -1))
    (dolist (m (my/aiu-subnet-map-files))
      (let ((mdir (file-name-directory (directory-file-name m))))
        (when (and (string-prefix-p mdir dir)
                   (> (length mdir) best-len))
          (setq best m best-len (length mdir)))))
    (when (and best (not (member file my/aiu-subnet--default-warned-files)))
      (push file my/aiu-subnet--default-warned-files)
      (display-warning 'cyberdeck
                       (format "No explicit AIU_SUBNET_MAP on %s; using nearest map %s"
                               (file-name-nondirectory file)
                               (file-name-nondirectory best))
                       :warning))
    best))

(defun my/aiu-subnet-primary-map (file)

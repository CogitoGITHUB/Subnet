                  (when id
                    (push (list id f (my/aiu-subnet-sync-node-text f)
                                (let ((o (my/aiu-subnet-file-drawer-get f "MM_ORDER")))
                                  (if (and o (string-match-p "^-?[0-9.]+$" o))
                                      (string-to-number o)
                                    1e18)))
                          out)))))))
        (sort out (lambda (a b) (< (nth 3 a) (nth 3 b)))))
    (error nil)))

(defun my/aiu-subnet-sync-region-rows (map-file)
  "AIU rows of MAP-FILE's aiu-subnet region.
Each entry: (ROW COL WIDTH TEXT HAD-PARENT). The parent flag lets
text sync partition the structural root (map title) from member
rows without touching vendor node objects."
  (when (and (fboundp 'org-aiu-subnet-parser-parse-region)
             (fboundp 'org-aiu-subnet-parser-node-text)
             (fboundp 'org-aiu-subnet-parser-node-parent))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
          (forward-line 1)
          (let ((roots (ignore-errors (org-aiu-subnet-parser-parse-region)))

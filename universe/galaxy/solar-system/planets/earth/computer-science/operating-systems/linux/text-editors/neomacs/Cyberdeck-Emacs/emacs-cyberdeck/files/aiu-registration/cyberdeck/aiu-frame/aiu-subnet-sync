** Structural sync (vendor-op rebuild)
Bare title rows are NOT structure: the vendor parser reads them as
continuation text and the next align would merge them away (proven:
insert "B" under bare "A", align, region collapses to one node).
So structural change rebuilds through the vendor ops instead: drop
directives (they would confuse the parse; reconciled after),
wipe the region, insert-root the map title, then insert each
member title as a sibling anchored on the root. Sibling-on-root
delegates to insert-child, which APPENDS, so call order equals
MM_ORDER exactly with no anchor matching at all. Failure modes
degrade to parseable states (empty or partial region); the next
sync retries. Never throws.
#+begin_src emacs-lisp
;; Forward declaration: vendor confirmation flag, bound dynamically
;; below. Declared so the byte-compiler sees dynamic intent.
(defvar org-aiu-subnet-confirm-delete)
(defun my/aiu-subnet-sync--rebuild (map-file desired map-title)
  "Rebuild MAP-FILE's region: root MAP-TITLE, children DESIRED
titles in order, via the vendor insert ops. Returns t on success."
  (condition-case nil
      (with-current-buffer (find-file-noselect map-file)
        (my/aiu-subnet-sync--drop-directives map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
            (let ((inhibit-read-only t))
              (forward-line 1)
              (let ((content-start (point)))
                (when (re-search-forward "^[ \t]*#\\+end_aiu-subnet\\b"
                                         nil t)
                  (delete-region content-start
                                 (line-beginning-position)))))
            ;; Empty region: insert-root is the supported entry
            ;; (get-state parses zero roots and allows it).
            (goto-char (point-min))
            (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
              (forward-line 1)
              (let ((org-aiu-subnet-confirm-delete nil))
                (org-aiu-subnet-insert-root map-title))
              (dolist (d desired)
                (my/aiu-subnet-sync--append-child map-file (nth 2 d))))
            ;; Normalize through the proven-safe align path.
            (goto-char (point-min))
            (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
              (forward-line 1)
              (condition-case nil
                  (org-aiu-subnet-align)
                (error nil)))
            t)))
    (error nil)))

(defun my/aiu-subnet-sync--append-child (map-file title)
  "Insert TITLE as a new last child of MAP-FILE's root node.
Re-parses per call, so earlier inserts shifting layout can never
mis-anchor, and duplicate-looking titles cannot collide: the
anchor is the parent-less node, never a text search."
  (let ((rows (my/aiu-subnet-sync-region-rows map-file))
        (root nil))
    (dolist (r rows)
      (unless (nth 4 r)
        (setq root r)))
    (when root
      (with-current-buffer (find-file-noselect map-file)
        (save-excursion
          (goto-char (point-min))
          (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
            (forward-line (1+ (nth 0 root)))
            (move-to-column (nth 1 root))
            (let ((org-aiu-subnet-confirm-delete nil))
              (condition-case nil
                  (org-aiu-subnet-insert-sibling title)
                (error nil)))))))))
#+end_src

** Nested embedding (AIU Proxy variant)
Lower maps embed as sibling directives, never nested rendering
(the renderer forbids it). The ⟦ MAP: name ⟧ description makes the
line obvious in source; a strip filter keeps inner directives out
of transcluded content. Never throws.
#+begin_src emacs-lisp
(defun my/aiu-subnet-child-maps (map-file)
  "Child maps as ((ID TITLE FILE ORDER)), exactly one directory
level below MAP-FILE's own. DB-backed, no file opens."
  (let ((mapdir (file-name-directory (directory-file-name map-file)))
        out)
    (dolist (m (my/aiu-subnet-maps-info))
      (let ((mdir (file-name-directory
                   (directory-file-name (nth 2 m)))))
        (when (and (not (equal (nth 2 m) map-file))
                   (equal (file-name-directory (directory-file-name mdir))
                          mapdir))
          (push m out))))
    out))

(defun my/aiu-subnet-sync-directives (map-file)
  "Ensure exactly one ⟦ MAP ⟧ directive per child map, ordered.
Directives live at the end of the region, sorted by child MM_ORDER."
  (when (and (fboundp 'org-aiu-subnet-parser-parse-region)
             (file-exists-p map-file))
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
          (let* ((kids (sort (my/aiu-subnet-child-maps map-file)
                             (lambda (a b)
                               (< (nth 3 a) (nth 3 b)))))
                 (want (mapcar (lambda (k)
                                 (format "#+wormhole: [[id:%s][\u27e6 MAP: %s \u27e7]] :level 2 :only-contents"
                                         (or (nth 0 k) "?")
                                         (file-name-nondirectory (nth 2 k))))
                               kids)))
          (my/aiu-subnet-sync--drop-directives map-file)
          (my/aiu-subnet-sync--insert-directives map-file want)))))))

(defun my/aiu-subnet-sync--directive-lines (map-file)
  "Line numbers of wormhole directives inside the map region.
Other AIU Proxies in the file belong to other business."
  (with-current-buffer (find-file-noselect map-file)
    (save-excursion
      (goto-char (point-min))
      (when (re-search-forward "^[ \t]*#\\+begin_aiu-subnet\\b" nil t)
        (let ((rstart (line-number-at-pos))
              (rend nil)
              (gone nil))
          (when (re-search-forward "^[ \t]*#\\+end_aiu-subnet\\b" nil t)
            (setq rend (line-number-at-pos)))
          (when rend
            (goto-char (point-min))
            (while (re-search-forward "^[ \t]*#\\+AIU Proxy:.*$" nil t)
              (let ((ln (line-number-at-pos)))
                (when (and (> ln rstart) (< ln rend))
                  (push ln gone))))
            (nreverse gone)))))))

(defun my/aiu-subnet-sync--drop-directives (map-file)
  "Delete region directive lines, bottom-up (no shifting)."
  (let ((lines (my/aiu-subnet-sync--directive-lines map-file)))
    (when lines
      (with-current-buffer (find-file-noselect map-file)
        (let ((inhibit-read-only t))
          (dolist (ln (sort lines #'>))
            (goto-char (point-min))
            (forward-line (1- ln))
            (delete-region (line-beginning-position)
                           (min (point-max)
                                (1+ (line-end-position))))))))))

(defun my/aiu-subnet-sync--insert-directives (map-file want)
  "Insert directive lines WANT before the region end marker."
  (when want
    (with-current-buffer (find-file-noselect map-file)
      (save-excursion
        (goto-char (point-min))
        (when (re-search-forward "^[ \t]*#\\+end_aiu-subnet\\b" nil t)
          (forward-line 0)
          (let ((inhibit-read-only t))
            (dolist (line want)
              (insert line "\n"))))))))

(defun my/aiu-subnet-map-order-of (map-file)
  "MM_ORDER float of MAP-FILE, huge when absent."
  (let ((o (my/aiu-subnet-file-drawer-get map-file "MM_ORDER")))

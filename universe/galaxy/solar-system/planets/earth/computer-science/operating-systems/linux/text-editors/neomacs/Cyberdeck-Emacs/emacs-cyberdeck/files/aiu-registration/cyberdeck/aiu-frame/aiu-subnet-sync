(defvar my/aiu-subnet--syncing nil
  "Re-entrancy guard: bound t while a sync writes.")

(defun my/aiu-subnet-vault-file-p (file)
  "Non-nil when FILE is a syncable vault AIU (extensionless, tracked)."
  (and file (stringp file)
       (let ((root (and (fboundp 'my/cyberdeck-root-dir)
                        (ignore-errors (my/cyberdeck-root-dir)))))
         (and root
              (string-prefix-p (file-name-as-directory root)
                               (expand-file-name file))
              (not (string-match-p "/\\.git/" file))
              (not (string-match-p "/WIP/" file))
              (not (string-match-p "/admin/" file))
              (null (file-name-extension file))
              (file-regular-p file)))))

(defun my/aiu-subnet-sync-headings (file)
  "Alist (ID . TITLE) for all headlines in FILE. ID may be nil."
  (when (file-exists-p file)
    (with-temp-buffer
      (insert-file-contents file)
      ;; Macro form (see `my/aiu-subnet-file-drawer-get').
      (delay-mode-hooks (org-mode))
      (let (out)
        (org-element-map (org-element-parse-buffer) 'headline
          (lambda (h)
            (push (cons (org-element-property :ID h)
                        (org-element-property :raw-value h))
                  out)))
        (nreverse out)))))

(defun my/aiu-subnet-sync-file-title (file)
  "Display title of FILE: first headline, else basename."
  (or (cdr (car (my/aiu-subnet-sync-headings file)))
      (file-name-nondirectory (directory-file-name file))))

(defun my/aiu-subnet-sync-node-text (file)
  "Card text for FILE: MM_ANCHOR headline, else file title."
  (let ((anchor (my/aiu-subnet-file-drawer-get file "MM_ANCHOR")))
    (if (and anchor (not (string-empty-p anchor)))
        (or (cdr (assoc anchor (my/aiu-subnet-sync-headings file)))
            (my/aiu-subnet-sync-file-title file))
      (my/aiu-subnet-sync-file-title file))))

(defun my/aiu-subnet-sync-members (map-file)
  "Ordered member list for MAP-FILE: ((ID FILE TITLE ORDER)).
DB-backed: member rows in MAP-FILE's directory with AIU_SUBNET_MAP set,
plus same-directory files falling back by the default rule.
On-disk files the DB missed are read directly (self-healing);
the DB path opens nothing. Sorted by MM_ORDER. Never throws."
  (condition-case nil
      (let ((rows (my/aiu-subnet-db-aiu-rows)))
        (if (null rows)
            (my/aiu-subnet-sync-members--scan map-file)
          (my/aiu-subnet-sync-members-from-rows map-file rows)))
    (error (my/aiu-subnet-sync-members--scan map-file))))

(defun my/aiu-subnet-sync-members-from-rows (map-file rows)
  "Member list for MAP-FILE from DB ROWS (see `my/aiu-subnet-db-aiu-rows').
ROW entries carry :id :title :path :unfoldings. Anchored members
still read their anchor headline from the file (headings live
outside the notes table). Never throws."
  (condition-case nil
      (let* ((map-id (let ((hit (cl-find map-file rows
                                         :key (lambda (r) (plist-get r :path))
                                         :test #'equal)))
                       (and hit (plist-get hit :id))))
             (mapdir (file-name-directory (directory-file-name map-file)))
             (by-path (make-hash-table :test 'equal))
             out)
        ;; Map itself unsynced (brand-new file): the directory scan
        ;; is small and always correct — use it.
        (if (null map-id)
            (setq out (my/aiu-subnet-sync-members--scan map-file))
          (progn
            (dolist (r rows)
              (let ((p (plist-get r :path)))
                (when (stringp p)
                  (puthash p r by-path))))
            ;; Self-healing union: on-disk files the DB missed — or
            ;; whose drawer data is empty (historical rows predate
            ;; drawer capture) — are read directly and written through
            ;; to the DB, so each file pays this at most once until
            ;; externally edited. Bounded to this one directory (a
            ;; handful of opens, never a vault walk).
            (when (file-directory-p mapdir)
              (dolist (f (directory-files mapdir t "^[^.]"))
                (when (and (file-regular-p f)
                           (null (file-name-extension f)))
                   (let ((old (gethash f by-path)))
                     (when (or (null old)
                               (null (plist-get old :unfoldings)))
                       (let* ((upd (when (fboundp 'cyberdeck-db-update-file)
                                     (ignore-errors
                                      (cyberdeck-db-update-file f))))
                              ;; update-file returns 0 when it deleted
                              ;; the row (file lost its ID drawer):
                              ;; then the stale `old' id/title must
                              ;; not survive — trust only the file.
                              (trusted (and old (not (eq upd 0))))
                              ;; One file open: the drawer alist
                              ;; carries the ID too, so no second
                              ;; open for it. File ID wins (files
                              ;; are truth); db id is the fallback.
                              (unf (my/aiu-subnet-drawer-alist f))
                              (id (or (cdr (assoc "ID" unf))
                                      (and trusted (plist-get old :id)))))
                         (if (null id)
                             ;; No verifiable ID anywhere: drop the
                             ;; raw row too, never emit a dangling
                             ;; member link.
                             (remhash f by-path)
                           (puthash f (list :id id :path f
                                            :title (or (and trusted
                                                            (plist-get old :title))
                                                       (my/aiu-subnet-sync-file-title f))
                                            :unfoldings unf)
                                    by-path))))))))
        (maphash
         (lambda (f r)
           (when (and (file-exists-p f)
                      (equal (file-name-directory (directory-file-name f))
                             mapdir)
                          (not (equal (cdr (assoc "MM_KIND"
                                                  (plist-get r :unfoldings)))
                                      "map")))
                 (let ((mid (cdr (assoc "AIU_SUBNET_MAP" (plist-get r :unfoldings)))))
                   (when (or (and mid (equal mid map-id))
                             (and (null mid)
                                  (equal (my/aiu-subnet-default-map f) map-file)))
                     (let ((id (plist-get r :id)))
                       (when id
                         (let* ((anchor (cdr (assoc "MM_ANCHOR"
                                                    (plist-get r :unfoldings))))
                                (title (if (and anchor
                                                (not (string-empty-p anchor)))
                                           (my/aiu-subnet-sync-node-text f)
                                         (my/aiu-subnet-strip-title-tags
                                          (plist-get r :title)))))
                           (push (list id f title
                                       (my/aiu-subnet-order-of-aiu-contexts
                                        (plist-get r :unfoldings)))
                                 out))))))))
             by-path)))
        (sort out (lambda (a b) (< (nth 3 a) (nth 3 b)))))
    (error (my/aiu-subnet-sync-members--scan map-file))))

(defun my/aiu-subnet-sync-members--scan (map-file)

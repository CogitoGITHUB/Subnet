** Path canon — vault-relative storage, absolute access
#+begin_src emacs-lisp
(defun cyberdeck-db--canon-path (path)
  "Vault-relative form of PATH for the notes table.
Strips surrounding double quotes (shell-quoted find output keeps them,
e.g. paths with spaces), expands both the Termux and the proot roots,
and returns the path relative to the vault root — the form the good
rows already use, so it survives root moves.  Never throws: returns
PATH unchanged when the root is unknown."
  (condition-case nil
      (let* ((s (if (stringp path) path ""))
             (s (if (and (> (length s) 0) (eq (aref s 0) 34))
                    (substring s 1) s))
             (s (if (and (> (length s) 0) (eq (aref s (1- (length s))) 34))
                    (substring s 0 -1) s))
             (abs (expand-file-name s))
             (root (and (fboundp 'my/cyberdeck-root-dir)
                        (file-name-as-directory
                         (expand-file-name (my/cyberdeck-root-dir))))))
        (if (and (> (length s) 0) root (string-prefix-p root abs))
            (substring abs (length root))
          (if (> (length s) 0) s path)))
    (error path)))

(defun cyberdeck-db--resolve-path (path)
  "Absolute form of stored PATH for filesystem access.
Stored paths are vault-relative; resolve them against the vault root so
file-exists-p and file reads work whatever the current directory is.
Absolute stored paths pass through untouched.  Surrounding double
quotes are stripped first: old rows were stored shell-quoted, and an
unstripped quote makes every existence check fail.  Never throws."
  (condition-case nil
      (let ((s (cond ((stringp path) path)
                     ;; emacsql hands back symbols for some TEXT values;
                     ;; coerce so existence checks see a real string.
                     ((symbolp path) (symbol-name path))
                     (t ""))))
        (when (and (> (length s) 0) (eq (aref s 0) 34))
          (setq s (substring s 1)))
        (when (and (> (length s) 0) (eq (aref s (1- (length s))) 34))
          (setq s (substring s 0 -1)))
        (if (file-name-absolute-p s)
            s
          (expand-file-name s
                            (and (fboundp 'my/cyberdeck-root-dir)
                                 (my/cyberdeck-root-dir)))))
    (error path)))

(defun cyberdeck-db--strip-quotes (s)
  "Remove one wrapping pair of ASCII double quotes from S.
Shell-quoted listings keep them; the DB stores paths and ids bare."
  (if (and (stringp s) (> (length s) 0) (eq (aref s 0) 34))
      (let ((r (substring s 1)))
        (if (and (> (length r) 0) (eq (aref r (1- (length r))) 34))
            (substring r 0 -1)
          r))
    s))
#+end_src

*** Orphan prune (state comparison, not hooks)
Shell rm, git checkout, and external tools never fire Emacs hooks,
so deleted files linger as DB ghosts (visible in find completion)
until something diffs. This does: every distinct DB path missing
on disk goes through `cyberdeck-db--update-file', which
already deletes the row. File existence is truth — same rule as
the aiu-context `.known-keys' reconcile. Admin history untouched.
#+begin_src emacs-lisp
(defun my/cyberdeck-db--prune-orphans ()
  "Drop DB note rows for vault files that no longer exist on disk.
Returns pruned count. Never touches files or admin history.
Skips silently when the engine (emacsql/cyberdeck-db) is not
loaded yet — boot timers fire before it; the idle repeat catches up."
  (if (not (and (fboundp 'emacsql) (fboundp 'cyberdeck-db)
                (fboundp 'cyberdeck-db--update-file)))
      0
    (let ((pruned 0))
    (my/cyberdeck--ensure-aius-table)
    (let ((paths (ignore-errors
                   (mapcar #'car (emacsql (cyberdeck-db)
                                          [:select :distinct [path] :from notes])))))
      (dolist (p paths)
        (when (and (stringp p) (not (file-exists-p p)))
          (ignore-errors (cyberdeck-db--update-file p))
          (setq pruned (1+ pruned)))))
    (when (> pruned 0)
      (message "db orphans: pruned %d AIU(s) for deleted files" pruned))
    pruned)))

(defun cyberdeck-db-query (&optional filter)
  "Query notes, filtered by FILTER if given.
Rows whose file no longer exists on disk are dropped before FILTER
is applied, so callers never see stale/deleted entries."
  (let* ((db (ignore-errors (cyberdeck-db)))
         (db-result (when db
                      (let* ((notes (seq-filter
                                     (lambda (n)
                                       (file-exists-p (cyberdeck-db--resolve-path (cyberdeck-aiu-path n))))
                                     (mapcar #'my/cyberdeck--row-to-aiu (emacsql db [:select * :from notes])))))
                        (if filter (seq-filter filter notes) notes)))))
    (if (and db-result (consp db-result))
        db-result
      ;; Fallback: scan vault directly when DB not available or empty (same fallback as elsewhere tonight)
      (let* ((root (my/cyberdeck-root-dir))
             (files (ignore-errors (my/cyberdeck-db-sync--list-org-files root)))
             notes)
        (dolist (file (or files (directory-files-recursively root "^[^.]" t)))
          (when (and (file-regular-p file)
                     (not (string-match-p "/\\.git/" file))
                     (not (string-match-p "/admin/" file))
                     (not (string-match-p "/WIP/" file)))
            (let ((id (ignore-errors
                        (with-temp-buffer
                          (insert-file-contents file)
                          (when (re-search-forward "^:ID:[ \t]+\\(.+\\)" nil t)
                            (string-trim (match-string 1)))))))
              (when id
                (let ((title (ignore-errors
                               (with-temp-buffer
                                 (insert-file-contents file)
                                 (when (re-search-forward "^\\*+[ \t]+\\(.*\\)" nil t)
                                   (let ((raw (string-trim (match-string 1))))
                                     (if (string-match "^TODO[ \t]+\\(.*\\)" raw)
                                         (string-trim (match-string 1 raw))
                                       raw)))))))
                  (push (list :id id :title (or title (file-name-nondirectory file))
                              :path file :level 0 :pos 1
                              :tags nil :unfoldings nil :aliases nil :primary-title nil :meta nil)
                        notes))))))
        (if filter
            (seq-filter filter notes)
          notes)))))

(defun cyberdeck-db-query-by-aiu-context (unfolding val)
  (let ((db (cyberdeck-db)))
    (if db
        (mapcar #'my/cyberdeck--row-to-aiu (emacsql db [:select * :from notes :where (= unfoldings $s1)] (format "\"%s\":\"%s\"" unfolding val)))
      ;; Fallback: scan vault and filter by AIU Context (uses same vault-scan as db-query)
      (seq-filter (lambda (n)
                    (let ((unfoldings (cyberdeck-aiu-aiu-contexts n)))
                      (equal (cdr (assoc (upcase unfolding) unfoldings)) val)))
                  (ignore-errors (cyberdeck-db-query))))))

(defun cyberdeck-db-query-by-ids (ids)
  (let ((db (cyberdeck-db)))
    (if (and db ids)
        ;; $v1 vector elements are prin1-encoded: raw strings gain Elisp
        ;; quotes ('"uuid"') and never match stored raw text. Symbols
        ;; prin1 bare, so intern string ids (UUID-safe: ids never hold
        ;; spaces/quotes) to keep the single IN query.
        (mapcar #'my/cyberdeck--row-to-aiu (emacsql db [:select * :from notes :where (in id $v1)] (vconcat (mapcar #'intern ids))))
      ;; Fallback: scan vault and filter by ids
      (when ids
        (seq-filter (lambda (n) (member (cyberdeck-aiu-id n) ids))
                    (ignore-errors (cyberdeck-db-query)))))))

(defun cyberdeck-db-query-by-file-path (path)
  (let ((db (cyberdeck-db)))
    (if db
        (mapcar #'my/cyberdeck--row-to-aiu (emacsql db [:select * :from notes :where (= path $s1)] path))
      ;; Fallback: scan vault and filter by path
      (seq-filter (lambda (n) (string-equal (cyberdeck-aiu-path n) path))
                  (ignore-errors (cyberdeck-db-query))))))

(defun cyberdeck-db-query-by-tags-some (tags)

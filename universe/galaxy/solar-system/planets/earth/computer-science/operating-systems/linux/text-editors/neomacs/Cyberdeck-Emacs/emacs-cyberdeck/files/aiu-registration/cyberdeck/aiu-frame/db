(defun cyberdeck-db-prune-missing ()
  "Remove DB rows whose file no longer exists on disk.
Also normalizes shell-quoted paths (strips wrapping double quotes)
and drops exact duplicate paths, so writers that store quoted forms
converge to one clean row. Safe to call anytime; only deletes rows,
never touches files. Rows with malformed (non-string, non-symbol)
paths are skipped and counted. Existence uses `cyberdeck-db--resolve-path',
never the raw stored form (relative paths must resolve against the
vault root, not whatever directory is current)."
  (interactive)
  (let* ((db (ignore-errors (cyberdeck-db)))
         (rows (and db (ignore-errors (emacsql db [:select [rowid id path] :from notes]))))
         (removed 0)
         (skipped 0)
         (seen (make-hash-table :test 'equal)))
    (message "cyberdeck: DB prune start…")
    (dolist (row rows)
      ;; Match rows by ROWID only. emacsql mangles TEXT values on the
      ;; way out (quotes stripped, bare text interned), so matching by
      ;; id/path silently matches nothing and junk survives forever.
      (let* ((rid (car row))
             (raw-id (cadr row))
             (raw-path (caddr row))
             (id (cond ((stringp raw-id) raw-id)
                       ((symbolp raw-id) (symbol-name raw-id))))
             (path (cond ((stringp raw-path) raw-path)
                         ((symbolp raw-path) (symbol-name raw-path)))))
        (cond
         ((or (not (integerp rid)) (not (stringp id)) (not (stringp path)))
          (setq skipped (1+ skipped)))
         (t
          (let ((nid (cyberdeck-db--strip-quotes id))
                (npath (cyberdeck-db--strip-quotes path)))
            (cond
             ((gethash npath seen)
              (condition-case nil
                  (progn
                    (emacsql db [:delete :from notes :where (= rowid $s1)] rid)
                    (setq removed (1+ removed)))
                (error (setq skipped (1+ skipped)))))
             (t
              (puthash npath t seen)
              (unless (string= nid id)
                (condition-case nil
                    (emacsql db [:update notes :set (= id $s1) :where (= rowid $s2)]
                             nid rid)
                  (error (setq skipped (1+ skipped)))))
              (unless (string= npath path)
                (condition-case nil
                    (emacsql db [:update notes :set (= path $s1) :where (= rowid $s2)]
                             npath rid)
                  (error (setq skipped (1+ skipped)))))
              (unless (file-exists-p (cyberdeck-db--resolve-path npath))
                (condition-case nil
                    (progn
                      (emacsql db [:delete :from notes :where (= rowid $s1)] rid)
                      (remhash npath seen)
                      (setq removed (1+ removed)))
                  (error (setq skipped (1+ skipped))))))))))))
    (message "cyberdeck: DB prune done: %d stale removed, %d skipped"
             removed skipped)
    removed))


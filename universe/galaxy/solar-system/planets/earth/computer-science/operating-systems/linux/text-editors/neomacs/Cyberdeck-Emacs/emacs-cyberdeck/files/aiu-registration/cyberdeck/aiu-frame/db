#+begin_src emacs-lisp
(defun cyberdeck-db-descendants (id &optional max-depth)
  "Ids reachable from ID following source→dest links, excluding ID.
Semantic reachability through knowledge links — not map containment
(contrast aiu-subnet/subtree-of, which walks placement instead)."
  (cdr (cyberdeck-db--bfs (list id) #'cyberdeck-db--link-dests max-depth)))

(defun cyberdeck-db-ancestors (id &optional max-depth)
  "Ids that can reach ID following source→dest links, excluding ID.
Answers \"what does this knowledge stand on?\" one question the
review queue may one day sort by."
  (cdr (cyberdeck-db--bfs (list id) #'cyberdeck-db--link-sources max-depth)))

(defun cyberdeck-db-component (id)
  "Full connected component of ID in either direction, ID first.
The unit of orphan triage: a component of one is an unintegrated card."
  (cyberdeck-db--bfs (list id) #'cyberdeck-db-neighbors))

(defun cyberdeck-select-from (prompt candidates &rest _args)
  "Real select-from: completing-read over CANDIDATES titles,
return existing or new plist."
  (require 'seq)
  (let* ((titles (mapcar (lambda (n) (or (cyberdeck-aiu-title n) (plist-get n :title) "")) candidates))
         (choice (completing-read (cond ((string-suffix-p ": " prompt) prompt)
                                         ((string-suffix-p ":" prompt) (concat prompt " "))
                                         (t (concat prompt ": ")))
                                   titles nil nil nil nil nil))
         (found (seq-find (lambda (n) (string= (or (cyberdeck-aiu-title n) (plist-get n :title) "") choice)) candidates)))
    (if found
        found
      (list :id nil :title choice :path nil :unfoldings nil :tags nil))))

(cl-defun cyberdeck-select (prompt &key require-match filter-fn candidates)
  "Select a note with PROMPT via completing-read.
CANDIDATES defaults to every note in the database (via
`cyberdeck-db-query'). FILTER-FN, if given, is applied to
narrow the auto-fetched candidates down first. REQUIRE-MATCH is
passed through to the underlying prompt."
  (let* ((cands (or candidates (ignore-errors (cyberdeck-db-query))))
         (cands (if filter-fn (seq-filter filter-fn cands) cands)))
    (cyberdeck-select-from prompt cands :require-match require-match)))


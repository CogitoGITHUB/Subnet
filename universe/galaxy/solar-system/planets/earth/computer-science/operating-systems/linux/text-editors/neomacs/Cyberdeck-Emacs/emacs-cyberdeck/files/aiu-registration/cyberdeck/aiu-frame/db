(provide 'cyberdeck-db)
(provide 'cyberdeck-db-query)

(defvar cyberdeck-db--connection nil
  "DB connection.")

(defcustom my/cyberdeck-db-backend 'sqlite
  "Substrate backend: sqlite (vault file) or pg (PostgreSQL).
The SQLite path is the temporary rollback artifact of the Postgres
migration — byte-identical behavior to before. Flip to pg after the
server exists and the fresh-rescan cutover checklist (README) passes.
Scaffolding, not a permanent feature: delete the sqlite branch once
PostgreSQL has survived real sessions."
  :type '(choice (const sqlite) (const pg))
  :group 'cyberdeck)

(defcustom my/cyberdeck-db-pg-host "localhost"
  "PostgreSQL host for the pg backend."
  :type 'string :group 'cyberdeck)
(defcustom my/cyberdeck-db-pg-port 5432
  "PostgreSQL port for the pg backend."
  :type 'integer :group 'cyberdeck)
(defcustom my/cyberdeck-db-pg-dbname "cyberdeck"
  "PostgreSQL database name for the pg backend."
  :type 'string :group 'cyberdeck)
(defcustom my/cyberdeck-db-pg-user user-login-name
  "PostgreSQL user for the pg backend.
The password is never a defcustom and never lives in source: it comes
solely from auth-source (typically ~/.authinfo as
\"machine <host> port <port> login <user> password <secret>\").
SCRAM-SHA-256 on the server side; no md5 fallback anywhere."
  :type 'string :group 'cyberdeck)

(defun my/cyberdeck-db-pg-password ()
  "Fetch the pg password from auth-source, or nil when absent."
  (require 'auth-source nil t)
  (when (fboundp 'auth-source-pick-first-password)
    (auth-source-pick-first-password
     :host my/cyberdeck-db-pg-host
     :user my/cyberdeck-db-pg-user
     :port my/cyberdeck-db-pg-port)))

(defun my/cyberdeck-db--connect-pg ()
  "Open the PostgreSQL connection. Signals classifiable errors."
  (require 'emacsql-pg)
  (require 'pg)
  (emacsql-pg my/cyberdeck-db-pg-dbname
              my/cyberdeck-db-pg-user
              :host my/cyberdeck-db-pg-host
              :port my/cyberdeck-db-pg-port
              :password (my/cyberdeck-db-pg-password)))

(defun my/cyberdeck-db-health ()
  "Probe the current backend; return (STATE . HINT).
STATE is CONNECTED, DOWN, AUTH-FAILED, DATABASE-MISSING, or
SCHEMA-OUTDATED. HINT names the exact shell recovery step. Never
signals — infrastructure state must be reportable, not exceptional."
  (condition-case err
      (let ((db (cyberdeck-db)))
        (if (null db)
            (cons 'DOWN "pg_ctl -D $PREFIX/var/lib/postgresql start")
          (condition-case nil
              (progn
                (emacsql db [:select [id] :from notes :limit 1])
                (cons 'CONNECTED nil))
            (error (cons 'SCHEMA-OUTDATED "rescan the vault to rebuild indexes")))))
    (error
     (let ((msg (error-message-string err)))
       (cond ((string-match-p "refused\\|could not connect\\|no such host" msg)
              (cons 'DOWN "pg_ctl -D $PREFIX/var/lib/postgresql start"))
             ((string-match-p "auth\\|password" msg)
              (cons 'AUTH-FAILED "check ~/.authinfo entry and pg_hba scram-sha-256"))
             ((string-match-p "does not exist" msg)
              (cons 'DATABASE-MISSING "createdb cyberdeck (after createuser)"))
             (t (cons 'DOWN msg)))))))

(defun cyberdeck-db (&optional _args)
  "Return DB connection, opening it if needed."
  (require 'emacsql)
  (if (eq my/cyberdeck-db-backend 'pg)
      (unless (and cyberdeck-db--connection
                   (ignore-errors (emacsql-live-p cyberdeck-db--connection)))
        (setq cyberdeck-db--connection
              (my/cyberdeck-db--connect-pg)))
    (require 'emacsql-sqlite-builtin)
    (unless (and cyberdeck-db--connection
                 (ignore-errors (emacsql-live-p cyberdeck-db--connection)))
      (setq cyberdeck-db--connection
            (emacsql-sqlite-builtin cyberdeck-db-location))))
  (when (and cyberdeck-db--connection
             (not (bound-and-true-p my/cyberdeck--aius-table-ready)))
    ;; Guarantee `AIUs' exists for every caller (find/query/create),
    ;; not just update-file path. Direct emacsql on connection avoids
    ;; recursing via ensure-aius-table -> (cyberdeck-db).
    (ignore-errors
      (emacsql cyberdeck-db--connection
               [:create :table :if :not :exists notes
                ([(id :text :primary-key :not-null)
                  (title :text)
                  (path :text :not-null)
                  (level :integer)
                  (pos :integer)
                  (unfoldings :text)
                  (tags :text)])]))
    (setq my/cyberdeck--aius-table-ready t))
  (when (and cyberdeck-db--connection
             (not (bound-and-true-p my/cyberdeck--links-table-ready)))
    (ignore-errors
      (emacsql cyberdeck-db--connection
               [:create :table :if :not :exists links
                ([(source :text :not-null)
                  (dest :text :not-null)]
                 (:primary-key [source dest]))]))
    (setq my/cyberdeck--links-table-ready t))
  (when (and cyberdeck-db--connection
             (fboundp 'my/aiu-proxy-links-ensure-table)
             (not (bound-and-true-p my/cyberdeck--aiu-proxy-links-table-ready)))
    ;; cyberdeck-aiu-proxies.org loads after db.org, so guard with fboundp —
    ;; symmetric with restoration.org's (when (fboundp ...)) call guard.
    (ignore-errors (my/aiu-proxy-links-ensure-table))
    (setq my/cyberdeck--aiu-proxy-links-table-ready t))
  cyberdeck-db--connection)

;; Wire-format law: TEXT cells hold raw human strings (titles with `#',
;; spaces, punctuation), NOT Elisp-readable s-expressions. Compound
;; cells (unfoldings/tags) are `prin1-to-string' output, parsed back by
;; row readers (`my/cyberdeck--row-to-aiu' `read's them).
;; Upstream `emacsql-sqlite-read-column' runs the Elisp reader over
;; every TEXT cell, so a title like "NERD-ICONS — ... #emacs-package"
;; signals (invalid-read-syntax "#e"), surfaced as (emacsql-error "#e")
;; on any SELECT * ; and any multi-token title silently splices extra
;; objects into the row via mapcan, shifting every positional reader
;; (`row-to-aiu' :path/:level/:pos all land wrong, no error).
;; Bypass the reader: every non-empty TEXT cell arrives as the stored
;; string. Integers/nil keep their upstream branches (numberp/null),
;; so count(*)/empty cells are unaffected.
(defun my/cyberdeck--read-column-raw (string)
  "Return STRING as a single-column value, bypassing the Elisp reader.
Wire-format law above: TEXT cells are raw strings."
  (list string))

(with-eval-after-load 'emacsql-sqlite
  (advice-add 'emacsql-sqlite-read-column :override
              #'my/cyberdeck--read-column-raw))

;; Missing core shims — extractor/parse-ctx structs, notes table, and workers
;; These are normally provided by the external `cyberdeck' package;
;; when that package is absent (as in this Termux checkout) we provide
;; minimal compatible implementations so `AIUs' actually populates.

(unless (fboundp 'make-cyberdeck-parse-ctx)
  (cl-defstruct (cyberdeck-parse-ctx (:constructor make-cyberdeck-parse-ctx))
    path ast file-aiu heading-aius hash mtime size))

(unless (fboundp 'make-cyberdeck-extractor)
  (cl-defstruct (cyberdeck-extractor (:constructor make-cyberdeck-extractor))
    name version priority extract-fn requires-ast))

(defvar cyberdeck-db--extractors nil
  "List of registered `cyberdeck-extractor' structs,
sorted by priority.")

(defun cyberdeck--register-extractor (extractor)
  "Register EXTRACTOR and keep
`cyberdeck-db--extractors' sorted by :priority."
  (setq cyberdeck-db--extractors
        (sort (cons extractor
                    (cl-remove (plist-get (list :name (cyberdeck-extractor-name extractor)) :name)
                               cyberdeck-db--extractors
                               :key #'cyberdeck-extractor-name :test #'eq))
              (lambda (a b) (< (or (cyberdeck-extractor-priority a) 100)
                               (or (cyberdeck-extractor-priority b) 100)))))
  ;; de-duplicate by name keep highest priority (last wins, sort stable)
  (setq cyberdeck-db--extractors
        (cl-remove-duplicates cyberdeck-db--extractors :key #'cyberdeck-extractor-name :test #'eq :from-end t)))

(defun my/cyberdeck--ensure-aius-table ()
  "Create `notes' table if absent — mirrors `citation.org' pattern."
  (emacsql (cyberdeck-db)
           [:create :table :if :not :exists notes
            ([(id :text :primary-key :not-null)
              (title :text)
              (path :text :not-null)
              (level :integer)
              (pos :integer)
              (unfoldings :text)
              (tags :text)])]))

(defun cyberdeck-db--read-cell (s)
  "Read printed DB cell S as a list, tolerating re-encoding.
Some rows store doubly printed values; symbols arrive for bare
text. Always returns nil or a list, so list consumers never crash
on data: stray scalars wrap in a one-list."
  (let* ((text (cond ((stringp s) s)
                     ((symbolp s) (symbol-name s))
                     (t nil)))
         (v (and text (ignore-errors (read text)))))
    (cond ((null v) nil)
          ((listp v) v)
          ((stringp v)
           (let ((w (ignore-errors (read v))))
             (cond ((listp w) w)
                   ((null w) nil)
                   (t (list w)))))
          (t (list v)))))

(defun my/cyberdeck--row-to-aiu (row)
  "Normalize DB ROW (vector or list) to plist note; tolerate
nil/malformed `unfoldings'/`tags' via `ignore-errors' + `read'."
  (if (and (listp row) (plist-get row :id))
      row
    (let ((v (if (vectorp row) (append row nil) row)))
      (list :id (nth 0 v) :title (nth 1 v) :path (nth 2 v)
            :level (or (nth 3 v) 0) :pos (or (nth 4 v) 1)
            :unfoldings (cyberdeck-db--read-cell (nth 5 v))
            :tags (cyberdeck-db--read-cell (nth 6 v))
            :aliases nil :primary-title nil :meta nil))))

(defun my/cyberdeck--ensure-links-table ()
  "Create `links' table if absent — queried by guard, may not
be created by extractors."
  (ignore-errors
    (emacsql (cyberdeck-db)
             [:create :table :if :not :exists links
              ([(source :text :not-null)
                (dest :text :not-null)]
               (:primary-key [source dest]))])))

(with-eval-after-load 'cyberdeck
  (my/cyberdeck--ensure-aius-table)
  (my/cyberdeck--ensure-links-table)
  (add-hook 'cyberdeck-db-autosync-mode-hook #'my/cyberdeck--ensure-aius-table)
  (add-hook 'cyberdeck-db-autosync-mode-hook #'my/cyberdeck--ensure-links-table))


(cl-defun cyberdeck-db--update-file (path)
  "Parse PATH, upsert its `notes' row, and run all registered extractors.
Returns 1 if a note was indexed, 0 otherwise. Handles deletion
when file missing."
  (my/cyberdeck--ensure-aius-table)
  (setq path (cyberdeck-db--canon-path path))
  (if (not (file-exists-p (cyberdeck-db--resolve-path path)))
      (progn
        (ignore-errors (emacsql (cyberdeck-db) [:delete :from notes :where (= path $s1)] path))
        ;; also purge dependent tables via cascade or explicit
        (dolist (extractor cyberdeck-db--extractors)
          (ignore-errors (funcall (cyberdeck-extractor-extract-fn extractor)
                                  (make-cyberdeck-parse-ctx :path path :ast nil) nil)))
        0)
    ;; Build parse-ctx via existing override if available, else minimal
    (let* ((ctx (if (fboundp 'cyberdeck-db--parse-file)
                    (ignore-errors (cyberdeck-db--parse-file path))
                  (with-temp-buffer
                    (insert-file-contents (cyberdeck-db--resolve-path path))
                    (let ((ast (ignore-errors (org-element-parse-buffer))))
                      (make-cyberdeck-parse-ctx :path path :ast ast)))))
           (_ast (and ctx (cyberdeck-parse-ctx-ast ctx)))
            (id (with-temp-buffer
                  (insert-file-contents (cyberdeck-db--resolve-path path))
                  (when (re-search-forward "^:ID:[ \t]+\\(.+\\)" nil t)
                    (string-trim (match-string 1)))))
           (title (with-temp-buffer
                    (insert-file-contents (cyberdeck-db--resolve-path path))
                    (when (re-search-forward "^\\*+[ \t]+\\(.*\\)" nil t)
                      (string-trim (match-string 1))))))
      (unless id
        (ignore-errors (emacsql (cyberdeck-db) [:delete :from notes :where (= path $s1)] path))
        (cl-return-from cyberdeck-db--update-file 0))
      (let ((unfoldings (with-temp-buffer
                     (insert-file-contents (cyberdeck-db--resolve-path path))
                     (when (re-search-forward "^:PROPERTIES:" nil t)
                       (let (alist)
                         (while (re-search-forward "^:\\([^:]+\\):[ \t]*\\(.*\\)" nil t)
                           (let ((k (match-string 1)))
                             (if (string= k "END") (goto-char (point-max))
                               (push (cons k (match-string 2)) alist))))
                         (nreverse alist)))))
            (tags (with-temp-buffer
                    (insert-file-contents (cyberdeck-db--resolve-path path))
                    (let (tags)
                      (when (re-search-forward "^\\*+[ \t]+.*:\\([^:\n]+\\):[ \t]*$" nil t)
                        (setq tags (split-string (match-string 1) ":" t)))
                      ;; Inline #tokens join headline tags (same token rule
                      ;; as the hashtag sidecar, so both agree exactly).
                      (goto-char (point-min))
                      (while (re-search-forward "\\(^\\|[ \t\n]\\)#\\([A-Za-z0-9_@/-]+\\)" nil t)
                        (let ((tag (match-string-no-properties 2)))
                          (unless (member tag tags)
                            (push tag tags))))
                      (nreverse tags)))))
        ;; upsert AIUs row
        (ignore-errors (emacsql (cyberdeck-db) [:delete :from notes :where (= id $s1)] id))
        ;; Stale rows for the same file under a quoted id or quoted
        ;; path survive the id delete: drop them by path as well.
        (ignore-errors (emacsql (cyberdeck-db) [:delete :from notes :where (= path $s1)] path))
        (ignore-errors (emacsql (cyberdeck-db) [:delete :from notes :where (= path $s1)] (concat "\"" path "\"")))
        (emacsql (cyberdeck-db)
                 [:insert :into notes :values $v1]
                 (vector id (or title (file-name-nondirectory path)) path 0 1
                         (prin1-to-string unfoldings) (prin1-to-string tags)))
        ;; run extractors
        (let ((aiu-data (list :id id :title title :path path)))
          (dolist (extractor (sort (copy-sequence cyberdeck-db--extractors)
                                   (lambda (a b) (< (or (cyberdeck-extractor-priority a) 100)
                                                    (or (cyberdeck-extractor-priority b) 100)))))
            (let ((fn (cyberdeck-extractor-extract-fn extractor)))
              (when fn
                (ignore-errors
                  (let ((result (funcall fn ctx aiu-data)))
                    (when result (setq aiu-data result))))))))
        (if (car (emacsql (cyberdeck-db) [:select * :from notes :where (= id $s1)] id)) 1 0)))))

(defvar cyberdeck--autosync-mode nil)

(defun cyberdeck--autosync-mode (&optional arg)
  "Toggle autosync: on save under
`cyberdeck-db-sync-directories', call
`cyberdeck-db--update-file'."
  (setq cyberdeck--autosync-mode
        (if (null arg) (not cyberdeck--autosync-mode)
          (> (prefix-numeric-value arg) 0)))
  (if cyberdeck--autosync-mode
      (add-hook 'after-save-hook #'cyberdeck--autosync-after-save nil t)
    (remove-hook 'after-save-hook #'cyberdeck--autosync-after-save t)))

(defun cyberdeck--autosync-after-save ()
  (when (and buffer-file-name
             (cl-some (lambda (dir) (string-prefix-p (expand-file-name dir) (expand-file-name buffer-file-name)))
                      cyberdeck-db-sync-directories))
    (cyberdeck-db--update-file buffer-file-name)))

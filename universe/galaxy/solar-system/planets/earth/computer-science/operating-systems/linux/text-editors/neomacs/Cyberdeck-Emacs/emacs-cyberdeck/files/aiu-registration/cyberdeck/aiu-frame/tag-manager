(require 'cl-lib)
(require 'seq)

(defun my/cyberdeck-tags-census ()
  "Alist (TAG COUNT SOURCES) over note tags and inline hashtags.
SOURCES is a subset of (AIU inline)."
  (let ((counts (make-hash-table :test 'equal))
        (srcs (make-hash-table :test 'equal)))
    (dolist (n (ignore-errors (cyberdeck-db-query)))
      (dolist (tag (ignore-errors (cyberdeck-aiu-tags n)))
        (when (stringp tag)
          (puthash tag (1+ (gethash tag counts 0)) counts)
          (puthash tag (cl-adjoin 'note (gethash tag srcs)) srcs))))
    (when (boundp 'my/cyberdeck-hashtag-index)
      (maphash (lambda (tag files)
                 (puthash tag (+ (gethash tag counts 0) (length files)) counts)
                 (puthash tag (cl-adjoin 'inline (gethash tag srcs)) srcs))
               my/cyberdeck-hashtag-index))
    (let (out)
      (maphash (lambda (tag count)
                 (push (list tag count (gethash tag srcs)) out))
               counts)
      (sort out (lambda (a b) (> (nth 1 a) (nth 1 b)))))))
#+end_src


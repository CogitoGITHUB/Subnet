(defun my/cyberdeck-tag-config-files ()
  "Existing saved-queries and automations files (for rename rewrites)."
  (delq nil
        (list (let ((f (expand-file-name ".local/cache/aiu-frame-queries.el"
                                         (expand-file-name "~"))))
                (when (file-exists-p f) f))
              (let ((f (expand-file-name ".local/cache/aiu-frame-automations.el"
                                         (expand-file-name "~"))))
                (when (file-exists-p f) f)))))

(defun my/cyberdeck-tag-config-occurrences (old)
  "Whole-word hits for OLD in config files, as occurrence shapes."
  (let ((out nil)
        (re (concat "\\<" (regexp-quote old) "\\>")))
    (dolist (f (my/cyberdeck-tag-config-files))
      (with-temp-buffer
        (insert-file-contents f)
        (goto-char (point-min))
        (let ((ln 0))
          (while (not (eobp))
            (setq ln (1+ ln))
            (let ((line (buffer-substring-no-properties
                         (line-beginning-position) (line-end-position))))
              (when (string-match-p re line)
                (push (list f ln line
                            (lambda (new)
                              (replace-regexp-in-string re new line t t)))
                      out)))
            (forward-line 1)))))
    (nreverse out)))

(defvar my/cyberdeck-tag-manager--home
  (let ((f (or load-file-name buffer-file-name)))
    ;; This file lives in aiu-frame/; aiu-contexts/ and workflows/ are
    ;; siblings of it.  Derived from our own location, never hardcoded.
    (when f
      (file-name-directory
       (directory-file-name (file-name-directory f)))))
  "Cyberdeck tree root holding aiu-contexts/ and workflows/.")

(defun my/cyberdeck-tag-vocab-hits (old)
  "Curated-vocabulary files mentioning OLD: REPORT ONLY, never edited.
AIU Context specs and routine/protocol vocabularies own their words."
  (let ((out nil)
        (re (concat "\\<" (regexp-quote old) "\\>")))
    (dolist (d (delq nil
                     (list (and my/cyberdeck-tag-manager--home
                                (expand-file-name "aiu-contexts"
                                                  my/cyberdeck-tag-manager--home))
                           (and my/cyberdeck-tag-manager--home
                                (expand-file-name "workflows"
                                                  my/cyberdeck-tag-manager--home)))))
      (dolist (f (ignore-errors (directory-files-recursively d "" t)))
        (when (and (file-regular-p f)
                   (ignore-errors
                     (with-temp-buffer
                       (insert-file-contents f nil 0 65536)
                       (re-search-forward re nil t))))
          (push f out))))
    (nreverse out)))
(defun my/cyberdeck-tag--rewrite-run (line old new)
  "Replace tag OLD with NEW inside a headline tag run; tidy on delete."
  (let ((out (replace-regexp-in-string
              (concat ":" (regexp-quote old) "\\(:\\|$\\)")
              (if (string-empty-p new) "\\1" (concat ":" new "\\1"))
              line)))
    (when (string-empty-p new)
      (setq out (replace-regexp-in-string "::" ":" out))
      (setq out (replace-regexp-in-string "[ \t]+:[ \t]*$" "" out)))
    out))
(defun my/cyberdeck-tag-occurrences (old)
  "List of (FILE LINE OLD-TEXT NEW-TEXT-FN) for tag OLD.
NEW-TEXT-FN takes the replacement tag and returns the new line text."
  (let ((out nil)
        (root (ignore-errors (my/cyberdeck-root-dir))))
    (when root
      (dolist (f (directory-files-recursively root "\\.org\\'"))
        (unless (or (string-match-p "/\\.git/" f) (string-match-p "/admin/" f))
          (with-temp-buffer
            (insert-file-contents f)
            (goto-char (point-min))
            (let ((ln 0))
              (while (not (eobp))
                (setq ln (1+ ln))
                (let ((line (buffer-substring-no-properties
                             (line-beginning-position) (line-end-position))))
                  (cond
                   ((string-match "^\\*+ .*\\(:[A-Za-z0-9_@]+\\(?::[A-Za-z0-9_@]+\\)*:\\)[ \t]*$" line)
                    (let ((run (match-string 1 line)))
                      (when (member old (split-string (substring run 1 -1) ":"))
                        (push (list f ln line
                                    (lambda (new)
                                      (my/cyberdeck-tag--rewrite-run line old new)))
                              out))))
                   ((string-match "^[ \t]*#\\+FILETAGS:" line)
                    (when (member old (split-string line "[: \t]+" t))
                      (push (list f ln line
                                  (lambda (new)
                                    (replace-regexp-in-string
                                     (regexp-quote old) new line t t)))
                            out)))
                   (t
                    (let ((pos 0) (found nil))
                      (while (string-match (concat "\\(^\\|[ \t\n]\\)#"
                                                          (regexp-quote old)
                                                          "\\([^A-Za-z0-9_@/]\\|$\\)")
                                                  line pos)
                        (setq found t
                              pos (match-end 0)))
                      (when found
                        (push (list f ln line
                                    (lambda (new)
                                      (replace-regexp-in-string
                                       (concat "\\(^\\|[ \t\n]\\)#"
                                               (regexp-quote old)
                                               "\\([^A-Za-z0-9_@/]\\|$\\)")
                                       (if (string-empty-p new)
                                           "\\1\\2"
                                         (concat "\\1#" new "\\2"))
                                       line)))
                              out)))))))
                (forward-line 1))))))
    (nreverse out)))

(defun my/cyberdeck-tag-apply (occurrences new)
  "Apply OCCURRENCES with replacement tag NEW (empty deletes).
Edits back to front per file.  Returns files changed."
  (let ((by-file (make-hash-table :test 'equal)))
    (dolist (o occurrences)
      (push o (gethash (nth 0 o) by-file)))
    (let (changed)
      (maphash
       (lambda (f os)
         (with-current-buffer (find-file-noselect f)
           (save-excursion
             (dolist (o (sort (copy-sequence os)
                              (lambda (a b) (> (nth 1 a) (nth 1 b)))))
               (goto-char (point-min))
               (forward-line (1- (nth 1 o)))
               (let ((cur (buffer-substring-no-properties
                           (line-beginning-position) (line-end-position))))
                 (when (string= cur (nth 2 o))
                   (delete-region (line-beginning-position) (line-end-position))
                   (insert (funcall (nth 3 o) new))))))
           (save-buffer)
           (push f changed)))
       by-file)
      changed)))

(defun my/cyberdeck-tag-all-occurrences (old)
  "Vault plus config-file occurrences for OLD, one list."
  (append (my/cyberdeck-tag-occurrences old)
          (my/cyberdeck-tag-config-occurrences old)))

(defun my/cyberdeck-tag-vocab-aius (old)
  "Report lines for curated files mentioning OLD (not edited)."
  (mapcar (lambda (f) (format "curated (edit by hand): %s" f))
          (my/cyberdeck-tag-vocab-hits old)))

(defun my/cyberdeck-tag-preview (occurrences new &optional notes)
  "Show OCCURRENCES with replacement NEW in a preview buffer.
AIUS are extra report lines (curated files, never edited)."
  (let ((buf (get-buffer-create "*Cyberdeck Tag Preview*")))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "%d occurrence(s) -> '%s'\n\n" (length occurrences) new))
        (dolist (o occurrences)
          (insert (format "%s:%d\n- %s\n+ %s\n\n"
                          (nth 0 o) (nth 1 o) (nth 2 o)
                          (funcall (nth 3 o) new))))
        (when notes
          (insert "--- report only ---\n")
          (dolist (n notes) (insert n "\n")))))
    (display-buffer buf)))

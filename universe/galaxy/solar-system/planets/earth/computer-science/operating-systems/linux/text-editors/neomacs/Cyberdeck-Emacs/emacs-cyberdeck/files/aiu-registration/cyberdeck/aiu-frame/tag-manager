(defvar my/cyberdeck-tag-renamed-functions nil
  "Hook run with (OLD NEW-or-empty) after a tag rename or delete.
Consumed by the tag-hierarchy module to keep extends in sync.")

(defun my/cyberdeck-tag-rename (old new)
  "Rename tag OLD to NEW vault-wide with preview and confirmation."
  (interactive
   (let ((old (completing-read "Rename tag: "
                               (mapcar #'car (my/cyberdeck-tags-census)))))
     (list old (read-string (format "Rename '%s' to: " old)))))
  (let ((occ (my/cyberdeck-tag-all-occurrences old))
        (notes (my/cyberdeck-tag-vocab-aius old)))
    (if (null occ)
        (message "no occurrences of '%s'" old)
      (my/cyberdeck-tag-preview occ new notes)
      (when (yes-or-no-p (format "Apply %d change(s)? " (length occ)))
        (my/cyberdeck-tag-apply occ new)
        (run-hook-with-args 'my/cyberdeck-tag-renamed-functions old new)
        (message "renamed '%s' to '%s'" old new)))))

(defun my/cyberdeck-tag-delete (tag)
  "Delete TAG everywhere with preview and confirmation."
  (interactive
   (list (completing-read "Delete tag: "
                          (mapcar #'car (my/cyberdeck-tags-census)))))
  (let ((occ (my/cyberdeck-tag-all-occurrences tag))
        (notes (my/cyberdeck-tag-vocab-aius tag)))
    (if (null occ)
        (message "no occurrences of '%s'" tag)
      (my/cyberdeck-tag-preview occ "" notes)
      (when (yes-or-no-p (format "Delete %d occurrence(s)? " (length occ)))
        (my/cyberdeck-tag-apply occ "")
        (run-hook-with-args 'my/cyberdeck-tag-renamed-functions tag "")
        (message "deleted '%s'" tag)))))

(defun my/cyberdeck-tag-orphans ()
  "Tags occurring exactly once vault-wide."
  (seq-filter (lambda (row) (= (nth 1 row) 1)) (my/cyberdeck-tags-census)))

(defun my/cyberdeck-tag-clean-orphans ()
  "List orphan tags; delete chosen ones with preview."
  (interactive)
  (let ((orphans (mapcar #'car (my/cyberdeck-tag-orphans))))
    (if (null orphans)
        (message "no orphan tags")
      (let ((tag (completing-read "Delete orphan tag: " orphans)))
        (my/cyberdeck-tag-delete tag)))))

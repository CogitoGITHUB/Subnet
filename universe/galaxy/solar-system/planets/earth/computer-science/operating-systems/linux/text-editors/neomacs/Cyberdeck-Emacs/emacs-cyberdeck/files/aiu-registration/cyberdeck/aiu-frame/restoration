      (dolist (f files)
          (when (and f (file-exists-p f))
            (when (with-temp-buffer
                    (insert-file-contents f)
                    (goto-char (point-min))
                    (when (re-search-forward "^\\* " nil t)
                      (let ((sub-end
                             (save-excursion
                               (if (re-search-forward "^\\* " nil t)
                                   (match-beginning 0)
                                 (point-max)))))
                        (when (re-search-forward
                               "^[ \t]*:PROPERTIES:[ \t]*$" sub-end t)
                          (let ((drawer-end
                                 (save-excursion
                                   (when (re-search-forward
                                          "^[ \t]*:END:[ \t]*$" sub-end t)
                                     (point)))))
                            (and drawer-end
                                 (re-search-forward re drawer-end t)))))))
              (push f holders))))
      (nreverse holders))))

(defun my/cyberdeck-links--ensure-drawer-order-keys (keys)
  "Append missing KEYS as `** KEY' lines to drawer-order.org, then apply.
Returns the appended list. Never reorders or prunes existing headings."
  (let ((missing (and keys
                      (fboundp 'my/cyberdeck-drawer-order-from-file)
                      (let ((order (my/cyberdeck-drawer-order-from-file)))
                        (cl-remove-if (lambda (k) (member k order)) keys))))
        (f (and (fboundp 'my/cyberdeck-drawer-order-file)
                (my/cyberdeck-drawer-order-file))))
    (when (and missing f (file-exists-p f))
      (with-temp-file f
        (insert-file-contents f)
        (goto-char (point-max))
        (unless (bolp) (insert "\n"))
        (dolist (k missing)
          (insert (format "** %s\n" k))))
      (when (fboundp 'my/cyberdeck--apply-drawer-order-file)
        (my/cyberdeck--apply-drawer-order-file)))
    missing))

(defun my/cyberdeck-links--prune-drawer-order-stale ()
  "Remove drawer-order.org `**' headings matching no prompt key.
Compares against spec :keys plus the reinforce extra-keys allowlist
\(e.g. ID). Skips entirely when the specs registry is empty — a
failed registration must never eat the order file. Applies
\(setq + vault sweep) when anything was removed. Returns removed list."
  (let ((removed nil))
    (unless (and (boundp 'my/cyberdeck-org-prompt--specs)
                 (hash-table-p my/cyberdeck-org-prompt--specs)
                 (> (hash-table-count my/cyberdeck-org-prompt--specs) 0))
      (message "drawer-order: prune skipped (prompt registry unavailable)"))
    (when (and (fboundp 'my/cyberdeck-drawer-order-from-file)
               (fboundp 'my/cyberdeck-drawer-order-file)
               (boundp 'my/cyberdeck-org-prompt--specs)
               (hash-table-p my/cyberdeck-org-prompt--specs)
               (> (hash-table-count my/cyberdeck-org-prompt--specs) 0))
      (let ((known nil)
            (extra (and (boundp 'my/cyberdeck-reinforce--drawer-order-extra-keys)
                        my/cyberdeck-reinforce--drawer-order-extra-keys))
            (f (my/cyberdeck-drawer-order-file)))
        (maphash (lambda (_k spec)
                   (let ((key (plist-get spec :key)))
                     (when (and (stringp key) (not (string-empty-p key)))
                       (push key known))))
                 my/cyberdeck-org-prompt--specs)
        (let ((order (my/cyberdeck-drawer-order-from-file)))
          (setq removed (cl-remove-if
                         (lambda (k) (or (member k known) (member k extra)))
                         order)))
        (when (and removed (file-exists-p f))
          (with-temp-file f
            (insert-file-contents f)
            (dolist (k removed)
              (goto-char (point-min))
              (when (re-search-forward
                     (format "^\\*\\* +%s[ \t]*$" (regexp-quote k)) nil t)
                (delete-region (line-beginning-position)
                               (min (1+ (line-end-position)) (point-max))))))
          (when (fboundp 'my/cyberdeck--apply-drawer-order-file)
            (my/cyberdeck--apply-drawer-order-file))
          (message "drawer-order: pruned %d stale keys (%s)"
                   (length removed) (string-join removed ", ")))))
    removed))

(defun my/cyberdeck-links--reconcile-on-boot ()
  "Diff on-disk prompt keys vs `.known-keys' and reconcile.
New keys: drawer-order append + stub sweep (Added log per file).
Gone keys: Deleted log per holder file, static-sentinel drawer lines
stripped (live values kept + logged to Deleted Live Headings
AIU Contexts), Static AIU Contexts rebuilt. Stale drawer-order headings
(no prompt key) are pruned.
Updates `.known-keys' to current reality. Idempotent —
a second boot with no changes is a no-op. Returns (NEW . GONE)."
  (let ((current (my/cyberdeck-links--scan-current-keys))
        (last-known (my/cyberdeck-links--known-keys-read)))
    (if (null last-known)
        (progn
          (my/cyberdeck-links--known-keys-write current)
          (message "known-keys: seeded %d keys (no diff on first record)"
                   (length current))
          (cons nil nil))
      (let ((new (sort (cl-set-difference current last-known :test #'string=)
                       #'string<))
            (gone (sort (cl-set-difference last-known current :test #'string=)
                        #'string<))
            (vault-files (my/cyberdeck-links--vault-aiu-files))
            (cleanup-stripped 0)
            (cleanup-live 0))
        (when new
          (my/cyberdeck-links--ensure-drawer-order-keys new)
          (when (fboundp 'my/cyberdeck--sweep-sync-drawer-keys)
            (let ((specs (and (boundp 'my/cyberdeck-org-prompt--specs)
                              my/cyberdeck-org-prompt--specs)))
              (my/cyberdeck--sweep-sync-drawer-keys
               (mapcar (lambda (k)
                         (let ((spec (and (hash-table-p specs)
                                          (gethash (intern (downcase k)) specs))))
                           (cons k (if (and spec
                                            (fboundp 'my/cyberdeck-org-prompt--default-for-spec))
                                       (my/cyberdeck-org-prompt--default-for-spec spec)
                                     "TODO"))))
                       new)))))
        (dolist (k gone)
          ;; One bad key must never abort prune + known-keys rewrite below.
          (condition-case err
              (progn
                (dolist (f (my/cyberdeck-links--gone-key-holders
                            k vault-files))
                  (my/cyberdeck-links--log-removed-property f k))
                (when (fboundp 'my/cyberdeck--sweep-remove-drawer-key-if-static)
                  (let ((res (my/cyberdeck--sweep-remove-drawer-key-if-static k)))
                    (setq cleanup-stripped (+ cleanup-stripped (car res)))
                    (dolist (lv (cdr res))
                      (my/cyberdeck-links--write-deleted-live-property
                       k (car lv) (cdr lv)))
                    (setq cleanup-live (+ cleanup-live (length (cdr res)))))))
            (error (lwarn 'cyberdeck :warning
                          "known-keys: gone-key %s cleanup failed: %s"
                          k err))))
        (my/cyberdeck-links--prune-drawer-order-stale)
        (when gone
          (when (fboundp 'my/cyberdeck-missing--rebuild-from-health)
            (my/cyberdeck-missing--rebuild-from-health))
          (when (or (> cleanup-stripped 0) (> cleanup-live 0))
            (message "drawer cleanup: stripped %d static, preserved %d live (see Deleted Live Headings AIU Contexts)"
                     cleanup-stripped cleanup-live)))
        (my/cyberdeck-links--known-keys-write current)
        (when (or new gone)
          (message "known-keys: +%d -%d (%s / %s)"
                   (length new) (length gone)
                   (string-join new ", ") (string-join gone ", ")))
        (cons new gone)))))

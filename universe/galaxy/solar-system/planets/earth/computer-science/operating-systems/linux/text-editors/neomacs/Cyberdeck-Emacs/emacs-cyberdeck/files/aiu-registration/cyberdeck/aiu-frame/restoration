(defun my/cyberdeck-links--scan-file-keys (f)
  "Prompt keys of F, from cache when its stamp matches."
  (let* ((attrs (file-attributes f))
         (stamp (and attrs (list (file-attribute-modification-time attrs)
                                 (file-attribute-size attrs))))
         (hit (and stamp (assoc f my/cyberdeck-links--scan-cache))))
    (if (and hit
             (equal (nth 1 hit) (nth 0 stamp))
             (equal (nth 2 hit) (nth 1 stamp))
             (listp (nth 3 hit)))
        (nth 3 hit)
      (let ((keys (let (out)
                    (when (my/cyberdeck-links--aiu-context-trackable-p f)
                      (let ((meta (ignore-errors
                                    (my/cyberdeck-links--read-aiu-context-meta f))))
                        (when (and meta (stringp (car meta))
                                   (not (string-empty-p (car meta))))
                          (push (car meta) out))))
                    out)))
        (when stamp
          (setq my/cyberdeck-links--scan-cache
                (cons (list f (nth 0 stamp) (nth 1 stamp) keys)
                      (assq-delete-all
                       f my/cyberdeck-links--scan-cache))))
        keys))))


(defun my/cyberdeck-links-audit ()
  "Scan entire vault for dead id: links using cyberdeck native API.
Produces *cyberdeck-dead-links* buffer. Run after bulk operations."
  (interactive)
  (let ((dead (cyberdeck-db-query-dead-links)))
    (if (not dead)
        (message "No dead links found in vault.")
      (with-current-buffer (get-buffer-create "*cyberdeck-dead-links*")
        (erase-buffer)
        (insert (format "Dead links: %d\n\n" (length dead)))
        (pcase-dolist (`(,note . ,dest-id) dead)
          (insert (format "  [%s]  %s  ->  missing id: %s\n"
                          (cyberdeck-aiu-id note)
                          (cyberdeck-aiu-title note)
                          dest-id)))
        (display-buffer (current-buffer))))))

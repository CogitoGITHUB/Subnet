**** Orphan detection
Skips DELETED-FILE itself and files under admin/unfoldings/.
#+begin_src emacs-lisp
 (defun my/cyberdeck-links--aiu-context-orphaned-p (aiu-context-id deleted-file)
  "Non-nil when UNFOLDING-ID is referenced only by DELETED-FILE.
For scoped unfoldings (with UNFOLDING_PARENT), checks parent ID
directly; for legacy shared unfoldings (no UNFOLDING_PARENT),
falls back to full vault scan."
  (let* ((aiu-context-aiu (ignore-errors (cyberdeck-db-get-by-id aiu-context-id)))
         (aiu-context-parent (and aiu-context-aiu
                          (cdr (assoc "UNFOLDING_PARENT"
                                      (cyberdeck-aiu-aiu-contexts aiu-context-aiu))))))
    (if aiu-context-parent
        ;; Scoped unique per parent — orphaned iff parent is the deleted file
        (let ((deleted-id (or my/cyberdeck-links--deleted-id
                              (ignore-errors
                                (with-temp-buffer
                                  (insert-file-contents deleted-file)
                                  (when (re-search-forward "^:ID:[ \t]+\\(.+\\)" nil t)
                                    (string-trim (match-string 1))))))))
          (and deleted-id (string= aiu-context-parent deleted-id)))
      ;; Legacy shared — full scan
      (let* ((root (my/cyberdeck-root-dir))
            (deleted-exp (expand-file-name deleted-file))
            (aiu-contexts-dir (expand-file-name "admin/unfoldings/" (my/cyberdeck-root-dir)))
            (files (nconc (directory-files-recursively root "\\.org\\'")
                          (directory-files-recursively root "[^./]+\\'")))
            (orphaned t))
        (dolist (f files)
          (let ((exp (expand-file-name f)))
            (when (and (not (string-equal exp deleted-exp))
                       (not (file-in-directory-p exp aiu-contexts-dir))
                       (not (string-match-p "/WIP/" exp)))
              (when (my/cyberdeck-links--aiu-context-id-in-file-p aiu-context-id exp)
                (setq orphaned nil)))))
        orphaned))))


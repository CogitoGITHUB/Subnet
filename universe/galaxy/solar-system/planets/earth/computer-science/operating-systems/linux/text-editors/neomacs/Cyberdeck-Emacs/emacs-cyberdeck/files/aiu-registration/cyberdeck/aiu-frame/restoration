(defun my/cyberdeck-links-setup ()
  "Register all advice hooks for the links guard.
Call once after cyberdeck has loaded."
  ;; File deletion
  (advice-add 'delete-file
              :before #'my/cyberdeck-links--before-file-delete)
  (advice-add 'delete-file
              :after  #'my/cyberdeck-links--after-file-delete)
  ;; Dired delete — dired-delete-file calls delete-file internally,

(defun my/cyberdeck-links--vault-aiu-files ()
  "Vault note files for sweeps: .org + extensionless, minus .git/admin.
Computed once per reconcile and shared, so N gone keys cost one scan.
One walk, pruning .git/WIP/admin at descent (walking them cost
minutes on phone storage), with pure string filters instead of
per-file truename resolution."
  (let* ((root (expand-file-name (my/cyberdeck-root-dir)))
         (skip (lambda (d)
                 (not (member (file-name-nondirectory
                               (directory-file-name d))
                              '(".git" "WIP" "admin"))))))
    (cl-remove-if
     (lambda (f)
       (or (string-match-p "/\\.git/" f)
           (string-match-p "/admin/" f)
           (string-match-p "/WIP/" f)))
     (directory-files-recursively root "" nil skip))))


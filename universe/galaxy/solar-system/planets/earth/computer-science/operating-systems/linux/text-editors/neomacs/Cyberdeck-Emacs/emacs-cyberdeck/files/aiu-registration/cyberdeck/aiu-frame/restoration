  (let (keys)
    (dolist (f (mapcar #'cdr (my/cyberdeck-aiu-context-key-files)))
      (setq keys (append (my/cyberdeck-links--scan-file-keys f) keys)))
    (setq keys (sort (delete-dups keys) #'string<))
    (my/cyberdeck-links--scan-cache-save)

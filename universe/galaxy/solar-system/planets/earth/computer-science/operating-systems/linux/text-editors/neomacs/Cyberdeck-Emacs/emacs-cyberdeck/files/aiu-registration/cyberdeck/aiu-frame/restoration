(defun my/cyberdeck-links--guard-deletion (deleted-id deleted-title)
  "Guard deletion of DELETED-ID / DELETED-TITLE.
1. Incoming: notes that link TO this note (incl. wormholes).
2. Outgoing: notes that this AIU Proxies TO."
  (when (and deleted-id deleted-title)
    ;; Check 1: incoming links and AIU Proxies
    (let ((incoming (cyberdeck-db-query-links-to deleted-id)))
      (dolist (id (my/cyberdeck-links--aiu-proxy-sources deleted-id))
        (push (list :source id) incoming))
      (my/cyberdeck-links--check-direction
       deleted-id deleted-title incoming "is linked from" :source "incoming"))
    ;; Check 2: outgoing links
    (let ((outgoing (cyberdeck-db-query-links-from deleted-id)))
      (my/cyberdeck-links--check-direction
       deleted-id deleted-title outgoing "links to" :dest "outgoing"))))

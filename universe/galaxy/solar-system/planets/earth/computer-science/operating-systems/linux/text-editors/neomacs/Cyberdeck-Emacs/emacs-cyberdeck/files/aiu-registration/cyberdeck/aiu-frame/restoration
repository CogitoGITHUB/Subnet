(defun my/cyberdeck-links--deletion-guardable-p (expanded)
  "Non-nil when EXPANDED is a deletable vault AIU file."
  (and (file-exists-p expanded)
       (file-in-directory-p expanded (my/cyberdeck-root-dir))
       (not (file-in-directory-p
             expanded
             (expand-file-name "admin/unfoldings/" (my/cyberdeck-root-dir))))
       (or (string-suffix-p ".org" expanded)
            (not (string-match-p "\\." (file-name-nondirectory expanded))))
       ;; Compare full paths: the admin vars hold "admin/..." relative
       ;; paths, so basename comparison never matched and admin files
       ;; (e.g. Missing Links deleted when empty) got logged as junk.
       (not (member (expand-file-name expanded)
                    (my/cyberdeck-links--admin-file-paths)))))
#+end_src

**** Before-file-delete advice
Guards the queue file, reads ID/title, runs the link guard, captures
orphaned AIU Contexts while the file still exists, then records the entry.
#+begin_src emacs-lisp
(defun my/cyberdeck-links--before-file-delete (file &rest _)
  "Before FILE is deleted: guard, capture state, record."
  (let ((expanded (expand-file-name file)))
    (when (my/cyberdeck-links--deletion-guardable-p expanded)
      ;; Guard broken-links specifically
      (my/cyberdeck-links--guard-broken-links-file expanded)
      ;; Read ID and title then run link guard
      (with-temp-buffer
        (insert-file-contents expanded)
        (org-mode)
        (let (id title)
          (setq id    (org-entry-get (point-min) "ID"))
          (setq title (cadr (assoc "TITLE"
                                   (org-collect-keywords
                                    (list "TITLE")))))
          (when id
            (setq my/cyberdeck-links--deleted-id    id
                  my/cyberdeck-links--deleted-title
                  (or title (file-name-base expanded)))
            (my/cyberdeck-links--guard-deletion
             id
             my/cyberdeck-links--deleted-title)))
        ;; Capture AIU Contexts orphaned by this deletion while the file exists
        (setq my/cyberdeck-links--deleted-aiu-contexts
              (my/cyberdeck-links--orphaned-aiu-contexts-for expanded))
        ;; Record in ReManifold even without ID
        (my/cyberdeck-links--write-deleted-entry
         expanded my/cyberdeck-links--deleted-aiu-contexts)))))

(defun my/cyberdeck-links--after-file-delete (&rest _)
  "After file deletion: delete orphaned unfoldings and clear captured state.
Unfoldings are captured into a local first so the delete-file advice firing
again for each AIU Context cannot re-enter with stale state."
  (let ((unfoldings my/cyberdeck-links--deleted-aiu-contexts))
    (setq my/cyberdeck-links--deleted-id    nil
          my/cyberdeck-links--deleted-title nil
          my/cyberdeck-links--deleted-aiu-contexts  nil)
    (dolist (rel unfoldings)
      (let ((path (expand-file-name rel (my/cyberdeck-root-dir))))
        (when (file-exists-p path)
          (delete-file path))))))

  ;; Skipping dired-delete-file advice to avoid double-firing.
  ;; Heading cut
  (advice-add 'org-cut-subtree
              :before #'my/cyberdeck-links--before-heading-delete)
  (advice-add 'org-cut-subtree
              :after  #'my/cyberdeck-links--after-heading-delete)
  ;; Heading archive

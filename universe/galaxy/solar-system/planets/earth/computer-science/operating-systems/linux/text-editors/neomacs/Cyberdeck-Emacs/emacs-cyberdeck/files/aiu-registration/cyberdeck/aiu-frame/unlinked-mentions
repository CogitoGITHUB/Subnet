** Hint overlays
#+begin_src emacs-lisp
(defvar-local my/cyberdeck-mention-hint-titles nil
  "Titles highlighted in this buffer by hint mode.")

(defvar-local my/cyberdeck-mention-hints-timer nil
  "Idle timer refreshing hint overlays in this buffer.")

(defun my/cyberdeck-mention-hints-refresh ()
  "Highlight known AIU titles in the current buffer (hints only)."
  (when (derived-mode-p 'org-mode)
    (unless my/cyberdeck-mention-hint-titles
      (let (titles)
        (dolist (n (ignore-errors (cyberdeck-db-query)))
          (let ((t1 (ignore-errors (cyberdeck-aiu-title n))))
            (when (and (stringp t1) (> (length t1) 3) (< (length titles) 500))
              (push t1 titles))))
        (setq my/cyberdeck-mention-hint-titles
              (sort titles (lambda (a b) (> (length a) (length b)))))))
    (when my/cyberdeck-mention-hint-titles
      (font-lock-add-keywords
       nil
       (list (list (regexp-opt my/cyberdeck-mention-hint-titles 'words)
                   0 'highlight t)))
      (when font-lock-mode (font-lock-flush)))))

(define-minor-mode my/cyberdeck-mention-hints-mode
  "Highlight known AIU titles as non-writing hints."
  :lighter " ?"
  (if my/cyberdeck-mention-hints-mode
      (progn (setq my/cyberdeck-mention-hints-timer
                   (run-with-idle-timer 2 t #'my/cyberdeck-mention-hints-refresh))
             (my/cyberdeck-mention-hints-refresh))
    (when (timerp my/cyberdeck-mention-hints-timer)
      (cancel-timer my/cyberdeck-mention-hints-timer)
      (setq my/cyberdeck-mention-hints-timer nil))
    (font-lock-remove-keywords nil
     (list (list (regexp-opt (or my/cyberdeck-mention-hint-titles '("")) 'words)
                 0 'highlight t)))
    (when font-lock-mode (font-lock-flush))))

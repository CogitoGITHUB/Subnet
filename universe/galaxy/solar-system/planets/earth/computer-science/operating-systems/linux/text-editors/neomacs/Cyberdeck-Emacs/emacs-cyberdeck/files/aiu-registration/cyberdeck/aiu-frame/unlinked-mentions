** Actions
#+begin_src emacs-lisp
(defun my/cyberdeck-mention-link-at (target-aiu file pos &optional title)
  "Replace the occurrence at POS in FILE with an id: link to TARGET-NOTE.
TITLE is the matched text (title or alias); defaults to the AIU title."
  (let ((text (or title (ignore-errors
                         (cyberdeck-aiu-title target-aiu)) "")))
    (with-current-buffer (find-file-noselect file)
      (save-excursion
        (goto-char pos)
        (when (looking-at (regexp-quote text))
          (delete-region pos (match-end 0))
          (insert (cyberdeck-utils-link-make-string target-aiu))))
      (save-buffer))))

(defun my/cyberdeck-mention-link (target-aiu file pos &optional title)
  "Link a single mention occurrence."
  (interactive)
  (my/cyberdeck-mention-link-at target-aiu file pos title)
  (message "linked one mention"))

(defun my/cyberdeck-mention-link-all (target-aiu file)
  "Link every unlinked mention of TARGET-NOTE in FILE.
Works back to front so earlier positions stay valid."
  (interactive)
  (let ((n 0)
        (cands (sort (seq-filter
                      (lambda (m) (string= (expand-file-name (nth 0 m))
                                          (expand-file-name file)))
                      (my/cyberdeck-mentions-for-aiu target-aiu))
                     (lambda (a b) (> (nth 1 a) (nth 1 b))))))
    (dolist (m cands)
      (my/cyberdeck-mention-link-at target-aiu (nth 0 m) (nth 1 m) (nth 2 m))
      (setq n (1+ n)))
    (message "linked %d mention(s)" n)))

(defun my/cyberdeck-mention-ignore (target-aiu file)
  "Never show mentions of TARGET-NOTE from FILE again."
  (interactive)
  (let* ((target-id (ignore-errors (cyberdeck-aiu-id target-aiu)))
         (sid (ignore-errors
                (with-temp-buffer
                  (insert-file-contents file)
                  (when (re-search-forward "^:ID:[ \t]*\\(\\S-+\\)" nil t)
                    (match-string-no-properties 1)))))
         (pair (cons sid target-id)))
    (unless (member pair my/cyberdeck-mention-ignores)
      (push pair my/cyberdeck-mention-ignores)
      (my/cyberdeck-mention-ignores-save))
    (message "ignored")))
#+end_src

** Review buffer
#+begin_src emacs-lisp
(defun my/cyberdeck-mentions-review (note)
  "Show unlinked mentions of NOTE with Link / Link-all / Ignore buttons."
  (interactive
   (list (cyberdeck-find)))
  (let ((buf (get-buffer-create "*Cyberdeck Mentions*"))
        (cands (my/cyberdeck-mentions-for-aiu note)))
    (with-current-buffer buf
      (let ((inhibit-read-only t))
        (erase-buffer)
        (insert (format "Unlinked mentions of %s (%d)\n\n"
                        (ignore-errors (cyberdeck-aiu-title note))
                        (length cands)))
        (dolist (m cands)
          (let ((f (nth 0 m)) (pos (nth 1 m)) (title (nth 2 m)))
            (insert (format "%s @%d: %s  " (file-name-nondirectory f) pos title))
            (insert-text-button "Link"
              'action (lambda (_) (my/cyberdeck-mention-link note f pos title)))
            (insert " ")
            (insert-text-button "Link-all"
              'action (lambda (_) (my/cyberdeck-mention-link-all note f)))
            (insert " ")
            (insert-text-button "Ignore"
              'action (lambda (_) (my/cyberdeck-mention-ignore note f)))
            (insert "\n"))))
      (special-mode))
    (display-buffer buf)))

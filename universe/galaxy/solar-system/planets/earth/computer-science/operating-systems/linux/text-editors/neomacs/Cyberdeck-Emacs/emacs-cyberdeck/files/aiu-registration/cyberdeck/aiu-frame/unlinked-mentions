Find bodies that mention an AIU's title without linking it, and act:
link one occurrence, link them all, or ignore that source for that
target.  Read-only until you act; actions reuse the standard link
builder.  Hint overlays (mention-hints-mode) highlight known titles
without writing anything.  Nothing here runs at load.

** Ignore store
#+begin_src emacs-lisp
(require 'cl-lib)

(defvar my/cyberdeck-mention-ignores-file
  (expand-file-name ".local/cache/aiu-frame-mention-ignores.el" (expand-file-name "~"))
  "Persisted list of (SOURCE-ID . TARGET-ID) to skip.")

(defvar my/cyberdeck-mention-ignores nil
  "List of (SOURCE-ID . TARGET-ID) pairs the user ignored.")

(defun my/cyberdeck-mention-ignores-load ()
  (setq my/cyberdeck-mention-ignores nil)
  (condition-case nil
      (when (file-exists-p my/cyberdeck-mention-ignores-file)
        (setq my/cyberdeck-mention-ignores
              (car (read-from-string
                    (with-temp-buffer
                      (insert-file-contents my/cyberdeck-mention-ignores-file)
                      (buffer-string))))))
    (error nil)))

(defun my/cyberdeck-mention-ignores-save ()
  (condition-case nil
      (let ((tmp (concat my/cyberdeck-mention-ignores-file ".tmp"))
            (print-length nil) (print-level nil))
        (make-directory (file-name-directory my/cyberdeck-mention-ignores-file) t)
        (with-temp-file tmp (prin1 my/cyberdeck-mention-ignores (current-buffer)))
        (rename-file tmp my/cyberdeck-mention-ignores-file t))
    (error nil)))

(my/cyberdeck-mention-ignores-load)
#+end_src

** Candidate scan
#+begin_src emacs-lisp
(defun my/cyberdeck-mention-titles (note)
  "Title plus aliases of NOTE for literal matching, longest first."
  (let ((out nil))
    (dolist (s (cons (ignore-errors (cyberdeck-aiu-title note))
                     (ignore-errors (cyberdeck-aiu-aliases note))))
      (when (and (stringp s) (> (length s) 2) (not (member s out)))
        (push s out)))
    (sort out (lambda (a b) (> (length a) (length b))))))

(defun my/cyberdeck-mention-occurrence-linked-p (target-id pos)
  "Non-nil when the occurrence at POS is already an id: link to TARGET-ID."
  (save-excursion
    (goto-char pos)
    (let ((beg (max (point-min) (- pos 80))))
      (goto-char beg)
      (re-search-forward (concat "\\[\\[id:" (regexp-quote target-id) "\\]") pos t))))

(defun my/cyberdeck-mentions-for-aiu (note)
  "List of (SOURCE-FILE POSITION TITLE) unlinked mentions of NOTE.
Scans vault text files; skips the note's own file, ignored pairs, and
already-linked occurrences.  Code blocks are skipped best-effort."
  (let* ((target-id (ignore-errors (cyberdeck-aiu-id note)))
         (titles (and target-id (my/cyberdeck-mention-titles note)))
         (own (and target-id (ignore-errors (cyberdeck-aiu-path note))))
         (root (ignore-errors (my/cyberdeck-root-dir)))
         (found nil))
    (when (and titles root)
      (dolist (f (directory-files-recursively root "\\.org\\'"))
        (unless (or (string-match-p "/\\.git/" f)
                    (string-match-p "/admin/" f)
                    (and own (string= (expand-file-name f) (expand-file-name own))))
          (let ((sid (ignore-errors
                       (with-temp-buffer
                         (insert-file-contents f)
                         (when (re-search-forward "^:ID:[ \t]*\\(\\S-+\\)" nil t)
                           (match-string-no-properties 1))))))
            (unless (member (cons sid target-id) my/cyberdeck-mention-ignores)
              (with-temp-buffer
                (insert-file-contents f)
                (dolist (title titles)
                  (goto-char (point-min))
                  (while (search-forward title nil t)
                    (let ((pos (match-beginning 0)))
                      (unless (or (my/cyberdeck-mention-occurrence-linked-p target-id pos)
                                  (and (fboundp 'org-in-src-block-p)
                                       (save-excursion (goto-char pos)
                                                       (org-in-src-block-p))))
                        (push (list f pos title) found)))))))))))
    (nreverse found)))

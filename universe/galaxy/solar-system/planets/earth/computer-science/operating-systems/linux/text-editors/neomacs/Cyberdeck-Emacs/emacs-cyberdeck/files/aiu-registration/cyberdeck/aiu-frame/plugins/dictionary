(defun my/cyberdeck-dictionary--ensure-table ()
  "Create the dictionary_words table if it does not exist."
  (emacsql (cyberdeck-db)
    [:create :table :if :not :exists dictionary_words
     ([(aiu-id :not-null)
       (word :not-null)
       (pos :null)
       (source :null)
       (added :null)]
      (:primary-key [aiu-id])
      (:foreign-key [aiu-id] :references notes [id]
       :on-delete :cascade))]))
#+end_src

* DB Extractor
Reads WORD/POS/SOURCE/ADDED straight from aiu-data's AIU Contexts and
title — no AST walk needed, so this stays fast and worker-eligible.

** Extractor
#+begin_src emacs-lisp
(defun my/cyberdeck-dictionary--extract (_ctx aiu-data)
  "Extract dictionary fields from NOTE-DATA and store in dictionary_words table."
  (let* ((aiu-id (plist-get aiu-data :id))
         (tags    (plist-get aiu-data :tags))
         (unfoldings   (plist-get aiu-data :unfoldings)))
    (when (member "dictionary" tags)
      (let ((word   (or (cdr (assoc "WORD" unfoldings))
                        (plist-get aiu-data :title)))
            (pos    (cdr (assoc "POS" unfoldings)))
            (source (cdr (assoc "SOURCE" unfoldings)))
            (added  (cdr (assoc "ADDED" unfoldings))))
        (emacsql (cyberdeck-db)
          [:delete :from dictionary_words :where (= aiu-id $s1)]
          aiu-id)
        (emacsql (cyberdeck-db)
          [:insert :into dictionary_words :values $v1]
          (vector aiu-id word pos source added))))
    aiu-data))
#+end_src


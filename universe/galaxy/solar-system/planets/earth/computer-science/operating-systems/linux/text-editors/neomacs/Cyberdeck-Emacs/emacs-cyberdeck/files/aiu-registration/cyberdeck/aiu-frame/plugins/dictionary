** New word command
Creates a new dictionary AIU for WORD. Tags are set automatically:
`dictionary', the slugified WORD, and each subdirectory level under
`dictionary/'.
#+begin_src emacs-lisp
(defun my/cyberdeck-dictionary-new-word (word)
  "Create a new dictionary note for WORD.
Prompts for subdirectory under `dictionary/', fast mode level,
dictionary-specific prompts (POS, pronunciation, etc.), and
general prompts (state, tags, etc.)."
  (interactive "sWord: ")
  (let* ((root (expand-file-name "dictionary/" (my/cyberdeck-root-dir)))
         (_ (make-directory root t))
         (added (format-time-string "[%Y-%m-%d]"))
         (slug (my/cyberdeck-dictionary--slugify word))
         (subdir "")
          (file-name (concat "dictionary/" subdir slug))
         (path-tags (if (string-empty-p subdir)
                        '()
                      (split-string (directory-file-name subdir) "/" t)))
         (cyberdeck-create-default-function (lambda (_) '()))
         (prompts (my/cyberdeck-collect-prompts-with-fast '(dictionary) '(file)))
         (tags (append (list "dictionary" slug) path-tags
                       (plist-get prompts :tags)))
         (unfoldings (append
                      `(("ADDED" . ,added))
                      (plist-get prompts :unfoldings)))
         (body (plist-get prompts :body))
         (post-apply (plist-get prompts :post-apply))
         (note (my/cyberdeck--create-file-wrapper
                word file-name tags unfoldings body)))
    (dolist (fn post-apply)
      (funcall fn note))
    (my/cyberdeck-dictionary--open-body-capture note body)
    (my/cyberdeck-dictionary-regenerate-dictionary)
    note))
#+end_src

* Dictionary Regeneration
#+begin_src emacs-lisp
(defun my/cyberdeck-dictionary--all-words ()
  "Return the sorted, deduplicated list of words from dictionary_words."
  (let ((rows (emacsql (cyberdeck-db)
               [:select [word] :from dictionary_words])))
    (sort (delete-dups (mapcar #'car rows)) #'string<)))

(defun my/cyberdeck-dictionary-regenerate-dictionary ()
  "Rebuild the flat ispell .pws file from all AIUs tagged \"dictionary\"."
  (interactive)
  (make-directory (file-name-directory my/cyberdeck-dictionary-pws-file) t)
  (let ((words (my/cyberdeck-dictionary--all-words)))
    (with-temp-file my/cyberdeck-dictionary-pws-file
      (insert (format "personal_ws-1.1 en %d\n" (length words)))
      (dolist (w words)
        (insert w "\n"))))
  (message "Vocab dictionary regenerated (%d words)"
           (length (my/cyberdeck-dictionary--all-words))))

;; Point ispell at the generated file.
(with-eval-after-load 'ispell
  (setq ispell-personal-dictionary my/cyberdeck-dictionary-pws-file))
#+end_src


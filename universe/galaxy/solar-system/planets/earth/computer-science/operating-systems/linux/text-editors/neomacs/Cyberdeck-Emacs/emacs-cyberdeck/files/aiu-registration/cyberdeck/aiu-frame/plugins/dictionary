#+begin_src emacs-lisp
(defun my/cyberdeck-dictionary--open-body-capture (note body)
  "Open org-capture for AIU's body with BODY template."
  (let ((org-capture-templates
         `(("v" "Edit AIU body"
             plain
             (file+function
              ,(cyberdeck-aiu-path note)
              (lambda ()
                (goto-char (point-max))
                (skip-chars-backward " \t\n")))
             ,(or body "%?")
             :kill-buffer t :unnarrowed t))))
    (org-capture nil "v"))
  (set-buffer-modified-p nil)
  (when (fboundp 'modaled-set-state) (modaled-set-state "insert")))

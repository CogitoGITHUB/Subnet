(defun aiu-subnet/--place-under (note)
  "Pick an existing child and reparent it under AIU."
  (let ((aiu-id (cyberdeck-aiu-id note)))
    (condition-case nil
        ;; let*: child-id reads the just-selected child (plain let
        ;; would read an outer binding instead).
        (let* ((child (cyberdeck-select "Child to place under this note: "
                                                :require-match t))
               (child-id (cyberdeck-aiu-id child)))
          (unless (string= aiu-id child-id)
            (aiu-subnet/reparent child-id aiu-id)
            (message "✓ %s is now a child of %s"
                     (cyberdeck-aiu-title child)
                     (cyberdeck-aiu-title note))))
      (quit (message "Placement cancelled.")))))

(defun aiu-subnet/--place-under-parent (note)
  "Pick a parent and file AIU under it."
  (let ((aiu-id (cyberdeck-aiu-id note)))
    (condition-case nil
        ;; let*: see above.
        (let* ((parent (cyberdeck-select "Parent for this note: "
                                                 :require-match t))
               (parent-id (cyberdeck-aiu-id parent)))
          (unless (string= aiu-id parent-id)
            (aiu-subnet/reparent aiu-id parent-id)
            (message "✓ %s → child of %s"
                     (cyberdeck-aiu-title note)
                     (cyberdeck-aiu-title parent))))
      (quit (message "Placement cancelled.")))))

(defun aiu-subnet/--place-after-sibling (note)
  "Pick a sibling and place AIU immediately after it."
  (let ((aiu-id (cyberdeck-aiu-id note)))
    (condition-case nil
        ;; let*: see above.
        (let* ((sibling (cyberdeck-select "Place after: "
                                                  :require-match t))
               (sib-id (cyberdeck-aiu-id sibling))
               (parent-id (aiu-subnet/parent-of (cyberdeck-aiu-id sibling))))
          (if parent-id
              (aiu-subnet/set-parent aiu-id parent-id)
            (aiu-subnet/make-root aiu-id))
          (aiu-subnet/set-order-key aiu-id (aiu-subnet/order-key-after sib-id))
          (message "✓ %s → after %s"
                   (cyberdeck-aiu-title note)
                   (cyberdeck-aiu-title sibling)))
      (quit (message "Placement cancelled.")))))

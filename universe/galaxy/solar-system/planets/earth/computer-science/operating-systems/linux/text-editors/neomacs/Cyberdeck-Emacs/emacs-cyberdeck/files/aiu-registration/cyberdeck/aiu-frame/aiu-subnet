(defun aiu-subnet/json--build-headings (file-aiu-id)
  "Build list of heading alists for FILE-NOTE-ID's group."
  (let (headings)
    (dolist (row (aiu-subnet/headings-of file-aiu-id))
      (when-let* ((h-aiu (cyberdeck-db-get-by-id (car row))))
        (push `((id       . ,(car row))
                (title    . ,(cyberdeck-aiu-title h-aiu))
                (type     . "heading")
                (orderKey . ,(cadr row))
                (status   . ,(aiu-subnet/status-of (car row)))
                (stage    . ,(aiu-subnet/map--stage-of (car row))))
              headings)))
    (nreverse headings)))

(defun aiu-subnet/json--build-nodes ()
  "Build list of JSON node alists for all file nodes."
  (let ((rows (emacsql (cyberdeck-db)
                       [:select [aiu-id parent-id order-key depth]
                        :from aiu-subnet-nodes
                        :where (= aiu-type "file")
                        :order-by [(asc depth) (asc order-key)]]))
        nodes)
    (dolist (row rows)
      (let* ((aiu-id   (nth 0 row))
             (parent-id (nth 1 row))
             (order-key (nth 2 row))
             (depth     (nth 3 row))
             (note      (cyberdeck-db-get-by-id aiu-id))
             (status    (aiu-subnet/status-of aiu-id))
             (headings  (aiu-subnet/json--build-headings aiu-id)))
        (when note
          (push `((id       . ,aiu-id)
                   (title    . ,(cyberdeck-aiu-title note))
                   (type     . "file")
                   (parentId . ,parent-id)
                   (orderKey . ,order-key)
                   (depth    . ,depth)
                   (status   . ,status)
                   (stage    . ,(aiu-subnet/map--stage-of aiu-id))
                   (headings . ,(vconcat headings)))
                 nodes))))
    (nreverse nodes)))

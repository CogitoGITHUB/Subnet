**** Extractor
File AIUs (level 0): parent-id nil — user assigns position explicitly.
Heading AIUs (level > 0): parent-id auto-set to the file's root AIU.
Never overwrites existing rows — user-set positions are preserved.
The insert is a plain conditional insert, deliberately backend-neutral:
the old SQLite-only =INSERT OR IGNORE= spelling cannot compile on
PostgreSQL, and the =unless existing= guard above already covers the
single-user case (a concurrent-insert race, if it ever happened,
is absorbed by ignore-errors rather than risking a duplicate row).
#+begin_src emacs-lisp
(defun aiu-subnet/extract (_ctx aiu-data)
  "Manifolding AIU Frame extractor: register note in aiu-subnet-nodes on DB sync.
File notes (level 0): parent-id nil — user assigns position explicitly.
Heading notes (level > 0): parent-id auto-set to the file's root note.
Never overwrites existing rows — user-set positions are preserved."
  (let* ((aiu-id   (plist-get aiu-data :id))
         (level     (or (plist-get aiu-data :level) 0))
         (file-path (plist-get aiu-data :path))
         (aiu-type (if (> level 0) "heading" "file"))
         (existing  (caar (emacsql (cyberdeck-db)
                                   [:select [aiu-id] :from aiu-subnet-nodes
                                    :where (= aiu-id $s1)]
                                   aiu-id))))
    (unless existing
      (let* ((parent-id
              (when (> level 0)
                (caar (emacsql (cyberdeck-db)
                               [:select [id] :from notes
                                :where (and (= path $s1)
                                            (= level 0))]
                               file-path))))
             (depth
              (if parent-id
                  (1+ (or (caar (emacsql (cyberdeck-db)
                                         [:select [depth] :from aiu-subnet-nodes
                                          :where (= aiu-id $s1)]
                                         parent-id))
                          0))
                0))
             (order-key
              (if (> level 0)
                  (float (or (plist-get aiu-data :pos) 0))
                0.0)))
        (ignore-errors
          (emacsql (cyberdeck-db)
                   [:insert :into aiu-subnet-nodes
                    :values $v1]
                   (vector aiu-id parent-id order-key aiu-type depth)))))
    aiu-data))

(defun aiu-subnet/goto-parent ()
  "Visit the parent of the current AIU in the map."
  (interactive)
  (let* ((note      (my/cyberdeck--buffer-aiu))
         (parent-id (aiu-subnet/parent-of (cyberdeck-aiu-id note))))

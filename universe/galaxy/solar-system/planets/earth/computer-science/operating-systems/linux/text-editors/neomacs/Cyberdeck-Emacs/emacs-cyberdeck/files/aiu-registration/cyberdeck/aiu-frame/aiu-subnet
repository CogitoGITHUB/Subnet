(defun aiu-subnet/json--edges (edges)
  "Convert edge PLIST EDGES into JSON-ready alists."
  `((structural     . ,(vconcat (mapcar (lambda (e)
                                          `((source . ,(car e))
                                            (target . ,(cdr e))))
                                        (plist-get edges :structural))))
    (semantic       . ,(vconcat (mapcar (lambda (e)
                                          `((source . ,(car e))
                                            (target . ,(cdr e))))
                                        (plist-get edges :semantic))))
    (presentational . ,(vconcat (mapcar (lambda (e)
                                          `((source . ,(car e))
                                            (target . ,(cdr e))))
                                        (plist-get edges :presentational))))))


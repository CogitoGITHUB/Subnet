(defun aiu-subnet/goto-root ()
  "Visit the root ancestor of the current AIU."
  (interactive)
  (let* ((note (my/cyberdeck--buffer-aiu))
         (id   (cyberdeck-aiu-id note)))
    (while (aiu-subnet/parent-of id)
      (setq id (aiu-subnet/parent-of id)))
    (if (string= id (cyberdeck-aiu-id note))
        (message "Already at root.")
      (cyberdeck-visit (cyberdeck-db-get-by-id id)))))

**** Insert-after key computation
Auto-triggers aiu-subnet/repack if the gap to the next sibling < aiu-subnet/epsilon.
#+begin_src emacs-lisp
(defun aiu-subnet/order-key-after (aiu-id)
  "Return an ORDER_KEY placing a new sibling immediately after NOTE-ID.
Auto-triggers aiu-subnet/repack if the gap to the next sibling < aiu-subnet/epsilon."
  (let* ((row       (aiu-subnet/node-at aiu-id))
         (parent-id (nth 1 row))
         (aiu-type (nth 3 row))
         (cur-key   (nth 2 row))
         (next-key  (aiu-subnet/next-order-key-above parent-id aiu-type cur-key)))
    (if (null next-key)
        (+ cur-key 1.0)
      (let ((gap (- next-key cur-key)))
        (when (< gap aiu-subnet/epsilon)
          (aiu-subnet/repack parent-id aiu-type)
          (setq cur-key  (nth 2 (aiu-subnet/node-at aiu-id))
                next-key (aiu-subnet/next-order-key-above
                          parent-id aiu-type cur-key))))
        (/ (+ cur-key next-key) 2.0))))
#+end_src

**** Insert-between key computation
Auto-triggers aiu-subnet/repack if gap < aiu-subnet/epsilon.
#+begin_src emacs-lisp
(defun aiu-subnet/order-key-between (aiu-id-an aiu-id-b)
  "Return an ORDER_KEY placing a new node between NOTE-ID-A and NOTE-ID-B."
  (let* ((key-a (nth 2 (aiu-subnet/node-at aiu-id-a)))
         (key-b (nth 2 (aiu-subnet/node-at aiu-id-b)))
         (lo    (min key-a key-b))
         (hi    (max key-a key-b)))
    (when (< (- hi lo) aiu-subnet/epsilon)
      (let* ((row-a     (aiu-subnet/node-at aiu-id-a))
             (parent-id (nth 1 row-a))
             (aiu-type (nth 3 row-a)))
        (aiu-subnet/repack parent-id aiu-type)
        (setq key-a (nth 2 (aiu-subnet/node-at aiu-id-a))
              key-b (nth 2 (aiu-subnet/node-at aiu-id-b))
              lo    (min key-a key-b)
              hi    (max key-a key-b))))
    (/ (+ lo hi) 2.0)))

(defun aiu-subnet/reparent (aiu-id new-parent-id &optional after-id)
  "Move NOTE-ID to be a child of NEW-PARENT-ID.
If AFTER-ID is given, place immediately after that sibling.
Otherwise append at end with order-key = max + 1.0."
  (let ((order-key
         (if after-id
             (aiu-subnet/order-key-after after-id)
           (let ((max-key (caar (emacsql (cyberdeck-db)
                                         [:select [(funcall max order-key)]
                                          :from aiu-subnet-nodes
                                          :where (= parent-id $s1)]
                                         new-parent-id))))
             (+ (or max-key 0.0) 1.0)))))
    (aiu-subnet/set-parent aiu-id new-parent-id)
    (aiu-subnet/set-order-key aiu-id order-key)))

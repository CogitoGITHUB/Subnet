**** Placement dispatcher
#+begin_src emacs-lisp
(defun aiu-subnet/--prompt-placement (note)
  "Prompt to place AIU in the mind map — parent/child/sibling/unknown."
  (let ((aiu-id (cyberdeck-aiu-id note))
        (file    (cyberdeck-aiu-path note)))
    (when (and file (file-exists-p file))
      (with-current-buffer (find-file-noselect file)
        (let ((choice (read-char-choice
                       "[p]arent  [c]hild  [s]ibling  [u]nknown: "
                       '(?p ?c ?s ?u))))
          (pcase choice
            (?p (aiu-subnet/--place-under note))
            (?c (aiu-subnet/--place-under-parent note))
            (?s (aiu-subnet/--place-after-sibling note))
            (?u
             (aiu-subnet/make-root aiu-id)
             (message "✓ %s left as root" (cyberdeck-aiu-title note)))))))))
#+end_src

**** Prompt post-apply
The declarative AIU Subnet prompt lands here instead of the interactive
dispatcher — no questions asked twice.
#+begin_src emacs-lisp
(defun aiu-subnet/--apply-placement (placement target-id note)
  "Apply mind map PLACEMENT for NOTE with TARGET-ID.
Called as a post-apply function by the AIU Subnet prompt."
  (let ((aiu-id (cyberdeck-aiu-id note)))
    (pcase placement
      ("parent"
       (when (and target-id (not (string= aiu-id target-id)))
         (aiu-subnet/reparent target-id aiu-id)))
      ("child"
       (when (and target-id (not (string= aiu-id target-id)))
         (aiu-subnet/reparent aiu-id target-id)))
      ("sibling"
       (when target-id
         (let ((parent-id (aiu-subnet/parent-of target-id)))
           (if parent-id
               (aiu-subnet/set-parent aiu-id parent-id)
             (aiu-subnet/make-root aiu-id))
           (aiu-subnet/set-order-key aiu-id (aiu-subnet/order-key-after target-id)))))
      ("node"
       (when (and target-id (not (string= aiu-id target-id)))
         (aiu-subnet/reparent aiu-id target-id)
         (when (fboundp 'my/aiu-subnet-set-drawer)
           (my/aiu-subnet-set-drawer (cyberdeck-aiu-path note)
                             "MM_ANCHOR" target-id))))
      ("root"
       (aiu-subnet/make-root aiu-id)))))
#+end_src

**** Deterministic sibling stepping
Traversal, not search: these move exactly one step along the sibling
axis and stop at the boundary with a message. No wrapping, ever — a
traversal system that teleports from the last sibling to the first
stops meaning "move through the topology" and starts performing a
hidden search. The picker-based goto-sibling above stays for jumps;
these are for walking.
#+begin_src emacs-lisp
(defun aiu-subnet/--sibling-at-offset (aiu-id offset)
  "Note-id OFFSET steps from NOTE-ID among ordered siblings, or nil.
Negative goes toward earlier siblings, positive toward later ones."
  (when-let* ((row       (aiu-subnet/node-at aiu-id))
              (aiu-type (nth 3 row))
              (parent-id (nth 1 row)))
    (let* ((sibs (if parent-id
                     (emacsql (cyberdeck-db)
                              [:select [aiu-id]
                               :from aiu-subnet-nodes
                               :where (and (= parent-id $s1)
                                           (= aiu-type $s2))
                               :order-by [(asc order-key)]]
                              parent-id aiu-type)
                   (emacsql (cyberdeck-db)
                            [:select [aiu-id]
                             :from aiu-subnet-nodes
                             :where (and (is parent-id nil)
                                         (= aiu-type $s1))
                             :order-by [(asc order-key)]]
                            aiu-type)))
           (ids  (mapcar #'car sibs))
           (pos  (cl-position aiu-id ids :test #'string=)))
      (when pos
        (nth (+ pos offset) ids)))))

(defun aiu-subnet/goto-next-sibling ()
  "Visit the next sibling in map order. Stops at the boundary."
  (interactive)
  (let* ((note (my/cyberdeck--buffer-aiu))
         (next (and note (aiu-subnet/--sibling-at-offset
                          (cyberdeck-aiu-id note) 1))))
    (if next
        (cyberdeck-visit (cyberdeck-db-get-by-id next))
      (message "Already at last sibling."))))

(defun aiu-subnet/goto-prev-sibling ()
  "Visit the previous sibling in map order. Stops at the boundary."
  (interactive)
  (let* ((note (my/cyberdeck--buffer-aiu))
         (prev (and note (aiu-subnet/--sibling-at-offset
                          (cyberdeck-aiu-id note) -1))))
    (if prev
        (cyberdeck-visit (cyberdeck-db-get-by-id prev))
      (message "Already at first sibling."))))

(defun aiu-subnet/traverse-child ()
  "Descend one level: first child when several, direct when one.
Headings are internal structure of their file card, not map nodes,
so from a heading this ascends to the file card first — s/n then
walks the tree proper. A leaf reports instead of guessing."
  (interactive)
  (let* ((note (my/cyberdeck--buffer-aiu)))
    (unless note (user-error "No AIU at point"))
    (if (> (cyberdeck-aiu-level note) 0)
        (let ((file-aiu (car (emacsql (cyberdeck-db)
                               [:select [id] :from notes
                                :where (and (= path $s1) (= level 0))]
                               (cyberdeck-aiu-path note)))))
          (if file-aiu
              (cyberdeck-visit (cyberdeck-db-get-by-id file-aiu))
            (message "No file card above.")))
      (let ((children (aiu-subnet/children-of (cyberdeck-aiu-id note))))
        (cond ((null children)
               (message "Leaf node — no children."))
              ((null (cdr children))
               (cyberdeck-visit
                (cyberdeck-db-get-by-id (caar children))))
              (t (aiu-subnet/goto-child)))))))

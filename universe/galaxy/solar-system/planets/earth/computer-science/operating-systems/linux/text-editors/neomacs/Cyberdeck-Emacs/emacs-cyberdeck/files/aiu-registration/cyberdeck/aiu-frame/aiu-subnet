(defun aiu-subnet/set-parent (aiu-id parent-id)
  "Set parent of NOTE-ID to PARENT-ID and recompute depth for subtree."
  (let* ((parent-row   (aiu-subnet/node-at parent-id))
         (parent-depth (if parent-row (nth 4 parent-row) 0)))
    (emacsql (cyberdeck-db)
             [:update aiu-subnet-nodes
              :set [(= parent-id $s1) (= depth $s2)]
              :where (= aiu-id $s3)]
             parent-id (1+ parent-depth) aiu-id)
    (aiu-subnet/recompute-depths aiu-id (+ 2 parent-depth))
    (aiu-subnet/sync-file-drawer aiu-id)))

(defun aiu-subnet/make-root (aiu-id)
  "Remove parent of NOTE-ID, making it a root file AIU."
  (emacsql (cyberdeck-db)
           [:update aiu-subnet-nodes
            :set [(= parent-id nil) (= depth 0)]
            :where (= aiu-id $s1)]
           aiu-id)
  (aiu-subnet/recompute-depths aiu-id 1)
  (aiu-subnet/sync-file-drawer aiu-id))

(defun aiu-subnet/recompute-depths (aiu-id child-depth)
  "Recursively recompute depths for all file children of NOTE-ID."
  (dolist (child-id (mapcar #'car (aiu-subnet/children-of aiu-id)))
    (emacsql (cyberdeck-db)
             [:update aiu-subnet-nodes
              :set [(= depth $s1)]
              :where (= aiu-id $s2)]
             child-depth child-id)
    (aiu-subnet/recompute-depths child-id (1+ child-depth))))

(defun aiu-subnet/set-order-key (aiu-id key)

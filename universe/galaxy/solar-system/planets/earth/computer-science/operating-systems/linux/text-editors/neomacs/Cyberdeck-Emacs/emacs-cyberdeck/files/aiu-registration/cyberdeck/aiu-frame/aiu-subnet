**** Table and registration
#+begin_src emacs-lisp
(defconst aiu-subnet/epsilon 1e-10
  "Minimum ORDER_KEY gap before aiu-subnet/repack is triggered automatically.")

(defun aiu-subnet/ensure-table ()
  "Create aiu-subnet-nodes table and indexes in cyberdeck DB if they do not exist."
  (emacsql (cyberdeck-db)
           [:create :table :if :not :exists aiu-subnet-nodes
            ([(aiu-id :text :primary-key :not-null)
              (parent-id :text)
              (order-key :real :not-null)
              (aiu-type :text :not-null)
              (depth :integer :not-null)]
             (:foreign-key [aiu-id] :references notes [id]
              :on-delete :cascade))])
  (emacsql (cyberdeck-db)
           [:create :index :if :not :exists aiu-subnet-idx-parent
            :on aiu-subnet-nodes [parent-id order-key]])
  (emacsql (cyberdeck-db)
           [:create :index :if :not :exists aiu-subnet-idx-depth
            :on aiu-subnet-nodes [depth]]))

(defun aiu-subnet/ensure-and-register ()
  "Ensure schema exists and register mm extractor with cyberdeck."
  (aiu-subnet/ensure-table)
  (cyberdeck-db-register-extractor
   (make-cyberdeck-extractor
    :name       'aiu-subnet-nodes
    :version    1
    :priority   70
    :extract-fn #'aiu-subnet/extract)))

(with-eval-after-load 'cyberdeck
  (aiu-subnet/ensure-and-register))

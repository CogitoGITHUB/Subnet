(defun aiu-subnet/repack (parent-id aiu-type)
  "Normalize ORDER_KEYs for siblings under PARENT-ID of NODE-TYPE.
Assigns 1.0, 2.0, 3.0, ... in current sorted order."
  (let ((siblings (emacsql (cyberdeck-db)
                           [:select [aiu-id]
                            :from aiu-subnet-nodes
                            :where (and (= parent-id $s1)
                                        (= aiu-type $s2))
                            :order-by [(asc order-key)]]
                           parent-id aiu-type))
        (i 1.0))
    (dolist (row siblings)
      (emacsql (cyberdeck-db)
               [:update aiu-subnet-nodes
                :set [(= order-key $s1)]
                :where (= aiu-id $s2)]
               i (car row))
      (setq i (+ i 1.0)))
    (message "mm: repacked %d siblings" (round (1- i)))))

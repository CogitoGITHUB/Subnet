**** Recursive level inserter
Headings render one level below their file; children indent deeper
when headings exist so the group stays visually coherent. Each line
carries its Installation Protocol stage (a display read — the map owns none of
it) plus a status flag whenever the AIU isn't ACTIVE.
#+begin_src emacs-lisp
(defun aiu-subnet/map--stage-of (aiu-id)
  "Stage token of NOTE-ID for display, defaulting to AWARE.
Reads the schedule row (fast, indexed); falls back to the drawer."
  (or (caar (condition-case nil
                (emacsql (cyberdeck-db)
                         [:select [stage] :from installation-schedule
                          :where (= aiu-id $s1)]
                         aiu-id)
              (error nil)))
      "AWARE"))

(defun aiu-subnet/map--insert-level (rows level)
  "Insert ROWS as org headings at LEVEL, recursing into children."
  (dolist (row rows)
    (let* ((aiu-id  (car row))
           (note     (cyberdeck-db-get-by-id aiu-id))
           (status   (aiu-subnet/status-of aiu-id))
           (stage    (aiu-subnet/map--stage-of aiu-id))
           (stars    (make-string level ?*))
           (tag      (concat (format " [%s]" stage)
                             (unless (string-equal status "ACTIVE")
                               (format "[%s]" status))))
           (headings (aiu-subnet/headings-of aiu-id))
           (children (aiu-subnet/children-of aiu-id)))
      (when note
        (insert (format "%s %s%s  [[id:%s]]\n"
                        stars
                        (cyberdeck-aiu-title note)
                        tag
                        aiu-id))
        (dolist (h-row headings)
          (when-let* ((h-aiu (cyberdeck-db-get-by-id (car h-row))))
            (insert (format "%s %s [%s]  [[id:%s]]\n"
                            (make-string (1+ level) ?*)
                            (cyberdeck-aiu-title h-aiu)
                            (aiu-subnet/map--stage-of (car h-row))
                            (car h-row)))))
        (when children
          (aiu-subnet/map--insert-level children (+ level 1 (if headings 1 0))))))))
#+end_src

**** Group side buffer
Shows the file card, its headings, and one branch-coverage line: how
many scoped cards sit at UNDERSTANDING or above. Coverage is computed
live from stage reads — never stored — so it can't drift from the
schedule table.
#+begin_src emacs-lisp
(defun aiu-subnet/branch-coverage (aiu-id)
  "Return (AT-OR-ABOVE . TOTAL) for NOTE-ID's branch incl. headings.
Counts cards at UNDERSTANDING or above on the spine; UNSEEN counts as
below. Pure read over aiu-subnet/* + stage lookups."
  (let* ((scope (cons aiu-id (aiu-subnet/subtree-of aiu-id)))
         (headings (mapcar #'car (aiu-subnet/headings-of aiu-id)))
         (all (append scope headings))
         (at 0))
    (unless (fboundp 'my/cyberdeck-installation-protocol--stage-index)
      (error "Installation Protocol engine not loaded"))
    (dolist (id all)
      (let ((idx (my/cyberdeck-installation-protocol--stage-index
                  (aiu-subnet/map--stage-of id))))
        (when (and (>= idx 0)
                   (>= idx (my/cyberdeck-installation-protocol--stage-index
                            "UNDERSTANDING")))
          (setq at (1+ at)))))
    (cons at (length all))))

(defun aiu-subnet/group-display ()
  "Display the Group of the current buffer AIU in a side buffer."
  (interactive)
  (let* ((note  (my/cyberdeck--buffer-aiu))
         (group (aiu-subnet/group-of (cyberdeck-aiu-id note))))
    (with-current-buffer (get-buffer-create "*aiu-subnet-group*")
      (erase-buffer)
      (org-mode)
      (insert (format "#+TITLE: Group — %s\n\n"
                      (cyberdeck-aiu-title (plist-get group :file))))
      (let ((cov (ignore-errors
                   (aiu-subnet/branch-coverage
                    (cyberdeck-aiu-id (plist-get group :file))))))
        (when cov
          (insert (format "Coverage: %d/%d cards at UNDERSTANDING or above\n\n"
                          (car cov) (cdr cov)))))
      (insert "* File\n")
      (insert (format "  [[id:%s][%s]]\n"
                      (cyberdeck-aiu-id (plist-get group :file))
                      (cyberdeck-aiu-title (plist-get group :file))))
      (when (plist-get group :headings)
        (insert "* Headings\n")
        (dolist (h (plist-get group :headings))
          (insert (format "  [[id:%s][%s]]\n"
                          (cyberdeck-aiu-id h)
                          (cyberdeck-aiu-title h)))))
      (display-buffer (current-buffer)))))

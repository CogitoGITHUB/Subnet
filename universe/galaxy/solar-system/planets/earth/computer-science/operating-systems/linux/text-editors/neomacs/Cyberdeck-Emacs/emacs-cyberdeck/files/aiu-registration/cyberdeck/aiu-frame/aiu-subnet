*** Position Management
Reparenting and order-key manipulation.

**** File drawer sync
Writes live mm state back into the AIU file so files stay
authoritative for boot order. Best-effort: never signals.
#+begin_src emacs-lisp
(defun aiu-subnet/sync-file-drawer (aiu-id)
  "Write NOTE-ID's mm parent/order into its own heading drawer.
Jumps to the heading carrying NOTE-ID's :ID:, so file and heading
AIUs each update exactly their own drawer."
  (condition-case err
      (let* ((row (aiu-subnet/node-at aiu-id))
             (rec (and row (car (emacsql (cyberdeck-db)
                                        [:select [path] :from notes
                                         :where (= id $s1)]
                                        aiu-id))))
             (path (and rec (fboundp 'my/cyberdeck-root-dir)
                        (expand-file-name (car rec)
                                          (my/cyberdeck-root-dir)))))
        (when (and path (file-exists-p path))
          (with-current-buffer (find-file-noselect path)
            (goto-char (point-min))
            (let ((hpos (save-excursion
                          (when (re-search-forward
                                 (format "^[ \t]*:ID:[ \t]*%s[ \t]*$"
                                         (regexp-quote aiu-id))
                                 nil t)
                            (when (re-search-backward "^\\*+ " nil t)
                              (copy-marker (point)))))))
              (when hpos
                (goto-char hpos)
                (forward-line 1)
                (when (looking-at "^[ \t]*:PROPERTIES:[ \t]*$")
                  (let ((dend (save-excursion
                                (when (re-search-forward "^[ \t]*:END:" nil t)
                                  (copy-marker (point))))))
                    (when dend
                      (dolist (kv `(("MM_PARENT" . ,(or (nth 1 row) "none"))
                                    ("MM_ORDER" . ,(number-to-string
                                                    (or (nth 2 row) 0.0)))))
                        (goto-char hpos)
                        (forward-line 1)
                        (if (re-search-forward
                             (format "^[ \t]*:%s:" (car kv)) dend t)
                            (progn (beginning-of-line) (kill-line)
                                   (insert (format ":%s: %s"
                                                   (car kv) (cdr kv))))
                          (goto-char dend)
                          (forward-line -1)
                          (end-of-line)
                          (insert (format "\n:%s: %s"
                                          (car kv) (cdr kv)))))
                      (set-marker dend nil))))
                (set-marker hpos nil)
                (save-buffer))))))
    (error (message "aiu-subnet/file-sync failed [%s]: %s"
                    aiu-id (error-message-string err)))))
#+end_src


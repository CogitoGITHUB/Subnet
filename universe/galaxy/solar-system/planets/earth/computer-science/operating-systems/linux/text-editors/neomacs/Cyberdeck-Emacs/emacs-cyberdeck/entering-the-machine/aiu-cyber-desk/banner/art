** Banner — dynamic outer box (follows window width)
Recomputed before every dashboard render, so resizes re-box.
#+begin_src emacs-lisp
(defun cyberdeck/banner-box (&optional width)
  "Frame `cyberdeck/banner-content-lines' in an outer box.
WIDTH defaults to the dashboard window width, clamped between
content width and 120 columns."
  (let* ((win (and (boundp 'dashboard-buffer-name)
                   (get-buffer-window dashboard-buffer-name)))
         (cols (or width (if win (window-width win) 80)))
         (inner (apply #'max
                       (mapcar #'string-width
                               cyberdeck/banner-content-lines)))
         (w (min (max (+ inner 4) (- cols 2)) 120))
         (center (lambda (s)
                   (let ((pad (- w (string-width s))))
                     (concat "║" (make-string (/ pad 2) ?\s) s
                             (make-string (- pad (/ pad 2)) ?\s) "║")))))
    (mapconcat #'identity
               (append (list (concat "╔" (make-string w ?═) "╗"))
                       (mapcar center cyberdeck/banner-content-lines)
                       (list (concat "╚" (make-string w ?═) "╝")))
               "\n")))

(defun cyberdeck/banner-apply (&rest _)
  "Recompute the dashboard banner for the current window width."
  (when (boundp 'dashboard-banner-ascii)
    (setq dashboard-banner-ascii (cyberdeck/banner-box)
          dashboard-startup-banner 'ascii)))

(when (fboundp 'dashboard-insert-startupify-lists)
  (advice-add 'dashboard-insert-startupify-lists
              :before #'cyberdeck/banner-apply))
#+end_src

(defun cyberdeck/banner-available-width (&optional width)
  "Return usable banner columns.
With WIDTH, use it as the available width (tests, callers).
Else use the body width of the dashboard window, else the selected
window, else the frame width --- always minus 1, because the last
TTY column wraps.  There is no 80-column fallback."
  (if width
      width
    (max 21
         (1- (let ((win (and (boundp 'dashboard-buffer-name)
                             (get-buffer-window dashboard-buffer-name))))
                (cond ((and win (window-live-p win))
                       (window-body-width win))
                      ((window-live-p (selected-window))
                       (window-body-width (selected-window)))
                      (t
                       (frame-width))))))))

(defun cyberdeck/banner--wrap (text width)
  "Wrap TEXT by words into lines of at most WIDTH columns, centered.
Every returned line is exactly WIDTH columns wide."
  (let ((lines nil)
        (line ""))
    (dolist (word (split-string text " +" t))
      (let ((trial (if (string-empty-p line) word (concat line " " word))))
        (if (<= (string-width trial) width)
            (setq line trial)
          (push line lines)
          (setq line word))))
    (push line lines)
    (mapcar (lambda (s) (cyberdeck/banner--pad-line s width))
            (nreverse lines))))

(defun cyberdeck/banner--pad-line (s width)
  "Center S in exactly WIDTH columns.
Left and right padding differ by at most 1."
  (let* ((pad (max 0 (- width (string-width s))))
         (left (/ pad 2)))
    (concat (make-string left ?\s) s
            (make-string (- pad left) ?\s))))

(defun cyberdeck/banner--inner-box (content-width)
  "Generate the inner CYBERDECK box, at most CONTENT-WIDTH wide.
Border width derives from `cyberdeck/banner-inner-text'; side
padding is equal left/right (+/-1) and shrinks under pressure."
  (let* ((text cyberdeck/banner-inner-text)
         (text-w (string-width text))
         (total (min content-width (+ text-w (* 2 cyberdeck/banner-inner-pad) 2)))
         (total (max total (+ text-w 2)))
         (inner-w (- total 2))
         (pad (- inner-w text-w))
         (left (/ pad 2))
         (right (- pad left))
         (mid (concat (make-string left ?\s) text (make-string right ?\s)))
         (box (list (concat "┌" (make-string inner-w ?─) "┐")
                    (concat "│" mid "│")
                    (concat "└" (make-string inner-w ?─) "┘"))))
    (mapcar (lambda (s) (cyberdeck/banner--pad-line s content-width))
            box)))

(defun cyberdeck/banner-box (&optional width)
  "Build the dashboard banner for available WIDTH columns.
WIDTH defaults to `cyberdeck/banner-available-width'.  Total outer
width is (min available `cyberdeck/banner-max-width').  Tiers:
wide shows the full spaced title, medium a wrapped compact title,
narrow only the inner box.  Every line shares one string-width."
  (let* ((available (cyberdeck/banner-available-width width))
         (total (min available cyberdeck/banner-max-width))
         (content-w (max 1 (- total 2)))
         (full-w (string-width cyberdeck/banner-title-full))
         (preferred (+ (string-width cyberdeck/banner-inner-text)
                       (* 2 cyberdeck/banner-inner-pad) 2))
         (lines (cond ((>= content-w full-w)
                       (append (list (cyberdeck/banner--pad-line
                                      cyberdeck/banner-title-full content-w))
                               (list (make-string content-w ?\s))
                               (cyberdeck/banner--inner-box content-w)))
                      ((>= content-w preferred)
                       (append (cyberdeck/banner--wrap
                                cyberdeck/banner-title-compact content-w)
                               (list (make-string content-w ?\s))
                               (cyberdeck/banner--inner-box content-w)))
                      (t
                       (cyberdeck/banner--inner-box content-w))))
         (frame (lambda (s)
                  (concat "║" s "║"))))
    (mapconcat #'identity
               (append (list (concat "╔" (make-string content-w ?═) "╗"))
                       (mapcar frame lines)
                       (list (concat "╚" (make-string content-w ?═) "╝")))
               "\n")))

(defun cyberdeck/banner-apply (&rest _)
  "Recompute the dashboard banner for the current window width."
  (when (boundp 'dashboard-banner-ascii)
    (setq dashboard-banner-ascii (cyberdeck/banner-box)
          dashboard-startup-banner 'ascii)))

(defvar cyberdeck/banner--resize-timer nil
  "Pending debounced dashboard banner re-render timer, if any.")

(defun cyberdeck/banner--resize-now ()
  "Re-render the dashboard banner if its window is visible."
  (setq cyberdeck/banner--resize-timer nil)
  (let ((buf (and (boundp 'dashboard-buffer-name)
                  (get-buffer dashboard-buffer-name))))
    (when (buffer-live-p buf)
      (let ((win (get-buffer-window buf)))
        (when (and (window-live-p win) (fboundp 'dashboard-open))
          (with-selected-window win
            (dashboard-open)))))))

(defun cyberdeck/banner--on-size-change (&optional _frame)
  "Debounce dashboard banner re-render after a window size change."
  (when (timerp cyberdeck/banner--resize-timer)
    (cancel-timer cyberdeck/banner--resize-timer))
  (setq cyberdeck/banner--resize-timer
        (run-with-idle-timer 0.15 nil #'cyberdeck/banner--resize-now)))

(unless (memq #'cyberdeck/banner--on-size-change window-size-change-functions)
  (add-hook 'window-size-change-functions #'cyberdeck/banner--on-size-change))

;; Upstream's resize hook re-renders WITHOUT erasing (no force-refresh),
;; stacking a second full dashboard under the first on every resize.
;; Ours erases via `dashboard-open', so the upstream one must go.
(remove-hook 'window-size-change-functions #'dashboard-resize-on-hook)
(remove-hook 'window-setup-hook #'dashboard-resize-on-hook)

(when (fboundp 'dashboard-insert-startupify-lists)
  (advice-add 'dashboard-insert-startupify-lists
              :before #'cyberdeck/banner-apply))

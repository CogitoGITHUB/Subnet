;; NOTE 2025-11-25: This is a copy of `color-blend' from Emacs 31.  We
;; should remove this in the future.
(defun theme-blend (a b &optional alpha)
  "Blend the two colors A and B in linear space with ALPHA.
A and B should be lists (RED GREEN BLUE), where each element is
between 0.0 and 1.0, inclusive.  ALPHA controls the influence A
has on the result and should be between 0.0 and 1.0, inclusive.

For instance:

   (theme-blend \\='(1 0.5 1) \\='(0 0 0) 0.75)
      => (0.75 0.375 0.75)"
  (setq alpha (or alpha 0.5))
  (let (blend)
    (dotimes (i 3)
      (push (+ (* (nth i a) alpha) (* (nth i b) (- 1 alpha))) blend))
    (nreverse blend)))

(defun theme-generate-color-blend (color blended-with-hex alpha)
  "Return hexadecimal RGB of COLOR with BLENDED-WITH-HEX given ALPHA.
BLENDED-WITH-HEX is commensurate with COLOR.  ALPHA is between 0.0 and 1.0,
inclusive.

Color values are of the form accepted by `theme-wcag-formula'."
  (let* ((blend-rgb (theme-blend
                     (theme--hex-or-name-to-rgb color)
                     (theme--hex-or-name-to-rgb blended-with-hex)
                     alpha))
         (blend-hex (apply #'color-rgb-to-hex blend-rgb)))
    (theme--color-eight-to-six-digits blend-hex)))

(defun theme-generate-color-warmer (color alpha)
  "Return warmer COLOR by ALPHA, per `theme-generate-color-blend'."
  (theme-generate-color-blend color "#ff0000" alpha))

(defun theme-generate-color-cooler (color alpha)
  "Return cooler COLOR by ALPHA, per `theme-generate-color-blend'."
  (theme-generate-color-blend color "#0000ff" alpha))

(define-obsolete-function-alias
  'theme-generate-gradient
  'theme-adjust-value
  "5.3.0")

(defun theme-color-warm-p (color)
  "Return non-nil if COLOR is warm.
A warm color has more contribution from the red channel of light than
the blue one."
  (pcase-let ((`(,r ,_ ,b) (theme--hex-or-name-to-rgb color)))
    (> r b)))

(defun theme-color-is-warm-or-cool-p (color)
  "Return `warm' or `cool' for COLOR depending on its value."
  (if (theme-color-warm-p color)
      'warm
    'cool))

(defun theme-generate-color-warmer-or-cooler (color alpha &optional preference)
  "Return COLOR variant by ALPHA and PREFERENCE.
PREFERENCE is either `cool' or `warm'.  An unknown PREFERENCE means
`cool'.  Without PREFERENCE, rely on the return value of
`theme-color-is-warm-or-cool-p'."
  (let ((kind (or preference (theme-color-is-warm-or-cool-p color))))
    (funcall
     (if (eq kind 'warm)
         #'theme-generate-color-warmer
       'theme-generate-color-cooler)
     color
     alpha)))


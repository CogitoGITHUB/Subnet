(defun theme-declare (name family description background-mode core-palette user-palette overrides-palette)
  "Declare NAME theme that belongs to FAMILY.
All of DESCRIPTION, BACKGROUND-MODE, CORE-PALETTE, USER-PALETTE,
OVERRIDES-PALETTE have the same meaning as in `theme-theme'.

To simply register the theme, use `theme-register'."
  (custom-declare-theme
   name (intern (format "%s-theme" name))
   description
   (list :kind 'color-scheme :background-mode background-mode :family family
         :theme-core-palette core-palette :theme-user-palette user-palette
         :theme-overrides-palette overrides-palette :theme-documentation description)))

(defun theme-register (name)
  "Add NAME theme to `theme-registered-items'.
To actually declare a theme, instantiating with together with its
properties, use `theme-declare'."
  (add-to-list 'theme-registered-items name))

;;;###autoload
(defun theme-theme (name family description background-mode core-palette user-palette overrides-palette &optional custom-faces custom-variables)
  "Define a theme or derivative thereof.
NAME is the name of the new theme.  FAMILY is the collection of themes
it belongs to.  DESCRIPTION is its documentation string.
BACKGROUND-MODE is either `dark' or `light', in reference to the theme's
background color.  The CORE-PALETTE, USER-PALETTE, and OVERRIDES-PALETTE
are symbols of variables which define palettes commensurate with
`palette-light'.

The optional CUSTOM-FACES and CUSTOM-VARIABLES are joined together with
the `theme-faces' and `theme-custom-variables',
respectively.  A derivative theme defining those is thus overriding what
the themes have by default.

Consult the upstream manual (see the header of `theme-options') for
details on how to build a theme on top of the `cyberdeck' family."
  (let ((theme-exists-p (get name 'theme-feature))
        (faces (append
                (symbol-value custom-faces)
                theme-faces))
        (variables (append
                    theme-custom-variables
                    (symbol-value custom-variables)
                    (list `'(frame-background-mode ',background-mode)))))
    (unless theme-exists-p
      (theme-declare
       name family
       description background-mode
       core-palette user-palette overrides-palette)
      (unless (eq family 'cyberdeck)
        (theme-register name)))
    (let ((palette (theme--get-theme-palette-subr name :with-overrides :with-user-palette)))
      (eval
       `(let* ((c '((class color) (min-colors 256)))
               (palette (theme--get-theme-palette-subr ',name :with-overrides :with-user-palette))
               ,@(mapcar
                  (lambda (entry)
                    (let ((name (car entry)))
                      (list name `(theme-retrieve-palette-value ',name palette))))
                  palette))
          (custom-theme-set-faces
           ',name
           ,@faces)
          (custom-theme-set-variables
           ',name
           ,@variables))
       :lexical))
    (unless (featurep theme-exists-p)
      (provide-theme name))))

;;;; Use theme colors

(defun theme--with-colors-get-palette (theme)
  "Get THEME palette for `theme-with-colors'.
Return (list CORE USER OVERRIDES) palettes."
  (when-let* ((properties (get theme 'theme-properties))
              (core-palette (symbol-value (plist-get properties :theme-core-palette))))
    (let* ((user-palette (symbol-value (plist-get properties :theme-user-palette)))
           (overrides-palette (symbol-value (plist-get properties :theme-overrides-palette)))
           (all-overrides (append overrides-palette palette-common-overrides)))
      (list core-palette user-palette all-overrides))))

(defun theme--with-colors-resolve-palette-sort (colors)
  "Sort all COLORS in the theme's palette.
Put all named colors before semantic color mappings.  A named color is a
symbol whose value is a string.  A semantic color mapping is a symbol
whose value is another symbol, which ultimately resolves to a string or
`unspecified'."
  (let ((named nil)
        (semantic nil))
    (dolist (group colors)
      (dolist (color group)
        (if (stringp (cadr color))
            (push color named)
          (push color semantic))))
    (let* ((unique-fn (lambda (sequence)
                        (seq-uniq sequence
                                  (lambda (elt1 elt2)
                                    (eq (car elt1) (car elt2))))))
           (named-unique (funcall unique-fn named))
           (semantic-unique (funcall unique-fn semantic)))
      (nreverse (nconc semantic-unique named-unique)))))

(defmacro theme-with-colors (&rest body)
  "Evaluate BODY with colors from current palette bound."
  (declare (indent 0))
  `(condition-case data
       (when-let* ((theme (theme-get-current-theme))
                   (palette (theme--with-colors-get-palette theme)))
         (let ((bindings
                (append
                 '((c '((class color) (min-colors 256))) (unspecified 'unspecified))
                 (cl-remove-duplicates (apply #'append palette) :key #'car))))
           (eval (nconc `(cl-symbol-macrolet ,bindings) ',body))))
     (error (message "Error in theme-with-colors: %s" data))))


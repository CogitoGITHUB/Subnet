(define-minor-mode theme-include-derivatives-mode
  "When enabled, all themes commands cover derivatives as well.
Otherwise, they only consider the `theme-items'.

Derivative theme projects can implement the equivalent of this minor
mode plus a method for `theme-get-themes' to filter themes
accordingly."
  :global t
  :init-value nil)

(cl-defmethod theme-get-themes (&context (theme-include-derivatives-mode (eql t)))
  "Return list of themes per `theme-include-derivatives-mode'."
  (if-let* ((themes (theme-get-all-known-themes nil))
            (sorted-themes (theme-sort themes 'light)))
      sorted-themes
    theme-items))

;;;; Let derivative themes create commands to load only their themes

(defvar theme-define-derivative-command-known-suffixes
  '( toggle rotate select select-dark select-light
     load-random load-random-dark load-random-light
     list-colors list-colors-current)
  "Command suffixes accepted by `theme-define-derivative-command'.")

(defmacro theme-define-derivative-command (family suffix)
  "Define convenience command with SUFFIX to load only FAMILY themes.
SUFFIX is a symbol among those listed in the variable
`theme-define-derivative-command-known-suffixes'.  The newly
defined command's symbol is FAMILY-SUFFIX, like `theme-rotate'."
  (unless (memq suffix theme-define-derivative-command-known-suffixes)
    (error "Cannot define command with unknown suffix `%s'" suffix))
  (let ((theme-command (intern (format "theme-%s" suffix))))
    `(defun ,(intern (format "%s-%s" family suffix)) ()
       ,(format "Like `%s' but only for the `%s'" theme-command family)
       (interactive)
       (cl-letf (((symbol-function 'theme-get-themes)
                  (lambda ()
                    (theme-get-all-known-themes ',family))))
         (call-interactively ',theme-command)))))


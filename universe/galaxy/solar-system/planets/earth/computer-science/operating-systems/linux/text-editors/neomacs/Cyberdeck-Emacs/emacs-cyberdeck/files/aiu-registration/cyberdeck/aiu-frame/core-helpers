** Point-based lookup
Walks up to the enclosing heading if the cursor is in the body/drawer.
#+begin_src emacs-lisp
(defun my/cyberdeck--aiu-at-point ()
  "Return the AIU for the heading under (or enclosing) point."
  (when (derived-mode-p 'org-mode)
    (unless (org-at-heading-p)
      (ignore-errors (org-back-to-heading t)))
    (let ((id (org-entry-get nil "ID")))
      (and id (cyberdeck-db-get-by-id id)))))
#+end_src

** Buffer fallback
Prefers the AIU under the cursor, falls back to the deepest AIU at or before point in the file.
#+begin_src emacs-lisp
(defun my/cyberdeck--buffer-aiu ()
  "Return the AIU for the current buffer, or nil."
  (or (my/cyberdeck--aiu-at-point)
      (when-let* ((file (buffer-file-name))
                 (notes (cyberdeck-db-query-by-file-path (file-truename file))))
        (let ((pos-point (point)))
          (or (let ((best nil))
                (dolist (n notes best)
                  (let ((npos (cyberdeck-aiu-pos n)))
                    (when (and npos (<= npos pos-point)
                               (or (null best) (> npos (cyberdeck-aiu-pos best))))
                      (setq best n)))))
              (car notes))))))
#+end_src

* Tolerant Drawer Access

** Drawer region locator
Finds the property drawer of the heading at point without org's own strict parsing.
#+begin_src emacs-lisp
(defun my/cyberdeck--drawer-region ()
  (save-excursion
    (when (condition-case nil (org-back-to-heading t) (error nil))
      (let* ((beg (line-beginning-position))
             (hend (save-excursion
                     (goto-char beg)
                     (forward-line 1)
                     (if (re-search-forward "^\\*+[ \t]" (point-max) t)
                         (line-beginning-position)
                       (point-max)))))
        (goto-char beg)
        (when (re-search-forward "^:PROPERTIES:[ \t]*$" hend t)
          (let ((a (line-beginning-position 2)))
            (when (re-search-forward "^:END:[ \t]*$" hend t)
              (cons a (line-beginning-position)))))))))
#+end_src

** Drawer read
#+begin_src emacs-lisp
(defun my/cyberdeck--drawer-get (key)
  (save-excursion
    (when-let* ((r (my/cyberdeck--drawer-region)))
      (goto-char (car r))
      (or (when (re-search-forward
                 (format "^:%s:[[:blank:]]+\\(.*\\)$" (regexp-quote key))
                 (cdr r) t)
            (match-string-no-properties 1))
          (progn
            (goto-char (car r))
            (when (re-search-forward
                   "^#\\+AIU Proxy: \\[\\[id:\\([^]]+\\)\\]\\[\\([^]]*\\)\\]\\]"
                   (cdr r) t)
              (let ((label (match-string-no-properties 2)))
                (when (string-equal key (my/cyberdeck--key-from-label label))
                  (format "[[id:%s][%s]]"
                          (match-string-no-properties 1) label)))))))))
#+end_src

** Drawer write
#+begin_src emacs-lisp
(defun my/cyberdeck--drawer-put (key value)
  (save-excursion
    (let ((r (my/cyberdeck--drawer-region)))
      (if r
          (progn
            (goto-char (car r))
            (if (re-search-forward
                 (format "^:%s:[[:blank:]]*\\(.*\\)$" (regexp-quote key))
                 (cdr r) t)
                (progn (beginning-of-line)
                       (delete-region (line-beginning-position)
                                      (line-end-position))
                       (insert (format ":%s: %s" key value)))
              (goto-char (cdr r))
              (beginning-of-line)
              (insert (format ":%s: %s\n" key value))))
        (org-back-to-heading t)
        (end-of-line)
        (forward-line 1)
        (unless (bolp) (insert "\n"))
        (insert (format ":PROPERTIES:\n:%s: %s\n:END:\n" key value))))))
#+end_src

